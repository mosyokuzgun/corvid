diff --git a/Dockerfile.nvidia b/Dockerfile.nvidia
new file mode 100644
index 0000000..131f155
--- /dev/null
+++ b/Dockerfile.nvidia
@@ -0,0 +1,77 @@
+# Restreamer NVIDIA fork bundle.
+#
+# Same layout, same processes, same ports as the official datarhei/restreamer:cuda image:
+#   /core/bin/core, /core/ui, /core/config, /core/data, run.sh
+#   8080/tcp (UI+API), 8181/tcp (HTTPS), 1935/tcp (RTMP), 1936/tcp (RTMPS), 6000/udp (SRT)
+#
+# Only the core and the UI are built from the fork sources. FFmpeg stays the official,
+# datarhei-patched CUDA build (the core needs its JSON progress patch).
+#
+#   docker build -f Dockerfile.nvidia \
+#     --build-context core=../core --build-context ui=../restreamer-ui -t restreamer:nvidia .
+#
+# Stage names (core-build, ui-build) must differ from the build-context names (core, ui),
+# otherwise BuildKit resolves "COPY --from=core" to the stage itself.
+
+# FFmpeg 6.1.1 with CUDA filters (built by build.sh from datarhei/ffmpeg, branch 6.1);
+# the stable UI accepts FFmpeg ^5.1 || ^6.1 only.
+ARG FFMPEG_IMAGE=restreamer-ffmpeg:6.1.1-cuda
+ARG GOLANG_IMAGE=golang:1.24-bookworm
+ARG NODE_IMAGE=node:22-bookworm
+
+# Build caches (BuildKit cache mounts) keep Go objects and downloaded npm packages on the host,
+# so a rebuild after a code change recompiles only what changed instead of fetching everything again.
+FROM $GOLANG_IMAGE AS core-build
+COPY --from=core . /dist/core
+RUN --mount=type=cache,target=/root/.cache/go-build \
+    --mount=type=cache,target=/go/pkg/mod \
+    cd /dist/core && make release && make import && make ffmigrate
+
+FROM $NODE_IMAGE AS ui-build
+ENV PUBLIC_URL="./"
+ENV YARN_CACHE_FOLDER=/yarn-cache
+WORKDIR /ui
+# Dependencies first: this layer only changes when package.json / yarn.lock change.
+COPY --from=ui package.json yarn.lock .yarnrc.yml /ui/
+RUN --mount=type=cache,target=/yarn-cache \
+    yarn install --frozen-lockfile --network-timeout 600000
+COPY --from=ui . /ui
+RUN --mount=type=cache,target=/ui/node_modules/.cache \
+    yarn build
+
+FROM $FFMPEG_IMAGE
+
+COPY --from=core-build /dist/core/core /core/bin/core
+COPY --from=core-build /dist/core/import /core/bin/import
+COPY --from=core-build /dist/core/ffmigrate /core/bin/ffmigrate
+COPY --from=core-build /dist/core/mime.types /core/mime.types
+COPY --from=ui-build /ui/build /core/ui
+
+COPY ./CHANGELOG.md /core/ui/CHANGELOG.md
+COPY ./run.sh /core/bin/run.sh
+COPY ./ui-root /core/ui-root
+
+# The GPU canvas/scale filters need scale_cuda + overlay_cuda, which exist only when FFmpeg is
+# built with --enable-cuda-nvcc. The stock datarhei/base CUDA images are not: fail loudly here
+# instead of silently hiding the filters in the UI. (build.sh builds a suitable FFmpeg image.)
+RUN mkdir -p /core/config /core/data && ffmpeg -buildconf && \
+    for f in scale_cuda overlay_cuda; do \
+      ffmpeg -hide_banner -filters | grep -q " $f " || { echo "ERROR: FFmpeg image has no $f (built without --enable-cuda-nvcc)"; exit 1; }; \
+    done
+
+ENV CORE_CONFIGFILE=/core/config/config.json
+ENV CORE_DB_DIR=/core/config
+ENV CORE_ROUTER_UI_PATH=/core/ui
+ENV CORE_STORAGE_DISK_DIR=/core/data
+# NVENC/NVDEC user-space libraries are only mounted with the "video" capability,
+# nvidia-smi (GPU monitor + balancer) with "utility".
+ENV NVIDIA_VISIBLE_DEVICES=all
+ENV NVIDIA_DRIVER_CAPABILITIES=compute,video,utility
+
+EXPOSE 8080/tcp
+EXPOSE 1935/tcp
+EXPOSE 6000/udp
+
+VOLUME ["/core/data", "/core/config"]
+ENTRYPOINT ["/core/bin/run.sh"]
+WORKDIR /core
diff --git a/docker-compose.corvid.yml b/docker-compose.corvid.yml
new file mode 100644
index 0000000..dd47daa
--- /dev/null
+++ b/docker-compose.corvid.yml
@@ -0,0 +1,34 @@
+# Corvid (built on datarhei Restreamer) with NVIDIA:
+#   panel http://<host>:4501  ->  container 8080 (UI + API)
+#   RTMP 1935/tcp, SRT 6000/udp. Nothing else is published (no HTTPS/RTMPS ports).
+# Its own compose project and folders (/opt/corvid), next to an older "restreamer" installation.
+name: corvid
+services:
+  corvid:
+    image: corvid:v1
+    container_name: corvid
+    restart: unless-stopped
+    ports:
+      - "4501:8080"
+      - "1935:1935"
+      - "6000:6000/udp"
+    volumes:
+      - /opt/corvid/config:/core/config
+      - /opt/corvid/data:/core/data
+    environment:
+      NVIDIA_DRIVER_CAPABILITIES: compute,video,utility
+      # GeForce cards: the driver caps NVENC sessions (check `nvidia-smi` / your driver).
+      # 0 = unlimited (Quadro/RTX A/L4/L40/T4 ...).
+      CORE_GPU_MAX_ENCODER_SESSIONS: "0"
+      # Keep RTMP players connected this long while an ingest restarts (no fallback configured).
+      CORE_RTMP_FAILOVER_GRACE_SECONDS: "10"
+      # A publisher that stays connected but sends nothing for this long counts as lost and the
+      # fallback takes over (typical when an ingest's source disappears). 0 = only disconnects.
+      CORE_RTMP_FAILOVER_STALL_SECONDS: "3"
+    deploy:
+      resources:
+        reservations:
+          devices:
+            - driver: nvidia
+              count: all
+              capabilities: [gpu, video, compute, utility]
diff --git a/docker-compose.nvidia.yml b/docker-compose.nvidia.yml
