diff --git a/linehealth/linehealth.go b/linehealth/linehealth.go
new file mode 100644
index 0000000..34e8959
--- /dev/null
+++ b/linehealth/linehealth.go
@@ -0,0 +1,240 @@
+// Package linehealth keeps a short history of how evenly the streams that are sent to this
+// server (RTMP, SRT publishers) arrive: gaps without data and dropped connections that came
+// back. The panel shows it as "line quality" of a channel's source and backup (fork).
+package linehealth
+
+import (
+	"sort"
+	"sync"
+	"time"
+)
+
+const (
+	// Window is how far back the history goes.
+	Window = 10 * time.Minute
+	// MinGap is the shortest pause without data that counts as a gap.
+	MinGap = time.Second
+	// ReconnectWithin: a publisher that comes back within this time after a disconnect
+	// counts as a dropped connection. One that stays away was stopped on purpose.
+	ReconnectWithin = time.Minute
+)
+
+// Levels of a report.
+const (
+	LevelGood     = "good"
+	LevelUnstable = "unstable"
+	LevelBad      = "bad"
+)
+
+type event struct {
+	at  time.Time
+	gap time.Duration // 0 for a dropped connection
+}
+
+type stream struct {
+	mu           sync.Mutex
+	connected    int // publishers (normally 0 or 1)
+	since        time.Time
+	last         time.Time
+	disconnected time.Time
+	gapBefore    time.Duration // silence before the last disconnect
+	events       []event
+}
+
+// Monitor keeps the history of all streams. The zero value is not usable, see New.
+type Monitor struct {
+	mu      sync.Mutex
+	streams map[string]*stream
+	now     func() time.Time
+}
+
+func New() *Monitor {
+	return &Monitor{streams: map[string]*stream{}, now: time.Now}
+}
+
+// Handle belongs to one publisher connection. A nil *Handle does nothing.
+type Handle struct {
+	m *Monitor
+	s *stream
+}
+
+// Connect registers a publisher of the stream key (e.g. "srt:channel.stream").
+func (m *Monitor) Connect(key string) *Handle {
+	if m == nil {
+		return nil
+	}
+
+	m.mu.Lock()
+	s := m.streams[key]
+	if s == nil {
+		s = &stream{}
+		m.streams[key] = s
+	}
+	m.mu.Unlock()
+
+	now := m.now()
+
+	s.mu.Lock()
+	if !s.disconnected.IsZero() && s.connected == 0 && now.Sub(s.disconnected) <= ReconnectWithin {
+		// It came back: the last disconnect was a drop, and the silence before it a gap.
+		if s.gapBefore >= MinGap {
+			s.events = append(s.events, event{at: s.disconnected, gap: s.gapBefore})
+		}
+		s.events = append(s.events, event{at: s.disconnected})
+	}
+	s.disconnected = time.Time{}
+	s.connected++
+	s.since = now
+	s.last = now
+	s.prune(now)
+	s.mu.Unlock()
+
+	return &Handle{m: m, s: s}
+}
+
+// Data notes that data arrived.
+func (h *Handle) Data() {
+	if h == nil {
+		return
+	}
+
+	now := h.m.now()
+	s := h.s
+
+	s.mu.Lock()
+	if d := now.Sub(s.last); d >= MinGap {
+		s.events = append(s.events, event{at: now, gap: d})
+		s.prune(now)
+	}
+	s.last = now
+	s.mu.Unlock()
+}
+
+// Close notes that the publisher disconnected.
+func (h *Handle) Close() {
+	if h == nil {
+		return
+	}
+
+	now := h.m.now()
+	s := h.s
+
+	s.mu.Lock()
+	if s.connected > 0 {
+		s.connected--
+	}
+	if s.connected == 0 {
+		s.disconnected = now
+		s.gapBefore = now.Sub(s.last)
+	}
+	s.mu.Unlock()
+}
+
+func (s *stream) prune(now time.Time) {
+	i := 0
+	for i < len(s.events) && now.Sub(s.events[i].at) > Window {
+		i++
+	}
+	if i > 0 {
+		s.events = append(s.events[:0], s.events[i:]...)
+	}
+}
+
+// Report is the line quality of one stream over the last Window.
+type Report struct {
+	Connected        bool    `json:"connected"`
+	ConnectedSeconds float64 `json:"connected_seconds"`
+	// StalledSeconds: how long it has been sending nothing right now (connected, >= MinGap).
+	StalledSeconds float64 `json:"stalled_seconds"`
+	Drops          int     `json:"drops"`
+	Gaps           int     `json:"gaps"`
+	LongestGapMs   int64   `json:"longest_gap_ms"`
+	TotalGapMs     int64   `json:"total_gap_ms"`
+	// LastEventAgoSeconds: how long ago the last gap or drop was, -1 if none.
+	LastEventAgoSeconds float64 `json:"last_event_ago_seconds"`
+	Level               string  `json:"level"`
+}
+
+// Level: bad from 2 drops, 10 s without data in total, a 5 s gap or a stall of 5 s;
+// unstable with any gap, drop or a current stall; good otherwise.
+func level(r Report) string {
+	if r.Drops >= 2 || r.TotalGapMs >= 10000 || r.LongestGapMs >= 5000 || r.StalledSeconds >= 5 {
+		return LevelBad
+	}
+	if r.Drops > 0 || r.Gaps > 0 || r.StalledSeconds >= MinGap.Seconds() {
+		return LevelUnstable
+	}
+	return LevelGood
+}
+
+func (s *stream) report(now time.Time) Report {
+	s.prune(now)
+
+	r := Report{Connected: s.connected > 0, LastEventAgoSeconds: -1}
+	if r.Connected {
+		r.ConnectedSeconds = now.Sub(s.since).Seconds()
+		if d := now.Sub(s.last); d >= MinGap {
+			r.StalledSeconds = d.Seconds()
+		}
+	}
+
+	for _, e := range s.events {
+		if e.gap == 0 {
+			r.Drops++
+		} else {
+			r.Gaps++
+			ms := e.gap.Milliseconds()
+			r.TotalGapMs += ms
+			if ms > r.LongestGapMs {
+				r.LongestGapMs = ms
+			}
+		}
+	}
+	if n := len(s.events); n > 0 {
+		r.LastEventAgoSeconds = now.Sub(s.events[n-1].at).Seconds()
+	}
+
+	r.Level = level(r)
+	return r
+}
+
+// Reports returns the streams that are connected or had something happen in the window.
+func (m *Monitor) Reports() map[string]Report {
+	reports := map[string]Report{}
+	if m == nil {
+		return reports
+	}
+
+	now := m.now()
+
+	m.mu.Lock()
+	keys := make([]string, 0, len(m.streams))
+	for k := range m.streams {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	streams := make([]*stream, len(keys))
+	for i, k := range keys {
+		streams[i] = m.streams[k]
+	}
+	m.mu.Unlock()
+
+	for i, s := range streams {
+		s.mu.Lock()
+		r := s.report(now)
+		gone := s.connected == 0 && len(s.events) == 0 && (s.disconnected.IsZero() || now.Sub(s.disconnected) > ReconnectWithin)
+		s.mu.Unlock()
+
+		if gone {
+			m.mu.Lock()
+			if m.streams[keys[i]] == s {
+				delete(m.streams, keys[i])
+			}
+			m.mu.Unlock()
+			continue
+		}
+		reports[keys[i]] = r
+	}
+
+	return reports
+}
diff --git a/linehealth/linehealth_test.go b/linehealth/linehealth_test.go
new file mode 100644
index 0000000..6609284
--- /dev/null
+++ b/linehealth/linehealth_test.go
@@ -0,0 +1,116 @@
+package linehealth
+
+import (
+	"testing"
+	"time"
+)
+
+type clock struct{ t time.Time }
+
+func (c *clock) now() time.Time      { return c.t }
+func (c *clock) add(d time.Duration) { c.t = c.t.Add(d) }
+func newTest() (*Monitor, *clock) {
+	c := &clock{t: time.Unix(1000000, 0)}
+	m := New()
+	m.now = c.now
+	return m, c
+}
+func send(h *Handle, c *clock, d time.Duration) {
+	for end := c.t.Add(d); c.t.Before(end); c.add(40 * time.Millisecond) {
+		h.Data()
+	}
+}
+
+func TestSteadyStreamIsGood(t *testing.T) {
+	m, c := newTest()
+	h := m.Connect("srt:a.stream")
+	send(h, c, 2*time.Minute)
+
+	r := m.Reports()["srt:a.stream"]
+	if !r.Connected || r.Level != LevelGood || r.Gaps != 0 || r.Drops != 0 || r.LastEventAgoSeconds != -1 {
+		t.Fatalf("unexpected %+v", r)
+	}
+	if r.ConnectedSeconds < 119 {
+		t.Fatalf("connected %v", r.ConnectedSeconds)
+	}
+}
+
+func TestGapsAndStall(t *testing.T) {
+	m, c := newTest()
+	h := m.Connect("rtmp:b.stream")
+	send(h, c, 10*time.Second)
+	c.add(1500 * time.Millisecond) // a gap
+	send(h, c, 10*time.Second)
+	c.add(800 * time.Millisecond) // too short to count
+	send(h, c, time.Second)
+
+	r := m.Reports()["rtmp:b.stream"]
+	if r.Gaps != 1 || r.LongestGapMs < 1500 || r.Level != LevelUnstable {
+		t.Fatalf("unexpected %+v", r)
+	}
+
+	c.add(6 * time.Second) // silent right now
+	r = m.Reports()["rtmp:b.stream"]
+	if r.StalledSeconds < 6 || r.Level != LevelBad {
+		t.Fatalf("stall not reported: %+v", r)
+	}
+}
+
+// The pattern of a flaky mobile line: data stops, the server times out after 10 s, the
+// encoder comes back. That is a drop plus a 10 s gap. A stop for good is no drop.
+func TestDropsAndStops(t *testing.T) {
+	m, c := newTest()
+	h := m.Connect("rtmp:c-backup.stream")
+	send(h, c, 45*time.Second)
+	c.add(10 * time.Second) // nothing arrives, then the read timeout
+	h.Close()
+	c.add(10 * time.Second) // OBS reconnects after 10 s
+	h = m.Connect("rtmp:c-backup.stream")
+	send(h, c, 30*time.Second)
+
+	r := m.Reports()["rtmp:c-backup.stream"]
+	if r.Drops != 1 || r.Gaps != 1 || r.LongestGapMs < 10000 || r.LongestGapMs > 10100 || r.Level != LevelBad {
+		t.Fatalf("unexpected %+v", r)
+	}
+
+	// stopped on purpose and not back: not a drop, and the stream is reported as disconnected
+	h.Close()
+	c.add(2 * time.Minute)
+	r = m.Reports()["rtmp:c-backup.stream"]
+	if r.Connected || r.Drops != 1 {
+		t.Fatalf("unexpected after stop %+v", r)
+	}
+}
+
+func TestWindowForgets(t *testing.T) {
+	m, c := newTest()
+	h := m.Connect("srt:d.stream")
+	send(h, c, time.Second)
+	c.add(3 * time.Second)
+	send(h, c, time.Second)
+	if r := m.Reports()["srt:d.stream"]; r.Gaps != 1 {
+		t.Fatalf("gap missing %+v", r)
+	}
+
+	send(h, c, Window+time.Second)
+	if r := m.Reports()["srt:d.stream"]; r.Gaps != 0 || r.Level != LevelGood {
+		t.Fatalf("old gap still reported %+v", r)
+	}
+
+	// a stream that is gone and has nothing in the window is dropped from the reports
+	h.Close()
+	c.add(ReconnectWithin + time.Second)
+	if _, ok := m.Reports()["srt:d.stream"]; ok {
+		t.Fatal("gone stream still reported")
+	}
+}
+
+func TestNilIsSafe(t *testing.T) {
+	var m *Monitor
+	h := m.Connect("x")
+	h.Data()
+	h.Close()
+	if len(m.Reports()) != 0 {
+		t.Fatal("nil monitor reported something")
+	}
+}
