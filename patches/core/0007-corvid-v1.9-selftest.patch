+func TestScheduleFiresOncePerMinute(t *testing.T) {
+	tt := New(Config{})
+	now := time.Now()
+	tt.data.Schedule = Schedule{Enabled: true, Times: []string{now.Format("15:04")}}
+	tt.tick()
+	tt.tick()
+	require.Eventually(t, func() bool { return len(tt.Status().History) == 1 && !tt.Status().Running }, 5*time.Second, 50*time.Millisecond)
+	time.Sleep(100 * time.Millisecond)
+	require.Len(t, tt.Status().History, 1)
+
+	// saving the schedule in the minute it names does not run it
+	tt2 := New(Config{})
+	_, err := tt2.SetSchedule(Schedule{Enabled: true, Times: []string{time.Now().Format("15:04")}})
+	require.NoError(t, err)
+	tt2.tick()
+	time.Sleep(100 * time.Millisecond)
+	require.Len(t, tt2.Status().History, 0)
+}
