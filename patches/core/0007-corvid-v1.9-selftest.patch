+package selftest
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/datarhei/core/v16/gpu"
+	"github.com/stretchr/testify/require"
+)
+
+func TestCleanSchedule(t *testing.T) {
+	s, err := cleanSchedule(Schedule{Enabled: true, Times: []string{"9:05", "08:30", "08:30"}, Days: []int{5, 1, 1}, Timezone: "Europe/Istanbul"})
+	require.NoError(t, err)
+	require.Equal(t, []string{"08:30", "09:05"}, s.Times)
+	require.Equal(t, []int{1, 5}, s.Days)
+
+	s, err = cleanSchedule(Schedule{Times: []string{"10:00"}, Days: []int{1, 2, 3, 4, 5, 6, 7}})
+	require.NoError(t, err)
+	require.Equal(t, []int{}, s.Days, "all days is the same as none")
+
+	for _, bad := range []Schedule{
+		{Times: []string{"24:00"}},
+		{Times: []string{"8.30"}},
+		{Days: []int{0}},
+		{Timezone: "Mars/Olympus"},
+		{Enabled: true},
+		{Times: []string{"01:00", "02:00", "03:00", "04:00", "05:00", "06:00", "07:00"}},
+	} {
+		_, err := cleanSchedule(bad)
+		require.Error(t, err, "%+v", bad)
+	}
+}
+
+func TestNextAndMatches(t *testing.T) {
+	loc, _ := time.LoadLocation("Europe/Istanbul")
+	// Tuesday, 24 Nov 2026, 08:00
+	now := time.Date(2026, 11, 24, 8, 0, 0, 0, loc)
+	s := Schedule{Enabled: true, Times: []string{"08:30", "18:00"}, Days: []int{1, 3}}
+
+	n := next(s, now)
+	require.NotNil(t, n)
+	require.Equal(t, time.Date(2026, 11, 25, 8, 30, 0, 0, loc), *n, "Tuesday is not chosen: Wednesday")
+
+	s.Days = nil
+	n = next(s, now)
+	require.Equal(t, time.Date(2026, 11, 24, 8, 30, 0, 0, loc), *n)
+	require.True(t, matches(s, *n))
+	require.False(t, matches(s, n.Add(time.Minute)))
+
+	n = next(s, time.Date(2026, 11, 24, 8, 30, 20, 0, loc))
+	require.Equal(t, time.Date(2026, 11, 24, 18, 0, 0, 0, loc), *n, "not the minute that is going on")
+
+	s.Enabled = false
+	require.Nil(t, next(s, now))
+}
