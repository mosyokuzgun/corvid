+func TestRunAndHistory(t *testing.T) {
+	dir := t.TempDir()
+	file := filepath.Join(dir, "selftest.json")
+	disk := filepath.Join(dir, "disk")
+	require.NoError(t, os.MkdirAll(disk, 0o755))
+
+	tt := New(Config{File: file, DiskDir: disk, Keys: func() Keys { return Keys{RTMP: true, SRT: true, SRTToken: true} }})
+	run := tt.Run("manual")
+	require.Equal(t, int64(1), run.ID)
+
+	byID := map[string]Check{}
+	for _, c := range run.Checks {
+		byID[c.ID] = c
+	}
+	require.Equal(t, "skip", byID["gpu"].State)
+	require.NotEqual(t, "", byID["disk"].State)
+	require.Equal(t, "warn", byID["keys"].State)
+	require.Equal(t, []string{"rtmp"}, byID["keys"].Detail["servers"])
+	require.Equal(t, "nochannel", byID["source"].Reason)
+	require.Equal(t, "warn", run.State)
+
+	for i := 0; i < HistoryLength+3; i++ {
+		tt.Run("manual")
+	}
+	st := tt.Status()
+	require.Len(t, st.History, HistoryLength)
+	require.Equal(t, int64(HistoryLength+4), st.Last.ID)
+	require.Nil(t, st.History[0].Checks, "the history is short")
+	require.NotEmpty(t, st.Last.Checks)
+
+	_, err := tt.SetSchedule(Schedule{Enabled: true, Times: []string{"07:15"}, Timezone: "Europe/Istanbul"})
+	require.NoError(t, err)
+
+	// kept across restarts
+	again := New(Config{File: file})
+	st = again.Status()
+	require.Equal(t, []string{"07:15"}, st.Schedule.Times)
+	require.Len(t, st.History, HistoryLength)
+	require.NotNil(t, st.Next)
+}
