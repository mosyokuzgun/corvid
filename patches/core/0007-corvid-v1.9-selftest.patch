+func TestGPU(t *testing.T) {
+	dir := t.TempDir()
+	good := filepath.Join(dir, "good")
+	bad := filepath.Join(dir, "bad")
+	require.NoError(t, os.WriteFile(good, []byte("#!/bin/sh\nexit 0\n"), 0o755))
+	require.NoError(t, os.WriteFile(bad, []byte("#!/bin/sh\necho 'OpenEncodeSessionEx failed: out of memory' >&2\nexit 1\n"), 0o755))
+
+	dev := gpu.Device{Name: "GTX 1050", TemperatureC: 40}
+	c := (&Tester{cfg: Config{FFmpeg: good, GPU: fakeGPU{[]gpu.Device{dev}}}}).checkGPU()
+	require.Equal(t, "ok", c.State)
+	require.Equal(t, "encoded", c.Reason)
+
+	c = (&Tester{cfg: Config{FFmpeg: bad, GPU: fakeGPU{[]gpu.Device{dev}}}}).checkGPU()
+	require.Equal(t, "fail", c.State)
+	require.Contains(t, c.Detail["error"], "OpenEncodeSessionEx")
+
+	dev.EncoderSession = 2
+	c = (&Tester{cfg: Config{FFmpeg: bad, GPU: fakeGPU{[]gpu.Device{dev}}}}).checkGPU()
+	require.Equal(t, "ok", c.State, "busy encoding: no extra session")
+	require.Equal(t, "busy", c.Reason)
+}
