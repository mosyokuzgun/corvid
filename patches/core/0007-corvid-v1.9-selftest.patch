diff --git a/reach/reach.go b/reach/reach.go
new file mode 100644
index 0000000..f8115d7
--- /dev/null
+++ b/reach/reach.go
@@ -0,0 +1,113 @@
+// Package reach (fork) checks whether this server can reach the places a process sends to:
+// the name is resolved and, for TCP protocols, a connection is opened and closed again.
+package reach
+
+import (
+	"context"
+	"net"
+	"regexp"
+	"strings"
+	"time"
+)
+
+// Result is the outcome for one destination.
+type Result struct {
+	Target   string `json:"target"`   // host:port, never the path (which holds the stream key)
+	Protocol string `json:"protocol"` // rtmp, rtmps, srt, http, https, rtsp
+	Resolved bool   `json:"resolved"` // the name has an address
+	Reached  bool   `json:"reached"`  // a connection was accepted (always false for SRT, which is UDP)
+	Checked  string `json:"checked"`  // "connect" or "name" (UDP: only the name can be checked)
+	Millis   int64  `json:"ms"`
+	Error    string `json:"error,omitempty"`
+}
+
+type Target struct {
+	Protocol string
+	Host     string
+	Port     string
+}
+
+var addressRE = regexp.MustCompile(`(?i)\b(rtmps?|srt|https?|rtsp)://([^\s/|'"\]?#]+)`)
+
+var defaultPorts = map[string]string{"rtmp": "1935", "rtmps": "443", "srt": "", "http": "80", "https": "443", "rtsp": "554"}
+
+// Targets finds the remote destinations in output addresses (plain or tee muxer form).
+func Targets(addresses []string) []Target {
+	seen := map[string]bool{}
+	targets := []Target{}
+
+	for _, address := range addresses {
+		for _, m := range addressRE.FindAllStringSubmatch(address, -1) {
+			protocol := strings.ToLower(m[1])
+			hostport := m[2]
+
+			// user:password@host
+			if i := strings.LastIndex(hostport, "@"); i != -1 {
+				hostport = hostport[i+1:]
+			}
+
+			host, port, err := net.SplitHostPort(hostport)
+			if err != nil {
+				host, port = strings.Trim(hostport, "[]"), defaultPorts[protocol]
+			}
+
+			if host == "" || strings.ContainsAny(host, "{}") {
+				continue // a placeholder of the core, i.e. this server itself
+			}
+
+			if host == "localhost" {
+				continue
+			}
+			if ip := net.ParseIP(host); ip != nil && ip.IsLoopback() {
+				continue
+			}
+
+			key := protocol + "|" + host + "|" + port
+			if seen[key] {
+				continue
+			}
+			seen[key] = true
+
+			targets = append(targets, Target{Protocol: protocol, Host: host, Port: port})
+		}
+	}
+
+	return targets
+}
+
+func Check(ctx context.Context, t Target) Result {
+	r := Result{Protocol: t.Protocol, Target: t.Host, Checked: "connect"}
+	if t.Port != "" {
+		r.Target = net.JoinHostPort(t.Host, t.Port)
+	}
+
+	start := time.Now()
+	defer func() { r.Millis = time.Since(start).Milliseconds() }()
+
+	addrs, err := net.DefaultResolver.LookupHost(ctx, t.Host)
+	if err != nil || len(addrs) == 0 {
+		r.Error = "name not found"
+		return r
+	}
+	r.Resolved = true
+
+	if t.Protocol == "srt" || t.Port == "" {
+		// UDP has no connection to try without speaking the protocol.
+		r.Checked = "name"
+		return r
+	}
+
+	d := net.Dialer{}
+	conn, err := d.DialContext(ctx, "tcp", net.JoinHostPort(t.Host, t.Port))
+	if err != nil {
+		r.Error = "no connection"
+		if ctx.Err() != nil {
+			r.Error = "timeout"
+		}
+		return r
+	}
+	conn.Close()
+	r.Reached = true
+
+	return r
+}
