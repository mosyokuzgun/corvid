@@ -0,0 +1,711 @@
+// Package selftest (fork) checks, at times chosen in the panel or on request, whether the
+// server is ready for a broadcast: graphics card encoder, free space, stream keys, the
+// channels' backup and standby image, the publication targets and whether the senders are
+// connected. Nothing is started for viewers, nothing is changed: the encoder gets a short
+// test encode into nothing, publication targets a connection that is closed right away.
+package selftest
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"regexp"
+	"sort"
+	"strings"
+	"sync"
+	"time"
+	_ "time/tzdata" // the panel sends the user's time zone; the container may not have the zone files
+
+	"github.com/datarhei/core/v16/gpu"
+	"github.com/datarhei/core/v16/linehealth"
+	"github.com/datarhei/core/v16/reach"
+	"github.com/datarhei/core/v16/restream"
+)
+
+// HistoryLength is how many runs are kept.
+const HistoryLength = 30
+
+// Schedule says when the test runs by itself.
+type Schedule struct {
+	Enabled  bool     `json:"enabled"`
+	Times    []string `json:"times"`    // "HH:MM", at most 6
+	Days     []int    `json:"days"`     // 1 = Monday .. 7 = Sunday; empty: every day
+	Timezone string   `json:"timezone"` // IANA name, e.g. Europe/Istanbul; empty: the server's
+}
+
+// Check is the outcome of one point of a run.
+type Check struct {
+	ID        string                 `json:"id"` // gpu, disk, keys, source, backup, slate, targets
+	ChannelID string                 `json:"channel_id,omitempty"`
+	Channel   string                 `json:"channel,omitempty"`
+	State     string                 `json:"state"` // ok, warn, fail, skip
+	Reason    string                 `json:"reason,omitempty"`
+	Detail    map[string]interface{} `json:"detail,omitempty"`
+}
+
+// Run is one test.
+type Run struct {
+	ID       int64     `json:"id"`
+	Trigger  string    `json:"trigger"` // schedule, manual
+	Started  time.Time `json:"started_at"`
+	Finished time.Time `json:"finished_at"`
+	State    string    `json:"state"` // worst state of the checks: ok, warn, fail
+	Checks   []Check   `json:"checks"`
+}
+
+// Status is what the API returns.
+type Status struct {
+	Schedule Schedule   `json:"schedule"`
+	Running  bool       `json:"running"`
+	Next     *time.Time `json:"next,omitempty"`
+	Last     *Run       `json:"last"`
+	History  []Run      `json:"history"` // newest first, without the checks
+}
+
+// Keys reports the stream key settings of the RTMP and the SRT server.
+type Keys struct {
+	RTMP      bool
+	RTMPToken bool
+	SRT       bool
+	SRTToken  bool
+}
+
+// Config holds what the test looks at.
+type Config struct {
+	File       string // where schedule and history are kept
+	Restream   restream.Restreamer
+	FFmpeg     string // the ffmpeg binary
+	DiskDir    string // root of the disk filesystem (recordings, standby images)
+	GPU        gpu.Monitor
+	LineHealth *linehealth.Monitor
+	Keys       func() Keys
+}
+
+type stored struct {
+	Schedule Schedule `json:"schedule"`
+	History  []Run    `json:"history"`
+}
+
+// Tester runs the checks and keeps the schedule and the history.
+type Tester struct {
+	cfg Config
+
+	lock     sync.Mutex
+	data     stored
+	running  chan struct{} // closed when the current run is done; nil if none runs
+	lastFire string
+
+	stop chan struct{}
+	done chan struct{}
+}
+
+// New loads the stored schedule and history. A missing or broken file starts empty.
+func New(cfg Config) *Tester {
+	t := &Tester{cfg: cfg, data: stored{Schedule: Schedule{Times: []string{}, Days: []int{}}, History: []Run{}}}
+	if b, err := os.ReadFile(cfg.File); err == nil {
+		var d stored
+		if json.Unmarshal(b, &d) == nil {
+			if s, err := cleanSchedule(d.Schedule); err == nil {
+				d.Schedule = s
+			} else {
+				d.Schedule = Schedule{}
+			}
+			t.data = d
+		}
+	}
+	return t
+}
+
+// Start the scheduler.
+func (t *Tester) Start() {
+	t.lock.Lock()
+	defer t.lock.Unlock()
+	if t.stop != nil {
+		return
+	}
+	t.stop = make(chan struct{})
+	t.done = make(chan struct{})
+	// a restart within the same minute must not run the test a second time
+	t.lastFire = fireKey(t.now())
+	go t.loop(t.stop, t.done)
+}
+
+// Stop the scheduler. A run that is going on finishes by itself.
+func (t *Tester) Stop() {
+	t.lock.Lock()
+	stop, done := t.stop, t.done
+	t.stop, t.done = nil, nil
+	t.lock.Unlock()
+	if stop != nil {
+		close(stop)
+		<-done
+	}
+}
+
+func (t *Tester) loop(stop, done chan struct{}) {
+	defer close(done)
+	ticker := time.NewTicker(10 * time.Second)
+	defer ticker.Stop()
+	for {
+		select {
+		case <-stop:
+			return
+		case <-ticker.C:
+			t.tick()
+		}
+	}
+}
+
+func (t *Tester) now() time.Time {
+	return time.Now().In(location(t.data.Schedule.Timezone))
+}
+
+func fireKey(now time.Time) string {
+	return now.Format("2006-01-02 15:04")
+}
+
+func (t *Tester) tick() {
+	t.lock.Lock()
+	s := t.data.Schedule
+	now := t.now()
+	key := fireKey(now)
+	due := s.Enabled && key != t.lastFire && matches(s, now)
+	if due {
+		t.lastFire = key
+	}
+	t.lock.Unlock()
+	if due {
+		go t.Run("schedule")
+	}
+}
+
+func location(name string) *time.Location {
+	if name == "" {
+		return time.Local
+	}
+	if loc, err := time.LoadLocation(name); err == nil {
+		return loc
+	}
+	return time.Local
+}
+
+func weekday(now time.Time) int {
+	d := int(now.Weekday())
+	if d == 0 {
+		return 7
+	}
+	return d
+}
+
+func matches(s Schedule, now time.Time) bool {
+	if len(s.Days) != 0 {
+		found := false
+		for _, d := range s.Days {
+			if d == weekday(now) {
+				found = true
+			}
+		}
+		if !found {
+			return false
+		}
+	}
+	hm := now.Format("15:04")
+	for _, x := range s.Times {
+		if x == hm {
+			return true
+		}
+	}
+	return false
+}
+
+// next is the next time the schedule fires after now, nil if never.
+func next(s Schedule, now time.Time) *time.Time {
+	if !s.Enabled || len(s.Times) == 0 {
+		return nil
+	}
+	start := now.Truncate(time.Minute)
+	for day := 0; day < 8; day++ {
+		base := time.Date(start.Year(), start.Month(), start.Day()+day, 0, 0, 0, 0, start.Location())
+		for _, x := range s.Times {
+			var h, m int
+			fmt.Sscanf(x, "%d:%d", &h, &m)
+			at := time.Date(base.Year(), base.Month(), base.Day(), h, m, 0, 0, base.Location())
+			if at.After(start) && matches(s, at) {
+				return &at
+			}
+		}
+	}
+	return nil
+}
+
+var timeRE = regexp.MustCompile(`^([01][0-9]|2[0-3]):[0-5][0-9]$`)
+
+func cleanSchedule(s Schedule) (Schedule, error) {
+	out := Schedule{Enabled: s.Enabled, Times: []string{}, Days: []int{}, Timezone: strings.TrimSpace(s.Timezone)}
+	seen := map[string]bool{}
+	for _, x := range s.Times {
+		x = strings.TrimSpace(x)
+		if len(x) == 4 && x[1] == ':' {
+			x = "0" + x
+		}
+		if !timeRE.MatchString(x) {
+			return out, fmt.Errorf("invalid time %q, expected HH:MM", x)
+		}
+		if !seen[x] {
+			seen[x] = true
+			out.Times = append(out.Times, x)
+		}
+	}
+	if len(out.Times) > 6 {
+		return out, fmt.Errorf("at most 6 times")
+	}
+	sort.Strings(out.Times)
+	days := map[int]bool{}
+	for _, d := range s.Days {
+		if d < 1 || d > 7 {
+			return out, fmt.Errorf("invalid day %d, expected 1 (Monday) to 7 (Sunday)", d)
+		}
+		days[d] = true
+	}
+	for d := 1; d <= 7; d++ {
+		if days[d] {
+			out.Days = append(out.Days, d)
+		}
+	}
+	if len(out.Days) == 7 {
+		out.Days = []int{}
+	}
+	if out.Timezone != "" {
+		if _, err := time.LoadLocation(out.Timezone); err != nil {
+			return out, fmt.Errorf("unknown time zone %q", out.Timezone)
+		}
+	}
+	if out.Enabled && len(out.Times) == 0 {
+		return out, fmt.Errorf("choose at least one time")
+	}
+	return out, nil
+}
+
+// SetSchedule stores a new schedule.
+func (t *Tester) SetSchedule(s Schedule) (Status, error) {
+	s, err := cleanSchedule(s)
+	if err != nil {
+		return t.Status(), err
+	}
+	t.lock.Lock()
+	old := t.data.Schedule
+	t.data.Schedule = s
+	err = t.save()
+	if err != nil {
+		t.data.Schedule = old
+	} else {
+		// saving a time that is the current minute must not run it right away
+		t.lastFire = fireKey(time.Now().In(location(s.Timezone)))
+	}
+	t.lock.Unlock()
+	return t.Status(), err
+}
+
+// must hold the lock
+func (t *Tester) save() error {
+	if t.cfg.File == "" {
+		return nil
+	}
+	b, err := json.MarshalIndent(t.data, "", "\t")
+	if err != nil {
+		return err
+	}
+	tmp := t.cfg.File + ".tmp"
+	if err := os.WriteFile(tmp, b, 0o600); err != nil {
+		return err
+	}
+	return os.Rename(tmp, t.cfg.File)
+}
+
+// Status returns schedule, last run and the short history.
+func (t *Tester) Status() Status {
+	t.lock.Lock()
+	defer t.lock.Unlock()
+	st := Status{Schedule: t.data.Schedule, Running: t.running != nil, History: []Run{}}
+	st.Next = next(t.data.Schedule, t.now())
+	for i, r := range t.data.History {
+		if i == 0 {
+			last := r
+			st.Last = &last
+		}
+		r.Checks = nil
+		st.History = append(st.History, r)
+	}
+	return st
+}
+
+// Run runs the test now and returns it. If a run is going on, it waits for that one and
+// returns it instead of starting a second one.
+func (t *Tester) Run(trigger string) Run {
+	t.lock.Lock()
+	if t.running != nil {
+		wait := t.running
+		t.lock.Unlock()
+		<-wait
+		t.lock.Lock()
+		defer t.lock.Unlock()
+		if len(t.data.History) != 0 {
+			return t.data.History[0]
+		}
+		return Run{}
+	}
+	t.running = make(chan struct{})
+	id := int64(1)
+	if len(t.data.History) != 0 {
+		id = t.data.History[0].ID + 1
+	}
+	t.lock.Unlock()
+
+	run := Run{ID: id, Trigger: trigger, Started: time.Now().UTC()}
+	run.Checks = t.checks()
+	run.Finished = time.Now().UTC()
+	run.State = "ok"
+	for _, c := range run.Checks {
+		if c.State == "fail" {
+			run.State = "fail"
+		} else if c.State == "warn" && run.State == "ok" {
+			run.State = "warn"
+		}
+	}
+
+	t.lock.Lock()
+	t.data.History = append([]Run{run}, t.data.History...)
+	if len(t.data.History) > HistoryLength {
+		t.data.History = t.data.History[:HistoryLength]
+	}
+	t.save()
+	close(t.running)
+	t.running = nil
+	t.lock.Unlock()
+
+	return run
+}
+
+// ---- the checks ----
+
+type channel struct {
+	id       string // process ID
+	ref      string
+	name     string
+	input    string
+	backup   string
+	slate    string
+	fallback bool
+}
+
+var ingestRE = regexp.MustCompile(`^restreamer-ui:ingest:[0-9a-fA-F-]{36}$`)
+
+type uiMeta struct {
+	Meta struct {
+		Name string `json:"name"`
+	} `json:"meta"`
+	Control struct {
+		Fallback struct {
+			Enable bool   `json:"enable"`
+			Type   string `json:"type"`
+			URL    string `json:"url"`
+			Image  string `json:"image"`
+		} `json:"fallback"`
+	} `json:"control"`
+	Name string `json:"name"` // publications
+}
+
+func readMeta(r restream.Restreamer, id string) uiMeta {
+	m := uiMeta{}
+	data, err := r.GetProcessMetadata(id, "restreamer-ui")
+	if err != nil || data == nil {
+		return m
+	}
+	b, err := json.Marshal(data)
+	if err == nil {
+		json.Unmarshal(b, &m)
+	}
+	return m
+}
+
+func (t *Tester) channels() []channel {
+	r := t.cfg.Restream
+	if r == nil {
+		return nil
+	}
+	list := []channel{}
+	for _, id := range r.GetProcessIDs("", "") {
+		if !ingestRE.MatchString(id) {
+			continue
+		}
+		p, err := r.GetProcess(id)
+		if err != nil {
+			continue
+		}
+		m := readMeta(r, id)
+		c := channel{id: id, ref: p.Reference, name: m.Meta.Name}
+		if p.Config != nil && len(p.Config.Input) != 0 {
+			c.input = p.Config.Input[0].Address
+		}
+		fb := m.Control.Fallback
+		c.fallback = fb.Enable
+		if fb.Enable && fb.Type == "stream" {
+			c.backup = strings.TrimSpace(fb.URL)
+		}
+		if fb.Enable {
+			c.slate = fb.Image
+		}
+		list = append(list, c)
+	}
+	sort.Slice(list, func(a, b int) bool { return list[a].name < list[b].name })
+	return list
+}
+
+func (t *Tester) checks() []Check {
+	out := []Check{}
+	out = append(out, t.checkGPU())
+	out = append(out, t.checkDisk())
+	out = append(out, t.checkKeys())
+
+	channels := t.channels()
+	var reports map[string]linehealth.Report
+	if t.cfg.LineHealth != nil {
+		reports = t.cfg.LineHealth.Reports()
+	}
+	for _, c := range channels {
+		out = append(out, t.checkFeed("source", c, c.input, reports))
+		if c.backup == "" {
+			out = append(out, Check{ID: "backup", ChannelID: c.ref, Channel: c.name, State: "warn", Reason: "none"})
+		} else {
+			out = append(out, t.checkFeed("backup", c, c.backup, reports))
+		}
+		out = append(out, t.checkSlate(c))
+		out = append(out, t.checkTargets(c))
+	}
+	if len(channels) == 0 {
+		out = append(out, Check{ID: "source", State: "warn", Reason: "nochannel"})
+	}
+	return out
+}
+
+func (t *Tester) checkGPU() Check {
+	c := Check{ID: "gpu", Detail: map[string]interface{}{}}
+	var devices []gpu.Device
+	if t.cfg.GPU != nil {
+		devices = t.cfg.GPU.Devices()
+	}
+	if len(devices) == 0 {
+		c.State, c.Reason = "skip", "none"
+		return c
+	}
+	d := devices[0]
+	c.Detail["name"] = d.Name
+	c.Detail["temperature"] = d.TemperatureC
+	sessions := 0
+	for _, x := range devices {
+		sessions += x.EncoderSession
+	}
+	if sessions > 0 {
+		// it is encoding right now, which is the best proof; no extra session on top
+		c.State, c.Reason = "ok", "busy"
+		c.Detail["sessions"] = sessions
+		c.Detail["load"] = d.UtilEncoder
+		if d.UtilEncoder >= 90 {
+			c.State = "warn"
+		}
+		return c
+	}
+	ms, err := encodeTest(t.cfg.FFmpeg)
+	c.Detail["ms"] = ms
+	if err != nil {
+		c.State, c.Reason = "fail", "encode"
+		c.Detail["error"] = err.Error()
+		return c
+	}
+	c.State, c.Reason = "ok", "encoded"
+	if d.TemperatureC >= 85 {
+		c.State, c.Reason = "warn", "hot"
+	}
+	return c
+}
+
+func (t *Tester) checkDisk() Check {
+	c := Check{ID: "disk", Detail: map[string]interface{}{}}
+	free, total, err := diskSpace(t.cfg.DiskDir)
+	if err != nil || total == 0 {
+		c.State, c.Reason = "skip", "unknown"
+		return c
+	}
+	c.Detail["free"] = free
+	c.Detail["total"] = total
+	const gb = 1024 * 1024 * 1024
+	switch {
+	case free < 1*gb:
+		c.State = "fail"
+	case free < 5*gb:
+		c.State = "warn"
+	default:
+		c.State = "ok"
+	}
+	return c
+}
+
+func (t *Tester) checkKeys() Check {
+	c := Check{ID: "keys", Detail: map[string]interface{}{}}
+	if t.cfg.Keys == nil {
+		c.State, c.Reason = "skip", "unknown"
+		return c
+	}
+	k := t.cfg.Keys()
+	missing := []string{}
+	if k.RTMP && !k.RTMPToken {
+		missing = append(missing, "rtmp")
+	}
+	if k.SRT && !k.SRTToken {
+		missing = append(missing, "srt")
+	}
+	if !k.RTMP && !k.SRT {
+		c.State, c.Reason = "skip", "noserver"
+		return c
+	}
+	if len(missing) != 0 {
+		c.State, c.Reason = "warn", "nokey"
+		c.Detail["servers"] = missing
+		return c
+	}
+	c.State = "ok"
+	return c
+}
+
+var placeholderRE = regexp.MustCompile(`^\{(rtmp|srt),name=([^,}]+)`)
+
+// healthKey is the line health key of an address of this server's RTMP or SRT server.
+func healthKey(address string) string {
+	m := placeholderRE.FindStringSubmatch(address)
+	if m == nil {
+		return ""
+	}
+	return m[1] + ":" + m[2]
+}
+
+func (t *Tester) checkFeed(id string, ch channel, address string, reports map[string]linehealth.Report) Check {
+	c := Check{ID: id, ChannelID: ch.ref, Channel: ch.name, Detail: map[string]interface{}{}}
+	if address == "" {
+		c.State, c.Reason = "fail", "nosource"
+		return c
+	}
+	key := healthKey(address)
+	if key == "" {
+		// pulled from elsewhere (e.g. a camera): its state is in the process
+		state, err := t.cfg.Restream.GetProcessState(ch.id)
+		if id == "source" && err == nil && state.State == "running" && state.Progress.Input != nil {
+			c.State, c.Reason = "ok", "pulled"
+			return c
+		}
+		c.State, c.Reason = "skip", "external"
+		return c
+	}
+	c.Detail["protocol"] = strings.SplitN(key, ":", 2)[0]
+	r, ok := reports[key]
+	if !ok || !r.Connected {
+		// before the broadcast nobody may be sending yet: that is not an error
+		c.State, c.Reason = "skip", "idle"
+		if ok {
+			c.Detail["drops"] = r.Drops
+		}
+		return c
+	}
+	c.Detail["level"] = r.Level
+	c.Detail["drops"] = r.Drops
+	c.Detail["gaps"] = r.Gaps
+	c.Detail["longest_gap_ms"] = r.LongestGapMs
+	switch r.Level {
+	case "bad":
+		c.State, c.Reason = "warn", "weak"
+	case "unstable":
+		c.State, c.Reason = "warn", "unstable"
+	default:
+		c.State, c.Reason = "ok", "sending"
+	}
+	return c
+}
+
+func (t *Tester) checkSlate(ch channel) Check {
+	c := Check{ID: "slate", ChannelID: ch.ref, Channel: ch.name}
+	if ch.slate == "" {
+		c.State, c.Reason = "warn", "none"
+		return c
+	}
+	if t.cfg.DiskDir == "" {
+		c.State, c.Reason = "skip", "unknown"
+		return c
+	}
+	p := filepath.Join(t.cfg.DiskDir, filepath.Clean("/"+ch.slate))
+	if st, err := os.Stat(p); err != nil || st.IsDir() || st.Size() == 0 {
+		c.State, c.Reason = "fail", "missing"
+		return c
+	}
+	c.State = "ok"
+	return c
+}
+
+func (t *Tester) checkTargets(ch channel) Check {
+	c := Check{ID: "targets", ChannelID: ch.ref, Channel: ch.name, Detail: map[string]interface{}{}}
+	r := t.cfg.Restream
+	type target struct {
+		Name  string         `json:"name"`
+		Hosts []reach.Result `json:"hosts"`
+	}
+	targets := []target{}
+	for _, id := range r.GetProcessIDs("", "") {
+		if !strings.HasPrefix(id, "restreamer-ui:egress:") {
+			continue
+		}
+		p, err := r.GetProcess(id)
+		if err != nil || p.Reference != ch.ref || p.Config == nil {
+			continue
+		}
+		addresses := []string{}
+		for _, o := range p.Config.Output {
+			addresses = append(addresses, o.Address)
+		}
+		list := reach.Targets(addresses)
+		if len(list) > 8 {
+			list = list[:8]
+		}
+		if len(list) == 0 {
+			continue // to this server only, e.g. the player
+		}
+		results := make([]reach.Result, len(list))
+		ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+		wg := sync.WaitGroup{}
+		for i, x := range list {
+			wg.Add(1)
+			go func(i int, x reach.Target) {
+				defer wg.Done()
+				results[i] = reach.Check(ctx, x)
+			}(i, x)
+		}
+		wg.Wait()
+		cancel()
+		name := readMeta(r, id).Name
+		targets = append(targets, target{Name: name, Hosts: results})
+	}
+	if len(targets) == 0 {
+		c.State, c.Reason = "skip", "none"
+		return c
+	}
+	c.Detail["targets"] = targets
+	c.State = "ok"
+	for _, x := range targets {
+		for _, h := range x.Hosts {
+			ok := h.Reached || (h.Checked == "name" && h.Resolved)
+			if !ok {
+				c.State, c.Reason = "fail", "unreachable"
+			}
+		}
+	}
+	return c
+}
