+package api
+
+import (
+	"net/http"
+
+	"github.com/datarhei/core/v16/http/api"
+	"github.com/datarhei/core/v16/http/handler/util"
+	"github.com/datarhei/core/v16/selftest"
+
+	"github.com/labstack/echo/v4"
+)
+
+// SelfTestHandler runs the check before broadcasts and sets its schedule (fork).
+type SelfTestHandler struct {
+	tester *selftest.Tester
+}
+
+func NewSelfTest(tester *selftest.Tester) *SelfTestHandler {
+	return &SelfTestHandler{tester: tester}
+}
+
+func (h *SelfTestHandler) Get(c echo.Context) error {
+	return c.JSON(http.StatusOK, h.tester.Status())
+}
+
+func (h *SelfTestHandler) Run(c echo.Context) error {
+	return c.JSON(http.StatusOK, h.tester.Run("manual"))
+}
+
+func (h *SelfTestHandler) SetSchedule(c echo.Context) error {
+	var req selftest.Schedule
+	if err := util.ShouldBindJSON(c, &req); err != nil {
+		return api.Err(http.StatusBadRequest, "", "Invalid JSON: %s", err.Error())
+	}
+	st, err := h.tester.SetSchedule(req)
+	if err != nil {
+		return api.Err(http.StatusBadRequest, "", "%s", err.Error())
+	}
+	return c.JSON(http.StatusOK, st)
+}
