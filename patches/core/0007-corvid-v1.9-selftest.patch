+package selftest
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"os/exec"
+	"strings"
+	"syscall"
+	"time"
+)
+
+// encodeTest makes the graphics card encode two seconds of a test picture into nothing.
+func encodeTest(binary string) (int64, error) {
+	if binary == "" {
+		binary = "ffmpeg"
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
+	defer cancel()
+
+	start := time.Now()
+	cmd := exec.CommandContext(ctx, binary, "-hide_banner", "-nostdin", "-nostats", "-loglevel", "error",
+		"-f", "lavfi", "-t", "2", "-i", "testsrc2=size=1280x720:rate=30",
+		"-c:v", "h264_nvenc", "-preset", "p4", "-b:v", "4M",
+		"-f", "null", "-")
+	var stderr bytes.Buffer
+	cmd.Stderr = &stderr
+	err := cmd.Run()
+	ms := time.Since(start).Milliseconds()
+	if err != nil {
+		if ctx.Err() != nil {
+			return ms, errors.New("timeout after 30 s")
+		}
+		return ms, errors.New(lastLine(stderr.String(), err.Error()))
+	}
+	return ms, nil
+}
+
+func lastLine(s, fallback string) string {
+	lines := strings.Split(strings.TrimSpace(s), "\n")
+	for i := len(lines) - 1; i >= 0; i-- {
+		if l := strings.TrimSpace(lines[i]); l != "" {
+			if len(l) > 200 {
+				l = l[:200]
+			}
+			return l
+		}
+	}
+	return fallback
+}
+
+func diskSpace(dir string) (free, total uint64, err error) {
+	if dir == "" {
+		return 0, 0, errors.New("no directory")
+	}
+	var st syscall.Statfs_t
+	if err := syscall.Statfs(dir, &st); err != nil {
+		return 0, 0, err
+	}
+	return st.Bavail * uint64(st.Bsize), st.Blocks * uint64(st.Bsize), nil
+}
