diff --git a/app/ffmigrate/migrate7.go b/app/ffmigrate/migrate7.go
new file mode 100644
index 0000000..fe93672
--- /dev/null
+++ b/app/ffmigrate/migrate7.go
@@ -0,0 +1,212 @@
+package main
+
+import (
+	"strings"
+
+	"github.com/datarhei/core/v16/restream/app"
+)
+
+// FFmpeg 7 rewrote the command line tool. Until FFmpeg 9 these options of
+// stored processes stopped working:
+//
+//   - "-vsync" is gone, "-fps_mode" (per output) replaces it.
+//   - The legacy NVENC presets (hp, hq, bd, ll, llhq, llhp, lossless, ...)
+//     and rate controls (cbr_ld_hq, cbr_hq, vbr_hq) are gone; p1..p7 plus
+//     a tuning info replace them.
+//
+// The new options exist in FFmpeg 6 as well, so a migrated process still
+// runs if the image is rolled back.
+
+var nvencLegacyPresets = map[string][2]string{
+	"default":    {"p4", ""},
+	"slow":       {"p7", "hq"},
+	"medium":     {"p4", "hq"},
+	"fast":       {"p2", "hq"},
+	"hp":         {"p1", "hq"},
+	"hq":         {"p6", "hq"},
+	"bd":         {"p7", "hq"},
+	"ll":         {"p4", "ll"},
+	"llhq":       {"p5", "ll"},
+	"llhp":       {"p2", "ll"},
+	"lossless":   {"p4", "lossless"},
+	"losslesshp": {"p1", "lossless"},
+	"losslesshq": {"p7", "lossless"},
+}
+
+var nvencLegacyRC = map[string][2]string{
+	"cbr_ld_hq": {"cbr", "ll"},
+	"cbr_hq":    {"cbr", ""},
+	"vbr_hq":    {"vbr", ""},
+}
+
+// vsyncToFPSMode maps a -vsync value to a -fps_mode value.
+func vsyncToFPSMode(v string) string {
+	switch v {
+	case "-1":
+		return "auto"
+	case "0":
+		return "passthrough"
+	case "1":
+		return "cfr"
+	case "2":
+		return "vfr"
+	}
+
+	return v
+}
+
+func optionName(o string) string {
+	if i := strings.IndexByte(o, ':'); i >= 0 {
+		return o[:i]
+	}
+
+	return o
+}
+
+// optionValue returns the value of the first option with one of the names
+// (stream specifiers are ignored) and whether it has been found.
+func optionValue(options []string, names ...string) (string, bool) {
+	for i := 0; i+1 < len(options); i++ {
+		name := optionName(options[i])
+		for _, n := range names {
+			if name == n {
+				return options[i+1], true
+			}
+		}
+	}
+
+	return "", false
+}
+
+func hasOption(options []string, names ...string) bool {
+	_, ok := optionValue(options, names...)
+	return ok
+}
+
+// removeOption removes all occurrences of an option with its value and
+// returns the new options and the last removed value.
+func removeOption(options []string, name string) ([]string, string, bool) {
+	result := make([]string, 0, len(options))
+	value := ""
+	found := false
+
+	for i := 0; i < len(options); i++ {
+		if optionName(options[i]) == name && i+1 < len(options) {
+			value = options[i+1]
+			found = true
+			i++
+			continue
+		}
+
+		result = append(result, options[i])
+	}
+
+	return result, value, found
+}
+
+// videoCodec returns the first video codec of the options (-codec:v, -c:v,
+// -codec:v:0, -vcodec, ...).
+func videoCodec(options []string) (string, bool) {
+	for i := 0; i+1 < len(options); i++ {
+		o := options[i]
+		if o == "-vcodec" {
+			return options[i+1], true
+		}
+
+		for _, prefix := range []string{"-codec:v", "-c:v"} {
+			if o == prefix || strings.HasPrefix(o, prefix+":") {
+				return options[i+1], true
+			}
+		}
+	}
+
+	return "", false
+}
+
+func usesNVENC(options []string) bool {
+	codec, _ := videoCodec(options)
+	return strings.HasSuffix(codec, "_nvenc")
+}
+
+// migrateOptions7 migrates the options of one output.
+func migrateOptions7(options []string) ([]string, bool) {
+	changed := false
+
+	// -vsync in the output options
+	for i := 0; i+1 < len(options); i++ {
+		if optionName(options[i]) != "-vsync" {
+			continue
+		}
+
+		options[i] = strings.Replace(options[i], "-vsync", "-fps_mode", 1)
+		options[i+1] = vsyncToFPSMode(options[i+1])
+		changed = true
+	}
+
+	if !usesNVENC(options) {
+		return options, changed
+	}
+
+	tune := ""
+
+	for i := 0; i+1 < len(options); i++ {
+		switch optionName(options[i]) {
+		case "-preset":
+			if m, ok := nvencLegacyPresets[options[i+1]]; ok {
+				options[i+1] = m[0]
+				if len(m[1]) != 0 {
+					tune = m[1]
+				}
+				changed = true
+			}
+		case "-rc":
+			if m, ok := nvencLegacyRC[options[i+1]]; ok {
+				options[i+1] = m[0]
+				if len(m[1]) != 0 {
+					tune = m[1]
+				}
+				changed = true
+			}
+		}
+	}
+
+	if len(tune) != 0 && !hasOption(options, "-tune") {
+		options = append(options, "-tune:v", tune)
+	}
+
+	return options, changed
+}
+
+// migrateConfig7 migrates a process config to FFmpeg 7 and later.
+func migrateConfig7(config *app.Config) bool {
+	changed := false
+
+	// The UI added a global "-vsync drop" for some audio encoders (mp3, opus,
+	// vorbis). It only ever affected encoded video and the UI doesn't add it
+	// for FFmpeg 7 and later, so it is dropped (fps_mode auto, the default).
+	options, _, found := removeOption(config.Options, "-vsync")
+	if found {
+		config.Options = options
+		changed = true
+	}
+
+	for i, output := range config.Output {
+		options, ok := migrateOptions7(output.Options)
+		if ok {
+			output.Options = options
+			config.Output[i] = output
+			changed = true
+		}
+	}
+
+	for i, input := range config.Input {
+		options, _, found := removeOption(input.Options, "-vsync")
+		if found {
+			input.Options = options
+			config.Input[i] = input
+			changed = true
+		}
+	}
+
+	return changed
+}
