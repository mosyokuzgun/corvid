+package main
+
+import (
+	"testing"
+
+	"github.com/datarhei/core/v16/log"
+	"github.com/datarhei/core/v16/restream/app"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestMigrate7GlobalVsync(t *testing.T) {
+	config := &app.Config{
+		FFVersion: "^6.1.0",
+		Options:   []string{"-loglevel", "level+info", "-vsync", "drop", "-err_detect", "ignore_err"},
+		Output: []app.ConfigIO{
+			{Options: []string{"-codec:v", "h264_nvenc", "-preset:v", "p4", "-codec:a", "libopus", "-f", "flv"}},
+			{Options: []string{"-codec:v", "copy", "-codec:a", "copy", "-f", "hls"}},
+		},
+	}
+
+	migrated, err := migrateProcessConfig(log.New(""), config, "9.0.2")
+	require.NoError(t, err)
+	require.True(t, migrated)
+
+	require.Equal(t, "^9.0.2", config.FFVersion)
+	require.Equal(t, []string{"-loglevel", "level+info", "-err_detect", "ignore_err"}, config.Options)
+	require.Equal(t, []string{"-codec:v", "h264_nvenc", "-preset:v", "p4", "-codec:a", "libopus", "-f", "flv"}, config.Output[0].Options)
+	require.Equal(t, []string{"-codec:v", "copy", "-codec:a", "copy", "-f", "hls"}, config.Output[1].Options)
+}
+
+func TestMigrate7OutputVsync(t *testing.T) {
+	config := &app.Config{
+		FFVersion: "^6.1.0",
+		Output: []app.ConfigIO{
+			{Options: []string{"-codec:v", "libx264", "-vsync", "1", "-f", "flv"}},
+			{Options: []string{"-codec:v", "libx264", "-vsync:v", "0", "-f", "flv"}},
+		},
+	}
+
+	_, err := migrateProcessConfig(log.New(""), config, "9.0.2")
+	require.NoError(t, err)
+
+	require.Equal(t, []string{"-codec:v", "libx264", "-fps_mode", "cfr", "-f", "flv"}, config.Output[0].Options)
+	require.Equal(t, []string{"-codec:v", "libx264", "-fps_mode:v", "passthrough", "-f", "flv"}, config.Output[1].Options)
+}
+
+func TestMigrate7NVENCLegacy(t *testing.T) {
+	config := &app.Config{
+		FFVersion: "^6.1.0",
+		Output: []app.ConfigIO{
+			{Options: []string{"-codec:v", "h264_nvenc", "-preset:v", "llhq", "-rc:v", "cbr_ld_hq", "-f", "flv"}},
+			{Options: []string{"-codec:v", "hevc_nvenc", "-preset", "hq", "-tune:v", "ull", "-rc", "vbr_hq"}},
+			{Options: []string{"-codec:v", "libx264", "-preset:v", "fast"}},
+		},
+	}
+
+	_, err := migrateProcessConfig(log.New(""), config, "9.0.2")
+	require.NoError(t, err)
+
+	require.Equal(t, []string{"-codec:v", "h264_nvenc", "-preset:v", "p5", "-rc:v", "cbr", "-f", "flv", "-tune:v", "ll"}, config.Output[0].Options)
+	// an explicit tuning is kept
+	require.Equal(t, []string{"-codec:v", "hevc_nvenc", "-preset", "p6", "-tune:v", "ull", "-rc", "vbr"}, config.Output[1].Options)
+	// not NVENC, untouched
+	require.Equal(t, []string{"-codec:v", "libx264", "-preset:v", "fast"}, config.Output[2].Options)
+}
+
+func TestMigrate7Unchanged(t *testing.T) {
+	options := []string{"-codec:v", "h264_nvenc", "-preset:v", "p4", "-tune:v", "ll", "-fps_mode", "cfr"}
+	config := &app.Config{
+		FFVersion: "^9.0.0",
+		Output:    []app.ConfigIO{{Options: append([]string{}, options...)}},
+	}
+
+	migrated, err := migrateProcessConfig(log.New(""), config, "9.0.2")
+	require.NoError(t, err)
+	require.False(t, migrated)
+	require.Equal(t, options, config.Output[0].Options)
+}
+
+func TestMigrateNewerMajorDoesNotFail(t *testing.T) {
+	config := &app.Config{FFVersion: "^6.1.0", Options: []string{"-vsync", "drop"}}
+
+	migrated, err := migrateProcessConfig(log.New(""), config, "12.0.0")
+	require.NoError(t, err)
+	require.False(t, migrated)
+	require.Equal(t, []string{"-vsync", "drop"}, config.Options)
+}
+
+func TestMigrateRollbackTo6(t *testing.T) {
+	config := &app.Config{FFVersion: "^9.0.2", Output: []app.ConfigIO{{Options: []string{"-fps_mode", "drop"}}}}
+
+	_, err := migrateProcessConfig(log.New(""), config, "6.1.1")
+	require.NoError(t, err)
+	require.Equal(t, "^6.1.1", config.FFVersion)
+	require.Equal(t, []string{"-fps_mode", "drop"}, config.Output[0].Options)
+}
