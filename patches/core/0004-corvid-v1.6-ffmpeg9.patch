+
+// FFmpeg 7 and later print two filter flags (no command flag) and a third
+// format flag ("d", is a device).
+func TestFilters7(t *testing.T) {
+	data := `Filters:
+  T.. = Timeline support
+  .S. = Slice threading
+  A = Audio input/output
+  V = Video input/output
+  N = Dynamic number and/or type of input/output
+  | = Source or sink filter
+  ------
+ .. aresample         A->A       Resample audio data.
+ TS overlay           VV->V      Overlay a video source on top of the input.
+ .S scale             V->V       Scale the input video size and/or convert the image format.
+ .. sine              |->A       Generate sine wave audio signal.`
+
+	f := parseFilters([]byte(data))
+
+	require.Equal(t, []Filter{
+		{Id: "aresample", Name: "Resample audio data."},
+		{Id: "overlay", Name: "Overlay a video source on top of the input."},
+		{Id: "scale", Name: "Scale the input video size and/or convert the image format."},
+		{Id: "sine", Name: "Generate sine wave audio signal."},
+	}, f)
+}
+
+func TestFormats7(t *testing.T) {
+	data := `Formats:
+ D.. = Demuxing supported
+ .E. = Muxing supported
+ ..d = Is a device
+ ---
+ DE  flv             FLV (Flash Video)
+  E  hls             Apple HTTP Live Streaming
+ D d lavfi           Libavfilter virtual input device
+ DE  mpegts          MPEG-TS (MPEG-2 Transport Stream)
+ DEd v4l2,video4linux2 Video4Linux2 output device`
+
+	f := parseFormats([]byte(data))
+
+	require.Equal(t, ffFormats{
+		Demuxers: []Format{
+			{Id: "flv", Name: "FLV (Flash Video)"},
+			{Id: "lavfi", Name: "Libavfilter virtual input device"},
+			{Id: "mpegts", Name: "MPEG-TS (MPEG-2 Transport Stream)"},
+			{Id: "v4l2", Name: "Video4Linux2 output device"},
+		},
+		Muxers: []Format{
+			{Id: "flv", Name: "FLV (Flash Video)"},
+			{Id: "hls", Name: "Apple HTTP Live Streaming"},
+			{Id: "mpegts", Name: "MPEG-TS (MPEG-2 Transport Stream)"},
+			{Id: "v4l2", Name: "Video4Linux2 output device"},
+		},
+	}, f)
+}
