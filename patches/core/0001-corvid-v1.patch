diff --git a/http/roles.go b/http/roles.go
new file mode 100644
index 0000000..479bc12
--- /dev/null
+++ b/http/roles.go
@@ -0,0 +1,215 @@
+package http
+
+// Roles (fork, see package users): which API requests each role may make, and the secrets
+// that are masked in the answers for everyone but the administrator.
+
+import (
+	"bytes"
+	"encoding/json"
+	"io"
+	"net/http"
+	"regexp"
+	"strings"
+
+	"github.com/datarhei/core/v16/http/api"
+	"github.com/datarhei/core/v16/users"
+
+	jwtgo "github.com/golang-jwt/jwt/v5"
+	"github.com/labstack/echo/v4"
+)
+
+// adminOnly are the routes (method + route pattern) only the administrator may use.
+var adminOnly = map[string]bool{
+	"PUT /api/v3/config":              true,
+	"GET /api/v3/config/reload":       true,
+	"GET /api/v3/fork/users":          true,
+	"PUT /api/v3/fork/users/:name":    true,
+	"DELETE /api/v3/fork/users/:name": true,
+	"POST /api/v3/fork/seal":          true,
+	"POST /api/v3/fork/unseal":        true,
+}
+
+// viewerDenied are reading routes that change something nevertheless.
+var viewerDenied = map[string]bool{
+	"GET /api/v3/config/reload":                           true,
+	"GET /api/v3/skills/reload":                           true,
+	"GET /api/v3/process/:id/playout/:inputid/reopen":     true,
+	"GET /api/v3/process/:id/playout/:inputid/keyframe/*": true,
+}
+
+// allowed decides by role, method and route pattern.
+func allowed(role, method, route string) bool {
+	key := method + " " + route
+	switch role {
+	case users.Admin:
+		return true
+	case users.Operator:
+		return !adminOnly[key]
+	case users.Viewer:
+		if adminOnly[key] || viewerDenied[key] {
+			return false
+		}
+		if method == http.MethodGet || method == http.MethodHead {
+			return true
+		}
+		return key == "POST /api/v3/metrics" // a query, not a change
+	}
+	return false
+}
+
+// RoleOf returns the role a request was made with ("admin" without accounts or for localhost
+// requests the JWT check let through).
+func RoleOf(c echo.Context) string {
+	if r, ok := c.Get("role").(string); ok && r != "" {
+		return r
+	}
+	return users.Admin
+}
+
+// masked reports which answers are masked for a role: the server settings and the UI's system
+// metadata (stream keys, guest keys, passwords) for operators and viewers, and for viewers
+// everything that holds addresses (process settings and states, logs, sessions).
+func masked(role, method, route string) (secrets, addresses bool) {
+	if role == users.Admin || (method != http.MethodGet && method != http.MethodHead) {
+		return false, false
+	}
+	switch {
+	case route == "/api/v3/config" || strings.HasPrefix(route, "/api/v3/metadata"):
+		return true, role == users.Viewer
+	case role == users.Viewer && (strings.HasPrefix(route, "/api/v3/process") || route == "/api/v3/log" ||
+		strings.HasPrefix(route, "/api/v3/session") || route == "/api/v3/rtmp" || route == "/api/v3/srt"):
+		return true, true
+	}
+	return false, false
+}
+
+var (
+	secretField = regexp.MustCompile(`("(?:password|secret|token|passphrase|watchKey|client_secret|jwt_secret)"\s*:\s*)"(?:[^"\\]|\\.)*"`)
+	userinfo    = regexp.MustCompile(`(://)[^/@"\s:]+:[^/@"\s]+@`)
+	queryKey    = regexp.MustCompile(`((?:[?&]|\\u0026)(?:token|passphrase|key|streamid|pass|password|auth)=)[^&"\s\\]+`)
+	rtmpPath    = regexp.MustCompile(`(rtmps?://)([^/"\s?]+)((?:/[^/"\s?]*)*/)([^/"\s?\\]+)`)
+)
+
+func isLocal(host string) bool {
+	h := host
+	if i := strings.LastIndex(h, ":"); i > 0 && !strings.HasSuffix(h, "]") {
+		h = h[:i]
+	}
+	h = strings.Trim(h, "[]")
+	return h == "localhost" || h == "127.0.0.1" || h == "::1" || strings.HasPrefix(h, "{")
+}
+
+// maskBody masks secrets in a JSON answer.
+func maskBody(body []byte, addresses bool) []byte {
+	body = secretField.ReplaceAll(body, []byte(`$1"***"`))
+	if !addresses {
+		return body
+	}
+	body = userinfo.ReplaceAll(body, []byte(`$1***:***@`))
+	body = queryKey.ReplaceAll(body, []byte(`$1***`))
+	return rtmpPath.ReplaceAllFunc(body, func(m []byte) []byte {
+		p := rtmpPath.FindSubmatch(m)
+		if isLocal(string(p[2])) {
+			return m
+		}
+		return []byte(string(p[1]) + string(p[2]) + string(p[3]) + "***")
+	})
+}
+
+// capture keeps the answer's body to mask it before it is sent.
+type capture struct {
+	http.ResponseWriter
+	buf bytes.Buffer
+}
+
+func (w *capture) WriteHeader(code int) {
+	w.ResponseWriter.Header().Del("Content-Length")
+	w.ResponseWriter.WriteHeader(code)
+}
+
+func (w *capture) Write(b []byte) (int, error) { return w.buf.Write(b) }
+
+// protectedMetadata are the fields of the UI's system metadata that only the administrator
+// may change: the keys. Other roles save the metadata (e.g. canvas templates) with these
+// fields masked; the stored values are put back.
+var protectedMetadata = []string{"guestKeys", "watchKey"}
+
+func (s *server) roleMiddleware() echo.MiddlewareFunc {
+	return func(next echo.HandlerFunc) echo.HandlerFunc {
+		return func(c echo.Context) error {
+			if s.users == nil {
+				return next(c)
+			}
+
+			role := users.Admin
+			if token, ok := c.Get("user").(*jwtgo.Token); ok && token != nil {
+				subject, _ := token.Claims.GetSubject()
+				role = s.users.Role(subject)
+				if role == "" {
+					return api.Err(http.StatusUnauthorized, "", "The account does not exist anymore")
+				}
+			}
+			c.Set("role", role)
+
+			method, route := c.Request().Method, c.Path()
+			if !allowed(role, method, route) {
+				return api.Err(http.StatusForbidden, "", "Not allowed with the role %q", role)
+			}
+
+			if role != users.Admin && method == http.MethodPut && route == "/api/v3/metadata/:key" && c.Param("key") == "restreamer-ui" && s.restream != nil {
+				if err := s.keepProtectedMetadata(c); err != nil {
+					return api.Err(http.StatusBadRequest, "", "%s", err.Error())
+				}
+			}
+
+			secrets, addresses := masked(role, method, route)
+			if !secrets {
+				return next(c)
+			}
+
+			res := c.Response()
+			orig := res.Writer
+			cw := &capture{ResponseWriter: orig}
+			res.Writer = cw
+			err := next(c)
+			res.Writer = orig
+			if _, werr := orig.Write(maskBody(cw.buf.Bytes(), addresses)); werr != nil && err == nil {
+				err = werr
+			}
+			return err
+		}
+	}
+}
+
+// keepProtectedMetadata replaces the key fields in a non-administrator's metadata update with
+// the stored ones.
+func (s *server) keepProtectedMetadata(c echo.Context) error {
+	body, err := io.ReadAll(io.LimitReader(c.Request().Body, 16<<20))
+	if err != nil {
+		return err
+	}
+	var data map[string]interface{}
+	if err := json.Unmarshal(body, &data); err != nil {
+		return err
+	}
+	current := map[string]interface{}{}
+	if m, err := s.restream.GetMetadata("restreamer-ui"); err == nil {
+		if mm, ok := m.(map[string]interface{}); ok {
+			current = mm
+		}
+	}
+	for _, k := range protectedMetadata {
+		if v, ok := current[k]; ok {
+			data[k] = v
+		} else {
+			delete(data, k)
+		}
+	}
+	body, err = json.Marshal(data)
+	if err != nil {
+		return err
+	}
+	c.Request().Body = io.NopCloser(bytes.NewReader(body))
+	c.Request().ContentLength = int64(len(body))
+	return nil
+}
