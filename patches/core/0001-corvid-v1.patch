+		{users.Viewer, "GET", "/api/v3/fork/users", false},
+		{users.Viewer, "POST", "/api/graph/query", false},
+		{"", "GET", "/api/v3/process", false},
+	}
+	for _, c := range cases {
+		if got := allowed(c.role, c.method, c.route); got != c.ok {
+			t.Errorf("%s %s %s: got %v", c.role, c.method, c.route, got)
+		}
+	}
+}
+
+func TestMaskBody(t *testing.T) {
+	body := `{"rtmp":{"token":"abc123"},"api":{"auth":{"password":"pw","jwt":{"secret":"s"}}},` +
+		`"output":[{"address":"rtmps://a.rtmps.youtube.com/live2/1u4v-1r4h-wcz4"},{"address":"rtmp://localhost:1935/ch.stream?token=abc123"},` +
+		`{"address":"srt://localhost:6000?mode=caller&streamid=kanal,mode:request,token:abc123"},{"address":"http://admin:pw@localhost:8080/memfs/x.m3u8"},` +
+		`{"address":"{rtmp,name=ch.stream}"}],"guestKeys":[{"token":"guesttoken0123456"}],"watchKey":"wk"}`
+
+	secrets := string(maskBody([]byte(body), false))
+	for _, leak := range []string{`"abc123"`, `"pw"`, `"s"`, "guesttoken0123456", `"wk"`} {
+		if strings.Contains(secrets, leak) {
+			t.Errorf("secret %s visible: %s", leak, secrets)
+		}
+	}
+	if !strings.Contains(secrets, "1u4v-1r4h-wcz4") {
+		t.Error("addresses are not masked for operators")
+	}
+
+	all := string(maskBody([]byte(body), true))
+	for _, leak := range []string{"abc123", "1u4v-1r4h-wcz4", "admin:pw", "guesttoken0123456"} {
+		if strings.Contains(all, leak) {
+			t.Errorf("%s visible for viewers: %s", leak, all)
+		}
+	}
+	for _, keep := range []string{"rtmp://localhost:1935/ch.stream", "rtmps://a.rtmps.youtube.com/live2/***", "{rtmp,name=ch.stream}"} {
+		if !strings.Contains(all, keep) {
+			t.Errorf("%s missing: %s", keep, all)
+		}
+	}
+}
