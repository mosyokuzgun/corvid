+func TestFailoverSwitchAndRecover(t *testing.T) {
+	srv, _ := New(Config{Failover: &FailoverConfig{Enable: true, Grace: 2 * time.Second, RecoverAfter: 300 * time.Millisecond}})
+	s := srv.(*server)
+	cd := codecs(t)
+
+	var stopP, stopF atomic.Bool
+	qp := addChannel(s, "/live/ch.stream", cd)
+	qf := addChannel(s, "/live/ch_fallback.stream", cd)
+	go publisher(qp, 'P', 100*time.Second, &stopP) // different timelines on purpose
+	go publisher(qf, 'F', 0, &stopF)
+	defer stopF.Store(true)
+
+	d := newFailoverDemuxer(s, s.failover, "/live/ch.stream")
+	defer d.Close()
+	var switches []string
+	d.onSwitch = func(from, to string) {
+		switches = append(switches, to)
+		if from != "" && d.Reason() == "" {
+			t.Errorf("switch from %s to %s without a reason", from, to)
+		}
+	}
+	if _, err := d.Streams(); err != nil {
+		t.Fatal(err)
+	}
+
+	last := map[int8]time.Duration{}
+	read := func(want byte, n int) (sawInjected bool) {
+		t.Helper()
+		got := 0
+		deadline := time.Now().Add(5 * time.Second)
+		for got < n {
+			if time.Now().After(deadline) {
+				t.Fatalf("timeout waiting for %c (switches=%v)", want, switches)
+			}
+			pkt, err := d.ReadPacket()
+			if err != nil {
+				t.Fatal(err)
+			}
+			if pkt.Time < last[pkt.Idx] {
+				t.Fatalf("non-monotonic ts on stream %d: %v < %v", pkt.Idx, pkt.Time, last[pkt.Idx])
+			}
+			last[pkt.Idx] = pkt.Time
+			tag := pkt.Data[len(pkt.Data)-1]
+			if tag == want {
+				got++
+				if pkt.Idx == 0 && bytes.HasPrefix(pkt.Data, []byte{0, 0, 0, 25, 0x67}) {
+					sawInjected = true
+				}
+			}
+		}
+		return
+	}
+
+	read('P', 20)
+	// Primary ingest dies -> fallback at its next keyframe. Both have the same parameter sets
+	// here, so nothing is injected (see TestFailoverParameterSetsOnEveryForeignKeyframe).
+	stopP.Store(true)
+	removeChannel(s, "/live/ch.stream", qp)
+	if read('F', 20) {
+		t.Fatal("identical SPS/PPS must not be injected")
+	}
+	// Primary comes back -> switch back after RecoverAfter at a keyframe.
+	stopP.Store(false)
+	qp2 := addChannel(s, "/live/ch.stream", cd)
+	go publisher(qp2, 'P', 5*time.Second, &stopP)
+	read('P', 20)
+	stopP.Store(true)
+
+	if len(switches) != 2 || switches[0] != "/live/ch_fallback.stream" || switches[1] != "/live/ch.stream" {
+		t.Fatalf("unexpected switches %v", switches)
+	}
+}
