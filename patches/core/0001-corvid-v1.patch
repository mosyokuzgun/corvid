@@ -0,0 +1,38 @@
+package restream
+
+import "testing"
+
+func TestCheckPaths(t *testing.T) {
+	roots := []string{"/dev", "/usr/share/fonts", "/tmp/data"}
+	ok := []string{
+		"rtmp://localhost:1935/live/ch.stream?token=x",
+		"http://admin:pw@localhost:8080/memfs/x.m3u8",
+		"srt://localhost:6000?mode=caller&streamid=a,mode:request",
+		"/dev/video0",
+		"[0:v]split=2[a][b];movie=filename='/tmp/data/slate.png',scale=w=1920:h=1080[c]",
+		"overlay=x=(main_w-overlay_w)/2:y=0",
+		"color=c=0x000000:s=1920x1080:r=1:d=1",
+		"/memfs/x.m3u8", // no such directory on this machine
+		"pipe:",
+		"-",
+	}
+	bad := []string{
+		"/etc/passwd",
+		"file:/etc/passwd",
+		"movie=filename='/etc/hostname'",
+		"drawtext=textfile=/etc/hostname:fontsize=20",
+		"subtitles=/proc/self/environ",
+		"/tmp/data/../../etc/passwd",
+		"../config.json",
+	}
+	for _, s := range ok {
+		if err := checkPaths(s, roots); err != nil {
+			t.Errorf("%q refused: %v", s, err)
+		}
+	}
+	for _, s := range bad {
+		if err := checkPaths(s, roots); err == nil {
+			t.Errorf("%q allowed", s)
+		}
+	}
+}
diff --git a/restream/handover.go b/restream/handover.go
new file mode 100644
index 0000000..97453f5
--- /dev/null
+++ b/restream/handover.go
@@ -0,0 +1,158 @@
+package restream
+
+import (
+	"net/url"
+	"strings"
+	"time"
+)
+
+// Seamless restart (fork). Saving a channel used to stop its ingest process and start the new
+// one: for the 2-5 s the new FFmpeg needs to connect and probe its source, the internal RTMP
+// failover showed the backup stream or the slate on YouTube, even for a changed caption.
+//
+// Now, if the running process publishes the channel to the internal RTMP server, the new
+// process starts next to it and publishes "<channel>_next.stream" first. The players of the
+// channel move to it at a keyframe once it delivers at real time (rtmp.HandoverAfter), then
+// the old process is stopped. Later restarts of the new process publish the normal name.
+
+// handoverTimeout bounds how long the old process keeps running when the new one never gets
+// going (wrong settings, source gone): then the usual failover takes over.
+const handoverTimeout = 20 * time.Second
+
+// handoverSettle is how long the new stream must have been published before the old process
+// is stopped: HandoverAfter plus a keyframe interval for every player to have moved.
+const handoverSettle = 4 * time.Second
+
+// Handover is what UpdateProcess needs from the RTMP server; see rtmp.Server.
+type Handover interface {
+	PublishedFor(path string) time.Duration
+	SeamlessRestart() bool
+}
+
+func isLocalHost(host string) bool {
+	switch host {
+	case "localhost", "127.0.0.1", "::1", "[::1]":
+		return true
+	}
+	return false
+}
+
+// outputArgs calls fn for every argument that is not an input address (after "-i").
+func outputArgs(args []string, fn func(i int, a string)) {
+	for i, a := range args {
+		if i > 0 && args[i-1] == "-i" {
+			continue
+		}
+		fn(i, a)
+	}
+}
+
+// localRTMPPaths returns the URL path of an internal RTMP output in arg ("-f tee" lists several
+// outputs separated by "|", each optionally prefixed with "[options]").
+func localRTMPPaths(arg string) []string {
+	paths := []string{}
+	for _, part := range strings.Split(arg, "|") {
+		if i := strings.Index(part, "]"); strings.HasPrefix(part, "[") && i > 0 {
+			part = part[i+1:]
+		}
+		if !strings.HasPrefix(part, "rtmp://") {
+			continue
+		}
+		u, err := url.Parse(part)
+		if err != nil || !isLocalHost(u.Hostname()) || !strings.HasSuffix(u.Path, ".stream") {
+			continue
+		}
+		paths = append(paths, u.Path)
+	}
+	return paths
+}
+
+// handoverPath returns the internal RTMP stream a process publishes, if it can be restarted
+// seamlessly: exactly one such output, not a fallback or next stream itself, and no output
+// that a second copy would collide with (a publish to the internal SRT server).
+func handoverPath(command []string) string {
+	found := []string{}
+	blocked := false
+	outputArgs(command, func(_ int, a string) {
+		if strings.Contains(a, "srt://") && strings.Contains(a, "mode:publish") {
+			blocked = true
+		}
+		found = append(found, localRTMPPaths(a)...)
+	})
+	if blocked || len(found) != 1 {
+		return ""
+	}
+	p := found[0]
+	base := strings.TrimSuffix(p, ".stream")
+	if strings.HasSuffix(base, "_fallback") || strings.HasSuffix(base, "_fallback2") || strings.HasSuffix(base, "_next") {
+		return ""
+	}
+	return p
+}
+
+// rtmpNextPath is rtmp.NextPath: "/abc.stream" -> "/abc_next.stream".
+func rtmpNextPath(path string) string {
+	return strings.TrimSuffix(path, ".stream") + "_next.stream"
+}
+
+// handoverArgs makes the process publish path under NextPath instead.
+func handoverArgs(args []string, path, next string) []string {
+	out := append([]string(nil), args...)
+	outputArgs(out, func(i int, a string) {
+		for _, p := range localRTMPPaths(a) {
+			if p == path {
+				out[i] = strings.Replace(a, path, next, 1)
+				return
+			}
+		}
+	})
+	return out
+}
+
+// handoverTarget decides whether old can be replaced by t seamlessly. It returns the stream
+// path of the channel and the name the new process has to publish: the other of the two
+// main names (the old process may itself publish "_next" after an earlier handover).
+// to == "" means: restart the classic way.
+func (r *restream) handoverTarget(old, t *task) (path, to string) {
+	if r.handover == nil || !r.handover.SeamlessRestart() || !t.valid || t.process.Order != "start" {
+		return "", ""
+	}
+	path = handoverPath(t.command)
+	if path == "" || path != handoverPath(old.command) {
+		return "", ""
+	}
+	if old.process.Order != "start" || old.ffmpeg == nil || old.ffmpeg.Status().State != "running" {
+		return "", ""
+	}
+	if r.maxProc > 0 && r.nProc >= r.maxProc {
+		return "", ""
+	}
+	next := rtmpNextPath(path)
+	onPath, onNext := r.handover.PublishedFor(path) > 0, r.handover.PublishedFor(next) > 0
+	switch {
+	case onPath && !onNext:
+		return path, next
+	case onNext && !onPath:
+		return path, path
+	}
+	return "", "" // not publishing, or a handover is still running
+}
+
+// finishHandover stops the old process once the new one has published long enough, or after
+// handoverTimeout.
+func (r *restream) finishHandover(old *task, next string) {
+	deadline := time.Now().Add(handoverTimeout)
+	for time.Now().Before(deadline) && r.handover.PublishedFor(next) < handoverSettle {
+		time.Sleep(200 * time.Millisecond)
+	}
+	if r.handover.PublishedFor(next) < handoverSettle {
+		r.logger.Warn().WithField("id", old.id).Log("Seamless restart: the new process did not start in time, stopping the old one anyway")
+	}
+
+	r.lock.Lock()
+	old.process.Order = "stop"
+	r.nProc--
+	r.lock.Unlock()
+
+	old.ffmpeg.Stop(true)
+}
