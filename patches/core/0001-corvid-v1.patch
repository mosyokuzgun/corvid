+++ b/prometheus/gpu.go
@@ -0,0 +1,52 @@
+package prometheus
+
+import (
+	"github.com/datarhei/core/v16/monitor/metric"
+
+	"github.com/prometheus/client_golang/prometheus"
+)
+
+type gpuCollector struct {
+	core      string
+	collector metric.Reader
+	desc      map[string]*prometheus.Desc
+}
+
+var gpuMetrics = map[string][2]string{
+	"temperature":      {"gpu_temperature_celsius", "GPU core temperature"},
+	"power":            {"gpu_power_watts", "GPU board power draw"},
+	"mem_total":        {"gpu_memory_total_bytes", "GPU memory total"},
+	"mem_used":         {"gpu_memory_used_bytes", "GPU memory used"},
+	"util_gpu":         {"gpu_utilization_percent", "GPU SM utilization"},
+	"util_encoder":     {"gpu_encoder_utilization_percent", "NVENC utilization"},
+	"util_decoder":     {"gpu_decoder_utilization_percent", "NVDEC utilization"},
+	"encoder_sessions": {"gpu_encoder_sessions", "Active NVENC sessions"},
+	"encoder_fps":      {"gpu_encoder_average_fps", "NVENC average FPS"},
+	"encoder_latency":  {"gpu_encoder_average_latency_microseconds", "NVENC average latency"},
+	"processes":        {"gpu_assigned_processes", "Core processes assigned to this GPU via {gpu}"},
+}
+
+func NewGPUCollector(core string, c metric.Reader) prometheus.Collector {
+	g := &gpuCollector{core: core, collector: c, desc: map[string]*prometheus.Desc{}}
+	for k, v := range gpuMetrics {
+		g.desc[k] = prometheus.NewDesc(v[0], v[1], []string{"core", "index", "uuid", "model"}, nil)
+	}
+	return g
+}
+
+func (c *gpuCollector) Describe(ch chan<- *prometheus.Desc) {
+	for _, d := range c.desc {
+		ch <- d
+	}
+}
+
+func (c *gpuCollector) Collect(ch chan<- prometheus.Metric) {
+	metrics := c.collector.Collect([]metric.Pattern{metric.NewPattern("gpu")})
+	for _, m := range metrics.All() {
+		d, ok := c.desc[m.L("name")]
+		if !ok {
+			continue
+		}
+		ch <- prometheus.MustNewConstMetric(d, prometheus.GaugeValue, m.Val(), c.core, m.L("index"), m.L("uuid"), m.L("model"))
+	}
+}
