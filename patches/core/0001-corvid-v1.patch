index 0000000..37366cb
--- /dev/null
+++ b/guest/guest.go
@@ -0,0 +1,148 @@
+// Package guest implements guest keys (fork): stream keys that let a third party either send
+// or watch one named stream on the RTMP or SRT server until a point in time, without knowing
+// the main stream key. A key is for one of the two: a "publish" key cannot be used to watch,
+// a "play" key cannot be used to send.
+//
+// The keys are kept by the UI in the system metadata ("restreamer-ui" -> "guestKeys"):
+//
+//	[{ "token": "...", "name": "guest1.stream", "mode": "publish", "expires": 1794567890 }, ...]
+//
+// mode is "publish" (the default) or "play".
+package guest
+
+import (
+	"crypto/subtle"
+	"net"
+	"strings"
+	"time"
+)
+
+// MinTokenLength is the shortest token that is accepted as a guest key.
+const MinTokenLength = 16
+
+// Checker reports whether token may publish (or, with publish false, play) the named
+// resource right now.
+type Checker func(token, resource string, publish bool) bool
+
+// Allowed checks token and resource against the guest keys in the metadata of the UI.
+// resource is the SRT resource ("guest1.stream") or the RTMP path ("/live/guest1.stream").
+func Allowed(metadata interface{}, token, resource string, publish bool, now time.Time) bool {
+	if len(token) < MinTokenLength {
+		return false
+	}
+
+	m, ok := metadata.(map[string]interface{})
+	if !ok {
+		return false
+	}
+
+	list, ok := m["guestKeys"].([]interface{})
+	if !ok {
+		return false
+	}
+
+	allowed := false
+
+	for _, e := range list {
+		key, ok := e.(map[string]interface{})
+		if !ok {
+			continue
+		}
+
+		t, _ := key["token"].(string)
+		name, _ := key["name"].(string)
+		expires, _ := key["expires"].(float64)
+		mode, _ := key["mode"].(string)
+
+		// A key without a mode is a publish key; an unknown mode is good for nothing.
+		forPublish := mode == "" || mode == "publish"
+		if !forPublish && mode != "play" {
+			continue
+		}
+
+		if len(t) < MinTokenLength || len(name) == 0 {
+			continue
+		}
+
+		// Compare every key, so that the time does not tell which one matched.
+		match := subtle.ConstantTimeCompare([]byte(t), []byte(token)) == 1
+		if match && forPublish == publish && now.Unix() < int64(expires) && sameResource(resource, name) {
+			allowed = true
+		}
+	}
+
+	return allowed
+}
+
+// sameResource reports whether the resource is the named stream: equal, or the last
+// element of an RTMP path.
+func sameResource(resource, name string) bool {
+	if strings.ContainsAny(name, "/?&, ") {
+		return false
+	}
+
+	return resource == name || strings.HasSuffix(resource, "/"+name)
+}
+
+// WatchKey returns the watch key from the metadata of the UI ("restreamer-ui" ->
+// "watchKey"), or "" if none is set (fork). With a watch key, the main stream key only
+// sends from the internet; watchers there use the watch key. The server itself and private
+// networks still play with the main key: the server's own processes read the streams with it
+// (via loopback, or via the Docker bridge when an address points at the server's public IP).
+func WatchKey(metadata interface{}) string {
+	m, ok := metadata.(map[string]interface{})
+	if !ok {
+		return ""
+	}
+
+	key, _ := m["watchKey"].(string)
+	if len(key) < MinTokenLength {
+		return ""
+	}
+
+	return key
+}
+
+// PlayDecision says how a request to play with token is to be treated (fork).
+type PlayDecision int
+
+const (
+	PlayRefused       PlayDecision = iota // not allowed
+	PlayMain                              // the main key
+	PlayWatch                             // the watch key
+	PlayMainOnlyLocal                     // the main key, refused: a watch key is set and the client is not local
+)
+
+// Play decides about a play request with the main key main, the watch key watch ("" for
+// none) and whether the client is local (the server itself or a private network). Guest keys are checked
+// by the caller when this returns PlayRefused. local: see IsLocal.
+func Play(main, watch, token string, local bool) PlayDecision {
+	if len(token) == 0 {
+		return PlayRefused
+	}
+
+	if subtle.ConstantTimeCompare([]byte(main), []byte(token)) == 1 {
+		if len(watch) != 0 && !local {
+			return PlayMainOnlyLocal
+		}
+		return PlayMain
+	}
+
+	if len(watch) != 0 && subtle.ConstantTimeCompare([]byte(watch), []byte(token)) == 1 {
+		return PlayWatch
+	}
+
+	return PlayRefused
+}
+
+// IsLocal reports whether the address (host:port or host) is the server itself or in a
+// private network (10/8, 172.16/12, 192.168/16, fc00::/7) or link-local.
+func IsLocal(address string) bool {
+	host := address
+	if h, _, err := net.SplitHostPort(address); err == nil {
+		host = h
+	}
+
+	ip := net.ParseIP(strings.Trim(host, "[]"))
+	return ip != nil && (ip.IsLoopback() || ip.IsPrivate() || ip.IsLinkLocalUnicast())
+}
diff --git a/guest/guest_test.go b/guest/guest_test.go
new file mode 100644
index 0000000..a018085
--- /dev/null
+++ b/guest/guest_test.go
@@ -0,0 +1,114 @@
+package guest
+
+import (
+	"encoding/json"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+)
+
+func meta(t *testing.T, s string) interface{} {
+	var v interface{}
+	if err := json.Unmarshal([]byte(s), &v); err != nil {
+		t.Fatal(err)
+	}
+	return v
+}
+
+func TestAllowed(t *testing.T) {
+	now := time.Unix(1000, 0)
+	m := meta(t, `{"guestKeys":[
+		{"token":"0123456789abcdef0123","name":"guest1.stream","expires":2000},
+		{"token":"ffffffffffffffffffff","name":"old.stream","expires":900},
+		{"token":"short","name":"x.stream","expires":2000},
+		{"token":"eeeeeeeeeeeeeeeeeeee","name":"a/b","expires":2000},
+		{"token":"aaaaaaaaaaaaaaaaaaaa","name":"show.stream","mode":"play","expires":2000},
+		{"token":"bbbbbbbbbbbbbbbbbbbb","name":"show.stream","mode":"admin","expires":2000}
+	]}`)
+
+	cases := []struct {
+		token, resource string
+		want            bool
+	}{
+		{"0123456789abcdef0123", "guest1.stream", true},
+		{"0123456789abcdef0123", "/live/guest1.stream", true},
+		{"0123456789abcdef0123", "/guest1.stream", true},
+		{"0123456789abcdef0123", "other.stream", false},   // a key is for one stream
+		{"0123456789abcdef0123", "xguest1.stream", false}, // not a suffix match
+		{"0123456789abcdef012", "guest1.stream", false},   // wrong key
+		{"ffffffffffffffffffff", "old.stream", false},     // expired
+		{"short", "x.stream", false},                      // too short to be a key
+		{"eeeeeeeeeeeeeeeeeeee", "a/b", false},            // not a stream name
+		{"", "guest1.stream", false},
+	}
+	for _, c := range cases {
+		if got := Allowed(m, c.token, c.resource, true, now); got != c.want {
+			t.Errorf("Allowed(%q, %q) = %v, want %v", c.token, c.resource, got, c.want)
+		}
+	}
+
+	// at the moment of expiry the key is no longer valid
+	if Allowed(m, "0123456789abcdef0123", "guest1.stream", true, time.Unix(2000, 0)) {
+		t.Error("key accepted at its expiry time")
+	}
+	// nothing stored, or something else stored
+	for _, s := range []string{`{}`, `null`, `{"guestKeys":"x"}`, `{"guestKeys":[1,"a",null]}`, `[]`} {
+		if Allowed(meta(t, s), "0123456789abcdef0123", "guest1.stream", true, now) {
+			t.Errorf("accepted with metadata %s", s)
+		}
+	}
+
+	// a key is for sending or for watching, never both
+	if Allowed(m, "0123456789abcdef0123", "guest1.stream", false, now) {
+		t.Error("publish key accepted for playing")
+	}
+	if !Allowed(m, "aaaaaaaaaaaaaaaaaaaa", "/live/show.stream", false, now) {
+		t.Error("play key rejected for playing")
+	}
+	if Allowed(m, "aaaaaaaaaaaaaaaaaaaa", "show.stream", true, now) {
+		t.Error("play key accepted for publishing")
+	}
+	if Allowed(m, "aaaaaaaaaaaaaaaaaaaa", "guest1.stream", false, now) {
+		t.Error("play key accepted for another stream")
+	}
+	if Allowed(m, "bbbbbbbbbbbbbbbbbbbb", "show.stream", false, now) || Allowed(m, "bbbbbbbbbbbbbbbbbbbb", "show.stream", true, now) {
+		t.Error("key with an unknown mode accepted")
+	}
+}
+
+func TestWatchKey(t *testing.T) {
+	require.Equal(t, "", WatchKey(nil))
+	require.Equal(t, "", WatchKey(map[string]interface{}{"watchKey": "short"}))
+	require.Equal(t, "w4tchk3y-0123456789", WatchKey(map[string]interface{}{"watchKey": "w4tchk3y-0123456789"}))
+}
+
+func TestPlay(t *testing.T) {
+	main := "main-key-0123456789"
+	watch := "w4tchk3y-0123456789"
+
+	// no watch key: as before, the main key plays from anywhere
+	require.Equal(t, PlayMain, Play(main, "", main, false))
+	require.Equal(t, PlayRefused, Play(main, "", watch, false))
+
+	// with a watch key the main key only plays locally
+	require.Equal(t, PlayMainOnlyLocal, Play(main, watch, main, false))
+	require.Equal(t, PlayMain, Play(main, watch, main, true))
+	require.Equal(t, PlayWatch, Play(main, watch, watch, false))
+	require.Equal(t, PlayRefused, Play(main, watch, "other-key-012345678", false))
+	require.Equal(t, PlayRefused, Play(main, watch, "", true))
+}
+
+func TestIsLocal(t *testing.T) {
+	require.True(t, IsLocal("127.0.0.1:51234"))
+	require.True(t, IsLocal("[::1]:51234"))
+	require.True(t, IsLocal("127.0.0.1"))
+	require.True(t, IsLocal("10.20.0.5:6000"), "the local network")
+	require.True(t, IsLocal("172.17.0.1:40000"), "the Docker bridge")
+	require.True(t, IsLocal("192.168.1.20:1935"))
+	require.True(t, IsLocal("10.0.0.5:1935"))
+	require.False(t, IsLocal("203.0.113.10:51234"))
+	require.False(t, IsLocal("8.8.8.8:1935"))
+	require.False(t, IsLocal("192.0.2.2:1935"))
+	require.False(t, IsLocal("garbage"))
+}
