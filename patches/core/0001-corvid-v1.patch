+
+// guestKey reports whether token is a valid guest key for publishing or playing resource (fork). The
+// keys are managed by the UI and live in its system metadata.
+// watchKey returns the watch key kept by the UI, "" for none (fork).
+func (a *api) watchKey() string {
+	rs := a.restream
+	if rs == nil {
+		return ""
+	}
+
+	metadata, err := rs.GetMetadata("restreamer-ui")
+	if err != nil {
+		return ""
+	}
+
+	return guest.WatchKey(metadata)
+}
+
+func (a *api) guestKey(token, resource string, publish bool) bool {
+	rs := a.restream
+	if rs == nil {
+		return false
+	}
+
+	metadata, err := rs.GetMetadata("restreamer-ui")
+	if err != nil {
+		return false
+	}
+
+	return guest.Allowed(metadata, token, resource, publish, time.Now())
+}
+
+// rtmpHandover gives the restreamer the RTMP server's view for seamless restarts. The RTMP
+// server is created after the restreamer, so it is looked up on every call.
+type rtmpHandover struct{ a *api }
+
+func (h rtmpHandover) PublishedFor(path string) time.Duration {
+	if h.a.rtmpserver == nil {
+		return 0
+	}
+	return h.a.rtmpserver.PublishedFor(path)
+}
+
+func (h rtmpHandover) SeamlessRestart() bool {
+	return h.a.rtmpserver != nil && h.a.rtmpserver.SeamlessRestart()
+}
