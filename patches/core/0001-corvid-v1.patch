+	}
+
+	acc.RemoveSubscriber(id)
+
+	s.log(log.Linfo, "PLAY", "STOP", playPath, "", client)
+}
diff --git a/seal/seal.go b/seal/seal.go
new file mode 100644
index 0000000..799d7c8
--- /dev/null
+++ b/seal/seal.go
@@ -0,0 +1,107 @@
+// Package seal encrypts the panel's configuration export with a password (fork).
+//
+// The browser cannot do this itself: the panel runs over plain HTTP, where browsers withhold
+// their crypto API. The envelope is JSON, so a sealed export is still recognisable:
+//
+//	{"format":"yayin-paneli-sealed","version":1,"kdf":"argon2id","time":3,"memory":65536,
+//	 "threads":2,"salt":"…","nonce":"…","data":"…"}
+//
+// Key: Argon2id(password, salt) -> 32 bytes; cipher: AES-256-GCM, the envelope's format and
+// version are authenticated as additional data.
+package seal
+
+import (
+	"crypto/aes"
+	"crypto/cipher"
+	"crypto/rand"
+	"encoding/json"
+	"errors"
+
+	"golang.org/x/crypto/argon2"
+)
+
+const Format = "yayin-paneli-sealed"
+
+type Envelope struct {
+	Format  string `json:"format"`
+	Version int    `json:"version"`
+	KDF     string `json:"kdf"`
+	Time    uint32 `json:"time"`
+	Memory  uint32 `json:"memory"`
+	Threads uint8  `json:"threads"`
+	Salt    []byte `json:"salt"`
+	Nonce   []byte `json:"nonce"`
+	Data    []byte `json:"data"`
+}
+
+// MinPasswordLength is the shortest password accepted for sealing.
+const MinPasswordLength = 8
+
+var (
+	ErrPassword = errors.New("the password must have at least 8 characters")
+	ErrFormat   = errors.New("not a sealed configuration file")
+	ErrOpen     = errors.New("wrong password or damaged file")
+)
+
+func aad() []byte { return []byte(Format + "/1") }
+
+func gcm(password string, salt []byte, t, m uint32, p uint8) (cipher.AEAD, error) {
+	key := argon2.IDKey([]byte(password), salt, t, m, p, 32)
+	block, err := aes.NewCipher(key)
+	if err != nil {
+		return nil, err
+	}
+	return cipher.NewGCM(block)
+}
+
+// Seal encrypts plaintext with password.
+func Seal(password string, plaintext []byte) (*Envelope, error) {
+	if len([]rune(password)) < MinPasswordLength {
+		return nil, ErrPassword
+	}
+	e := &Envelope{Format: Format, Version: 1, KDF: "argon2id", Time: 3, Memory: 64 * 1024, Threads: 2, Salt: make([]byte, 16)}
+	if _, err := rand.Read(e.Salt); err != nil {
+		return nil, err
+	}
+	aead, err := gcm(password, e.Salt, e.Time, e.Memory, e.Threads)
+	if err != nil {
+		return nil, err
+	}
+	e.Nonce = make([]byte, aead.NonceSize())
+	if _, err := rand.Read(e.Nonce); err != nil {
+		return nil, err
+	}
+	e.Data = aead.Seal(nil, e.Nonce, plaintext, aad())
+	return e, nil
+}
+
+// Open decrypts an envelope.
+func Open(password string, e *Envelope) ([]byte, error) {
+	if e == nil || e.Format != Format || e.Version != 1 || e.KDF != "argon2id" || len(e.Salt) < 8 {
+		return nil, ErrFormat
+	}
+	// bounds, so a crafted file cannot make the server spend gigabytes
+	if e.Time == 0 || e.Time > 10 || e.Memory < 8*1024 || e.Memory > 256*1024 || e.Threads == 0 || e.Threads > 8 {
+		return nil, ErrFormat
+	}
+	aead, err := gcm(password, e.Salt, e.Time, e.Memory, e.Threads)
+	if err != nil {
+		return nil, err
+	}
+	if len(e.Nonce) != aead.NonceSize() {
+		return nil, ErrFormat
+	}
+	out, err := aead.Open(nil, e.Nonce, e.Data, aad())
+	if err != nil {
+		return nil, ErrOpen
+	}
+	return out, nil
+}
+
+// IsSealed reports whether data is a sealed envelope.
+func IsSealed(data []byte) bool {
+	var probe struct {
+		Format string `json:"format"`
+	}
+	return json.Unmarshal(data, &probe) == nil && probe.Format == Format
+}
