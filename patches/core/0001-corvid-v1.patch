diff --git a/restream/tune.go b/restream/tune.go
new file mode 100644
index 0000000..3327ae9
--- /dev/null
+++ b/restream/tune.go
@@ -0,0 +1,71 @@
+package restream
+
+import "strings"
+
+// tuneArgs makes two kinds of processes cheaper without changing what they produce. It runs
+// at every start, after gpu.EncoderDevice, so stored processes need not be saved again.
+func tuneArgs(args []string) []string {
+	return stillImageOnGPU(keyframeDecoderThreads(args))
+}
+
+// keyframeDecoderThreads gives a decoder that only decodes keyframes (-skip_frame nokey, the
+// panel's level meter) a single thread. With the default, FFmpeg opens one frame thread per
+// CPU and wakes each of them for every packet it then skips: on the 8-thread production
+// server that was ~8 % of a core per meter, for a frame every 2 seconds.
+func keyframeDecoderThreads(args []string) []string {
+	for i := 0; i+1 < len(args); i++ {
+		if args[i] == "-threads" {
+			return args
+		}
+		if args[i] == "-i" {
+			break
+		}
+	}
+	for i := 0; i+1 < len(args); i++ {
+		if args[i] == "-skip_frame" && args[i+1] == "nokey" {
+			out := make([]string, 0, len(args)+2)
+			out = append(out, args[:i+2]...)
+			out = append(out, "-threads", "1")
+			return append(out, args[i+2:]...)
+		}
+	}
+	return args
+}
+
+// stillLoop is how the panel repeats a still picture (the slate).
+const stillLoop = "format=yuv420p,loop=loop=-1:size=1:start=0"
+
+// stillImageOnGPU uploads a slate's still picture to the GPU once, before the loop, instead of
+// copying the same 3 MB picture to the encoder 25 times a second. Measured on the production
+// server: 1.90 s -> 1.46 s of CPU per 20 s. Only for NVENC processes that have the CUDA device
+// named "gpu" (as gpu.EncoderDevice creates it) and no -filter_hw_device yet.
+func stillImageOnGPU(args []string) []string {
+	device, filter := -1, -1
+	for i := 0; i+1 < len(args); i++ {
+		switch {
+		case args[i] == "-filter_hw_device":
+			return args
+		case args[i] == "-init_hw_device" && strings.HasPrefix(args[i+1], "cuda=gpu"):
+			device = i
+		case (args[i] == "-filter:v" || args[i] == "-vf") && strings.Contains(args[i+1], stillLoop):
+			filter = i
+		case (args[i] == "-codec:v" || args[i] == "-c:v") && !strings.HasSuffix(args[i+1], "_nvenc"):
+			return args
+		}
+	}
+	if device < 0 || filter < 0 || strings.Count(args[filter+1], stillLoop) != 1 {
+		return args
+	}
+
+	out := make([]string, 0, len(args)+2)
+	out = append(out, args[:device+2]...)
+	out = append(out, "-filter_hw_device", "gpu")
+	for i := device + 2; i < len(args); i++ {
+		if i == filter+1 {
+			out = append(out, strings.Replace(args[i], stillLoop, "format=nv12,hwupload,loop=loop=-1:size=1:start=0", 1))
+			continue
+		}
+		out = append(out, args[i])
+	}
+	return out
+}
diff --git a/restream/tune_test.go b/restream/tune_test.go
new file mode 100644
index 0000000..b66f60d
--- /dev/null
+++ b/restream/tune_test.go
@@ -0,0 +1,57 @@
+package restream
+
+import (
+	"reflect"
+	"strings"
+	"testing"
+
+	"github.com/datarhei/core/v16/gpu"
+)
+
+func TestKeyframeDecoderThreads(t *testing.T) {
+	watch := strings.Fields("-loglevel level+info -skip_frame nokey -rtmp_enhanced_codecs hvc1 -i rtmp://x -map 0:v:0? -vf scale=320:-2 -f null -")
+	want := strings.Fields("-loglevel level+info -skip_frame nokey -threads 1 -rtmp_enhanced_codecs hvc1 -i rtmp://x -map 0:v:0? -vf scale=320:-2 -f null -")
+	if got := tuneArgs(watch); !reflect.DeepEqual(got, want) {
+		t.Fatalf("got %v", got)
+	}
+	for _, s := range []string{
+		"-skip_frame nokey -threads 2 -i rtmp://x -f null -",
+		"-i rtmp://x -codec copy -f flv out",
+	} {
+		if got := tuneArgs(strings.Fields(s)); !reflect.DeepEqual(got, strings.Fields(s)) {
+			t.Fatalf("changed %q: %v", s, got)
+		}
+	}
+}
+
+func TestStillImageOnGPU(t *testing.T) {
+	// The production slate, as it reaches the hook after gpu.EncoderDevice.
+	slate := gpu.EncoderDevice(strings.Fields("-loglevel level+info -i /core/data/fallback.jpg -f lavfi -i anullsrc=r=44100:cl=stereo -map 0:v:0 -map 1:a:0 " +
+		"-codec:v h264_nvenc -gpu {gpu} -preset:v p3 -filter:v scale=1920:1080:force_original_aspect_ratio=decrease,pad=1920:1080:(ow-iw)/2:(oh-ih)/2,setsar=1,format=yuv420p,loop=loop=-1:size=1:start=0,setpts=N/(25)/TB,realtime " +
+		"-codec:a aac -f flv rtmp://localhost:1935/x_fallback2.stream"))
+	got := tuneArgs(slate)
+	want := strings.Fields("-init_hw_device cuda=gpu:{gpu} -filter_hw_device gpu -loglevel level+info -i /core/data/fallback.jpg -f lavfi -i anullsrc=r=44100:cl=stereo -map 0:v:0 -map 1:a:0 " +
+		"-codec:v h264_nvenc -gpu {gpu} -preset:v p3 -filter:v scale=1920:1080:force_original_aspect_ratio=decrease,pad=1920:1080:(ow-iw)/2:(oh-ih)/2,setsar=1,format=nv12,hwupload,loop=loop=-1:size=1:start=0,setpts=N/(25)/TB,realtime " +
+		"-codec:a aac -f flv rtmp://localhost:1935/x_fallback2.stream")
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("got  %v\nwant %v", got, want)
+	}
+	if again := tuneArgs(got); !reflect.DeepEqual(again, got) {
+		t.Fatalf("not idempotent: %v", again)
+	}
+
+	for _, s := range []string{
+		// libx264 slate: no GPU
+		"-i a.jpg -codec:v libx264 -filter:v format=yuv420p,loop=loop=-1:size=1:start=0 -f flv out",
+		// NVENC without a device named gpu
+		"-init_hw_device cuda=dev:0 -i a.jpg -codec:v h264_nvenc -filter:v format=yuv420p,loop=loop=-1:size=1:start=0 -f flv out",
+		// GPU canvas already uses a filter device
+		"-init_hw_device cuda=gpu:0 -filter_hw_device gpu -i a.jpg -codec:v h264_nvenc -filter:v format=yuv420p,loop=loop=-1:size=1:start=0 -f flv out",
+		// a normal stream
+		"-init_hw_device cuda=gpu:0 -hwaccel cuda -i srt://x -codec:v h264_nvenc -filter:v format=yuv420p -f flv out",
+	} {
+		if got := tuneArgs(strings.Fields(s)); !reflect.DeepEqual(got, strings.Fields(s)) {
+			t.Fatalf("changed %q: %v", s, got)
+		}
+	}
+}
diff --git a/rtmp/failover.go b/rtmp/failover.go
new file mode 100644
index 0000000..7679a4a
--- /dev/null
+++ b/rtmp/failover.go
@@ -0,0 +1,767 @@
+package rtmp
+
+// Seamless failover for the internal RTMP server (fork addition).
+//
+// Restreamer's process model is unchanged: the ingest process publishes
+// {rtmp,name=<channel>.stream}, every egress process (YouTube, Twitch, ...) plays it.
+// Without failover, an ingest crash closes the queue and every egress FFmpeg gets EOF,
+// exits and reconnects to the CDN ("stream offline").
+//
+// With failover a player of "<channel>.stream" is served by a switching demuxer:
+//
+//   - If a process publishes "<channel>_fallback.stream" (backup source, or a looping
+//     slate), the player switches to it at the fallback's next keyframe as soon as the
+//     primary disappears, and switches back at the primary's next keyframe once the
+//     primary has been publishing for RecoverAfter (anti-flapping).
+//   - Without a fallback the player is kept connected for Grace while the ingest process
+//     restarts, so a short ingest reconnect no longer tears down every egress.
+//   - Seamless restart: when a process with new settings publishes "<channel>_next.stream"
+//     while the old one still publishes "<channel>.stream", the player moves to it at its
+//     next keyframe once it delivers at real time (HandoverAfter); the old process is then
+//     stopped (restream.UpdateProcess). Viewers see the new settings without a slate.
+//   - Timestamps are rewritten to stay monotonic (offset = last output time + wall-clock
+//     gap), and the new source's SPS/PPS are injected in-band in the first keyframe, so
+//     -c copy egresses and the CDN see one continuous stream.
+
+import (
+	"bytes"
+	"encoding/binary"
+	"io"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/datarhei/joy4/av"
+	"github.com/datarhei/joy4/av/pubsub"
+	"github.com/datarhei/joy4/codec/h264parser"
+	"github.com/datarhei/joy4/format/flv/flvio"
+)
+
+// FailoverConfig configures the switching behaviour.
+type FailoverConfig struct {
+	Enable       bool
+	Grace        time.Duration // keep players connected this long without any source
+	RecoverAfter time.Duration // primary must be up this long before switching back
+	// Stall: a primary that stays connected but delivers no packets for this long counts as
+	// lost. This is the usual case when the *source* of an ingest process disappears: the
+	// ingest FFmpeg keeps running (blocked on its input) and never disconnects from the
+	// RTMP server. 0 disables the detection (only disconnects trigger the switch).
+	Stall time.Duration
+}
+
+func DefaultFailoverConfig() FailoverConfig {
+	return FailoverConfig{Enable: true, Grace: 10 * time.Second, RecoverAfter: 3 * time.Second, Stall: 3 * time.Second}
+}
+
+// HandoverAfter is how long a "_next" stream must deliver at real time before players move
+// to it. Shorter than RecoverAfter: it is a process we started on purpose, not a flapping one.
+const HandoverAfter = time.Second
+
+// NextPath maps "/live/abc.stream" -> "/live/abc_next.stream", where a restarted process
+// publishes until the players have moved over (seamless restart).
+func NextPath(path string) string {
+	if strings.HasSuffix(path, ".stream") {
+		return strings.TrimSuffix(path, ".stream") + "_next.stream"
+	}
+	return path + "_next"
+}
+
+// Fallback candidates in priority order. "_fallback" is the preferred one (typically a
+// backup stream), "_fallback2" the last resort (typically a slate image that is always
+// available). A channel can use either or both.
+var fallbackSuffixes = []string{"_fallback", "_fallback2"}
+
+// fallbackPaths maps "/live/abc.stream" -> ["/live/abc_fallback.stream", "/live/abc_fallback2.stream"].
+func fallbackPaths(path string) []string {
+	base, ext := path, ""
+	if strings.HasSuffix(path, ".stream") {
+		base, ext = strings.TrimSuffix(path, ".stream"), ".stream"
+	}
+	out := make([]string, 0, len(fallbackSuffixes))
+	for _, sfx := range fallbackSuffixes {
+		out = append(out, base+sfx+ext)
+	}
+	return out
+}
+
+// fallbackPath returns the preferred fallback of a path.
+func fallbackPath(path string) string { return fallbackPaths(path)[0] }
+
+func isFallbackPath(path string) bool {
+	base := strings.TrimSuffix(path, ".stream")
+	for _, sfx := range fallbackSuffixes {
+		if strings.HasSuffix(base, sfx) {
+			return true
+		}
+	}
+	return false
+}
+
+// badFor is how long a fallback candidate that was connected but silent is skipped.
+const badFor = 3 * time.Second
+
+// source is one subscribed channel with its own reader goroutine.
+type source struct {
+	path    string
+	streams []av.CodecData
+	idxMap  map[int8]int8 // source stream index -> output stream index
+	pkts    chan av.Packet
+	done    chan struct{}
+	once    sync.Once
+	needKey bool
+	started bool
+	foreign bool // its video parameter sets differ from the output header
+	offset  time.Duration
+
+	last  atomic.Int64 // unix nano of the last packet (or of opening, before the first one)
+	first atomic.Int64 // unix nano of the first packet
+
+	// Real-time tracking (see track/steady): a source that delivers media faster than real
+	// time is replaying a backlog (e.g. an ingest that restarted on a stale HLS playlist) and
+	// must not be switched to; it would show old pictures for a few seconds and then vanish.
+	mu        sync.Mutex
+	hasBase   bool
+	baseMedia time.Duration
+	maxMedia  time.Duration
+	baseWall  time.Time
+}
+
+// burstTolerance is how far a source may run ahead of real time before it counts as a backlog.
+const burstTolerance = 1500 * time.Millisecond
+
+func (src *source) track(t time.Duration) {
+	now := time.Now()
+	src.mu.Lock()
+	defer src.mu.Unlock()
+	if !src.hasBase {
+		src.hasBase, src.baseMedia, src.maxMedia, src.baseWall = true, t, t, now
+		return
+	}
+	if t > src.maxMedia {
+		src.maxMedia = t
+	}
+	if (src.maxMedia-src.baseMedia)-now.Sub(src.baseWall) > burstTolerance {
+		src.baseMedia, src.baseWall = src.maxMedia, now
+	}
+}
+
+// steady reports for how long the source has been delivering at (about) real time.
+func (src *source) steady() time.Duration {
+	src.mu.Lock()
+	defer src.mu.Unlock()
+	if !src.hasBase {
+		return 0
+	}
+	return time.Since(src.baseWall)
+}
+
+func (src *source) stop() { src.once.Do(func() { close(src.done) }) }
+
+func (src *source) touch() {
+	now := time.Now().UnixNano()
+	src.last.Store(now)
+	src.first.CompareAndSwap(0, now)
+}
+
+func (src *source) idle() time.Duration { return time.Since(time.Unix(0, src.last.Load())) }
+
+// live reports for how long packets have been flowing, 0 if none arrived yet.
+func (src *source) live() time.Duration {
+	f := src.first.Load()
+	if f == 0 {
+		return 0
+	}
+	return time.Since(time.Unix(0, f))
+}
+
+type failoverDemuxer struct {
+	s         *server
+	cfg       FailoverConfig
+	primary   string
+	next      string   // where a seamlessly restarted primary publishes (NextPath)
+	fallbacks []string // candidates, preferred first
+	streams   []av.CodecData
+	videoIdx  int8
+
+	cur     *source
+	pending *source
+	stalled bool                 // the primary was given up because it stalled (it is still connected)
+	bad     map[string]time.Time // fallback candidates that were connected but silent
+
+	lastOut  map[int8]time.Duration
+	maxOut   time.Duration
+	lastWall time.Time
+	frame    time.Duration // last video frame duration
+	emitted  bool
+
+	ticker   *time.Ticker
+	onSwitch func(from, to string)
+	// reason says why the next switch happens; it is reported with the switch (logs).
+	reason string
+	// onNote reports decisions that are not a switch, e.g. a candidate that was passed over.
+	onNote func(msg string)
+}
+
+func (s *server) lookup(path string) *channel {
+	s.lock.RLock()
+	defer s.lock.RUnlock()
+	return s.channels[path]
+}
+
+// open subscribes to a channel at its live edge.
+func (d *failoverDemuxer) open(path string) *source {
+	ch := d.s.lookup(path)
+	if ch == nil || ch.queue == nil {
+		return nil
+	}
+	return openQueue(path, ch.queue)
+}
+
+func openQueue(path string, q *pubsub.Queue) *source {
+	cursor := q.Latest()
+	streams, err := cursor.Streams()
+	if err != nil {
+		return nil
+	}
+	src := &source{path: path, streams: streams, pkts: make(chan av.Packet, 512), done: make(chan struct{}), needKey: true}
+	src.last.Store(time.Now().UnixNano())
+	go func() {
+		defer close(src.pkts)
+		for {
+			pkt, err := cursor.ReadPacket()
+			if err != nil {
+				return
+			}
+			src.touch()
+			src.track(pkt.Time)
+			select {
+			case src.pkts <- pkt:
+			case <-src.done:
+				return
+			}
+		}
+	}()
+	return src
+}
+
+// bind maps the source's streams onto the output streams by codec type. It returns false
+// if the source is incompatible (different video codec) – switching to it would break
+// every -c copy egress.
+func (d *failoverDemuxer) bind(src *source) bool {
+	src.idxMap = map[int8]int8{}
+	used := map[int]bool{}
+	for si, sc := range src.streams {
+		for oi, oc := range d.streams {
+			if used[oi] || sc.Type() != oc.Type() {
+				continue
+			}
+			src.idxMap[int8(si)] = int8(oi)
+			used[oi] = true
+			break
+		}
+	}
+	if d.videoIdx >= 0 {
+		for _, oi := range src.idxMap {
+			if oi == d.videoIdx {
+				return true
+			}
+		}
+		return false
+	}
+	return len(src.idxMap) > 0
+}
+
+func newFailoverDemuxer(s *server, cfg FailoverConfig, primary string) *failoverDemuxer {
+	return &failoverDemuxer{
+		s: s, cfg: cfg, primary: primary, next: NextPath(primary), fallbacks: fallbackPaths(primary),
+		lastOut: map[int8]time.Duration{}, videoIdx: -1, bad: map[string]time.Time{},
+	}
+}
+
+// fbIndex returns the priority of a fallback path (0 = preferred), -1 if it is not one.
+func (d *failoverDemuxer) fbIndex(path string) int {
+	for i, p := range d.fallbacks {
+		if p == path {
+			return i
+		}
+	}
+	return -1
+}
+
+// isMain reports whether path is the channel's own stream: the primary, or its restarted
+// successor publishing under the "_next" name.
+func (d *failoverDemuxer) isMain(path string) bool { return path == d.primary || path == d.next }
+
+func (d *failoverDemuxer) markBad(path string) { d.bad[path] = time.Now().Add(badFor) }
+
+func (d *failoverDemuxer) note(msg string) {
+	if d.onNote != nil {
+		d.onNote(msg)
+	}
+}
+
+// Reason returns why the last switch happened.
+func (d *failoverDemuxer) Reason() string { return d.reason }
+
+// openFallback subscribes to the best usable fallback candidate other than skip. Candidates
+// that were connected but silent recently are passed over.
+func (d *failoverDemuxer) openFallback(skip string) *source {
+	for _, p := range d.fallbacks {
+		if p == skip {
+			continue
+		}
+		if until, ok := d.bad[p]; ok {
+			if time.Now().Before(until) {
+				continue
+			}
+			delete(d.bad, p)
+		}
+		src := d.open(p)
+		if src == nil {
+			continue
+		}
+		// Before the first source is chosen there is no output layout to bind to yet:
+		// Streams() takes the layout from whatever source it starts with.
+		if d.streams == nil || d.bind(src) {
+			return src
+		}
+		src.stop()
+	}
+	return nil
+}
+
+// Streams picks the initial source (primary preferred) and defines the output header.
+func (d *failoverDemuxer) Streams() ([]av.CodecData, error) {
+	if d.streams != nil {
+		return d.streams, nil
+	}
+	src := d.open(d.next)
+	if src == nil {
+		src = d.open(d.primary)
+	}
+	if src == nil {
+		src = d.openFallback("")
+	}
+	if src == nil {
+		return nil, io.EOF
+	}
+	d.streams = src.streams
+	for i, c := range d.streams {
+		if c.Type().IsVideo() {
+			d.videoIdx = int8(i)
+			break
+		}
+	}
+	d.bind(src)
+	d.cur = src
+	d.ticker = time.NewTicker(250 * time.Millisecond)
+	return d.streams, nil
+}
+
+func (d *failoverDemuxer) isKey(src *source, pkt av.Packet) bool {
+	if d.videoIdx < 0 {
+		return true // audio-only: any packet is a switch point
+	}
+	oi, ok := src.idxMap[pkt.Idx]
+	return ok && oi == d.videoIdx && pkt.IsKeyFrame
+}
+
+// emit maps one packet into the output timeline. ok=false means "drop".
+func (d *failoverDemuxer) emit(src *source, pkt av.Packet) (av.Packet, bool) {
+	oi, ok := src.idxMap[pkt.Idx]
+	if !ok {
+		return pkt, false
+	}
+	if src.needKey {
+		if !d.isKey(src, pkt) {
+			return pkt, false
+		}
+		src.needKey = false
+	}
+	now := time.Now()
+	if !src.started {
+		src.started = true
+		start := time.Duration(0)
+		if d.emitted {
+			// Continue the media timeline without a hole, one frame after the last packet.
+			// The wall-clock time that passed while nothing was sent (e.g. the stall
+			// detection) must not show up in the timestamps: HLS players (MSE) stop at a
+			// gap in the timeline and freeze on the last picture instead of showing the
+			// fallback, and RTMP receivers handle a late packet better than a jump.
+			start = d.maxOut + d.frameDur()
+		}
+		src.offset = start - pkt.Time
+		if oi == d.videoIdx && d.videoIdx >= 0 {
+			src.foreign = !sameParameterSets(src.streams[pkt.Idx], d.streams[d.videoIdx])
+		}
+	}
+	// A source with other parameter sets than the stream header (the slate, a backup stream,
+	// a re-encoded primary) carries its SPS/PPS on *every* keyframe: a decoder that starts
+	// in the middle (a viewer joining behind an RTMP relay, a seek) only has the header's.
+	if src.foreign && oi == d.videoIdx && pkt.IsKeyFrame {
+		pkt.Data = injectParameterSets(src.streams[pkt.Idx], pkt.Data)
+	}
+	out := pkt
+	out.Idx = oi
+	out.Time = pkt.Time + src.offset
+	if last, ok := d.lastOut[oi]; ok && out.Time <= last {
+		out.Time = last + time.Millisecond // keep DTS strictly increasing per stream
+	}
+	if oi == d.videoIdx {
+		if last, ok := d.lastOut[oi]; ok {
+			if delta := out.Time - last; delta > 0 && delta < 200*time.Millisecond {
+				d.frame = delta
+			}
+		}
+	}
+	d.lastOut[oi] = out.Time
+	if out.Time > d.maxOut {
+		d.maxOut = out.Time
+	}
+	d.lastWall = now
+	d.emitted = true
+	return out, true
+}
+
+// frameDur is the last seen video frame duration (40 ms until one was seen).
+func (d *failoverDemuxer) frameDur() time.Duration {
+	if d.frame > 0 {
+		return d.frame
+	}
+	return 40 * time.Millisecond
+}
+
+func (d *failoverDemuxer) switchTo(src *source) {
+	from := ""
+	if d.cur != nil {
+		from = d.cur.path
+		d.cur.stop()
+	}
+	d.cur = src
+	if d.isMain(src.path) {
+		d.stalled = false
+	}
+	if d.onSwitch != nil {
+		d.onSwitch(from, src.path)
+	}
+}
+
+// waitForSource polls for primary, then fallback, for up to Grace.
+func (d *failoverDemuxer) waitForSource() *source {
+	deadline := time.Now().Add(d.cfg.Grace)
+	for {
+		for _, p := range append([]string{d.next, d.primary}, d.fallbacks...) {
+			if src := d.open(p); src != nil {
+				if d.bind(src) {
+					return src
+				}
+				src.stop()
+			}
+		}
+		if time.Now().After(deadline) {
+			return nil
+		}
+		time.Sleep(100 * time.Millisecond)
+	}
+}
+
+func (d *failoverDemuxer) ReadPacket() (av.Packet, error) {
+	if d.streams == nil {
+		if _, err := d.Streams(); err != nil {
+			return av.Packet{}, err
+		}
+	}
+	for {
+		var pending <-chan av.Packet
+		if d.pending != nil {
+			pending = d.pending.pkts
+		}
+		select {
+		case pkt, ok := <-d.cur.pkts:
+			if !ok { // current publisher stopped
+				d.cur.stop()
+				d.reason = "publisher disconnected"
+				next := d.pending
+				d.pending = nil
+				if next == nil {
+					next = d.waitForSource()
+				}
+				if next == nil {
+					d.Close()
+					return av.Packet{}, io.EOF
+				}
+				d.switchTo(next)
+				continue
+			}
+			if out, ok := d.emit(d.cur, pkt); ok {
+				return out, nil
+			}
+		case pkt, ok := <-pending:
+			if !ok {
+				d.pending.stop()
+				d.pending = nil
+				continue
+			}
+			if d.isKey(d.pending, pkt) && d.pendingReady() {
+				next := d.pending
+				d.pending = nil
+				d.switchTo(next)
+				if out, ok := d.emit(d.cur, pkt); ok {
+					return out, nil
+				}
+			}
+		case <-d.ticker.C:
+			d.checkHandover()
+			d.checkStall()
+			d.checkRecovery()
+			d.checkUpgrade()
+		}
+	}
+}
+
+// pendingBusy reports whether the pending source must be left alone: a fallback we are
+// switching to, or a primary that is already delivering packets. A primary that is merely
+// being listened on (stalled, still silent) does not block the candidate chain.
+func (d *failoverDemuxer) pendingBusy() bool {
+	return d.pending != nil && (d.pending.path != d.primary || d.pending.first.Load() != 0)
+}
+
+// checkStall moves to a fallback when the current source is still connected but silent
+// (the primary), or on to the next candidate when a fallback itself went silent. The
+// switch happens at the new source's next keyframe (the "pending" mechanism).
+func (d *failoverDemuxer) checkStall() {
+	if d.cur == nil {
+		return
+	}
+	d.dropSilentPending()
+	idle := d.cur.idle()
+	if d.pendingBusy() {
+		// The primary came back before the fallback's keyframe arrived: stay.
+		if d.isMain(d.cur.path) && !d.isMain(d.pending.path) && d.cfg.Stall > 0 && idle < d.cfg.Stall/2 {
+			d.pending.stop()
+			d.pending = nil
+		}
+		return
+	}
+	if d.cfg.Stall <= 0 || idle < d.cfg.Stall {
+		return
+	}
+	if d.fbIndex(d.cur.path) >= 0 {
+		d.markBad(d.cur.path) // a silent fallback is not worth coming back to right away
+	}
+	src := d.openFallback(d.cur.path)
+	if src == nil {
+		return // nothing to switch to; keep waiting
+	}
+	if d.pending != nil {
+		d.pending.stop() // the silent primary; checkRecovery listens on it again later
+	}
+	d.pending = src
+	d.reason = "no data for " + idle.Round(100*time.Millisecond).String()
+	if d.isMain(d.cur.path) {
+		d.stalled = true
+	}
+}
+
+// silentFor is the time after which a candidate that delivers nothing is passed over.
+func (d *failoverDemuxer) silentFor() time.Duration {
+	if d.cfg.Stall > 0 {
+		return d.cfg.Stall / 2
+	}
+	return 1500 * time.Millisecond
+}
+
+// dropSilentPending gives up on a pending fallback that is connected but not delivering,
+// e.g. a backup-stream process whose input is gone, and remembers it as bad for a while so
+// the next candidate gets its turn.
+func (d *failoverDemuxer) dropSilentPending() {
+	if d.pending == nil || d.fbIndex(d.pending.path) < 0 {
+		return
+	}
+	if d.pending.idle() >= d.silentFor() {
+		d.note("passed over " + d.pending.path + ": connected but no data")
+		d.markBad(d.pending.path)
+		d.pending.stop()
+		d.pending = nil
+	}
+}
+
+// pendingReady gates a switch that must not happen on the first keyframe: back to the
+// primary and up from a lower to a higher priority fallback. The new source has to deliver
+// at real time for RecoverAfter first. Otherwise a flapping source would bounce the viewers
+// between two streams, and a source replaying a backlog would show old pictures.
+func (d *failoverDemuxer) pendingReady() bool {
+	if d.pending == nil {
+		return true
+	}
+	if d.isMain(d.pending.path) && d.isMain(d.cur.path) {
+		return d.pending.steady() >= HandoverAfter
+	}
+	if d.pending.path == d.next {
+		return d.pending.steady() >= HandoverAfter
+	}
+	if d.pending.path == d.primary {
+		return d.pending.steady() >= d.cfg.RecoverAfter
+	}
+	if pi, ci := d.fbIndex(d.pending.path), d.fbIndex(d.cur.path); pi >= 0 && ci >= 0 && pi < ci {
+		return d.pending.steady() >= d.cfg.RecoverAfter
+	}
+	return true
+}
+
+// checkUpgrade moves from a lower to a higher priority fallback (e.g. from the slate back
+// to the backup stream) once the better one is available.
+func (d *failoverDemuxer) checkUpgrade() {
+	if d.pendingBusy() {
+		return
+	}
+	ci := d.fbIndex(d.cur.path)
+	for i := 0; i < ci; i++ {
+		p := d.fallbacks[i]
+		if until, ok := d.bad[p]; ok && time.Now().Before(until) {
+			continue
+		}
+		if d.s.lookup(p) == nil {
+			continue
+		}
+		if src := d.open(p); src != nil {
+			if d.bind(src) {
+				if d.pending != nil {
+					d.pending.stop() // the silent primary; checkRecovery listens on it again later
+				}
+				d.pending = src
+				d.reason = "preferred fallback is available again"
+				return
+			}
+			src.stop()
+		}
+	}
+}
+
+// checkHandover follows a seamless restart: the restarted process publishes under the other
+// of the two main names (primary / "_next") while the old one still runs. The newer
+// publisher wins; pendingReady lets the switch happen once it runs at real time. The old
+// publisher of a finished handover is older, so the player never goes back to it.
+func (d *failoverDemuxer) checkHandover() {
+	other := d.next
+	if d.cur.path == d.next {
+		other = d.primary
+	}
+	if d.pending != nil && d.pending.path == other {
+		return
+	}
+	och := d.s.lookup(other)
+	if och == nil {
+		return
+	}
+	if d.isMain(d.cur.path) {
+		cch := d.s.lookup(d.cur.path)
+		if cch == nil || !och.since.After(cch.since) {
+			return
+		}
+	} else if other != d.next {
+		return // on a fallback, the primary's return is checkRecovery's business
+	}
+	src := d.open(other)
+	if src == nil {
+		return
+	}
+	if !d.bind(src) {
+		src.stop()
+		return
+	}
+	if d.pending != nil {
+		d.pending.stop()
+	}
+	d.pending = src
+	d.reason = "restarted with new settings"
+}
+
+// checkRecovery listens on the primary (pending) while a fallback plays, as soon as the
+// primary publishes again. pendingReady decides when it is good enough to switch back; the
+// switch itself happens on its next keyframe.
+func (d *failoverDemuxer) checkRecovery() {
+	// On the "_next" stream the old primary may still publish until it is stopped: never
+	// go back to it.
+	if d.isMain(d.cur.path) || d.pending != nil {
+		return
+	}
+	if d.s.lookup(d.primary) == nil {
+		return
+	}
+	if src := d.open(d.primary); src != nil {
+		if d.bind(src) {
+			d.pending = src
+			d.reason = "primary is back"
+		} else {
+			src.stop()
+		}
+	}
+}
+
+func (d *failoverDemuxer) Close() {
+	if d.cur != nil {
+		d.cur.stop()
+	}
+	if d.pending != nil {
+		d.pending.stop()
+	}
+	if d.ticker != nil {
+		d.ticker.Stop()
+	}
+}
+
+// metadata returns the AMF metadata of whichever channel exists.
+func (d *failoverDemuxer) metadata() flvio.AMFMap {
+	for _, p := range append([]string{d.primary, d.next}, d.fallbacks...) {
+		if ch := d.s.lookup(p); ch != nil {
+			return ch.metadata
+		}
+	}
+	return nil
+}
+
+// sameParameterSets reports whether two H.264 codecs have identical SPS and PPS.
+func sameParameterSets(a, b av.CodecData) bool {
+	ha, ok1 := a.(h264parser.CodecData)
+	hb, ok2 := b.(h264parser.CodecData)
+	if !ok1 || !ok2 {
+		return true // not H.264: nothing to inject
+	}
+	return bytes.Equal(ha.SPS(), hb.SPS()) && bytes.Equal(ha.PPS(), hb.PPS())
+}
+
+// injectParameterSets prepends the source's SPS/PPS as length-prefixed NAL units to an
+// AVCC keyframe. Decoders (and CDNs) accept in-band parameter sets, so a switch between
+// sources with slightly different encoder settings still decodes cleanly.
+func injectParameterSets(codec av.CodecData, data []byte) []byte {
+	h, ok := codec.(h264parser.CodecData)
+	if !ok {
+		return data
+	}
+	sps, pps := h.SPS(), h.PPS()
+	if len(sps) == 0 || len(pps) == 0 {
+		return data
+	}
+	rec := h.AVCDecoderConfRecordBytes()
+	lenSize := 4
+	if len(rec) > 4 {
+		lenSize = int(rec[4]&3) + 1
+	}
+	if lenSize != 4 && lenSize != 2 {
+		return data
+	}
+	out := make([]byte, 0, len(sps)+len(pps)+2*lenSize+len(data))
+	put := func(nal []byte) {
+		if lenSize == 4 {
+			out = binary.BigEndian.AppendUint32(out, uint32(len(nal)))
+		} else {
+			out = binary.BigEndian.AppendUint16(out, uint16(len(nal)))
+		}
+		out = append(out, nal...)
+	}
+	put(sps)
+	put(pps)
+	return append(out, data...)
+}
