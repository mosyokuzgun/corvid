new file mode 100644
index 0000000..79dd73c
--- /dev/null
+++ b/http/jwt/guard.go
@@ -0,0 +1,121 @@
+package jwt
+
+import (
+	"sync"
+	"time"
+)
+
+// loginGuard stops password guessing (fork): after too many wrong logins from one address,
+// further attempts from that address are refused for a while. Upstream only slept 5 s per
+// wrong attempt, which does not slow down a client that tries in parallel.
+type loginGuard struct {
+	max    int           // wrong attempts allowed within window
+	window time.Duration // attempts older than this are forgotten
+	block  time.Duration // how long an address stays locked out
+	limit  int           // addresses remembered at most
+
+	lock    sync.Mutex
+	entries map[string]*guardEntry
+	now     func() time.Time
+}
+
+type guardEntry struct {
+	failures []time.Time
+	until    time.Time
+}
+
+func newLoginGuard(max int, window, block time.Duration) *loginGuard {
+	return &loginGuard{
+		max:     max,
+		window:  window,
+		block:   block,
+		limit:   10000,
+		entries: map[string]*guardEntry{},
+		now:     time.Now,
+	}
+}
+
+// blockedFor returns how long the address is still locked out, 0 if it may try.
+func (g *loginGuard) blockedFor(addr string) time.Duration {
+	g.lock.Lock()
+	defer g.lock.Unlock()
+
+	e, ok := g.entries[addr]
+	if !ok {
+		return 0
+	}
+
+	if d := e.until.Sub(g.now()); d > 0 {
+		return d
+	}
+
+	return 0
+}
+
+// fail records a wrong attempt. It returns true if this attempt locked the address out.
+func (g *loginGuard) fail(addr string) bool {
+	g.lock.Lock()
+	defer g.lock.Unlock()
+
+	now := g.now()
+
+	e, ok := g.entries[addr]
+	if !ok {
+		if len(g.entries) >= g.limit {
+			g.prune(now)
+		}
+		if len(g.entries) >= g.limit {
+			// Under a flood from many addresses: forget everything that is not locked out
+			// rather than grow without bound.
+			for k, v := range g.entries {
+				if !v.until.After(now) {
+					delete(g.entries, k)
+				}
+			}
+		}
+		e = &guardEntry{}
+		g.entries[addr] = e
+	}
+
+	recent := e.failures[:0]
+	for _, t := range e.failures {
+		if now.Sub(t) < g.window {
+			recent = append(recent, t)
+		}
+	}
+	e.failures = append(recent, now)
+
+	if len(e.failures) >= g.max {
+		e.failures = nil
+		e.until = now.Add(g.block)
+		return true
+	}
+
+	return false
+}
+
+// success forgets the wrong attempts of an address.
+func (g *loginGuard) success(addr string) {
+	g.lock.Lock()
+	defer g.lock.Unlock()
+
+	delete(g.entries, addr)
+}
+
+func (g *loginGuard) prune(now time.Time) {
+	for k, e := range g.entries {
+		if e.until.After(now) {
+			continue
+		}
+		live := false
+		for _, t := range e.failures {
+			if now.Sub(t) < g.window {
+				live = true
+				break
+			}
+		}
+		if !live {
+			delete(g.entries, k)
+		}
+	}
+}
diff --git a/http/jwt/guard_test.go b/http/jwt/guard_test.go
new file mode 100644
index 0000000..71c9cb3
--- /dev/null
+++ b/http/jwt/guard_test.go
@@ -0,0 +1,56 @@
+package jwt
+
+import (
+	"fmt"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestLoginGuard(t *testing.T) {
+	now := time.Date(2026, 11, 14, 10, 0, 0, 0, time.UTC)
+	g := newLoginGuard(5, 15*time.Minute, 15*time.Minute)
+	g.now = func() time.Time { return now }
+
+	for i := 0; i < 4; i++ {
+		require.False(t, g.fail("1.2.3.4"))
+		require.Zero(t, g.blockedFor("1.2.3.4"))
+	}
+	require.True(t, g.fail("1.2.3.4"), "the fifth wrong attempt locks the address out")
+	require.Equal(t, 15*time.Minute, g.blockedFor("1.2.3.4"))
+	require.Zero(t, g.blockedFor("5.6.7.8"), "other addresses are not affected")
+
+	now = now.Add(15*time.Minute + time.Second)
+	require.Zero(t, g.blockedFor("1.2.3.4"))
+	require.False(t, g.fail("1.2.3.4"), "the count starts over after the lockout")
+}
+
+func TestLoginGuardWindowAndSuccess(t *testing.T) {
+	now := time.Date(2026, 11, 14, 10, 0, 0, 0, time.UTC)
+	g := newLoginGuard(5, 15*time.Minute, 15*time.Minute)
+	g.now = func() time.Time { return now }
+
+	for i := 0; i < 4; i++ {
+		g.fail("a")
+	}
+	now = now.Add(16 * time.Minute)
+	require.False(t, g.fail("a"), "old attempts are forgotten")
+
+	for i := 0; i < 3; i++ {
+		g.fail("b")
+	}
+	g.success("b")
+	for i := 0; i < 4; i++ {
+		require.False(t, g.fail("b"), "a correct login clears the count")
+	}
+}
+
+func TestLoginGuardBounded(t *testing.T) {
+	g := newLoginGuard(5, 15*time.Minute, 15*time.Minute)
+	g.limit = 100
+	for i := 0; i < 1000; i++ {
+		g.fail(fmt.Sprintf("10.0.%d.%d", i/250, i%250))
+	}
+	require.LessOrEqual(t, len(g.entries), 100)
+}
