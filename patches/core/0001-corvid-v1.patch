+func codecs(t *testing.T) []av.CodecData {
+	sps, _ := hex.DecodeString("6764000dacd94141fb011000000300100000030320f1429960")
+	pps, _ := hex.DecodeString("68ef8fcb")
+	v, err := h264parser.NewCodecDataFromSPSAndPPS(sps, pps)
+	if err != nil {
+		t.Fatal(err)
+	}
+	a, err := aacparser.NewCodecDataFromMPEG4AudioConfigBytes([]byte{0x11, 0x90})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return []av.CodecData{v, a}
+}
+
+// publisher writes 25 fps video (keyframe every 5 frames) + audio at real time, tagging payloads.
+func publisher(q *pubsub.Queue, tag byte, base time.Duration, stop *atomic.Bool) {
+	for n := 0; !stop.Load(); n++ {
+		ts := base + time.Duration(n)*40*time.Millisecond
+		q.WritePacket(av.Packet{Idx: 0, Time: ts, IsKeyFrame: n%5 == 0, Data: []byte{0, 0, 0, 1, tag}})
+		q.WritePacket(av.Packet{Idx: 1, Time: ts, Data: []byte{tag}})
+		time.Sleep(40 * time.Millisecond)
+	}
+}
+
+// burst writes d of media at speed× real time (a backlog being replayed), then nothing.
+func burst(q *pubsub.Queue, tag byte, base, d time.Duration, speed int) {
+	for n := 0; time.Duration(n)*40*time.Millisecond < d; n++ {
+		ts := base + time.Duration(n)*40*time.Millisecond
+		q.WritePacket(av.Packet{Idx: 0, Time: ts, IsKeyFrame: n%5 == 0, Data: []byte{0, 0, 0, 1, tag}})
+		q.WritePacket(av.Packet{Idx: 1, Time: ts, Data: []byte{tag}})
+		time.Sleep(40 * time.Millisecond / time.Duration(speed))
+	}
+}
+
+func addChannel(s *server, path string, cd []av.CodecData) *pubsub.Queue {
+	q := pubsub.NewQueue()
+	q.WriteHeader(cd)
+	s.lock.Lock()
+	s.channels[path] = &channel{queue: q, path: path, hasVideo: true, hasAudio: true, since: time.Now()}
+	s.lock.Unlock()
+	return q
+}
+
+func removeChannel(s *server, path string, q *pubsub.Queue) {
+	s.lock.Lock()
+	delete(s.channels, path)
+	s.lock.Unlock()
+	q.Close()
+}
