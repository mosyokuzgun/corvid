@@ -0,0 +1,38 @@
+package api
+
+import (
+	"net/http"
+
+	"github.com/datarhei/core/v16/gpu"
+
+	"github.com/labstack/echo/v4"
+)
+
+// GPUHandler exposes the NVIDIA GPU monitor and the scheduling decisions of the balancer.
+type GPUHandler struct {
+	balancer *gpu.Balancer
+}
+
+func NewGPU(b *gpu.Balancer) *GPUHandler { return &GPUHandler{balancer: b} }
+
+// GPUInfo is the response of GET /api/v3/gpu.
+type GPUInfo struct {
+	Enabled    bool            `json:"enabled"`
+	Candidates []gpu.Candidate `json:"gpus"`
+}
+
+// List returns all GPUs with live metrics, ordered by the balancer's preference.
+// @Summary List NVIDIA GPUs
+// @Description Live GPU metrics (temperature, VRAM, NVENC/NVDEC usage, sessions) and the order in which the balancer assigns {gpu}.
+// @Tags v16.nvidia
+// @ID gpu-3-list
+// @Produce json
+// @Success 200 {object} GPUInfo
+// @Security ApiKeyAuth
+// @Router /api/v3/gpu [get]
+func (h *GPUHandler) List(c echo.Context) error {
+	if h.balancer == nil {
+		return c.JSON(http.StatusOK, GPUInfo{Enabled: false, Candidates: []gpu.Candidate{}})
+	}
+	return c.JSON(http.StatusOK, GPUInfo{Enabled: true, Candidates: h.balancer.Explain()})
+}
diff --git a/http/handler/api/reach.go b/http/handler/api/reach.go
new file mode 100644
index 0000000..5656d98
--- /dev/null
+++ b/http/handler/api/reach.go
@@ -0,0 +1,171 @@
+package api
+
+import (
+	"context"
+	"net"
+	"net/http"
+	"regexp"
+	"sort"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/datarhei/core/v16/http/api"
+	"github.com/datarhei/core/v16/http/handler/util"
+
+	"github.com/labstack/echo/v4"
+)
+
+// Reach (fork): can this server reach the places a process sends to? Used by the panel's
+// check before a broadcast. Only the outputs of an existing process are tried, the caller
+// cannot make the server connect anywhere else.
+
+// ReachResult is the outcome for one destination.
+type ReachResult struct {
+	Target   string `json:"target"`   // host:port, never the path (which holds the stream key)
+	Protocol string `json:"protocol"` // rtmp, rtmps, srt, http, https, rtsp
+	Resolved bool   `json:"resolved"` // the name has an address
+	Reached  bool   `json:"reached"`  // a connection was accepted (always false for SRT, which is UDP)
+	Checked  string `json:"checked"`  // "connect" or "name" (UDP: only the name can be checked)
+	Millis   int64  `json:"ms"`
+	Error    string `json:"error,omitempty"`
+}
+
+type reachTarget struct {
+	protocol string
+	host     string
+	port     string
+}
+
+var reachURL = regexp.MustCompile(`(?i)\b(rtmps?|srt|https?|rtsp)://([^\s/|'"\]?#]+)`)
+
+var reachPorts = map[string]string{"rtmp": "1935", "rtmps": "443", "srt": "", "http": "80", "https": "443", "rtsp": "554"}
+
+// reachTargets finds the remote destinations in output addresses (plain or tee muxer form).
+func reachTargets(addresses []string) []reachTarget {
+	seen := map[string]bool{}
+	targets := []reachTarget{}
+
+	for _, address := range addresses {
+		for _, m := range reachURL.FindAllStringSubmatch(address, -1) {
+			protocol := strings.ToLower(m[1])
+			hostport := m[2]
+
+			// user:password@host
+			if i := strings.LastIndex(hostport, "@"); i != -1 {
+				hostport = hostport[i+1:]
+			}
+
+			host, port, err := net.SplitHostPort(hostport)
+			if err != nil {
+				host, port = strings.Trim(hostport, "[]"), reachPorts[protocol]
+			}
+
+			if host == "" || strings.ContainsAny(host, "{}") {
+				continue // a placeholder of the core, i.e. this server itself
+			}
+
+			if host == "localhost" {
+				continue
+			}
+			if ip := net.ParseIP(host); ip != nil && ip.IsLoopback() {
+				continue
+			}
+
+			key := protocol + "|" + host + "|" + port
+			if seen[key] {
+				continue
+			}
+			seen[key] = true
+
+			targets = append(targets, reachTarget{protocol: protocol, host: host, port: port})
+		}
+	}
+
+	return targets
+}
+
+func reachOne(ctx context.Context, t reachTarget) ReachResult {
+	r := ReachResult{Protocol: t.protocol, Target: t.host, Checked: "connect"}
+	if t.port != "" {
+		r.Target = net.JoinHostPort(t.host, t.port)
+	}
+
+	start := time.Now()
+	defer func() { r.Millis = time.Since(start).Milliseconds() }()
+
+	addrs, err := net.DefaultResolver.LookupHost(ctx, t.host)
+	if err != nil || len(addrs) == 0 {
+		r.Error = "name not found"
+		return r
+	}
+	r.Resolved = true
+
+	if t.protocol == "srt" || t.port == "" {
+		// UDP has no connection to try without speaking the protocol.
+		r.Checked = "name"
+		return r
+	}
+
+	d := net.Dialer{}
+	conn, err := d.DialContext(ctx, "tcp", net.JoinHostPort(t.host, t.port))
+	if err != nil {
+		r.Error = "no connection"
+		if ctx.Err() != nil {
+			r.Error = "timeout"
+		}
+		return r
+	}
+	conn.Close()
+	r.Reached = true
+
+	return r
+}
+
+// Reach tries the destinations of a process
+// @Summary Check whether the outputs of a process can be reached
+// @Description Resolve the name and open a TCP connection to every remote output of a process.
+// @ID process-3-reach
+// @Produce json
+// @Param id path string true "Process ID"
+// @Success 200 {array} ReachResult
+// @Failure 404 {object} api.Error
+// @Security ApiKeyAuth
+// @Router /api/v3/process/{id}/reach [get]
+func (h *RestreamHandler) Reach(c echo.Context) error {
+	id := util.PathParam(c, "id")
+
+	p, err := h.restream.GetProcess(id)
+	if err != nil {
+		return api.Err(http.StatusNotFound, "Unknown process ID", "%s", err)
+	}
+
+	addresses := []string{}
+	for _, o := range p.Config.Output {
+		addresses = append(addresses, o.Address)
+	}
+
+	targets := reachTargets(addresses)
+	if len(targets) > 8 {
+		targets = targets[:8]
+	}
+
+	results := make([]ReachResult, len(targets))
+
+	ctx, cancel := context.WithTimeout(c.Request().Context(), 4*time.Second)
+	defer cancel()
+
+	wg := sync.WaitGroup{}
+	for i, t := range targets {
+		wg.Add(1)
+		go func(i int, t reachTarget) {
+			defer wg.Done()
+			results[i] = reachOne(ctx, t)
+		}(i, t)
+	}
+	wg.Wait()
+
+	sort.SliceStable(results, func(a, b int) bool { return results[a].Target < results[b].Target })
+
+	return c.JSON(http.StatusOK, results)
+}
diff --git a/http/handler/api/reach_test.go b/http/handler/api/reach_test.go
new file mode 100644
index 0000000..e123d20
--- /dev/null
+++ b/http/handler/api/reach_test.go
@@ -0,0 +1,61 @@
+package api
+
+import (
+	"context"
+	"net"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestReachTargets(t *testing.T) {
+	targets := reachTargets([]string{
+		"rtmp://a.rtmp.youtube.com/live2/secret-key",
+		"[f=flv]rtmps://live-api-s.facebook.com:443/rtmp/KEY|[f=flv]rtmp://b.rtmp.youtube.com/live2/secret-key?backup=1",
+		"srt://user:pw@relay.example.org:9000?streamid=abc",
+		"{rtmp,name=abc.stream}",
+		"rtmp://localhost:1935/live/abc.stream?token=x",
+		"rtmp://127.0.0.1/live/abc",
+		"{memfs}/abc.m3u8",
+		"rtmp://a.rtmp.youtube.com/live2/other-key",
+		"-",
+	})
+
+	require.Equal(t, []reachTarget{
+		{"rtmp", "a.rtmp.youtube.com", "1935"},
+		{"rtmps", "live-api-s.facebook.com", "443"},
+		{"rtmp", "b.rtmp.youtube.com", "1935"},
+		{"srt", "relay.example.org", "9000"},
+	}, targets)
+}
+
+func TestReachOne(t *testing.T) {
+	l, err := net.Listen("tcp", "127.0.0.1:0")
+	require.NoError(t, err)
+	defer l.Close()
+	_, port, _ := net.SplitHostPort(l.Addr().String())
+
+	ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+	defer cancel()
+
+	r := reachOne(ctx, reachTarget{"rtmp", "127.0.0.1", port})
+	require.True(t, r.Resolved)
+	require.True(t, r.Reached)
+	require.Equal(t, "127.0.0.1:"+port, r.Target)
+
+	l.Close()
+	r = reachOne(ctx, reachTarget{"rtmp", "127.0.0.1", port})
+	require.True(t, r.Resolved)
+	require.False(t, r.Reached)
+	require.Equal(t, "no connection", r.Error)
+
+	r = reachOne(ctx, reachTarget{"rtmp", "does-not-exist.invalid", "1935"})
+	require.False(t, r.Resolved)
+	require.Equal(t, "name not found", r.Error)
+
+	r = reachOne(ctx, reachTarget{"srt", "127.0.0.1", "9000"})
+	require.True(t, r.Resolved)
+	require.False(t, r.Reached)
+	require.Equal(t, "name", r.Checked)
+}
diff --git a/http/handler/api/users.go b/http/handler/api/users.go
new file mode 100644
index 0000000..f17c862
--- /dev/null
+++ b/http/handler/api/users.go
@@ -0,0 +1,102 @@
+package api
+
+import (
+	"encoding/json"
+	"net/http"
+
+	"github.com/datarhei/core/v16/http/api"
+	"github.com/datarhei/core/v16/http/handler/util"
+	"github.com/datarhei/core/v16/seal"
+	"github.com/datarhei/core/v16/users"
+
+	jwtgo "github.com/golang-jwt/jwt/v5"
+	"github.com/labstack/echo/v4"
+)
+
+// UsersHandler manages the additional accounts and seals configuration exports (fork).
+type UsersHandler struct {
+	users *users.Store
+}
+
+func NewUsers(store *users.Store) *UsersHandler {
+	return &UsersHandler{users: store}
+}
+
+// Me returns the logged-in account and its role.
+func (h *UsersHandler) Me(c echo.Context) error {
+	name := ""
+	if token, ok := c.Get("user").(*jwtgo.Token); ok && token != nil {
+		name, _ = token.Claims.GetSubject()
+	}
+	role, _ := c.Get("role").(string)
+	if role == "" {
+		role = users.Admin
+	}
+	return c.JSON(http.StatusOK, users.User{Name: name, Role: role})
+}
+
+// List returns all accounts (without passwords).
+func (h *UsersHandler) List(c echo.Context) error {
+	return c.JSON(http.StatusOK, h.users.List())
+}
+
+type userSet struct {
+	Role     string `json:"role"`
+	Password string `json:"password"`
+}
+
+// Set creates an account or changes its role and/or password.
+func (h *UsersHandler) Set(c echo.Context) error {
+	var req userSet
+	if err := util.ShouldBindJSON(c, &req); err != nil {
+		return api.Err(http.StatusBadRequest, "", "Invalid JSON: %s", err.Error())
+	}
+	if err := h.users.Set(util.PathParam(c, "name"), req.Role, req.Password); err != nil {
+		return api.Err(http.StatusBadRequest, "", "%s", err.Error())
+	}
+	return c.JSON(http.StatusOK, h.users.List())
+}
+
+// Delete removes an account.
+func (h *UsersHandler) Delete(c echo.Context) error {
+	if err := h.users.Delete(util.PathParam(c, "name")); err != nil {
+		return api.Err(http.StatusBadRequest, "", "%s", err.Error())
+	}
+	return c.JSON(http.StatusOK, h.users.List())
+}
+
+type sealRequest struct {
+	Password string          `json:"password"`
+	Data     json.RawMessage `json:"data"`
+}
+
+type unsealRequest struct {
+	Password string         `json:"password"`
+	Sealed   *seal.Envelope `json:"sealed"`
+}
+
+// Seal encrypts a configuration export with a password.
+func (h *UsersHandler) Seal(c echo.Context) error {
+	var req sealRequest
+	if err := util.ShouldBindJSON(c, &req); err != nil {
+		return api.Err(http.StatusBadRequest, "", "Invalid JSON: %s", err.Error())
+	}
+	e, err := seal.Seal(req.Password, req.Data)
+	if err != nil {
+		return api.Err(http.StatusBadRequest, "", "%s", err.Error())
+	}
+	return c.JSON(http.StatusOK, e)
+}
+
+// Unseal decrypts a sealed configuration export.
+func (h *UsersHandler) Unseal(c echo.Context) error {
+	var req unsealRequest
+	if err := util.ShouldBindJSON(c, &req); err != nil {
+		return api.Err(http.StatusBadRequest, "", "Invalid JSON: %s", err.Error())
+	}
+	data, err := seal.Open(req.Password, req.Sealed)
+	if err != nil {
+		return api.Err(http.StatusBadRequest, "", "%s", err.Error())
+	}
+	return c.JSONBlob(http.StatusOK, data)
+}
