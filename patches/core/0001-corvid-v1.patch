+// chain drives a demuxer and reports which tag it reads.
+type chain struct {
+	t    *testing.T
+	d    *failoverDemuxer
+	last map[int8]time.Duration
+}
+
+func (c *chain) read(want byte, n int) {
+	c.t.Helper()
+	got := 0
+	deadline := time.Now().Add(8 * time.Second)
+	for got < n {
+		if time.Now().After(deadline) {
+			c.t.Fatalf("timeout waiting for %c", want)
+		}
+		pkt, err := c.d.ReadPacket()
+		if err != nil {
+			c.t.Fatal(err)
+		}
+		if pkt.Time < c.last[pkt.Idx] {
+			c.t.Fatalf("non-monotonic ts on stream %d", pkt.Idx)
+		}
+		c.last[pkt.Idx] = pkt.Time
+		if pkt.Data[len(pkt.Data)-1] == want {
+			got++
+		}
+	}
+}
