diff --git a/restream/fileaccess.go b/restream/fileaccess.go
new file mode 100644
index 0000000..cce043e
--- /dev/null
+++ b/restream/fileaccess.go
@@ -0,0 +1,108 @@
+package restream
+
+// FFmpeg file access (fork). FFmpeg can open any file the core can: an input
+// "/core/config/config.json", a filter like movie=, drawtext=textfile= or subtitles= on the
+// same file, or a "file:" URL would put the configuration (passwords, keys) into a picture or
+// a stream. Output files are already kept inside the data directory by validateOutputAddress.
+//
+// Here: every absolute path in a process's inputs and options must be inside the data
+// directory, /dev (cameras, sound cards) or the system fonts, unless its top-level directory
+// does not exist on this machine (then it is no file, e.g. "/memfs/" in an option). Paths
+// with ".." are refused, and FFmpeg runs in the data directory, so relative paths stay there.
+// CORE_FFMPEG_FILE_ACCESS=open switches this off.
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"regexp"
+	"strings"
+
+	"github.com/datarhei/core/v16/restream/app"
+)
+
+var pathToken = regexp.MustCompile(`(?:^|[='"\s:;,\[(])(/[^'"\s:;,\[\]|()]*)`)
+
+func fileAccessOpen() bool {
+	return strings.EqualFold(os.Getenv("CORE_FFMPEG_FILE_ACCESS"), "open")
+}
+
+// fileRoots are the directories FFmpeg may read from.
+func (r *restream) fileRoots() []string {
+	roots := []string{"/dev", "/usr/share/fonts", "/usr/local/share/fonts"}
+	for _, fs := range r.fs.diskfs {
+		if base := fs.Metadata("base"); base != "" {
+			roots = append(roots, filepath.Clean(base))
+		}
+	}
+	return roots
+}
+
+func insideRoots(p string, roots []string) bool {
+	for _, root := range roots {
+		if p == root || strings.HasPrefix(p, root+"/") {
+			return true
+		}
+	}
+	return false
+}
+
+// checkPaths returns an error for the first path in s FFmpeg must not open.
+func checkPaths(s string, roots []string) error {
+	if strings.Contains(s, "../") || strings.HasSuffix(s, "/..") || s == ".." {
+		return fmt.Errorf("paths with \"..\" are not allowed: %s", s)
+	}
+	for _, m := range pathToken.FindAllStringSubmatch(s, -1) {
+		p := m[1]
+		if strings.HasPrefix(p, "//") && !strings.HasPrefix(p, "///") {
+			continue // the host part of an URL ("rtmp://host/...")
+		}
+		p = filepath.Clean(p)
+		if p == "/" || insideRoots(p, roots) {
+			continue
+		}
+		top := "/" + strings.SplitN(strings.TrimPrefix(p, "/"), "/", 2)[0]
+		if _, err := os.Stat(top); err != nil {
+			continue // no such directory here: not a file
+		}
+		return fmt.Errorf("FFmpeg may only open files in the data directory, not %s", p)
+	}
+	return nil
+}
+
+// checkFileAccess checks the inputs and all options of a process (after its placeholders are
+// resolved).
+func (r *restream) checkFileAccess(config *app.Config) error {
+	if fileAccessOpen() || r.ffmpegDir() == "" {
+		return nil // no data directory to keep FFmpeg in
+	}
+	roots := r.fileRoots()
+	values := append([]string{}, config.Options...)
+	for _, io := range config.Input {
+		values = append(values, io.Address)
+		values = append(values, io.Options...)
+	}
+	for _, io := range config.Output {
+		values = append(values, io.Options...)
+	}
+	for _, v := range values {
+		if err := checkPaths(v, roots); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// ffmpegDir is the working directory of FFmpeg: the data directory, so a relative path cannot
+// reach the configuration ("" keeps the core's own).
+func (r *restream) ffmpegDir() string {
+	if fileAccessOpen() {
+		return ""
+	}
+	for _, fs := range r.fs.diskfs {
+		if base := fs.Metadata("base"); base != "" {
+			return base
+		}
+	}
+	return ""
+}
