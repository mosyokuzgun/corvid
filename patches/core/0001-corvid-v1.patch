@@ -0,0 +1,54 @@
+package monitor
+
+import (
+	"strconv"
+
+	"github.com/datarhei/core/v16/gpu"
+	"github.com/datarhei/core/v16/monitor/metric"
+)
+
+type gpuCollector struct {
+	mon      gpu.Monitor
+	balancer *gpu.Balancer
+	descr    *metric.Description
+}
+
+// NewGPUCollector exposes GPU values as gpu{index,uuid,name,name=...}. They are available
+// via /api/v3/metrics (UI dashboard) and /metrics (Prometheus).
+func NewGPUCollector(m gpu.Monitor, b *gpu.Balancer) metric.Collector {
+	return &gpuCollector{
+		mon:      m,
+		balancer: b,
+		descr:    metric.NewDesc("gpu", "NVIDIA GPU values by name", []string{"index", "uuid", "model", "name"}),
+	}
+}
+
+func (c *gpuCollector) Stop()                           {}
+func (c *gpuCollector) Prefix() string                  { return "gpu" }
+func (c *gpuCollector) Describe() []*metric.Description { return []*metric.Description{c.descr} }
+
+func (c *gpuCollector) Collect() metric.Metrics {
+	metrics := metric.NewMetrics()
+	leases := map[int]int{}
+	if c.balancer != nil {
+		leases = c.balancer.Leases()
+	}
+	for _, d := range c.mon.Devices() {
+		i := strconv.Itoa(d.Index)
+		add := func(name string, v float64) {
+			metrics.Add(metric.NewValue(c.descr, v, i, d.UUID, d.Name, name))
+		}
+		add("temperature", d.TemperatureC)
+		add("power", d.PowerW)
+		add("mem_total", float64(d.MemTotal))
+		add("mem_used", float64(d.MemUsed))
+		add("util_gpu", d.UtilGPU)
+		add("util_encoder", d.UtilEncoder)
+		add("util_decoder", d.UtilDecoder)
+		add("encoder_sessions", float64(d.EncoderSession))
+		add("encoder_fps", d.EncoderFPS)
+		add("encoder_latency", d.EncoderLatency)
+		add("processes", float64(leases[d.Index]))
+	}
+	return metrics
+}
diff --git a/net/tlsrelay/rechunk.go b/net/tlsrelay/rechunk.go
new file mode 100644
index 0000000..e55f846
--- /dev/null
+++ b/net/tlsrelay/rechunk.go
@@ -0,0 +1,280 @@
+package tlsrelay
+
+// The server-to-client side of an RTMP connection, rewritten so that FFmpeg sends in large
+// chunks.
+//
+// FFmpeg's RTMP client starts with 128-byte chunks and only changes the size of the chunks
+// it sends when the server sends it a "Set Chunk Size" message: it then sends the same
+// message back to the server and uses that size (libavformat/rtmpproto.c,
+// handle_chunk_size). Servers that never send one (YouTube) get the whole stream in
+// 128-byte chunks: about 16000 write calls a second for 8 Mbit/s, each one a system call,
+// which is what costs the CPU.
+//
+// So after the handshake the relay sends FFmpeg a "Set Chunk Size" of OutChunkSize. FFmpeg
+// then also reads with that size, so everything the server sends after it is passed on as
+// whole messages in chunks of that size, re-chunked from the server's own chunk size. The
+// server's own "Set Chunk Size" messages are applied to the reading side and not passed on.
+// What the server sends is small (results, acknowledgements, status), so this is cheap.
+
+import (
+	"bufio"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"io"
+)
+
+// OutChunkSize is the chunk size FFmpeg is asked to use (and receives with).
+const OutChunkSize = 4096
+
+const (
+	handshakeSize   = 1 + 1536 + 1536 // S0, S1, S2
+	typeSetChunk    = 1
+	maxMessageSize  = 16 << 20
+	defaultChunk    = 128
+	extendedTSField = 0xFFFFFF
+)
+
+var errProtocol = errors.New("rtmp: unexpected data from server")
+
+type chunkStream struct {
+	timestamp uint32
+	delta     uint32
+	length    uint32
+	typeID    uint8
+	streamID  uint32
+	extended  bool   // the last header of this chunk stream had an extended timestamp
+	payload   []byte // the message being read
+	pending   bool   // a message is being read
+}
+
+// rechunk copies an RTMP server-to-client stream from src to dst: the handshake as it is,
+// then a "Set Chunk Size" of outChunk, then every message of the server re-chunked to
+// outChunk. It returns when src ends (nil for EOF) or on an error.
+func rechunk(dst io.Writer, src io.Reader, outChunk uint32) error {
+	r := bufio.NewReaderSize(src, 16*1024)
+
+	hs := make([]byte, handshakeSize)
+	if _, err := io.ReadFull(r, hs); err != nil {
+		if err == io.EOF || err == io.ErrUnexpectedEOF {
+			return nil
+		}
+		return err
+	}
+	if hs[0] != 3 {
+		return fmt.Errorf("%w: RTMP version %d", errProtocol, hs[0])
+	}
+	if _, err := dst.Write(hs); err != nil {
+		return err
+	}
+
+	payload := make([]byte, 4)
+	binary.BigEndian.PutUint32(payload, outChunk)
+	if err := writeMessage(dst, 2, 0, typeSetChunk, 0, payload, outChunk); err != nil {
+		return err
+	}
+
+	inChunk := uint32(defaultChunk)
+	streams := map[uint32]*chunkStream{}
+
+	for {
+		b, err := r.ReadByte()
+		if err != nil {
+			if err == io.EOF {
+				return nil
+			}
+			return err
+		}
+
+		format := b >> 6
+		csid := uint32(b & 0x3f)
+		switch csid {
+		case 0:
+			c, err := r.ReadByte()
+			if err != nil {
+				return eof(err)
+			}
+			csid = 64 + uint32(c)
+		case 1:
+			var c [2]byte
+			if _, err := io.ReadFull(r, c[:]); err != nil {
+				return eof(err)
+			}
+			csid = 64 + uint32(c[0]) + uint32(c[1])*256
+		}
+
+		cs, ok := streams[csid]
+		if !ok {
+			if format != 0 {
+				return fmt.Errorf("%w: chunk stream %d starts with format %d", errProtocol, csid, format)
+			}
+			cs = &chunkStream{}
+			streams[csid] = cs
+		}
+
+		var hdr [11]byte
+		var tsField uint32
+		switch format {
+		case 0:
+			if _, err := io.ReadFull(r, hdr[:11]); err != nil {
+				return eof(err)
+			}
+			tsField = be24(hdr[0:3])
+			cs.length = be24(hdr[3:6])
+			cs.typeID = hdr[6]
+			cs.streamID = binary.LittleEndian.Uint32(hdr[7:11])
+		case 1:
+			if _, err := io.ReadFull(r, hdr[:7]); err != nil {
+				return eof(err)
+			}
+			tsField = be24(hdr[0:3])
+			cs.length = be24(hdr[3:6])
+			cs.typeID = hdr[6]
+		case 2:
+			if _, err := io.ReadFull(r, hdr[:3]); err != nil {
+				return eof(err)
+			}
+			tsField = be24(hdr[0:3])
+		}
+
+		var ts uint32
+		if format == 3 {
+			if cs.extended {
+				var ext [4]byte
+				if _, err := io.ReadFull(r, ext[:]); err != nil {
+					return eof(err)
+				}
+				// continuation: the value repeats the message's timestamp, not used
+				if !cs.pending {
+					cs.delta = binary.BigEndian.Uint32(ext[:])
+				}
+			}
+		} else {
+			cs.extended = tsField == extendedTSField
+			ts = tsField
+			if cs.extended {
+				var ext [4]byte
+				if _, err := io.ReadFull(r, ext[:]); err != nil {
+					return eof(err)
+				}
+				ts = binary.BigEndian.Uint32(ext[:])
+			}
+		}
+
+		if !cs.pending {
+			// a new message
+			switch format {
+			case 0:
+				cs.timestamp = ts
+				cs.delta = 0
+			case 1, 2:
+				cs.delta = ts
+				cs.timestamp += ts
+			case 3:
+				cs.timestamp += cs.delta
+			}
+			if cs.length > maxMessageSize {
+				return fmt.Errorf("%w: message of %d bytes", errProtocol, cs.length)
+			}
+			cs.payload = make([]byte, 0, cs.length)
+			cs.pending = true
+		} else if format != 3 {
+			return fmt.Errorf("%w: new header in the middle of a message", errProtocol)
+		}
+
+		n := cs.length - uint32(len(cs.payload))
+		if n > inChunk {
+			n = inChunk
+		}
+		start := len(cs.payload)
+		cs.payload = cs.payload[:start+int(n)]
+		if _, err := io.ReadFull(r, cs.payload[start:]); err != nil {
+			return eof(err)
+		}
+
+		if uint32(len(cs.payload)) < cs.length {
+			continue
+		}
+
+		// a whole message
+		cs.pending = false
+
+		if cs.typeID == typeSetChunk && csid == 2 && len(cs.payload) >= 4 {
+			size := binary.BigEndian.Uint32(cs.payload) & 0x7fffffff
+			if size < 1 || size > maxMessageSize {
+				return fmt.Errorf("%w: chunk size %d", errProtocol, size)
+			}
+			inChunk = size
+			continue
+		}
+
+		if err := writeMessage(dst, csid, cs.timestamp, cs.typeID, cs.streamID, cs.payload, outChunk); err != nil {
+			return err
+		}
+	}
+}
+
+// writeMessage writes a message as a format 0 chunk and format 3 continuations.
+func writeMessage(w io.Writer, csid, timestamp uint32, typeID uint8, streamID uint32, payload []byte, chunk uint32) error {
+	basic := basicHeader(0, csid)
+	cont := basicHeader(3, csid)
+
+	extended := timestamp >= extendedTSField
+	tsField := timestamp
+	if extended {
+		tsField = extendedTSField
+	}
+
+	buf := make([]byte, 0, len(payload)+len(payload)/int(chunk)*8+32)
+	buf = append(buf, basic...)
+	buf = append(buf, byte(tsField>>16), byte(tsField>>8), byte(tsField))
+	l := uint32(len(payload))
+	buf = append(buf, byte(l>>16), byte(l>>8), byte(l))
+	buf = append(buf, typeID)
+	buf = binary.LittleEndian.AppendUint32(buf, streamID)
+	if extended {
+		buf = binary.BigEndian.AppendUint32(buf, timestamp)
+	}
+
+	for off := uint32(0); ; {
+		n := l - off
+		if n > chunk {
+			n = chunk
+		}
+		buf = append(buf, payload[off:off+n]...)
+		off += n
+		if off >= l {
+			break
+		}
+		buf = append(buf, cont...)
+		if extended {
+			buf = binary.BigEndian.AppendUint32(buf, timestamp)
+		}
+	}
+
+	_, err := w.Write(buf)
+	return err
+}
+
+func basicHeader(format uint8, csid uint32) []byte {
+	switch {
+	case csid < 64:
+		return []byte{format<<6 | byte(csid)}
+	case csid < 64+256:
+		return []byte{format << 6, byte(csid - 64)}
+	default:
+		c := csid - 64
+		return []byte{format<<6 | 1, byte(c), byte(c >> 8)}
+	}
+}
+
+func be24(b []byte) uint32 {
+	return uint32(b[0])<<16 | uint32(b[1])<<8 | uint32(b[2])
+}
+
+func eof(err error) error {
+	if err == io.EOF || err == io.ErrUnexpectedEOF {
+		return nil
+	}
+	return err
+}
diff --git a/net/tlsrelay/rechunk_test.go b/net/tlsrelay/rechunk_test.go
new file mode 100644
index 0000000..ad5a26d
--- /dev/null
+++ b/net/tlsrelay/rechunk_test.go
@@ -0,0 +1,180 @@
+package tlsrelay
+
+import (
+	"bytes"
+	"encoding/binary"
+	"io"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+type msg struct {
+	csid      uint32
+	timestamp uint32
+	typeID    uint8
+	streamID  uint32
+	payload   []byte
+}
+
+// chunks encodes one message the way a server may: the first chunk with the given format
+// and header field values, continuations with format 3.
+func chunks(csid uint32, format uint8, tsField uint32, ext bool, length uint32, typeID uint8, streamID uint32, payload []byte, chunk int) []byte {
+	var b []byte
+	b = append(b, basicHeader(format, csid)...)
+	field := tsField
+	if ext {
+		field = extendedTSField
+	}
+	switch format {
+	case 0:
+		b = append(b, byte(field>>16), byte(field>>8), byte(field), byte(length>>16), byte(length>>8), byte(length), typeID)
+		b = binary.LittleEndian.AppendUint32(b, streamID)
+	case 1:
+		b = append(b, byte(field>>16), byte(field>>8), byte(field), byte(length>>16), byte(length>>8), byte(length), typeID)
+	case 2:
+		b = append(b, byte(field>>16), byte(field>>8), byte(field))
+	}
+	if ext {
+		b = binary.BigEndian.AppendUint32(b, tsField)
+	}
+	for off := 0; ; {
+		n := len(payload) - off
+		if n > chunk {
+			n = chunk
+		}
+		b = append(b, payload[off:off+n]...)
+		off += n
+		if off >= len(payload) {
+			break
+		}
+		b = append(b, basicHeader(3, csid)...)
+		if ext {
+			b = binary.BigEndian.AppendUint32(b, tsField)
+		}
+	}
+	return b
+}
+
+func fill(n int, seed byte) []byte {
+	p := make([]byte, n)
+	for i := range p {
+		p[i] = seed + byte(i*7)
+	}
+	return p
+}
+
+// readAll parses what the client gets, like FFmpeg: 128-byte chunks until a Set Chunk Size.
+func readAll(t *testing.T, data []byte) []msg {
+	r := bytes.NewReader(data)
+	hs := make([]byte, handshakeSize)
+	_, err := io.ReadFull(r, hs)
+	require.NoError(t, err)
+
+	chunk := uint32(128)
+	var out []msg
+	for r.Len() > 0 {
+		b, _ := r.ReadByte()
+		format, csid := b>>6, uint32(b&0x3f)
+		if csid == 0 {
+			c, _ := r.ReadByte()
+			csid = 64 + uint32(c)
+		}
+		require.Equal(t, uint8(0), format, "messages start with format 0")
+		var h [11]byte
+		io.ReadFull(r, h[:])
+		ts := be24(h[0:3])
+		ext := ts == extendedTSField
+		if ext {
+			var e [4]byte
+			io.ReadFull(r, e[:])
+			ts = binary.BigEndian.Uint32(e[:])
+		}
+		m := msg{csid: csid, timestamp: ts, typeID: h[6], streamID: binary.LittleEndian.Uint32(h[7:11])}
+		length := int(be24(h[3:6]))
+		for len(m.payload) < length {
+			n := length - len(m.payload)
+			if n > int(chunk) {
+				n = int(chunk)
+			}
+			p := make([]byte, n)
+			_, err := io.ReadFull(r, p)
+			require.NoError(t, err)
+			m.payload = append(m.payload, p...)
+			if len(m.payload) < length {
+				want := basicHeader(3, csid)
+				got := make([]byte, len(want))
+				io.ReadFull(r, got)
+				require.Equal(t, want, got, "continuation chunk")
+				if ext {
+					var e [4]byte
+					io.ReadFull(r, e[:])
+				}
+			}
+		}
+		if m.typeID == typeSetChunk {
+			chunk = binary.BigEndian.Uint32(m.payload)
+		}
+		out = append(out, m)
+	}
+	return out
+}
+
+func TestRechunk(t *testing.T) {
+	var server bytes.Buffer
+	server.WriteByte(3)
+	server.Write(fill(3072, 1))
+
+	result := fill(300, 2)
+	extended := fill(300, 3)
+	status := fill(200, 4)
+	status2 := fill(200, 5)
+	video := fill(9000, 6)
+
+	// window ack size, 4 bytes
+	server.Write(chunks(2, 0, 0, false, 4, 5, 0, []byte{0, 0x26, 0x25, 0xa0}, 128))
+	// _result, 300 bytes in 128-byte chunks
+	server.Write(chunks(3, 0, 0, false, 300, 20, 0, result, 128))
+	// extended timestamp, with continuations
+	server.Write(chunks(4, 0, 0x01000000, true, 300, 18, 1, extended, 128))
+	// the server's own chunk size (format 1 on csid 2): 4096
+	server.Write(chunks(2, 1, 0, false, 4, typeSetChunk, 0, []byte{0, 0, 0x10, 0}, 128))
+	// onStatus with a delta of 10 (format 1), now in one chunk
+	server.Write(chunks(3, 1, 10, false, 200, 20, 0, status, 4096))
+	// a new message in format 3: same length and type, timestamp + the last delta
+	server.Write(chunks(3, 3, 0, false, 200, 20, 0, status2, 4096))
+	// a large message on a csid >= 64, split at 4096
+	server.Write(chunks(70, 0, 500, false, 9000, 9, 1, video, 4096))
+
+	var client bytes.Buffer
+	require.NoError(t, rechunk(&client, bytes.NewReader(server.Bytes()), 4096))
+
+	require.Equal(t, server.Bytes()[:handshakeSize], client.Bytes()[:handshakeSize], "the handshake is passed on")
+
+	got := readAll(t, client.Bytes())
+	want := []msg{
+		{2, 0, typeSetChunk, 0, []byte{0, 0, 0x10, 0}}, // from the relay
+		{2, 0, 5, 0, []byte{0, 0x26, 0x25, 0xa0}},
+		{3, 0, 20, 0, result},
+		{4, 0x01000000, 18, 1, extended},
+		// the server's Set Chunk Size is not passed on
+		{3, 10, 20, 0, status},
+		{3, 20, 20, 0, status2},
+		{70, 500, 9, 1, video},
+	}
+	require.Equal(t, want, got)
+}
+
+func TestRechunkErrors(t *testing.T) {
+	// not RTMP
+	err := rechunk(io.Discard, bytes.NewReader(append([]byte{'H'}, fill(3072, 1)...)), 4096)
+	require.ErrorIs(t, err, errProtocol)
+
+	// a chunk stream that starts without a full header
+	bad := append([]byte{3}, fill(3072, 1)...)
+	bad = append(bad, chunks(3, 1, 0, false, 4, 20, 0, []byte{1, 2, 3, 4}, 128)...)
+	require.ErrorIs(t, rechunk(io.Discard, bytes.NewReader(bad), 4096), errProtocol)
+
+	// the server closes early: no error
+	require.NoError(t, rechunk(io.Discard, bytes.NewReader([]byte{3, 1, 2}), 4096))
+}
diff --git a/net/tlsrelay/tlsrelay.go b/net/tlsrelay/tlsrelay.go
new file mode 100644
index 0000000..0acae37
--- /dev/null
+++ b/net/tlsrelay/tlsrelay.go
@@ -0,0 +1,311 @@
+// Package tlsrelay sends RTMP over TLS for FFmpeg.
+//
+// FFmpeg's RTMP client writes every 128-byte chunk of a stream (and a 1-byte header after
+// it) with its own write call, unless the server raises the chunk size, which some servers
+// (YouTube among them) don't. Over "rtmps://" every one of these writes becomes its own TLS
+// record: about 16000 records and system calls a second for an 8 Mbit/s stream, which costs
+// a third of a CPU core per output and adds 40-50% to the traffic.
+//
+// Rewrite changes the "rtmps://" outputs of an FFmpeg command before it starts: FFmpeg sends
+// plain RTMP to a listener on 127.0.0.1 and the relay forwards it over TLS to the server.
+// The relay also tells FFmpeg to send in 4 KB chunks (rechunk.go), so it writes 30 times
+// less often, and gathers what it gets into large TLS records. "-rtmp_tcurl" keeps the URL FFmpeg
+// tells the server the original one, so for the server nothing changes.
+//
+// The certificate of the server is verified (system roots, server name from the URL). If a
+// server fails the verification, its outputs go directly with "rtmps://" again for an hour,
+// as before the relay (FFmpeg doesn't verify certificates). If the relay can't listen, the
+// output stays as it is.
+package tlsrelay
+
+import (
+	"bufio"
+	"crypto/tls"
+	"crypto/x509"
+	"errors"
+	"io"
+	"net"
+	"regexp"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/datarhei/core/v16/log"
+)
+
+// rtmps://host[:port]/app/rest: the app is the first part of the path, as FFmpeg takes it.
+var rtmpsURL = regexp.MustCompile(`^rtmps://([A-Za-z0-9.\-]+)(?::([0-9]{1,5}))?(/[^/]+)(/.+)$`)
+
+// directFor is how long a server that failed the certificate check is reached directly.
+const directFor = time.Hour
+
+// Relay keeps one local listener per server.
+type Relay struct {
+	logger      log.Logger
+	dialTimeout time.Duration
+	tlsConfig   func(host string) *tls.Config
+
+	lock      sync.Mutex
+	listeners map[string]net.Listener
+	direct    map[string]time.Time // servers reached directly until then
+}
+
+// New creates a relay. The logger may be nil.
+func New(logger log.Logger) *Relay {
+	if logger == nil {
+		logger = log.New("")
+	}
+
+	return &Relay{
+		logger:      logger,
+		dialTimeout: 10 * time.Second,
+		tlsConfig: func(host string) *tls.Config {
+			return &tls.Config{ServerName: host, MinVersion: tls.VersionTLS12}
+		},
+		listeners: map[string]net.Listener{},
+		direct:    map[string]time.Time{},
+	}
+}
+
+// Rewrite returns args with every argument that is one of outputs and an "rtmps://" URL
+// sent through the relay: "-rtmp_tcurl rtmps://host:port/app" is put in front of it and the
+// URL becomes "rtmp://127.0.0.1:<port>/app/rest". args is not changed.
+func (r *Relay) Rewrite(args []string, outputs []string) []string {
+	targets := map[string]bool{}
+	for _, o := range outputs {
+		if rtmpsURL.MatchString(o) {
+			targets[o] = true
+		}
+	}
+	if len(targets) == 0 {
+		return args
+	}
+
+	out := make([]string, 0, len(args)+4)
+	for i, arg := range args {
+		if !targets[arg] || (i > 0 && (args[i-1] == "-i" || args[i-1] == "-rtmp_tcurl")) || hasTcURL(args[:i]) {
+			out = append(out, arg)
+			continue
+		}
+
+		m := rtmpsURL.FindStringSubmatch(arg)
+		host, port, app, rest := strings.ToLower(m[1]), m[2], m[3], m[4]
+		if port == "" {
+			port = "443"
+		}
+		host = canonicalHost(host)
+
+		local, err := r.Addr(host, port)
+		if err != nil {
+			if !errors.Is(err, errDirect) {
+				r.logger.Warn().WithError(err).WithField("server", host+":"+port).Log("TLS relay not available, connecting directly")
+			}
+			out = append(out, arg)
+			continue
+		}
+
+		out = append(out, "-rtmp_tcurl", "rtmps://"+host+":"+port+app, "rtmp://"+local+app+rest)
+	}
+
+	return out
+}
+
+// hasTcURL tells whether the options of the output that starts after the last "-i" or
+// output already set a tcUrl: then the output is left alone.
+func hasTcURL(before []string) bool {
+	for i := len(before) - 1; i >= 0; i-- {
+		if before[i] == "-rtmp_tcurl" {
+			return true
+		}
+		if before[i] == "-i" {
+			return false
+		}
+		// a URL ends the options of the output before, unless it is the value of -rtmp_tcurl
+		if strings.Contains(before[i], "://") && (i == 0 || before[i-1] != "-rtmp_tcurl") {
+			return false
+		}
+	}
+	return false
+}
+
+var errDirect = errors.New("server is reached directly")
+
+// youtubeRTMP matches YouTube's RTMP ingest names (a.rtmp.youtube.com, b.rtmp.youtube.com).
+var youtubeRTMP = regexp.MustCompile(`^([a-z0-9-]+)\.rtmp\.youtube\.com$`)
+
+// canonicalHost returns the name a server is reached under over TLS. YouTube's RTMPS ingest
+// is a.rtmps.youtube.com (b. for the backup); its certificate is only valid for
+// *.rtmps.youtube.com. Over "rtmps://a.rtmp.youtube.com" FFmpeg got the same servers but
+// didn't check the name; the relay checks it, so it uses YouTube's RTMPS name.
+func canonicalHost(host string) string {
+	if m := youtubeRTMP.FindStringSubmatch(host); m != nil {
+		return m[1] + ".rtmps.youtube.com"
+	}
+	return host
+}
+
+// Addr returns the local address ("127.0.0.1:port") that is relayed to host:port, and
+// starts listening on it if this is the first time.
+func (r *Relay) Addr(host, port string) (string, error) {
+	if p, err := strconv.Atoi(port); err != nil || p < 1 || p > 65535 {
+		return "", errors.New("invalid port")
+	}
+
+	key := net.JoinHostPort(host, port)
+
+	r.lock.Lock()
+	defer r.lock.Unlock()
+
+	if until, ok := r.direct[key]; ok {
+		if time.Now().Before(until) {
+			return "", errDirect
+		}
+		delete(r.direct, key)
+	}
+
+	if l, ok := r.listeners[key]; ok {
+		return l.Addr().String(), nil
+	}
+
+	l, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		return "", err
+	}
+
+	r.listeners[key] = l
+	r.logger.Info().WithField("server", key).WithField("local", l.Addr().String()).Log("TLS relay listening")
+
+	go r.serve(l, host, key)
+
+	return l.Addr().String(), nil
+}
+
+// Close stops all listeners. Connections already relayed stay open until either side closes.
+func (r *Relay) Close() {
+	r.lock.Lock()
+	defer r.lock.Unlock()
+
+	for key, l := range r.listeners {
+		l.Close()
+		delete(r.listeners, key)
+	}
+}
+
+func (r *Relay) serve(l net.Listener, host, key string) {
+	for {
+		conn, err := l.Accept()
+		if err != nil {
+			var ne net.Error
+			if errors.As(err, &ne) && ne.Timeout() {
+				continue
+			}
+
+			r.lock.Lock()
+			if r.listeners[key] == l {
+				delete(r.listeners, key)
+			}
+			r.lock.Unlock()
+			return
+		}
+
+		go r.relay(conn, host, key)
+	}
+}
+
+func (r *Relay) relay(local net.Conn, host, key string) {
+	dialer := &tls.Dialer{
+		NetDialer: &net.Dialer{Timeout: r.dialTimeout, KeepAlive: 15 * time.Second},
+		Config:    r.tlsConfig(host),
+	}
+
+	remote, err := dialer.Dial("tcp", key)
+	if err != nil {
+		if isCertificateError(err) {
+			// Not a network problem: FFmpeg would have connected (it doesn't verify). The
+			// next starts of this server's outputs go directly for a while.
+			r.lock.Lock()
+			r.direct[key] = time.Now().Add(directFor)
+			r.lock.Unlock()
+			r.logger.Warn().WithError(err).WithField("server", key).Log("TLS relay: certificate not trusted, connecting directly for an hour")
+		} else {
+			r.logger.Warn().WithError(err).WithField("server", key).Log("TLS relay: connection failed")
+		}
+		local.Close()
+		return
+	}
+
+	done := make(chan struct{}, 2)
+
+	go func() {
+		gather(remote, local, gatherDelay)
+		done <- struct{}{}
+	}()
+
+	go func() {
+		// The server's side, with a "Set Chunk Size" for FFmpeg (see rechunk.go).
+		if err := rechunk(local, remote, OutChunkSize); errors.Is(err, errProtocol) {
+			r.lock.Lock()
+			r.direct[key] = time.Now().Add(directFor)
+			r.lock.Unlock()
+			r.logger.Warn().WithError(err).WithField("server", key).Log("TLS relay: unexpected RTMP from the server, connecting directly for an hour")
+		}
+		done <- struct{}{}
+	}()
+
+	// Either side closes: close both, which ends the other copy too.
+	<-done
+	local.Close()
+	remote.Close()
+	<-done
+}
+
+func isCertificateError(err error) bool {
+	var unknown x509.UnknownAuthorityError
+	var hostname x509.HostnameError
+	var invalid x509.CertificateInvalidError
+	var verify *tls.CertificateVerificationError
+	return errors.As(err, &unknown) || errors.As(err, &hostname) || errors.As(err, &invalid) || errors.As(err, &verify)
+}
+
+// gatherDelay is how long data from FFmpeg is gathered before it is sent on. FFmpeg writes
+// a stream in pieces of 128 bytes; read as they come, every piece would still be its own TLS
+// record. 4 ms adds at most 4 ms of delay and makes records of about 4 KB at 8 Mbit/s.
+const gatherDelay = 4 * time.Millisecond
+
+// gather copies src to dst. After the first byte it keeps reading for up to delay (or until
+// 16 KB are together) before it writes, so dst gets few large writes instead of many small.
+func gather(dst io.Writer, src net.Conn, delay time.Duration) error {
+	bw := bufio.NewWriterSize(dst, 16*1024)
+	buf := make([]byte, 32*1024)
+	waiting := false
+
+	for {
+		n, err := src.Read(buf)
+		if n > 0 {
+			if _, werr := bw.Write(buf[:n]); werr != nil {
+				return werr
+			}
+			if !waiting {
+				src.SetReadDeadline(time.Now().Add(delay))
+				waiting = true
+			}
+		}
+		if err != nil {
+			var ne net.Error
+			if errors.As(err, &ne) && ne.Timeout() {
+				if ferr := bw.Flush(); ferr != nil {
+					return ferr
+				}
+				src.SetReadDeadline(time.Time{})
+				waiting = false
+				continue
+			}
+			bw.Flush()
+			if err == io.EOF {
+				return nil
+			}
+			return err
+		}
+	}
+}
diff --git a/net/tlsrelay/tlsrelay_test.go b/net/tlsrelay/tlsrelay_test.go
new file mode 100644
index 0000000..4760a4c
--- /dev/null
+++ b/net/tlsrelay/tlsrelay_test.go
@@ -0,0 +1,215 @@
+package tlsrelay
+
+import (
+	"bytes"
+	"crypto/ecdsa"
+	"crypto/elliptic"
+	"crypto/rand"
+	"crypto/tls"
+	"crypto/x509"
+	"crypto/x509/pkix"
+	"io"
+	"math/big"
+	"net"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestRewrite(t *testing.T) {
+	r := New(nil)
+	defer r.Close()
+
+	a := "rtmps://a.rtmp.youtube.com/live2/abcd-efgh"
+	b := "rtmps://b.rtmp.youtube.com/live2?backup=1/abcd-efgh"
+	fb := "rtmps://live-api-s.facebook.com:443/rtmp/FB-1-0-Ab"
+	args := []string{
+		"-i", "rtmps://in.example.com/app/in", // an input: not rewritten
+		"-map", "0:0", "-codec:v", "copy", "-f", "flv", a,
+		"-map", "0:0", "-codec:v", "copy", "-f", "flv", b,
+		"-f", "flv", fb,
+		"-f", "flv", "rtmp://plain.example.com/app/key",
+		"-metadata", "comment=" + a, // an option value: not an output
+	}
+	before := append([]string{}, args...)
+
+	out := r.Rewrite(args, []string{a, b, fb, "rtmp://plain.example.com/app/key"})
+	require.Equal(t, before, args, "arguments are not changed")
+
+	s := strings.Join(out, " ")
+	require.Contains(t, s, "-i rtmps://in.example.com/app/in ")
+	// YouTube's RTMPS name, the one its certificate is for
+	require.Contains(t, s, "-f flv -rtmp_tcurl rtmps://a.rtmps.youtube.com:443/live2 rtmp://127.0.0.1:")
+	require.Contains(t, s, "-f flv -rtmp_tcurl rtmps://b.rtmps.youtube.com:443/live2?backup=1 rtmp://127.0.0.1:")
+	require.Contains(t, s, "-f flv -rtmp_tcurl rtmps://live-api-s.facebook.com:443/rtmp rtmp://127.0.0.1:")
+	require.Contains(t, s, "/live2/abcd-efgh -map")
+	require.Contains(t, s, "/live2?backup=1/abcd-efgh -f flv")
+	require.Contains(t, s, "/rtmp/FB-1-0-Ab -f flv rtmp://plain.example.com/app/key")
+	require.True(t, strings.HasSuffix(s, "-metadata comment="+a))
+
+	// one listener per server, used again
+	a1, _ := r.Addr("a.rtmps.youtube.com", "443")
+	a2, _ := r.Addr("a.rtmps.youtube.com", "443")
+	require.Equal(t, a1, a2)
+	require.Contains(t, s, "rtmp://"+a1+"/live2/abcd-efgh")
+
+	// a tcUrl set for the output: left alone
+	args = []string{"-i", "x", "-rtmp_tcurl", "rtmps://other/app", "-f", "flv", a}
+	require.Equal(t, args, r.Rewrite(args, []string{a}))
+
+	// nothing to do
+	args = []string{"-i", "x", "-f", "null", "-"}
+	require.Equal(t, args, r.Rewrite(args, []string{"-"}))
+}
+
+func TestCanonicalHost(t *testing.T) {
+	require.Equal(t, "a.rtmps.youtube.com", canonicalHost("a.rtmp.youtube.com"))
+	require.Equal(t, "b.rtmps.youtube.com", canonicalHost("b.rtmp.youtube.com"))
+	require.Equal(t, "a.rtmps.youtube.com", canonicalHost("a.rtmps.youtube.com"))
+	require.Equal(t, "live-api-s.facebook.com", canonicalHost("live-api-s.facebook.com"))
+	require.Equal(t, "rtmp.youtube.com.example.org", canonicalHost("rtmp.youtube.com.example.org"))
+}
+
+func selfSigned(t *testing.T) tls.Certificate {
+	key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	require.NoError(t, err)
+	tmpl := &x509.Certificate{
+		SerialNumber: big.NewInt(1),
+		Subject:      pkix.Name{CommonName: "localhost"},
+		DNSNames:     []string{"localhost"},
+		NotBefore:    time.Now().Add(-time.Hour),
+		NotAfter:     time.Now().Add(time.Hour),
+	}
+	der, err := x509.CreateCertificate(rand.Reader, tmpl, tmpl, &key.PublicKey, key)
+	require.NoError(t, err)
+	return tls.Certificate{Certificate: [][]byte{der}, PrivateKey: key}
+}
+
+// A TLS server that counts how many reads (at most one TLS record each) it takes to get
+// the data, and answers with a few bytes.
+func TestRelaySmallWrites(t *testing.T) {
+	cert := selfSigned(t)
+	srv, err := tls.Listen("tcp", "127.0.0.1:0", &tls.Config{Certificates: []tls.Certificate{cert}})
+	require.NoError(t, err)
+	defer srv.Close()
+
+	type result struct {
+		data  []byte
+		reads int
+	}
+	got := make(chan result, 1)
+
+	go func() {
+		c, err := srv.Accept()
+		if err != nil {
+			return
+		}
+		defer c.Close()
+		// an RTMP handshake (S0, S1, S2), so the relay passes it on
+		hs := make([]byte, handshakeSize)
+		hs[0] = 3
+		c.Write(hs)
+		var b bytes.Buffer
+		buf := make([]byte, 64*1024)
+		reads := 0
+		for {
+			n, err := c.Read(buf)
+			if n > 0 {
+				reads++
+				b.Write(buf[:n])
+			}
+			if err != nil {
+				break
+			}
+		}
+		got <- result{b.Bytes(), reads}
+	}()
+
+	pool := x509.NewCertPool()
+	leaf, _ := x509.ParseCertificate(cert.Certificate[0])
+	pool.AddCert(leaf)
+
+	r := New(nil)
+	r.tlsConfig = func(host string) *tls.Config { return &tls.Config{ServerName: host, RootCAs: pool} }
+	defer r.Close()
+
+	_, port, _ := net.SplitHostPort(srv.Addr().String())
+	addr, err := r.Addr("localhost", port)
+	require.NoError(t, err)
+
+	c, err := net.Dial("tcp", addr)
+	require.NoError(t, err)
+
+	// the handshake, then the relay's Set Chunk Size (12-byte header + 4)
+	hs := make([]byte, handshakeSize+16)
+	c.SetReadDeadline(time.Now().Add(5 * time.Second))
+	_, err = io.ReadFull(c, hs)
+	require.NoError(t, err)
+	require.Equal(t, byte(3), hs[0])
+	require.Equal(t, []byte{0x02, 0, 0, 0, 0, 0, 4, typeSetChunk, 0, 0, 0, 0, 0, 0, 0x10, 0}, hs[handshakeSize:])
+
+	// 1 MB as FFmpeg writes it: 128 bytes and a 1-byte header, over 250 ms.
+	var sent bytes.Buffer
+	chunk := make([]byte, 128)
+	writes := 0
+	for i := 0; sent.Len() < 1<<20; i++ {
+		for j := range chunk {
+			chunk[j] = byte(i + j)
+		}
+		c.Write(chunk)
+		c.Write([]byte{0xC4})
+		sent.Write(chunk)
+		sent.WriteByte(0xC4)
+		writes += 2
+		if i%64 == 0 {
+			time.Sleep(time.Millisecond)
+		}
+	}
+	c.Close()
+
+	select {
+	case res := <-got:
+		require.Equal(t, sent.Bytes(), res.data, "data arrives unchanged")
+		require.Less(t, res.reads, writes/20, "small writes are gathered into few records (%d reads for %d writes)", res.reads, writes)
+	case <-time.After(10 * time.Second):
+		t.Fatal("timeout")
+	}
+}
+
+func TestRelayVerifiesCertificate(t *testing.T) {
+	cert := selfSigned(t)
+	srv, err := tls.Listen("tcp", "127.0.0.1:0", &tls.Config{Certificates: []tls.Certificate{cert}})
+	require.NoError(t, err)
+	defer srv.Close()
+	go func() {
+		for {
+			c, err := srv.Accept()
+			if err != nil {
+				return
+			}
+			go func() { c.(*tls.Conn).Handshake(); c.Close() }()
+		}
+	}()
+
+	r := New(nil) // system roots: the self-signed certificate is not trusted
+	defer r.Close()
+
+	_, port, _ := net.SplitHostPort(srv.Addr().String())
+	addr, err := r.Addr("localhost", port)
+	require.NoError(t, err)
+
+	c, err := net.Dial("tcp", addr)
+	require.NoError(t, err)
+	defer c.Close()
+
+	c.SetReadDeadline(time.Now().Add(5 * time.Second))
+	_, err = c.Read(make([]byte, 1))
+	require.Error(t, err, "the relay closes the connection when the certificate isn't trusted")
+
+	// from now on outputs to that server go directly, as before the relay
+	time.Sleep(100 * time.Millisecond)
+	u := "rtmps://localhost:" + port + "/app/key"
+	require.Equal(t, []string{"-f", "flv", u}, r.Rewrite([]string{"-f", "flv", u}, []string{u}))
+}
