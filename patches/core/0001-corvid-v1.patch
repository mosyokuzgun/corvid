diff --git a/users/users.go b/users/users.go
new file mode 100644
index 0000000..df5365a
--- /dev/null
+++ b/users/users.go
@@ -0,0 +1,260 @@
+// Package users keeps the panel's additional user accounts and their roles (fork).
+//
+// The administrator from the configuration (api.auth.username/password) always exists and
+// always has the admin role, so nobody can lock themselves out. Further accounts live in
+// <db dir>/users.json with Argon2id password hashes:
+//
+//   - admin:    everything.
+//   - operator: runs the channels: start/stop, edit channels and publications, upload
+//     pictures. Not: system settings, user accounts, stream keys, configuration export.
+//   - viewer:   watches: reads states and settings with every secret masked, changes nothing.
+package users
+
+import (
+	"crypto/rand"
+	"crypto/subtle"
+	"encoding/base64"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"regexp"
+	"sort"
+	"sync"
+	"time"
+
+	"golang.org/x/crypto/argon2"
+)
+
+const (
+	Admin    = "admin"
+	Operator = "operator"
+	Viewer   = "viewer"
+)
+
+// ValidRole reports whether role is one of the three roles.
+func ValidRole(role string) bool {
+	return role == Admin || role == Operator || role == Viewer
+}
+
+// User is an account as the API shows it (never with the password).
+type User struct {
+	Name    string `json:"name"`
+	Role    string `json:"role"`
+	Created int64  `json:"created"`
+	Builtin bool   `json:"builtin,omitempty"` // the administrator from the configuration
+}
+
+type stored struct {
+	Name    string `json:"name"`
+	Role    string `json:"role"`
+	Salt    string `json:"salt"`
+	Hash    string `json:"hash"`
+	Created int64  `json:"created"`
+}
+
+// Argon2id parameters (RFC 9106, second recommendation, with 64 MiB).
+const (
+	argonTime    = 3
+	argonMemory  = 64 * 1024
+	argonThreads = 2
+	argonKeyLen  = 32
+)
+
+var namePattern = regexp.MustCompile(`^[A-Za-z0-9._@-]{1,64}$`)
+
+// MinPasswordLength is the shortest password accepted for an account.
+const MinPasswordLength = 8
+
+var (
+	ErrName     = errors.New("the name may contain letters, digits and . _ @ - (1 to 64 characters)")
+	ErrRole     = errors.New("unknown role")
+	ErrPassword = fmt.Errorf("the password must have at least %d characters", MinPasswordLength)
+	ErrBuiltin  = errors.New("the administrator from the configuration cannot be changed here")
+	ErrUnknown  = errors.New("unknown user")
+)
+
+// Store is the account list.
+type Store struct {
+	path  string
+	admin func() (string, string) // the configured administrator: name, password
+
+	lock  sync.RWMutex
+	users map[string]stored
+}
+
+// New loads (or starts) the account list in path. admin returns the configured administrator.
+func New(path string, admin func() (string, string)) (*Store, error) {
+	s := &Store{path: path, admin: admin, users: map[string]stored{}}
+	data, err := os.ReadFile(path)
+	if errors.Is(err, os.ErrNotExist) {
+		return s, nil
+	}
+	if err != nil {
+		return nil, err
+	}
+	list := []stored{}
+	if err := json.Unmarshal(data, &list); err != nil {
+		return nil, fmt.Errorf("%s: %w", path, err)
+	}
+	for _, u := range list {
+		if namePattern.MatchString(u.Name) && ValidRole(u.Role) {
+			s.users[u.Name] = u
+		}
+	}
+	return s, nil
+}
+
+func (s *Store) adminName() string {
+	if s.admin == nil {
+		return ""
+	}
+	name, _ := s.admin()
+	return name
+}
+
+// Check verifies a login. ok is false for unknown names and wrong passwords alike.
+func (s *Store) Check(name, password string) bool {
+	if s.admin != nil {
+		an, ap := s.admin()
+		if an != "" && name == an {
+			return subtle.ConstantTimeCompare([]byte(password), []byte(ap)) == 1
+		}
+	}
+	s.lock.RLock()
+	u, ok := s.users[name]
+	s.lock.RUnlock()
+	if !ok {
+		// the same work as for a known user: the answer time does not tell names apart
+		hash(make([]byte, 16), password)
+		return false
+	}
+	salt, err1 := base64.StdEncoding.DecodeString(u.Salt)
+	want, err2 := base64.StdEncoding.DecodeString(u.Hash)
+	if err1 != nil || err2 != nil {
+		return false
+	}
+	return subtle.ConstantTimeCompare(hash(salt, password), want) == 1
+}
+
+func hash(salt []byte, password string) []byte {
+	return argon2.IDKey([]byte(password), salt, argonTime, argonMemory, argonThreads, argonKeyLen)
+}
+
+// Role returns the role of an account, "" if there is none.
+func (s *Store) Role(name string) string {
+	if name != "" && name == s.adminName() {
+		return Admin
+	}
+	s.lock.RLock()
+	defer s.lock.RUnlock()
+	return s.users[name].Role
+}
+
+// List returns all accounts, the configured administrator first.
+func (s *Store) List() []User {
+	list := []User{}
+	if an := s.adminName(); an != "" {
+		list = append(list, User{Name: an, Role: Admin, Builtin: true})
+	}
+	s.lock.RLock()
+	names := make([]string, 0, len(s.users))
+	for n := range s.users {
+		names = append(names, n)
+	}
+	sort.Strings(names)
+	for _, n := range names {
+		u := s.users[n]
+		list = append(list, User{Name: u.Name, Role: u.Role, Created: u.Created})
+	}
+	s.lock.RUnlock()
+	return list
+}
+
+// Set creates an account or changes its role and/or password (empty: keep the password; a new
+// account needs one).
+func (s *Store) Set(name, role, password string) error {
+	if !namePattern.MatchString(name) {
+		return ErrName
+	}
+	if name == s.adminName() {
+		return ErrBuiltin
+	}
+	if !ValidRole(role) {
+		return ErrRole
+	}
+	s.lock.Lock()
+	defer s.lock.Unlock()
+	u, exists := s.users[name]
+	if !exists && password == "" {
+		return ErrPassword
+	}
+	if password != "" {
+		if len([]rune(password)) < MinPasswordLength {
+			return ErrPassword
+		}
+		salt := make([]byte, 16)
+		if _, err := rand.Read(salt); err != nil {
+			return err
+		}
+		u.Salt = base64.StdEncoding.EncodeToString(salt)
+		u.Hash = base64.StdEncoding.EncodeToString(hash(salt, password))
+	}
+	if !exists {
+		u.Name = name
+		u.Created = time.Now().Unix()
+	}
+	u.Role = role
+	old, had := s.users[name]
+	s.users[name] = u
+	if err := s.save(); err != nil {
+		if had {
+			s.users[name] = old
+		} else {
+			delete(s.users, name)
+		}
+		return err
+	}
+	return nil
+}
+
+// Delete removes an account.
+func (s *Store) Delete(name string) error {
+	if name == s.adminName() {
+		return ErrBuiltin
+	}
+	s.lock.Lock()
+	defer s.lock.Unlock()
+	old, ok := s.users[name]
+	if !ok {
+		return ErrUnknown
+	}
+	delete(s.users, name)
+	if err := s.save(); err != nil {
+		s.users[name] = old
+		return err
+	}
+	return nil
+}
+
+// save writes the list atomically, readable only by the owner.
+func (s *Store) save() error {
+	list := make([]stored, 0, len(s.users))
+	for _, u := range s.users {
+		list = append(list, u)
+	}
+	sort.Slice(list, func(i, j int) bool { return list[i].Name < list[j].Name })
+	data, err := json.MarshalIndent(list, "", "  ")
+	if err != nil {
+		return err
+	}
+	if err := os.MkdirAll(filepath.Dir(s.path), 0o700); err != nil {
+		return err
+	}
+	tmp := s.path + ".tmp"
+	if err := os.WriteFile(tmp, data, 0o600); err != nil {
+		return err
+	}
+	return os.Rename(tmp, s.path)
+}
diff --git a/users/users_test.go b/users/users_test.go
new file mode 100644
index 0000000..619a6ab
--- /dev/null
+++ b/users/users_test.go
@@ -0,0 +1,63 @@
+package users
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestStore(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "users.json")
+	s, err := New(path, func() (string, string) { return "admin", "adminpass" })
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !s.Check("admin", "adminpass") || s.Check("admin", "x") || s.Role("admin") != Admin {
+		t.Fatal("configured administrator")
+	}
+	if err := s.Set("admin", Viewer, "whatever1"); err != ErrBuiltin {
+		t.Fatalf("the administrator must not be changed: %v", err)
+	}
+	if err := s.Set("op", Operator, "short"); err != ErrPassword {
+		t.Fatalf("short password: %v", err)
+	}
+	if err := s.Set("bad name", Operator, "longenough"); err != ErrName {
+		t.Fatalf("name: %v", err)
+	}
+	if err := s.Set("op", "king", "longenough"); err != ErrRole {
+		t.Fatalf("role: %v", err)
+	}
+	if err := s.Set("op", Operator, "longenough"); err != nil {
+		t.Fatal(err)
+	}
+	if !s.Check("op", "longenough") || s.Check("op", "longenougH") || s.Check("nobody", "longenough") {
+		t.Fatal("check")
+	}
+	// role change keeps the password
+	if err := s.Set("op", Viewer, ""); err != nil || s.Role("op") != Viewer || !s.Check("op", "longenough") {
+		t.Fatalf("role change: %v", err)
+	}
+	if fi, err := os.Stat(path); err != nil || fi.Mode().Perm() != 0o600 {
+		t.Fatalf("file mode: %v %v", fi.Mode(), err)
+	}
+	data, _ := os.ReadFile(path)
+	if len(data) == 0 || strings.Contains(string(data), "longenough") {
+		t.Fatal("the password must not be stored")
+	}
+
+	// reload from disk
+	s2, err := New(path, func() (string, string) { return "admin", "adminpass" })
+	if err != nil || s2.Role("op") != Viewer || !s2.Check("op", "longenough") {
+		t.Fatalf("reload: %v", err)
+	}
+	if l := s2.List(); len(l) != 2 || !l[0].Builtin || l[1].Name != "op" {
+		t.Fatalf("list %+v", l)
+	}
+	if err := s2.Delete("op"); err != nil || s2.Role("op") != "" || s2.Check("op", "longenough") {
+		t.Fatalf("delete: %v", err)
+	}
+	if err := s2.Delete("admin"); err != ErrBuiltin {
+		t.Fatal("the administrator must not be deleted")
+	}
+}
