+++ b/restream/handover_test.go
@@ -0,0 +1,41 @@
+package restream
+
+import (
+	"reflect"
+	"strings"
+	"testing"
+)
+
+func TestHandoverPath(t *testing.T) {
+	main := strings.Fields("-init_hw_device cuda=gpu:0 -i srt://localhost:6000?mode=caller&streamid=a -codec:v h264_nvenc -f tee [f=flv]rtmp://localhost:1935/abc.stream?token=x")
+	if p := handoverPath(main); p != "/abc.stream" {
+		t.Fatalf("got %q", p)
+	}
+	want := strings.Fields("-init_hw_device cuda=gpu:0 -i srt://localhost:6000?mode=caller&streamid=a -codec:v h264_nvenc -f tee [f=flv]rtmp://localhost:1935/abc_next.stream?token=x")
+	if got := handoverArgs(main, "/abc.stream", rtmpNextPath("/abc.stream")); !reflect.DeepEqual(got, want) {
+		t.Fatalf("got %v", got)
+	}
+	if !strings.Contains(main[len(main)-1], "/abc.stream") {
+		t.Fatal("handoverArgs changed its input")
+	}
+
+	for _, s := range []string{
+		// also publishes to the internal SRT server: a second publisher would be refused
+		"-i srt://x -f tee [f=flv]rtmp://localhost:1935/abc.stream?token=x|[f=mpegts]srt://localhost:6000?mode=caller&streamid=abc,mode:publish",
+		// reads the channel (watch, HLS, YouTube): the input is not an output
+		"-i rtmp://localhost:1935/abc.stream -f null -",
+		"-i rtmp://localhost:1935/abc.stream -c copy -f flv rtmps://a.rtmps.youtube.com/live2/key",
+		// fallbacks restart the classic way
+		"-i a.jpg -f flv rtmp://localhost:1935/abc_fallback2.stream",
+		"-i rtmp://localhost/live -f flv rtmp://127.0.0.1:1935/abc_fallback.stream",
+		// not the internal server
+		"-i srt://x -f flv rtmp://a.rtmp.youtube.com/live2/abc.stream",
+	} {
+		if p := handoverPath(strings.Fields(s)); p != "" {
+			t.Fatalf("%q: got %q", s, p)
+		}
+	}
+	if p := handoverPath(strings.Fields("-i srt://x -f flv rtmp://127.0.0.1:11935/live/abc.stream")); p != "/live/abc.stream" {
+		t.Fatalf("got %q", p)
+	}
+}
