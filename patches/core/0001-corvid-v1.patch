+func TestFailoverGraceWithoutFallback(t *testing.T) {
+	srv, _ := New(Config{Failover: &FailoverConfig{Enable: true, Grace: 1500 * time.Millisecond, RecoverAfter: time.Second}})
+	s := srv.(*server)
+	cd := codecs(t)
+	var stop atomic.Bool
+	q := addChannel(s, "/live/x.stream", cd)
+	go publisher(q, 'A', 0, &stop)
+
+	d := newFailoverDemuxer(s, s.failover, "/live/x.stream")
+	defer d.Close()
+	d.Streams()
+	for i := 0; i < 10; i++ {
+		d.ReadPacket()
+	}
+	// Ingest restarts within the grace period: the player survives.
+	stop.Store(true)
+	removeChannel(s, "/live/x.stream", q)
+	time.Sleep(500 * time.Millisecond)
+	stop.Store(false)
+	q2 := addChannel(s, "/live/x.stream", cd)
+	go publisher(q2, 'B', 0, &stop)
+	for {
+		pkt, err := d.ReadPacket()
+		if err != nil {
+			t.Fatalf("player dropped during ingest restart: %v", err)
+		}
+		if pkt.Data[len(pkt.Data)-1] == 'B' {
+			break
+		}
+	}
+	// Ingest gone for longer than grace: EOF (egress process reconnect logic takes over).
+	stop.Store(true)
+	removeChannel(s, "/live/x.stream", q2)
+	start := time.Now()
+	for {
+		if _, err := d.ReadPacket(); err != nil {
+			break
+		}
+	}
+	if time.Since(start) < time.Second {
+		t.Fatal("grace not honoured")
+	}
+}
