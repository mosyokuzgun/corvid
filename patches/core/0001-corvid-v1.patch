@@ -0,0 +1,40 @@
+package seal
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestSealOpen(t *testing.T) {
+	plain := []byte(`{"format":"restreamer-backup","processes":[{"key":"secret"}]}`)
+	if _, err := Seal("short", plain); err != ErrPassword {
+		t.Fatalf("short password: %v", err)
+	}
+	e, err := Seal("correct horse", plain)
+	if err != nil {
+		t.Fatal(err)
+	}
+	data, _ := json.Marshal(e)
+	if !IsSealed(data) || IsSealed(plain) {
+		t.Fatal("IsSealed")
+	}
+	var back Envelope
+	if err := json.Unmarshal(data, &back); err != nil {
+		t.Fatal(err)
+	}
+	out, err := Open("correct horse", &back)
+	if err != nil || string(out) != string(plain) {
+		t.Fatalf("open: %v %s", err, out)
+	}
+	if _, err := Open("correct horsE", &back); err != ErrOpen {
+		t.Fatalf("wrong password: %v", err)
+	}
+	back.Data[3] ^= 1
+	if _, err := Open("correct horse", &back); err != ErrOpen {
+		t.Fatalf("damaged: %v", err)
+	}
+	back.Memory = 1 << 30
+	if _, err := Open("correct horse", &back); err != ErrFormat {
+		t.Fatalf("absurd parameters must be refused: %v", err)
+	}
+}
