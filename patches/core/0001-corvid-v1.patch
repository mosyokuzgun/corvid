+func TestFailoverChainBackupDies(t *testing.T) {
+	srv, _ := New(Config{Failover: &FailoverConfig{Enable: true, Grace: 2 * time.Second, RecoverAfter: 300 * time.Millisecond, Stall: 400 * time.Millisecond}})
+	s := srv.(*server)
+	cd := codecs(t)
+
+	var stopP, stopB, stopS atomic.Bool
+	qp := addChannel(s, "/live/ch.stream", cd)
+	qb := addChannel(s, "/live/ch_fallback.stream", cd)
+	qs := addChannel(s, "/live/ch_fallback2.stream", cd)
+	go publisher(qp, 'P', 100*time.Second, &stopP)
+	go publisher(qb, 'B', 0, &stopB)
+	go publisher(qs, 'S', 0, &stopS)
+	defer stopS.Store(true)
+
+	d := newFailoverDemuxer(s, s.failover, "/live/ch.stream")
+	defer d.Close()
+	if _, err := d.Streams(); err != nil {
+		t.Fatal(err)
+	}
+	c := &chain{t: t, d: d, last: map[int8]time.Duration{}}
+
+	c.read('P', 20)
+	stopP.Store(true)
+	c.read('B', 20)
+	stopB.Store(true) // backup goes silent but stays connected
+	c.read('S', 20)
+}
+
+// A player that (re)starts while the main source is down must start on the slate and move to
+// the main source when it returns. (Regression: the fallback was rejected because there was no
+// output layout yet, so a restarted publication could not start at all during an outage.)
+func TestFailoverStartsOnFallbackWhenPrimaryIsDown(t *testing.T) {
+	srv, _ := New(Config{Failover: &FailoverConfig{Enable: true, Grace: 2 * time.Second, RecoverAfter: 300 * time.Millisecond, Stall: 400 * time.Millisecond}})
+	s := srv.(*server)
+	cd := codecs(t)
+
+	var stopP, stopS atomic.Bool
+	qs := addChannel(s, "/live/ch_fallback2.stream", cd) // only the slate is there
+	go publisher(qs, 'S', 0, &stopS)
+	defer stopS.Store(true)
+
+	d := newFailoverDemuxer(s, s.failover, "/live/ch.stream")
+	defer d.Close()
+	if _, err := d.Streams(); err != nil {
+		t.Fatalf("must start on the slate: %v", err)
+	}
+	c := &chain{t: t, d: d, last: map[int8]time.Duration{}}
+	c.read('S', 20)
+
+	qp := addChannel(s, "/live/ch.stream", cd)
+	go publisher(qp, 'P', 100*time.Second, &stopP)
+	defer stopP.Store(true)
+	c.read('P', 20)
+}
+
+// The slate has other parameter sets than the header: every one of its keyframes carries
+// them, so a decoder that joins while the slate plays can decode. The primary's own
+// keyframes are left untouched.
+func TestFailoverParameterSetsOnEveryForeignKeyframe(t *testing.T) {
+	srv, _ := New(Config{Failover: &FailoverConfig{Enable: true, Grace: 2 * time.Second, RecoverAfter: 300 * time.Millisecond, Stall: 400 * time.Millisecond}})
+	s := srv.(*server)
+	cd := codecs(t)
+	sps2, _ := hex.DecodeString("6764001facd94141fb011000000300100000030320f1429960") // other level
+	pps, _ := hex.DecodeString("68ef8fcb")
+	v2, err := h264parser.NewCodecDataFromSPSAndPPS(sps2, pps)
+	if err != nil {
+		t.Fatal(err)
+	}
+	cd2 := []av.CodecData{v2, cd[1]}
+
+	var stopP, stopS atomic.Bool
+	qp := addChannel(s, "/live/ch.stream", cd)
+	qs := addChannel(s, "/live/ch_fallback2.stream", cd2)
+	go publisher(qp, 'P', 100*time.Second, &stopP)
+	go publisher(qs, 'S', 0, &stopS)
+	defer stopS.Store(true)
+
+	d := newFailoverDemuxer(s, s.failover, "/live/ch.stream")
+	defer d.Close()
+	if _, err := d.Streams(); err != nil {
+		t.Fatal(err)
+	}
+	check := func(want byte, n int, injected bool) {
+		t.Helper()
+		keys := 0
+		deadline := time.Now().Add(5 * time.Second)
+		for keys < n {
+			if time.Now().After(deadline) {
+				t.Fatalf("timeout waiting for %c", want)
+			}
+			pkt, err := d.ReadPacket()
+			if err != nil {
+				t.Fatal(err)
+			}
+			if pkt.Idx != 0 || pkt.Data[len(pkt.Data)-1] != want {
+				continue
+			}
+			has := bytes.HasPrefix(pkt.Data, append([]byte{0, 0, 0, byte(len(sps2))}, sps2...))
+			if pkt.IsKeyFrame {
+				keys++
+				if has != injected {
+					t.Fatalf("%c keyframe %d: injected=%v, want %v", want, keys, has, injected)
+				}
+			} else if has {
+				t.Fatalf("%c: parameter sets on a non-keyframe", want)
+			}
+		}
+	}
+	check('P', 3, false)
+	stopP.Store(true)
+	removeChannel(s, "/live/ch.stream", qp)
+	check('S', 4, true) // every slate keyframe, not only the first
+}
+
+// An ingest that restarts on a stale HLS playlist replays a few seconds of old media at once
+// and then stops. The player stays on the fallback instead of flashing the old pictures; it
+// goes back only once the primary delivers at real time.
+func TestFailoverIgnoresBacklogBurst(t *testing.T) {
+	srv, _ := New(Config{Failover: &FailoverConfig{Enable: true, Grace: 2 * time.Second, RecoverAfter: time.Second, Stall: 400 * time.Millisecond}})
+	s := srv.(*server)
+	cd := codecs(t)
+
+	var stopP, stopS, stopP2 atomic.Bool
+	qp := addChannel(s, "/live/ch.stream", cd)
+	qs := addChannel(s, "/live/ch_fallback2.stream", cd)
+	go publisher(qp, 'P', 100*time.Second, &stopP)
+	go publisher(qs, 'S', 0, &stopS)
+	defer stopS.Store(true)
+
+	d := newFailoverDemuxer(s, s.failover, "/live/ch.stream")
+	defer d.Close()
+	var switches []string
+	d.onSwitch = func(from, to string) {
+		switches = append(switches, to)
+		if from != "" && d.Reason() == "" {
+			t.Errorf("switch from %s to %s without a reason", from, to)
+		}
+	}
+	if _, err := d.Streams(); err != nil {
+		t.Fatal(err)
+	}
+	c := &chain{t: t, d: d, last: map[int8]time.Duration{}}
+	c.read('P', 10)
+	stopP.Store(true) // the source is gone, the ingest stays connected: stall -> slate
+	c.read('S', 10)
+	removeChannel(s, "/live/ch.stream", qp) // the ingest gives up and restarts
+
+	// The restarted ingest replays 6 s of old media at 4x and then has nothing more.
+	qb := addChannel(s, "/live/ch.stream", cd)
+	go burst(qb, 'B', 200*time.Second, 6*time.Second, 4)
+	deadline := time.Now().Add(2500 * time.Millisecond)
+	for time.Now().Before(deadline) {
+		pkt, err := d.ReadPacket()
+		if err != nil {
+			t.Fatal(err)
+		}
+		if pkt.Data[len(pkt.Data)-1] == 'B' {
+			t.Fatalf("switched to the replayed backlog (switches=%v)", switches)
+		}
+	}
+	removeChannel(s, "/live/ch.stream", qb)
+
+	// Now the source is really back.
+	qp2 := addChannel(s, "/live/ch.stream", cd)
+	go publisher(qp2, 'R', 300*time.Second, &stopP2)
+	defer stopP2.Store(true)
+	c.read('R', 10)
+}
+
+// The time that passes while the stall is detected must not become a hole in the output
+// timestamps: browsers' HLS players freeze at such a gap instead of showing the fallback.
+func TestFailoverNoTimelineGapOnStall(t *testing.T) {
+	srv, _ := New(Config{Failover: &FailoverConfig{Enable: true, Grace: 2 * time.Second, RecoverAfter: 300 * time.Millisecond, Stall: 800 * time.Millisecond}})
+	s := srv.(*server)
+	cd := codecs(t)
+	var stopP, stopS atomic.Bool
+	qp := addChannel(s, "/live/ch.stream", cd)
+	qs := addChannel(s, "/live/ch_fallback2.stream", cd)
+	go publisher(qp, 'P', 100*time.Second, &stopP)
+	go publisher(qs, 'S', 0, &stopS)
+	defer stopS.Store(true)
+	_ = qp
+
+	d := newFailoverDemuxer(s, s.failover, "/live/ch.stream")
+	defer d.Close()
+	if _, err := d.Streams(); err != nil {
+		t.Fatal(err)
+	}
+	var lastV time.Duration
+	seenS := 0
+	stopped := false
+	deadline := time.Now().Add(6 * time.Second)
+	for seenS < 10 {
+		if time.Now().After(deadline) {
+			t.Fatal("timeout")
+		}
+		pkt, err := d.ReadPacket()
+		if err != nil {
+			t.Fatal(err)
+		}
+		if pkt.Idx == 0 {
+			if lastV != 0 && pkt.Time-lastV > 200*time.Millisecond {
+				t.Fatalf("hole of %v in the video timeline at the switch", pkt.Time-lastV)
+			}
+			lastV = pkt.Time
+			if !stopped && pkt.Time > 0 {
+				if n := int(pkt.Time / (40 * time.Millisecond)); n > 15 {
+					stopP.Store(true) // primary goes silent, stays connected
+					stopped = true
+				}
+			}
+		}
+		if pkt.Data[len(pkt.Data)-1] == 'S' {
+			seenS++
+		}
+	}
+}
+
+// A process saved with new settings publishes "_next" while the old one still runs: players
+// move to it at a keyframe without ever seeing the fallback, and stay there when the old
+// process stops.
+func TestFailoverSeamlessRestart(t *testing.T) {
+	srv, _ := New(Config{Failover: &FailoverConfig{Enable: true, Grace: 2 * time.Second, RecoverAfter: 300 * time.Millisecond, Stall: time.Second}})
+	s := srv.(*server)
+	cd := codecs(t)
+
+	var stopP, stopN, stopF atomic.Bool
+	qp := addChannel(s, "/live/ch.stream", cd)
+	qf := addChannel(s, "/live/ch_fallback2.stream", cd)
+	go publisher(qp, 'P', 100*time.Second, &stopP)
+	go publisher(qf, 'F', 0, &stopF)
+	defer stopF.Store(true)
+
+	d := newFailoverDemuxer(s, s.failover, "/live/ch.stream")
+	defer d.Close()
+	var switches []string
+	d.onSwitch = func(from, to string) { switches = append(switches, to+" ("+d.Reason()+")") }
+	if _, err := d.Streams(); err != nil {
+		t.Fatal(err)
+	}
+
+	last := map[int8]time.Duration{}
+	read := func(want byte, n int) {
+		t.Helper()
+		got := 0
+		deadline := time.Now().Add(6 * time.Second)
+		for got < n {
+			if time.Now().After(deadline) {
+				t.Fatalf("timeout waiting for %c (switches=%v)", want, switches)
+			}
+			pkt, err := d.ReadPacket()
+			if err != nil {
+				t.Fatal(err)
+			}
+			if pkt.Time < last[pkt.Idx] {
+				t.Fatalf("non-monotonic ts")
+			}
+			last[pkt.Idx] = pkt.Time
+			tag := pkt.Data[len(pkt.Data)-1]
+			if tag == 'F' {
+				t.Fatalf("the fallback was shown (switches=%v)", switches)
+			}
+			if tag == want {
+				got++
+			}
+		}
+	}
+
+	read('P', 10)
+	qn := addChannel(s, "/live/ch_next.stream", cd)
+	go publisher(qn, 'N', 7*time.Second, &stopN)
+	read('N', 30) // after HandoverAfter, at a keyframe, while P still publishes
+	stopP.Store(true)
+	removeChannel(s, "/live/ch.stream", qp)
+	read('N', 30) // the old process is gone: nothing changes
+
+	if len(switches) != 1 || !strings.HasPrefix(switches[0], "/live/ch_next.stream (restarted") {
+		t.Fatalf("unexpected switches %v", switches)
+	}
+
+	// Saved again: the newer process publishes the normal name next to "_next".
+	stopP.Store(false)
+	qp2 := addChannel(s, "/live/ch.stream", cd)
+	go publisher(qp2, 'Q', 200*time.Second, &stopP)
+	defer stopP.Store(true)
+	read('Q', 30)
+	stopN.Store(true)
+	removeChannel(s, "/live/ch_next.stream", qn)
+	read('Q', 30)
+	if len(switches) != 2 || !strings.HasPrefix(switches[1], "/live/ch.stream (restarted") {
+		t.Fatalf("unexpected switches %v", switches)
+	}
+}
