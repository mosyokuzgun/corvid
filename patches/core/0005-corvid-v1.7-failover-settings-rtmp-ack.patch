+package api
+
+import (
+	"net/http"
+
+	"github.com/datarhei/core/v16/http/api"
+	"github.com/datarhei/core/v16/http/handler/util"
+	"github.com/datarhei/core/v16/rtmp"
+
+	"github.com/labstack/echo/v4"
+)
+
+// FailoverHandler reads and sets the stall times of the RTMP failover (fork).
+type FailoverHandler struct {
+	store *rtmp.SettingsStore
+}
+
+func NewFailover(store *rtmp.SettingsStore) *FailoverHandler {
+	return &FailoverHandler{store: store}
+}
+
+func (h *FailoverHandler) Get(c echo.Context) error {
+	return c.JSON(http.StatusOK, h.store.State())
+}
+
+func (h *FailoverHandler) Set(c echo.Context) error {
+	var req rtmp.FailoverSettings
+	if err := util.ShouldBindJSON(c, &req); err != nil {
+		return api.Err(http.StatusBadRequest, "", "Invalid JSON: %s", err.Error())
+	}
+	st, err := h.store.Set(req)
+	if err != nil {
+		return api.Err(http.StatusBadRequest, "", "%s", err.Error())
+	}
+	return c.JSON(http.StatusOK, st)
+}
