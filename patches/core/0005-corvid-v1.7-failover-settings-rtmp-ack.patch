diff --git a/rtmp/settings.go b/rtmp/settings.go
new file mode 100644
index 0000000..1b4e3c6
--- /dev/null
+++ b/rtmp/settings.go
@@ -0,0 +1,124 @@
+package rtmp
+
+// Run-time failover settings changed in the panel (fork). They are kept in a small JSON file
+// next to the database and applied at start, over the CORE_RTMP_FAILOVER_* defaults.
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"sync"
+	"time"
+)
+
+// FailoverSettings are the stall times in whole seconds.
+type FailoverSettings struct {
+	// StallSeconds: a connected primary that sends nothing for this long counts as lost
+	// and the viewers move to the backup. 0 = only a disconnect counts.
+	StallSeconds int `json:"stall_seconds"`
+	// FallbackStallSeconds: the same for the backup; the viewers move on to the waiting
+	// picture. A longer time rides out short gaps of a flaky backup line.
+	FallbackStallSeconds int `json:"fallback_stall_seconds"`
+}
+
+const (
+	maxStallSeconds = 60
+)
+
+func (f FailoverSettings) Validate() error {
+	if f.StallSeconds < 0 || f.StallSeconds > maxStallSeconds {
+		return fmt.Errorf("stall_seconds must be between 0 and %d", maxStallSeconds)
+	}
+	if f.FallbackStallSeconds < 1 || f.FallbackStallSeconds > maxStallSeconds {
+		return fmt.Errorf("fallback_stall_seconds must be between 1 and %d", maxStallSeconds)
+	}
+	return nil
+}
+
+// FailoverState is what the API returns.
+type FailoverState struct {
+	Enabled  bool             `json:"enabled"`
+	Current  FailoverSettings `json:"current"`
+	Defaults FailoverSettings `json:"defaults"`
+}
+
+// SettingsStore keeps the failover settings of a server.
+type SettingsStore struct {
+	path     string
+	srv      Server
+	defaults FailoverSettings
+	mu       sync.Mutex
+}
+
+func seconds(d time.Duration) int { return int((d + time.Second/2) / time.Second) }
+
+// NewSettingsStore remembers the server's current (start) values as the defaults.
+func NewSettingsStore(path string, srv Server) *SettingsStore {
+	st, fb := srv.FailoverStall()
+	return &SettingsStore{path: path, srv: srv, defaults: FailoverSettings{StallSeconds: seconds(st), FallbackStallSeconds: max(1, seconds(fb))}}
+}
+
+// Apply loads the stored settings, if there are any, and applies them.
+func (s *SettingsStore) Apply() error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	data, err := os.ReadFile(s.path)
+	if errors.Is(err, os.ErrNotExist) {
+		return nil
+	}
+	if err != nil {
+		return err
+	}
+	var f FailoverSettings
+	if err := json.Unmarshal(data, &f); err != nil {
+		return fmt.Errorf("%s: %w", s.path, err)
+	}
+	if err := f.Validate(); err != nil {
+		return fmt.Errorf("%s: %w", s.path, err)
+	}
+	s.apply(f)
+	return nil
+}
+
+func (s *SettingsStore) apply(f FailoverSettings) {
+	s.srv.SetFailoverStall(time.Duration(f.StallSeconds)*time.Second, time.Duration(f.FallbackStallSeconds)*time.Second)
+}
+
+func (s *SettingsStore) State() FailoverState {
+	st, fb := s.srv.FailoverStall()
+	return FailoverState{
+		Enabled:  s.srv.SeamlessRestart(),
+		Current:  FailoverSettings{StallSeconds: seconds(st), FallbackStallSeconds: max(1, seconds(fb))},
+		Defaults: s.defaults,
+	}
+}
+
+// Set validates, stores and applies the settings (also for connected viewers).
+func (s *SettingsStore) Set(f FailoverSettings) (FailoverState, error) {
+	if err := f.Validate(); err != nil {
+		return FailoverState{}, err
+	}
+
+	s.mu.Lock()
+	data, _ := json.MarshalIndent(f, "", "  ")
+	tmp := s.path + ".tmp"
+	err := os.MkdirAll(filepath.Dir(s.path), 0755)
+	if err == nil {
+		err = os.WriteFile(tmp, data, 0644)
+	}
+	if err == nil {
+		err = os.Rename(tmp, s.path)
+	}
+	if err == nil {
+		s.apply(f)
+	}
+	s.mu.Unlock()
+
+	if err != nil {
+		return FailoverState{}, err
+	}
+	return s.State(), nil
+}
