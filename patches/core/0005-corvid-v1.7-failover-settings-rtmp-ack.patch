+// readOnly is read, but fails as soon as a packet of the forbidden source shows up.
+func (c *chain) readOnly(want, forbid byte, n int) {
+	c.t.Helper()
+	got := 0
+	deadline := time.Now().Add(8 * time.Second)
+	for got < n {
+		if time.Now().After(deadline) {
+			c.t.Fatalf("timeout waiting for %c", want)
+		}
+		pkt, err := c.d.ReadPacket()
+		if err != nil {
+			c.t.Fatal(err)
+		}
+		switch pkt.Data[len(pkt.Data)-1] {
+		case forbid:
+			c.t.Fatalf("switched to %c", forbid)
+		case want:
+			got++
+		}
+	}
+}
