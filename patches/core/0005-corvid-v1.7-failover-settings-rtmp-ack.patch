@@ -0,0 +1,60 @@
+package rtmp
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+)
+
+func TestFailoverSettingsStore(t *testing.T) {
+	dir := t.TempDir()
+	path := filepath.Join(dir, "failover.json")
+	srv, _ := New(Config{Failover: &FailoverConfig{Enable: true, Stall: 3 * time.Second}})
+
+	st := NewSettingsStore(path, srv)
+	if err := st.Apply(); err != nil { // no file yet: the start values stay
+		t.Fatal(err)
+	}
+	if s := st.State(); s.Current.StallSeconds != 3 || s.Current.FallbackStallSeconds != 3 || s.Defaults.StallSeconds != 3 || !s.Enabled {
+		t.Fatalf("unexpected state %+v", s)
+	}
+
+	if _, err := st.Set(FailoverSettings{StallSeconds: 3, FallbackStallSeconds: 0}); err == nil {
+		t.Fatal("fallback 0 accepted")
+	}
+	if _, err := st.Set(FailoverSettings{StallSeconds: 61, FallbackStallSeconds: 5}); err == nil {
+		t.Fatal("stall 61 accepted")
+	}
+
+	s, err := st.Set(FailoverSettings{StallSeconds: 2, FallbackStallSeconds: 10})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if s.Current.StallSeconds != 2 || s.Current.FallbackStallSeconds != 10 || s.Defaults.FallbackStallSeconds != 3 {
+		t.Fatalf("unexpected state %+v", s)
+	}
+	if a, b := srv.FailoverStall(); a != 2*time.Second || b != 10*time.Second {
+		t.Fatalf("server not updated: %v %v", a, b)
+	}
+
+	// a restart: a new server with the env defaults, the stored file wins
+	srv2, _ := New(Config{Failover: &FailoverConfig{Enable: true, Stall: 3 * time.Second}})
+	st2 := NewSettingsStore(path, srv2)
+	if err := st2.Apply(); err != nil {
+		t.Fatal(err)
+	}
+	if a, b := srv2.FailoverStall(); a != 2*time.Second || b != 10*time.Second {
+		t.Fatalf("stored settings not applied: %v %v", a, b)
+	}
+
+	// a broken file is reported and changes nothing
+	os.WriteFile(path, []byte("{"), 0644)
+	srv3, _ := New(Config{Failover: &FailoverConfig{Enable: true, Stall: 3 * time.Second}})
+	if err := NewSettingsStore(path, srv3).Apply(); err == nil {
+		t.Fatal("broken file accepted")
+	}
+	if a, _ := srv3.FailoverStall(); a != 3*time.Second {
+		t.Fatalf("broken file changed the server: %v", a)
+	}
+}
