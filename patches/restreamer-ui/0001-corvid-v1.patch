+		} catch (err) {
+			path = '';
+		}
+		setUploading(false);
+		if (!path) {
+			setUploadError(true);
+			return;
+		}
+		const W = even(latest.current.width);
+		const list = (latest.current.layers || []).map(L.initLayer);
+		handleChange({
