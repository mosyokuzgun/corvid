diff --git a/src/misc/controls/Record.js b/src/misc/controls/Record.js
new file mode 100644
index 0000000..6961919
--- /dev/null
+++ b/src/misc/controls/Record.js
@@ -0,0 +1,224 @@
+import React from 'react';
+
+import { Trans } from '@lingui/macro';
+import Alert from '@mui/material/Alert';
+import Box from '@mui/material/Box';
+import Button from '@mui/material/Button';
+import Grid from '@mui/material/Grid';
+import Link from '@mui/material/Link';
+import MenuItem from '@mui/material/MenuItem';
+import TextField from '@mui/material/TextField';
+import Typography from '@mui/material/Typography';
+
+import Checkbox from '../Checkbox';
+import Select from '../Select';
+import RestreamerContext from '../../contexts/Restreamer';
+
+// Recording (fork): a helper process copies what is on air (the program, including the
+// fallback) into files of a fixed length on the disk. Nothing is encoded, so it costs no GPU.
+// Files older than the retention time are removed by the core.
+
+function init(settings) {
+	return {
+		enable: false,
+		auto: false,
+		secret: '',
+		format: 'mp4',
+		minutes: 60,
+		days: 7,
+		files: 0,
+		prefix: '',
+		...settings,
+	};
+}
+
+function newSecret() {
+	const a = new Uint8Array(12);
+	if (typeof window !== 'undefined' && window.crypto && window.crypto.getRandomValues) {
+		window.crypto.getRandomValues(a);
+	} else {
+		for (let i = 0; i < a.length; i++) {
+			a[i] = Math.floor(Math.random() * 256);
+		}
+	}
+	return Array.from(a, (b) => b.toString(16).padStart(2, '0')).join('');
+}
+
+export function formatSize(bytes) {
+	if (bytes >= 1024 * 1024 * 1024) {
+		return (bytes / (1024 * 1024 * 1024)).toFixed(2) + ' GB';
+	}
+	return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
+}
+
+export default function Control(props) {
+	const settings = init(props.settings);
+	const ctx = React.useContext(RestreamerContext) || {};
+	const [$files, setFiles] = React.useState(null);
+	const [$busy, setBusy] = React.useState(false);
+
+	// Set the defaults
+	React.useEffect(() => {
+		props.onChange(settings, true);
+		// eslint-disable-next-line react-hooks/exhaustive-deps
+	}, []);
+
+	const handleChange = (what) => (event) => {
+		if (what === 'auto') {
+			settings.auto = !settings.auto;
+		} else if (what === 'enable') {
+			settings.enable = !settings.enable;
+			if (settings.enable && !settings.secret) {
+				settings.secret = newSecret();
+			}
+		} else {
+			settings[what] = event.target.value;
+		}
+
+		props.onChange(settings, false);
+	};
+
+	const load = async () => {
+		if (!ctx.recordings) {
+			return;
+		}
+		setBusy(true);
+		setFiles(await ctx.recordings(settings));
+		setBusy(false);
+	};
+
+	const remove = (name) => async () => {
+		setBusy(true);
+		await ctx.deleteRecording(settings, name);
+		setFiles(await ctx.recordings(settings));
+		setBusy(false);
+	};
+
+	const total = $files ? $files.reduce((sum, f) => sum + f.size, 0) : 0;
+
+	return (
+		<Grid container spacing={2}>
+			<Grid item xs={12}>
+				<Checkbox label={<Trans>Record the stream</Trans>} checked={settings.enable} onChange={handleChange('enable')} />
+				<Typography variant="caption" component="div">
+					<Trans>
+						Stores what is on air (including the fallback) in files on the disk, without encoding it again. Start and stop it with the record button
+						below the player; disconnecting the channel stops it too.
+					</Trans>
+				</Typography>
+				<Checkbox
+					label={<Trans>Start recording automatically when the channel is connected</Trans>}
+					checked={settings.auto}
+					disabled={!settings.enable}
+					onChange={handleChange('auto')}
+				/>
+			</Grid>
+			<Grid item xs={12} md={4}>
+				<Select label={<Trans>File format</Trans>} disabled={!settings.enable} value={settings.format} onChange={handleChange('format')}>
+					<MenuItem value="mp4">MP4</MenuItem>
+					<MenuItem value="mkv">MKV</MenuItem>
+					<MenuItem value="ts">MPEG-TS</MenuItem>
+				</Select>
+				<Typography variant="caption">
+					<Trans>MP4 plays everywhere. MPEG-TS is the most robust if the backup stream comes from a different encoder.</Trans>
+				</Typography>
+			</Grid>
+			<Grid item xs={12} md={4}>
+				<TextField
+					variant="outlined"
+					fullWidth
+					type="number"
+					label={<Trans>File length (minutes)</Trans>}
+					disabled={!settings.enable}
+					value={settings.minutes}
+					onChange={handleChange('minutes')}
+				/>
+				<Typography variant="caption">
+					<Trans>A new file starts after this time. 0 writes one file per recording.</Trans>
+				</Typography>
+			</Grid>
+			<Grid item xs={12} md={4}>
+				<TextField
+					variant="outlined"
+					fullWidth
+					type="number"
+					label={<Trans>Keep for (days)</Trans>}
+					disabled={!settings.enable}
+					value={settings.days}
+					onChange={handleChange('days')}
+				/>
+				<Typography variant="caption">
+					<Trans>Older files are deleted automatically. 0 keeps them forever.</Trans>
+				</Typography>
+			</Grid>
+			<Grid item xs={12} md={4}>
+				<TextField
+					variant="outlined"
+					fullWidth
+					type="number"
+					label={<Trans>Keep at most (files)</Trans>}
+					disabled={!settings.enable}
+					value={settings.files}
+					onChange={handleChange('files')}
+				/>
+				<Typography variant="caption">
+					<Trans>The oldest files are deleted beyond this number. 0 means no limit. Use it to cap the disk space.</Trans>
+				</Typography>
+			</Grid>
+			<Grid item xs={12} md={4}>
+				<TextField
+					variant="outlined"
+					fullWidth
+					label={<Trans>File name prefix</Trans>}
+					disabled={!settings.enable}
+					value={settings.prefix}
+					onChange={handleChange('prefix')}
+				/>
+				<Typography variant="caption">
+					<Trans>Letters and digits, e.g. "studyo". The start time follows it.</Trans>
+				</Typography>
+			</Grid>
+			{settings.secret && ctx.recordings && (
+				<Grid item xs={12}>
+					<Button variant="outlined" size="small" disabled={$busy} onClick={load}>
+						<Trans>Show recordings</Trans>
+					</Button>
+					{$files !== null && $files.length === 0 && (
+						<Alert severity="info" sx={{ mt: 1 }}>
+							<Trans>There are no recordings yet.</Trans>
+						</Alert>
+					)}
+					{$files !== null && $files.length !== 0 && (
+						<Box sx={{ mt: 1 }}>
+							<Typography variant="caption" component="div">
+								<Trans>Files</Trans>: {$files.length} · {formatSize(total)}
+							</Typography>
+							<Typography variant="caption" component="div">
+								<Trans>
+									The file names carry the start time in the server's clock; the date next to them is your local time.
+								</Trans>
+							</Typography>
+							{$files.map((f) => (
+								<Box key={f.name} sx={{ display: 'flex', alignItems: 'center', gap: 1, fontFamily: 'monospace', fontSize: '0.8rem' }}>
+									<Link href={f.url} target="_blank" rel="noreferrer" download={f.name} sx={{ flexGrow: 1 }}>
+										{f.name}
+									</Link>
+									{f.date && <span>{f.date.toLocaleString()}</span>}
+									<span>{formatSize(f.size)}</span>
+									<Button size="small" color="secondary" disabled={$busy} onClick={remove(f.name)}>
+										<Trans>Delete</Trans>
+									</Button>
+								</Box>
+							))}
+						</Box>
+					)}
+				</Grid>
+			)}
+		</Grid>
+	);
+}
+
+Control.defaulProps = {
+	settings: {},
+	onChange: function (settings, automatic) {},
+};
