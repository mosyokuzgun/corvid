diff --git a/src/misc/ActionButton.test.js b/src/misc/ActionButton.test.js
new file mode 100644
index 0000000..5655992
--- /dev/null
+++ b/src/misc/ActionButton.test.js
@@ -0,0 +1,38 @@
+import React from 'react';
+import { render, screen } from '@testing-library/react';
+import { i18n } from '@lingui/core';
+import { I18nProvider } from '@lingui/react';
+
+import ActionButton from './ActionButton';
+
+i18n.load('en', {});
+i18n.activate('en');
+
+const show = (props) => {
+	const { unmount } = render(
+		<I18nProvider i18n={i18n}>
+			<ActionButton {...props} />
+		</I18nProvider>,
+	);
+	const b = screen.getByRole('button');
+	const res = `${b.textContent}${b.disabled ? ' [disabled]' : ''}`;
+	unmount();
+	return res;
+};
+
+test('the operator can always end a broadcast that is meant to run', () => {
+	// connecting (also while the fallback is on air): it can be stopped
+	expect(show({ state: 'connecting', order: 'start', cancelable: true })).toBe('Disconnect');
+	// lost, a retry is scheduled
+	expect(show({ state: 'error', order: 'start', reconnect: 5 })).toBe('Disconnect');
+	expect(show({ state: 'connected', order: 'start' })).toBe('Disconnect');
+});
+
+test('a channel that is switched off is connected, not reconnected', () => {
+	expect(show({ state: 'error', order: 'stop', reconnect: -1 })).toBe('Connect');
+	expect(show({ state: 'disconnected', order: 'stop', reconnect: -1 })).toBe('Connect');
+	// meant to run but given up: reconnect
+	expect(show({ state: 'error', order: 'start', reconnect: -1 })).toBe('Reconnect');
+	// elsewhere (no cancel asked for) the old behaviour stays
+	expect(show({ state: 'connecting' })).toBe('Connecting ... [disabled]');
+});
diff --git a/src/misc/AddressHints.js b/src/misc/AddressHints.js
new file mode 100644
index 0000000..6fb4e47
--- /dev/null
+++ b/src/misc/AddressHints.js
@@ -0,0 +1,33 @@
+import React from 'react';
+
+import { Trans } from '@lingui/macro';
+import Alert from '@mui/material/Alert';
+
+import { checkInputAddress } from '../utils/address';
+
+const TEXT = {
+	whitespace: <Trans>The address contains a space or a line break. Remove it.</Trans>,
+	srt_publish: (
+		<Trans>
+			This SRT address is for sending ("mode:publish"). To read the stream here, the stream ID has to end in "mode:request". With "mode:publish" this
+			process connects as a sender and never receives anything.
+		</Trans>
+	),
+	rtmp_no_path: <Trans>The RTMP address has no application or stream name (e.g. rtmp://server/live/name).</Trans>,
+};
+
+// Warnings for an address a process reads from (fork).
+export default function AddressHints(props) {
+	const problems = checkInputAddress(props.address);
+	if (problems.length === 0) {
+		return null;
+	}
+
+	return (
+		<Alert severity="warning" sx={{ mt: 1 }}>
+			{problems.map((p) => (
+				<div key={p}>{TEXT[p] || p}</div>
+			))}
+		</Alert>
+	);
+}
