+++ b/src/views/Help.js
@@ -0,0 +1,312 @@
+import React from 'react';
+import { useNavigate, useParams } from 'react-router-dom';
+
+import { Trans } from '@lingui/macro';
+import Box from '@mui/material/Box';
+import Button from '@mui/material/Button';
+import Grid from '@mui/material/Grid';
+import Link from '@mui/material/Link';
+import Typography from '@mui/material/Typography';
+import ArrowBackIcon from '@mui/icons-material/ArrowBack';
+import ChevronRightIcon from '@mui/icons-material/ChevronRight';
+
+import Paper from '../misc/Paper';
+import Palette from '../theme/base/palette';
+import { ORIGIN, useBrand } from '../utils/brand';
+import * as Version from '../version';
+
+// Help (fork): the application's own help. Short answers to what operators actually ask,
+// in the words the panel uses. Every help button of the panel lands on a section here.
+
+const P = (props) => (
+	<Typography variant="body1" sx={{ maxWidth: '72ch', mb: 1 }}>
+		{props.children}
+	</Typography>
+);
+
+function Question(props) {
+	return (
+		<Box component="details" open={props.open} sx={{ borderTop: `1px solid ${Palette.background.line}`, '&[open] .chev': { transform: 'rotate(90deg)' } }}>
+			<Box
+				component="summary"
+				sx={{
+					minHeight: 48,
+					display: 'flex',
+					alignItems: 'center',
+					gap: 1,
+					cursor: 'pointer',
+					listStyle: 'none',
+					fontWeight: 600,
+					'&::-webkit-details-marker': { display: 'none' },
+				}}
+			>
+				<ChevronRightIcon className="chev" fontSize="small" sx={{ flexShrink: 0, transition: 'transform .15s' }} />
+				{props.q}
+			</Box>
+			<Box sx={{ pl: 3.5, pb: 1.5 }}>{props.children}</Box>
+		</Box>
+	);
+}
+
+function Section(props) {
+	return (
+		<Box component="section" id={`help-${props.id}`} sx={{ mb: 3, scrollMarginTop: 16 }}>
+			<Typography variant="h3" component="h2" sx={{ mb: 1 }}>
+				{props.title}
+			</Typography>
+			{props.children}
+		</Box>
+	);
+}
+
+export default function Help(props) {
+	const navigate = useNavigate();
+	const { section } = useParams();
+	const brand = useBrand(React);
+
+	React.useEffect(() => {
+		const el = document.getElementById(`help-${section || 'first'}`);
+		if (el && section) {
+			el.scrollIntoView();
+		}
+	}, [section]);
+
+	const is = (id) => section === id;
+
+	return (
+		<Grid container justifyContent="center" spacing={1} sx={{ mb: '6em' }}>
+			<Grid item xs={12} sm={12} md={10} lg={8}>
+				<Paper>
+					<Button size="small" color="inherit" startIcon={<ArrowBackIcon />} onClick={() => navigate('/')} sx={{ mb: 1 }}>
+						<Trans>Main screen</Trans>
+					</Button>
+					<Typography variant="h1" sx={{ mb: 0.5 }}>
+						<Trans>Help</Trans>
+					</Typography>
+					<Typography variant="body1" sx={{ color: 'text.secondary', mb: 3 }}>
+						<Trans>Short answers to common questions, in the order of a broadcast day.</Trans>
+					</Typography>
+
+					<Section id="first" title={<Trans>The first broadcast</Trans>}>
+						<Box component="ol" sx={{ pl: 3, m: 0, maxWidth: '72ch', '& li': { mb: 0.75 } }}>
+							<li>
+								<Trans>Point the encoder (OBS, a hardware encoder) at the source address of the channel: SRT or RTMP.</Trans>
+							</li>
+							<li>
+								<Trans>Set a backup stream address and a standby image in the channel settings.</Trans>
+							</li>
+							<li>
+								<Trans>Add a publication: choose the target and paste its stream key.</Trans>
+							</li>
+							<li>
+								<Trans>Run "Check before broadcast", then press Connect. The source starts first, the fallbacks follow.</Trans>
+							</li>
+						</Box>
+					</Section>
+
+					<Section id="main" title={<Trans>Main screen</Trans>}>
+						<Question open={is('main')} q={<Trans>What does the strip under the player show?</Trans>}>
+							<P>
+								<Trans>
+									The three feeds of the channel in the order they are used: source, backup stream, standby image. The lit one is what viewers get. Green: the source is on air.
+									Amber: a fallback is on air.
+								</Trans>
+							</P>
+						</Question>
+						<Question q={<Trans>What does Disconnect stop?</Trans>}>
+							<P>
+								<Trans>Everything of the channel: the source, both fallbacks, the recording and all publications. The fallbacks are for a source that is lost, not for one that is switched off on purpose.</Trans>
+							</P>
+						</Question>
+						<Question q={<Trans>What do the sound meter and its warnings do?</Trans>}>
+							<P>
+								<Trans>
+									The meter shows the level of what viewers hear. The panel warns when the programme has been silent, black or frozen for longer than set; it never switches anything. The limits
+									are behind the settings button next to the meter. The warning works while this page is open.
+								</Trans>
+							</P>
+						</Question>
+						<Question q={<Trans>What does "Check before broadcast" look at?</Trans>}>
+							<P>
+								<Trans>Source, sound, backup stream, standby image, whether the publication targets can be reached, disk space for the recording, the server clock and the encoder load. A stream key can only be tested by a real broadcast.</Trans>
+							</P>
+						</Question>
+					</Section>
+
+					<Section id="channel" title={<Trans>Source and channel settings</Trans>}>
+						<Question open={is('channel')} q={<Trans>Which source should I use?</Trans>}>
+							<P>
+								<Trans>
+									For an encoder that sends to this server, choose the internal SRT or RTMP server and copy the address shown. SRT copes better with a poor network. For a camera or a stream
+									that is fetched, enter its address as a network source.
+								</Trans>
+							</P>
+						</Question>
+						<Question q={<Trans>Copy or encode?</Trans>}>
+							<P>
+								<Trans>
+									Copy passes the source on untouched and uses no encoder. Encoding (NVENC on the graphics card) is needed for a canvas, a different size or a fixed bitrate. Encoding with the
+									same settings for source and fallbacks makes switching smooth.
+								</Trans>
+							</P>
+						</Question>
+						<Question q={<Trans>The SRT picture breaks up or stutters.</Trans>}>
+							<P>
+								<Trans>Look at the packet loss under "Status and tools". Above 1 %, raise the SRT latency in the encoder (500 ms, for instance) or lower its bitrate.</Trans>
+							</P>
+						</Question>
+						<Question q={<Trans>What happens when I save?</Trans>}>
+							<P>
+								<Trans>The processes of the channel are written again with the new settings. A connected channel is interrupted for a few seconds, so change settings outside a broadcast.</Trans>
+							</P>
+						</Question>
+					</Section>
+
+					<Section id="backup" title={<Trans>Backup and standby image</Trans>}>
+						<Question open={is('backup')} q={<Trans>What do viewers see when the source is lost?</Trans>}>
+							<P>
+								<Trans>
+									After 3 s without data the broadcast switches to the backup stream; without a backup stream, to the standby image. When the source has delivered properly for 3 s it switches
+									back by itself. Publications such as YouTube keep running meanwhile.
+								</Trans>
+							</P>
+						</Question>
+						<Question q={<Trans>Where should the backup stream come from?</Trans>}>
+							<P>
+								<Trans>From a second computer or encoder in the room, sent to the backup address in the channel settings. The same size and frame rate as the source make the switch smooth.</Trans>
+							</P>
+						</Question>
+					</Section>
+
+					<Section id="publications" title={<Trans>Publications</Trans>}>
+						<Question open={is('publications')} q={<Trans>How do I add YouTube or another target?</Trans>}>
+							<P>
+								<Trans>Press the plus sign above the publications, choose the target and paste the stream key from that platform. The switch next to a publication starts and stops it.</Trans>
+							</P>
+						</Question>
+						<Question q={<Trans>A publication shows "Error".</Trans>}>
+							<P>
+								<Trans>
+									Mostly the stream key is wrong or the live event is not open on the platform. Paste the key again. If the error stays, open "Status and tools" and look at the events; "Check
+									before broadcast" tells whether the platform can be reached at all.
+								</Trans>
+							</P>
+						</Question>
+						<Question q={<Trans>Does every publication load the graphics card?</Trans>}>
+							<P>
+								<Trans>No. A publication that passes the channel on as it is uses no encoder. Only a publication with its own size or bitrate is encoded.</Trans>
+							</P>
+						</Question>
+					</Section>
+
+					<Section id="player" title={<Trans>Player and player page</Trans>}>
+						<Question open={is('player')} q={<Trans>How do I put the broadcast on a website?</Trans>}>
+							<P>
+								<Trans>The player of the channel has an embed code under its settings (pencil next to "Player"). Colours, logo and poster are set there too. The player page is a ready-made page with the player, for when there is no website.</Trans>
+							</P>
+						</Question>
+					</Section>
+
+					<Section id="recording" title={<Trans>Recording and sharing</Trans>}>
+						<Question open={is('recording')} q={<Trans>Where are the recordings and how long are they kept?</Trans>}>
+							<P>
+								<Trans>On this server. Download or delete them under "Status and tools" &gt; Recordings. How long and how many are kept is set in the channel settings; the oldest file is removed by itself.</Trans>
+							</P>
+						</Question>
+						<Question q={<Trans>How do I let a reporter send a stream?</Trans>}>
+							<P>
+								<Trans>Create a guest key of the kind "send" with a time limit under "Status and tools" &gt; Keys and pass on the address shown. When the time is up or the key is deleted, the address stops working.</Trans>
+							</P>
+						</Question>
+						<Question q={<Trans>How do I share a link for watching?</Trans>}>
+							<P>
+								<Trans>Create a guest key of the kind "watch". The main stream key never has to be given to anybody.</Trans>
+							</P>
+						</Question>
+					</Section>
+
+					<Section id="process" title={<Trans>Processes, command and logs</Trans>}>
+						<Question open={is('process')} q={<Trans>Where do I see the FFmpeg command and the log?</Trans>}>
+							<P>
+								<Trans>"Process details" on the main screen shows the command, the start-up output and the log of the source. Keys and passwords are hidden until you ask for them.</Trans>
+							</P>
+						</Question>
+						<Question q={<Trans>What is the process report for?</Trans>}>
+							<P>
+								<Trans>It collects configuration, state and log of a process in one text, with addresses made anonymous. Attach it when you report a problem.</Trans>
+							</P>
+						</Question>
+					</Section>
+
+					<Section id="server" title={<Trans>Server, security and updates</Trans>}>
+						<Question open={is('server')} q={<Trans>What protects the streams?</Trans>}>
+							<P>
+								<Trans>The stream key. It is part of the RTMP and SRT addresses; without it nobody can send or watch. Set or renew it under "Status and tools" &gt; Keys; the addresses of the channels are updated by themselves.</Trans>
+							</P>
+						</Question>
+						<Question q={<Trans>What protects the panel?</Trans>}>
+							<P>
+								<Trans>
+									The password: at least 12 characters. Five wrong logins lock an address out for 15 minutes. Without HTTPS the password travels unencrypted, so from outside use the panel only
+									on networks you trust, or through a VPN.
+								</Trans>
+							</P>
+						</Question>
+						<Question q={<Trans>How much can the graphics card take?</Trans>}>
+							<P>
+								<Trans>The server card on the main screen shows the load. If NVENC stays above 80 %, do not add another encoded output.</Trans>
+							</P>
+						</Question>
+						<Question q={<Trans>How do I install an update?</Trans>}>
+							<P>
+								<Trans>
+									Copy the update package to the server and run <code>sudo bash update.sh</code>. Nothing is rebuilt. Broadcasts are interrupted briefly, so update outside meeting hours. The panel
+									contacts no outside service for updates.
+								</Trans>
+							</P>
+						</Question>
+					</Section>
+
+					<Section id="support" title={<Trans>Support</Trans>}>
+						{brand.support ? (
+							<Typography variant="body1" sx={{ maxWidth: '72ch', whiteSpace: 'pre-line' }}>
+								{brand.support}
+							</Typography>
+						) : (
+							<P>
+								<Trans>Whom to call can be written here: System &gt; General &gt; Support text.</Trans>
+							</P>
+						)}
+					</Section>
+
+					<Section id="about" title={<Trans>About</Trans>}>
+						<Typography variant="body1" sx={{ fontWeight: 600 }}>
+							<Trans>
+								{brand.name} v{Version.Release}
+							</Trans>
+						</Typography>
+						<P>
+							<Trans>
+								Built on the open source projects{' '}
+								<Link color="inherit" underline="always" href={ORIGIN.ui.url} target="_blank" rel="noopener noreferrer">
+									{ORIGIN.ui.name}
+								</Link>{' '}
+								and{' '}
+								<Link color="inherit" underline="always" href={ORIGIN.core.url} target="_blank" rel="noopener noreferrer">
+									{ORIGIN.core.name}
+								</Link>
+								, both under the Apache License 2.0. NVIDIA encoding, the seamless fallback, recording, guest keys and the watch were added in this version.
+							</Trans>
+						</P>
+						<Typography variant="caption" sx={{ display: 'block' }}>
+							<Trans>The names datarhei and Restreamer belong to their owners. This application is not affiliated with datarhei.</Trans>
+						</Typography>
+						<Typography variant="caption" sx={{ display: 'block', mt: 1 }}>
+							<Trans>Also used: FFmpeg, video.js, React and MUI, each under its own licence.</Trans>
+						</Typography>
+					</Section>
+				</Paper>
+			</Grid>
+		</Grid>
+	);
+}
