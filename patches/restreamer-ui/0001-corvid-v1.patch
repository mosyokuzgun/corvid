+		'-frames:v',
+		'1',
+		'-f',
+		'rawvideo',
+		out,
+	]);
+	const px = fs.readFileSync(out);
+	const at = (x, y) => Array.from(px.subarray((y * 1080 + x) * 3, (y * 1080 + x) * 3 + 3));
+	const red = (c) => c[0] > 200 && c[1] < 60 && c[2] < 60;
+	expect(red(at(20, 960))).toBe(true); // left edge of the box
+	expect(red(at(1060, 960))).toBe(true); // right edge of the box
+	expect(red(at(540, 600))).toBe(false); // above the box
+	expect(red(at(540, 1300))).toBe(false); // below the box
+	fs.rmSync(dir, { recursive: true, force: true });
+});
+
+// Layers: the browser draws them into a "composed" background and a transparent "top"
+// picture. Here both are made with FFmpeg: the composed one is plain blue, the top one is
+// transparent with an opaque yellow square at 100,700 (on the video box).
+for (const bg of ['image', 'color', 'blur']) {
+	(ffmpeg ? test : test.skip)(`canvas:ffmpeg layer pictures are mixed in (${bg} background)`, () => {
+		const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'canvas-'));
+		const composed = path.join(dir, 'composed.png');
+		const top = path.join(dir, 'top.png');
+		execFileSync('ffmpeg', ['-v', 'error', '-y', '-f', 'lavfi', '-i', 'color=c=0x0000ff:s=1080x1920', '-frames:v', '1', composed]);
+		execFileSync('ffmpeg', [
+			'-v',
+			'error',
+			'-y',
+			'-f',
+			'lavfi',
+			'-i',
+			'color=c=0xffff00:s=200x200,format=rgba,pad=1080:1920:100:700:color=black@0',
+			'-frames:v',
+			'1',
+			top,
+		]);
+		const settings = { ...base, y: '656', vh: '608', fit: 'stretch', bg, image: '/orig.png', color: '#00ff00', composed: '/composed.png', top: '/top.png' };
+		const graph = Canvas.createGraph(settings, { cpu: true, path: (p) => (p === '/top.png' ? top : composed) });
+		expect(graph).toContain('[cvmix][cvtop]overlay');
+		const out = path.join(dir, 'f.rgb');
+		execFileSync('ffmpeg', [
+			'-v',
+			'error',
+			'-y',
+			'-f',
+			'lavfi',
+			'-i',
+			'color=c=red:s=1920x1080:r=25:d=1',
+			'-filter:v',
+			graph,
+			'-frames:v',
+			'1',
+			'-pix_fmt',
+			'rgb24',
+			'-f',
+			'rawvideo',
+			out,
+		]);
+		const buf = fs.readFileSync(out);
+		expect(buf.length).toBe(1080 * 1920 * 3);
+		const px = (x, y) => Array.from(buf.subarray((y * 1080 + x) * 3, (y * 1080 + x) * 3 + 3));
+		const near = (a, b) => a.every((v, i) => Math.abs(v - b[i]) < 40);
+		// the top picture covers the video where it is opaque ...
+		expect(near(px(200, 800), [255, 255, 0])).toBe(true);
+		// ... and lets it through where it is transparent
+		expect(near(px(800, 900), [255, 0, 0])).toBe(true);
+		if (bg !== 'blur') {
+			// the composed picture replaces the background (image and colour alike)
+			expect(near(px(540, 200), [0, 0, 255])).toBe(true);
+		} else {
+			// a blurred background is live video: the composed picture is not used
+			expect(near(px(540, 200), [255, 0, 0])).toBe(true);
+		}
+		fs.rmSync(dir, { recursive: true, force: true });
+	});
+}
+
+test('canvas:gpu graph mixes the top picture with CUDA filters', () => {
+	const g = Canvas.createGraph({ ...base, bg: 'image', image: '/a.png', composed: '/c.png', top: '/t.png' });
+	expect(g).toContain("movie=filename='{diskfs}/c.png'");
+	expect(g).not.toContain('/a.png');
+	expect(g).toContain("movie=filename='{diskfs}/t.png',format=yuva420p,hwupload[cvtop]");
+	expect(g).toContain('[cvmix][cvtop]overlay_cuda=x=0:y=0:eof_action=repeat,setsar=1');
+	expect(g.match(/setsar=1/g).length).toBe(1);
+	// without layers nothing changes
+	expect(Canvas.createGraph({ ...base, bg: 'image', image: '/a.png' })).not.toContain('cvmix');
+});
