+++ b/src/misc/filters/video/CanvasLayers.js
@@ -0,0 +1,212 @@
+// Canvas layers (fork): title texts, a logo and further images on the canvas.
+//
+// All layers are stills. Instead of one FFmpeg overlay (and one font) per layer, the browser
+// draws them into at most two pictures of the size of the canvas and uploads those:
+//
+//   - "composed": the background (image or colour) with the layers that sit *behind* the
+//     video. It simply replaces the background picture, the graph stays as it was.
+//   - "top": a transparent picture with the layers *in front of* the video. It is overlaid
+//     once at the end of the graph.
+//
+// With a blurred-video background there is no still background to draw into, so all layers
+// go into "top".
+
+export const FONTS = ['Arial', 'Arial Black', 'Verdana', 'Tahoma', 'Trebuchet MS', 'Georgia', 'Times New Roman', 'Impact', 'Courier New'];
+
+const num = (v, def = 0) => {
+	const n = parseFloat(v);
+	return isNaN(n) ? def : n;
+};
+
+export function initLayer(layer) {
+	const base = {
+		type: 'text',
+		x: '40',
+		y: '120',
+		w: '1000',
+		above: false,
+	};
+	if (!layer || layer.type !== 'image') {
+		return { ...base, text: '', font: 'Arial', size: '64', color: '#ffffff', bold: true, align: 'center', shadow: true, ...layer, type: 'text' };
+	}
+	return { ...base, w: '300', image: '', ...layer };
+}
+
+export function hasLayers(settings) {
+	return Array.isArray(settings.layers) && settings.layers.some((l) => usable(initLayer(l)));
+}
+
+const usable = (l) => (l.type === 'image' ? !!l.image : `${l.text}`.trim().length !== 0);
+
+// Does the background allow drawing layers into it?
+export const stillBackground = (settings) => (settings.bg === 'image' && !!settings.image) || settings.bg === 'color';
+
+// Which picture a layer goes into: 'bg' or 'top'.
+export function layerTarget(settings, layer) {
+	return !layer.above && stillBackground(settings) ? 'bg' : 'top';
+}
+
+// Everything the pictures depend on. If it differs from settings.layersKey, the pictures
+// are out of date.
+export function layersKey(settings) {
+	const layers = (settings.layers || []).map(initLayer).filter(usable);
+	if (layers.length === 0) {
+		return '';
+	}
+	return JSON.stringify([settings.width, settings.height, settings.bg, stillBackground(settings) ? [settings.color, settings.image] : 0, layers]);
+}
+
+export const fontOf = (l) => `${l.bold ? 'bold ' : ''}${Math.max(8, num(l.size, 64))}px "${FONTS.includes(l.font) ? l.font : 'Arial'}", sans-serif`;
+
+// Break a text into lines no wider than maxWidth. Explicit line breaks are kept.
+export function wrapLines(ctx, text, maxWidth) {
+	const lines = [];
+	for (const para of `${text}`.split('\n')) {
+		let line = '';
+		for (const word of para.split(/\s+/).filter((w) => w.length !== 0)) {
+			const probe = line ? `${line} ${word}` : word;
+			if (line && ctx.measureText(probe).width > maxWidth) {
+				lines.push(line);
+				line = word;
+			} else {
+				line = probe;
+			}
+		}
+		lines.push(line);
+	}
+	return lines;
+}
+
+const LINE = 1.2;
+
+// The rectangle a layer covers on the canvas.
+export function layerBox(ctx, layer, images) {
+	const l = initLayer(layer);
+	const w = Math.max(8, num(l.w, 100));
+	if (l.type === 'image') {
+		const img = images ? images[l.image] : null;
+		const h = img && img.width ? (w * img.height) / img.width : w;
+		return { x: num(l.x), y: num(l.y), w, h };
+	}
+	let n = `${l.text}`.split('\n').length;
+	if (ctx) {
+		ctx.font = fontOf(l);
+		n = wrapLines(ctx, l.text, w).length;
+	}
+	return { x: num(l.x), y: num(l.y), w, h: n * num(l.size, 64) * LINE };
+}
+
+export function drawLayer(ctx, layer, images) {
+	const l = initLayer(layer);
+	if (!usable(l)) {
+		return;
+	}
+	const box = layerBox(ctx, l, images);
+	if (l.type === 'image') {
+		const img = images ? images[l.image] : null;
+		if (img && img.width) {
+			ctx.drawImage(img, box.x, box.y, box.w, box.h);
+		}
+		return;
+	}
+
+	const size = Math.max(8, num(l.size, 64));
+	ctx.save();
+	ctx.font = fontOf(l);
+	ctx.fillStyle = /^#[0-9a-fA-F]{6}$/.test(l.color) ? l.color : '#ffffff';
+	ctx.textBaseline = 'middle';
+	ctx.textAlign = ['left', 'center', 'right'].includes(l.align) ? l.align : 'center';
+	if (l.shadow) {
+		ctx.shadowColor = 'rgba(0,0,0,0.55)';
+		ctx.shadowBlur = size * 0.12;
+		ctx.shadowOffsetY = size * 0.04;
+	}
+	const ax = ctx.textAlign === 'left' ? box.x : ctx.textAlign === 'right' ? box.x + box.w : box.x + box.w / 2;
+	wrapLines(ctx, l.text, box.w).forEach((line, i) => {
+		ctx.fillText(line, ax, box.y + (i + 0.5) * size * LINE);
+	});
+	ctx.restore();
+}
+
+// Draw the background like FFmpeg does (cover: scale up, crop the centre).
+export function drawBackground(ctx, W, H, settings, images) {
+	const color = /^#[0-9a-fA-F]{6}$/.test(settings.color) ? settings.color : '#000000';
+	ctx.fillStyle = color;
+	ctx.fillRect(0, 0, W, H);
+	const img = settings.bg === 'image' && images ? images[settings.image] : null;
+	if (img && img.width) {
+		const k = Math.max(W / img.width, H / img.height);
+		const w = img.width * k;
+		const h = img.height * k;
+		ctx.drawImage(img, (W - w) / 2, (H - h) / 2, w, h);
+	}
+}
+
+export function drawLayers(ctx, settings, images, target) {
+	for (const layer of settings.layers || []) {
+		const l = initLayer(layer);
+		if (!target || layerTarget(settings, l) === target) {
+			drawLayer(ctx, l, images);
+		}
+	}
+}
+
+export function loadImage(url) {
+	return new Promise((resolve, reject) => {
+		const img = new Image();
+		img.onload = () => resolve(img);
+		img.onerror = () => reject(new Error('The image could not be loaded: ' + url));
+		img.src = url;
+	});
+}
+
+// The image paths the pictures need.
+export function neededImages(settings) {
+	const paths = [];
+	if (settings.bg === 'image' && settings.image) {
+		paths.push(settings.image);
+	}
+	for (const layer of settings.layers || []) {
+		if (layer.type === 'image' && layer.image) {
+			paths.push(layer.image);
+		}
+	}
+	return [...new Set(paths)];
+}
+
+const toBlob = (canvas, type, quality) => new Promise((resolve) => canvas.toBlob(resolve, type, quality));
+
+// Draw the pictures. Returns { bg, top }: ArrayBuffers (PNG) or null where none is needed.
+export async function compose(settings, images, createCanvas) {
+	const W = Math.round(num(settings.width) / 2) * 2;
+	const H = Math.round(num(settings.height) / 2) * 2;
+	const layers = (settings.layers || []).map(initLayer).filter(usable);
+	const result = { bg: null, top: null };
+
+	const make =
+		createCanvas ||
+		((w, h) => {
+			const c = document.createElement('canvas');
+			c.width = w;
+			c.height = h;
+			return c;
+		});
+
+	if (layers.some((l) => layerTarget(settings, l) === 'bg')) {
+		const c = make(W, H);
+		const ctx = c.getContext('2d');
+		drawBackground(ctx, W, H, settings, images);
+		drawLayers(ctx, { ...settings, layers }, images, 'bg');
+		result.bg = await (await toBlob(c, 'image/png')).arrayBuffer();
+	}
+
+	if (layers.some((l) => layerTarget(settings, l) === 'top')) {
+		const c = make(W, H);
+		const ctx = c.getContext('2d');
+		ctx.clearRect(0, 0, W, H);
+		drawLayers(ctx, { ...settings, layers }, images, 'top');
+		result.top = await (await toBlob(c, 'image/png')).arrayBuffer();
+	}
+
+	return result;
+}
