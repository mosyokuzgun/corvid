+}
+
+Filter.defaultProps = {
+	settings: {},
+	onChange: function (settings, mapping) {},
+};
+
+const filter = 'overlay_cuda';
+const name = 'Canvas (CUDA)';
+const type = 'video';
+const hwaccel = true;
+
+function summarize(settings) {
+	settings = init(settings);
+	if (settings.mode !== 'canvas') {
+		return '';
+	}
+	return `${name} ${settings.width}x${settings.height}, video ${settings.vw}x${settings.vh}@${settings.x},${settings.y} (${settings.fit}, ${settings.bg})`;
+}
+
+function defaults() {
+	const settings = init({});
