+				</Tooltip>
+			)}
+			<Tooltip title={<Trans>Watch settings</Trans>}>
+				<IconButton size="small" color="inherit" onClick={() => setOpen(true)} aria-label={i18n._(t`Watch settings`)}>
+					<TuneIcon fontSize="small" />
+				</IconButton>
+			</Tooltip>
+		</Box>
+	);
+
+	let body = null;
+	if (!settings.enable) {
+		body = (
+			<Typography variant="body1" sx={{ color: 'text.secondary', flex: '1 1 auto' }}>
+				<Trans>Sound and picture watch is off for this channel.</Trans>
+			</Typography>
+		);
+	} else if (!props.active) {
+		body = (
+			<Typography variant="body1" sx={{ color: 'text.secondary', flex: '1 1 auto' }}>
+				<Trans>Sound level: shown while the channel is connected.</Trans>
+			</Typography>
+		);
+	} else if ($watch === null || !$watch.fresh) {
+		body = (
+			<Typography variant="body1" sx={{ color: 'text.secondary', flex: '1 1 auto' }}>
+				<Trans>Sound level: waiting for the first measurement.</Trans>
+			</Typography>
+		);
+	} else if (!$watch.hasAudio) {
+		body = (
+			<Typography variant="body1" sx={{ color: Palette.warning.main, flex: '1 1 auto' }}>
+				<Trans>The programme has no sound track.</Trans>
+			</Typography>
+		);
+	} else {
+		const mono = $watch.rms[1] === null;
+		body = (
+			<Box sx={{ flex: '1 1 auto', minWidth: 0, display: 'flex', flexDirection: 'column', gap: 0.5 }}>
+				<Bar name={mono ? '' : i18n._(t`L`)} label={mono ? i18n._(t`Sound level`) : i18n._(t`Sound level, left`)} level={$watch.rms[0]} />
+				{!mono && <Bar name={i18n._(t`R`)} label={i18n._(t`Sound level, right`)} level={$watch.rms[1]} />}
+			</Box>
+		);
+	}
+
+	return (
+		<React.Fragment>
+			{alarm && (
+				<Alert severity="warning" variant="standard" role="alert" sx={{ mb: 1 }}>
+					{alarms.includes('silence') && (
+						<div>
+							<Trans>No sound for {$watch.silentFor} s. Check the microphone and the mixer.</Trans>
+						</div>
+					)}
+					{alarms.includes('black') && (
+						<div>
+							<Trans>The picture has been black for {$watch.blackFor} s.</Trans>
+						</div>
+					)}
+					{alarms.includes('freeze') && (
+						<div>
+							<Trans>The picture has not moved for {$watch.frozenFor} s.</Trans>
+						</div>
+					)}
+				</Alert>
+			)}
+			<Box sx={{ display: 'flex', alignItems: 'center', gap: 1.5 }}>
+				{body}
+				{tools}
+			</Box>
+			{$watch && $watch.fresh && $watch.oneSided !== '' && $watch.sideFor >= 10 && (
+				<Typography variant="caption" sx={{ display: 'block', mt: 0.5 }}>
+					{$watch.oneSided === 'left' ? <Trans>Only the right channel carries sound.</Trans> : <Trans>Only the left channel carries sound.</Trans>}
+				</Typography>
+			)}
+			<Settings open={$open} settings={props.settings} onClose={() => setOpen(false)} onSave={save} />
+		</React.Fragment>
+	);
+}
