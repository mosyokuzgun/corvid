--- /dev/null
+++ b/src/utils/help.test.js
@@ -0,0 +1,22 @@
+import { helpSection, helpURL, SECTIONS } from './help';
+
+test('topics of the views map to sections of the own help page', () => {
+	expect(helpSection('main')).toBe('main');
+	expect(helpSection('process-details')).toBe('process');
+	expect(helpSection('publication-add')).toBe('publications');
+	expect(helpSection('player-embed')).toBe('player');
+	expect(helpSection('playersite-design')).toBe('player');
+	expect(helpSection('settings-srt')).toBe('server');
+	expect(helpSection('wizard-video-setup')).toBe('channel');
+	expect(helpSection('edit-control')).toBe('channel');
+	expect(helpSection('encoder-libx264')).toBe('channel');
+	expect(helpSection('unknown-thing')).toBe('first');
+	expect(helpSection('about')).toBe('about');
+});
+
+test('every mapped section exists and no link leaves the application', () => {
+	for (const t of ['main', 'process-report', 'publication', 'player-logo', 'settings-auth', 'wizard-abort', 'login', '']) {
+		expect(SECTIONS).toContain(helpSection(t));
+		expect(helpURL(t).startsWith(window.location.href.split('#')[0] + '#/help/')).toBe(true);
+	}
+});
