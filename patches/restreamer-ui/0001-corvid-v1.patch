+		if (p === 'top') patch({ x: '0', y: `${even(H * 0.12)}`, vw: `${W}`, vh: `${vh}`, fit: 'contain' });
+		if (p === 'fill') patch({ x: '0', y: '0', vw: `${W}`, vh: `${H}`, fit: 'cover' });
+	};
+
+	const upload = async (event) => {
+		const file = event.target.files[0];
+		if (!file || !['image/png', 'image/jpeg'].includes(file.type)) {
+			return;
+		}
+		setUploading(true);
+		setUploadError(false);
+		let path = '';
+		try {
