+	async _upsertFallbackProcess(channel, id, isSlate, fb, outputs, control, target) {
+		const channelid = channel.channelid;
+
+		// Split the main output options into the video and the audio part.
+		const opts = outputs.length !== 0 ? outputs[0].options.map((o) => '' + o) : [];
+		const parts = [];
+		for (let i = 0; i < opts.length; i++) {
+			if (opts[i] === '-map') {
+				parts.push([]);
+				i++;
+				continue;
+			}
+			if (parts.length !== 0) {
+				parts[parts.length - 1].push(opts[i]);
+			}
+		}
+		const strip = (list, names) => {
+			const out = [];
+			for (let i = 0; i < list.length; i++) {
+				if (names.includes(list[i])) {
+					i++;
+					continue;
+				}
+				out.push(list[i]);
+			}
+			return out;
+		};
+		const value = (list, name, def) => {
+			const i = list.indexOf(name);
+			return i !== -1 && i + 1 < list.length ? list[i + 1] : def;
+		};
+
+		const mainVideo = parts.length > 0 ? strip(parts[0], ['-filter:v']) : [];
+		const mainAudio = parts.length > 1 ? parts[1] : [];
+		const vcodec = value(mainVideo, '-codec:v', 'copy');
+		const acodec = value(mainAudio, '-codec:a', 'aac');
+		const fps = value(mainVideo, '-r', target.fps ? `${target.fps}` : '25');
+		const width = target.width || 1920;
+		const height = target.height || 1080;
+		const fit = `scale=${width}:${height}:force_original_aspect_ratio=decrease,pad=${width}:${height}:(ow-iw)/2:(oh-ih)/2,setsar=1,format=yuv420p`;
+		// 1 s GOP: the core can only switch at keyframes.
+		const gop = `${Math.max(1, Math.round(parseFloat(fps)))}`;
+
+		// The same encoder with the same settings as the program: the parameter sets (SPS/PPS)
+		// come out identical, so players of the HLS and of the publications don't see a change of
+		// stream configuration on a switch (browsers' MSE players stumble over that).
+		let video = [];
+		if (vcodec === 'copy') {
+			// The program is not encoded here; nothing to match.
+			video = fb.type === 'image' ? ['-codec:v', 'libx264', '-preset:v', 'veryfast', '-tune:v', 'zerolatency', '-b:v', '1500k'] : ['-codec:v', 'copy'];
+		} else {
+			video = mainVideo.slice();
+		}
+		if (video[1] !== 'copy') {
+			// Slate: decode and fit the picture once, then repeat that one frame in real time.
+			// "-loop 1" would decode and scale the picture again for every frame: with a photo
+			// from a camera that is a whole CPU core per channel, for a picture that never changes.
+			video.push('-filter:v', fb.type === 'image' ? `${fit},loop=loop=-1:size=1:start=0,setpts=N/(${fps})/TB,realtime` : fit);
+			if (!video.includes('-r')) {
+				video.push('-r', fps);
+			}
+			// The core switches at keyframes: keep the program's GOP, or use 1 s if it has none.
+			if (!video.includes('-g')) {
+				video.push('-g', gop, '-keyint_min', gop);
+			}
+		}
+
+		// Same sample rate and layout as the program: the publications copy the audio, and an
+		// AAC stream that changes its configuration on a switch is garbled or rejected.
+		const rate = target.sampleRate || 48000;
+		const layout = ['mono', 'stereo'].includes(target.layout) ? target.layout : 'stereo';
+		let audio = acodec === 'copy' || mainAudio.length === 0 || mainAudio.includes('-an') ? ['-codec:a', 'aac', '-b:a', '128k'] : mainAudio.slice();
+		if (!audio.includes('-ar')) {
+			audio.push('-ar', `${rate}`);
+		}
+		if (!audio.includes('-ac')) {
+			audio.push('-ac', layout === 'mono' ? '1' : '2');
+		}
+		if (fb.type === 'stream' && acodec === 'copy') {
+			audio = ['-codec:a', 'copy'];
+		}
+
+		const input = [];
+		if (fb.type === 'image') {
+			input.push(
+				{ id: 'input_0', address: `{diskfs}${fb.image}`, options: [] },
+				{ id: 'input_1', address: `anullsrc=r=${rate}:cl=${layout}`, options: ['-f', 'lavfi'] },
+			);
+		} else {
+			const options = ['-fflags', '+genpts'];
+			if (/^(rtmps?|https?|rtsp):\/\//i.test(`${fb.url}`.trim())) {
+				// Give up on a connection that hangs instead of waiting for the stale timeout.
+				options.push('-rw_timeout', '10000000');
+			}
+			// Encoded on the GPU: decode there too. The frames come back to the CPU filters
+			// (fit to size), so nothing else changes; a stream NVDEC can't decode is decoded
+			// by the CPU, FFmpeg falls back by itself.
+			if (`${value(video, '-codec:v', '')}`.endsWith('_nvenc')) {
+				options.unshift('-hwaccel', 'cuda');
+			}
+			input.push({ id: 'input_0', address: this._localAddress(`${fb.url}`.trim()), options });
+		}
+
+		const proc = {
+			type: 'ffmpeg',
+			id: id,
+			reference: channel.channelid,
+			input: input,
+			output: [
+				{
+					id: 'output_0',
+					address: `{rtmp,name=${fallbackStream(await this._programName(channelid), isSlate)}}`,
+					options: ['-map', '0:v:0', '-map', fb.type === 'image' ? '1:a:0' : '0:a:0?', ...video, ...audio, '-f', 'flv'],
+				},
+			],
+			options: ['-loglevel', 'level+info', '-err_detect', 'ignore_err'],
+			autostart: await this._helperAutostart(channel, control),
+			reconnect: true,
+			reconnect_delay_seconds: 3,
+			// A backup stream that is not there yet is retried quickly: it should be picked up soon after it appears.
+			reconnect_delay_max_seconds: fb.type === 'stream' ? 10 : 30,
+			// A backup that is connected but delivers nothing is reconnected after 15 s, not 30.
+			stale_timeout_seconds: fb.type === 'stream' ? 15 : 30,
+		};
+
+		return await this._upsertProcess(id, proc);
+	}
+
+	// Upsert the ingest snapshot process
+	async UpsertIngestSnapshot(channelid, control) {
+		const channel = this.GetChannel(channelid);
+		if (channel === null) {
+			return [null, { message: 'Unknown channel ID' }];
+		}
+
+		// Set hls storage endpoint
+		const hlsStorage = control.hls.storage;
+
