+});
+
+// The background upload used to return '' silently outside the channel editor (the publication
+// editors had no RestreamerProvider), which fell back to the blurred background.
+const uploadImage = async (ui) => {
+	i18n.load('en', {});
+	i18n.activate('en');
+	const changes = [];
+	const { container } = render(
+		<I18nProvider i18n={i18n}>
+			<Grid container>{ui(changes)}</Grid>
+		</I18nProvider>,
