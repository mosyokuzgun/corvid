diff --git a/src/views/Process.js b/src/views/Process.js
new file mode 100644
index 0000000..fcd97a9
--- /dev/null
+++ b/src/views/Process.js
@@ -0,0 +1,360 @@
+import React from 'react';
+import { useNavigate, useParams } from 'react-router-dom';
+
+import { i18n } from '@lingui/core';
+import { Trans } from '@lingui/macro';
+import Alert from '@mui/material/Alert';
+import Box from '@mui/material/Box';
+import Button from '@mui/material/Button';
+import Grid from '@mui/material/Grid';
+import MenuItem from '@mui/material/MenuItem';
+import TextField from '@mui/material/TextField';
+import Typography from '@mui/material/Typography';
+import ArrowBackIcon from '@mui/icons-material/ArrowBack';
+import DownloadIcon from '@mui/icons-material/Download';
+import RestartAltIcon from '@mui/icons-material/RestartAlt';
+
+import useInterval from '../hooks/useInterval';
+import Paper from '../misc/Paper';
+import CommandView from '../misc/CommandView';
+import Palette from '../theme/base/palette';
+import { maskSecrets } from '../utils/secrets';
+
+// Process details (fork): what one FFmpeg process of a channel does. The command as the core
+// runs it, cut into its parts with a plain sentence for each; the log; a short summary and a
+// restart. The command is not edited here: the panel writes it from the channel settings.
+
+const MONO = '"IBM Plex Mono", "Consolas", "Menlo", monospace';
+
+export const ROLE = {
+	source: <Trans>Source intake</Trans>,
+	fallback: <Trans>Backup stream encoder</Trans>,
+	slate: <Trans>Standby image encoder</Trans>,
+	relay: <Trans>HLS and player</Trans>,
+	record: <Trans>Recording</Trans>,
+	watch: <Trans>Sound and picture watch</Trans>,
+	snapshot: <Trans>Preview picture</Trans>,
+	target: <Trans>Publication</Trans>,
+	other: <Trans>Other</Trans>,
+};
+
+export const ROLE_TEXT = {
+	source: <Trans>Takes the source in and hands it to the server's own stream. Viewers, the fallback and every publication are fed from there.</Trans>,
+	fallback: <Trans>Encodes the backup stream so that it can replace the source without a break.</Trans>,
+	slate: <Trans>Turns the standby image into a stream, the last fallback.</Trans>,
+	relay: <Trans>Writes what viewers get as HLS for the player.</Trans>,
+	record: <Trans>Writes the programme to files on this server.</Trans>,
+	watch: <Trans>Measures sound and picture of the programme for the warnings on the main screen. Sends nothing.</Trans>,
+	snapshot: <Trans>Takes the preview picture once a minute.</Trans>,
+	target: <Trans>Sends the programme to a publication target.</Trans>,
+	other: <Trans>A process of this channel.</Trans>,
+};
+
+const EXEC = {
+	running: <Trans>Running</Trans>,
+	starting: <Trans>Starting</Trans>,
+	finishing: <Trans>Stopping</Trans>,
+	finished: <Trans>Stopped</Trans>,
+	failed: <Trans>Failed</Trans>,
+	killed: <Trans>Stopped</Trans>,
+};
+
+const dot = (p) => (p.running ? Palette.tally.live : p.order === 'start' ? Palette.tally.fault : null);
+
+const duration = (s) => {
+	const v = Math.max(0, Math.floor(s || 0));
+	return `${String(Math.floor(v / 3600)).padStart(2, '0')}:${String(Math.floor((v % 3600) / 60)).padStart(2, '0')}:${String(v % 60).padStart(2, '0')}`;
+};
+
+
+export default function Process(props) {
+	const navigate = useNavigate();
+	const { channelid, pid } = useParams();
+	const _channelid = channelid;
+	const _pid = decodeURIComponent(pid || '');
+	const [$p, setP] = React.useState(undefined);
+	const [$secrets, setSecrets] = React.useState(false);
+	const [$allLog, setAllLog] = React.useState(false);
+	const [$restart, setRestart] = React.useState(0); // 0 idle, 1 armed, 2 running
+
+	const load = async () => {
+		setP(await props.restreamer.GetProcessDetail(_channelid, _pid));
+	};
+
+	React.useEffect(() => {
+		setP(undefined);
+		setRestart(0);
+		// another process: its keys are hidden again
+		setSecrets(false);
+		load();
+		// eslint-disable-next-line react-hooks/exhaustive-deps
+	}, [_pid]);
+
+	useInterval(load, 3000);
+
+	const show = (text) => ($secrets ? text : maskSecrets(text));
+
+	if ($p === undefined) {
+		return null;
+	}
+
+	const back = () => navigate(`/${_channelid}/status/status`);
+
+	if ($p === null) {
+		return (
+			<Paper xs={12} md={10} lg={8} className="PaperM">
+				<Button size="small" color="inherit" startIcon={<ArrowBackIcon />} onClick={back}>
+					<Trans>Status and tools</Trans>
+				</Button>
+				<Typography variant="body1" sx={{ mt: 2 }}>
+					<Trans>This process does not exist (any more).</Trans>
+				</Typography>
+			</Paper>
+		);
+	}
+
+	const command = Array.isArray($p.state.command) ? $p.state.command : [];
+	const report = $p.report || {};
+	// FFmpeg's build banner (configuration, library versions) says nothing about this run.
+	const banner = /^\s*(built with |configuration: |lib[a-z]+\s+\d+\.\s*\d+)/;
+	const log = (Array.isArray(report.log) ? report.log : []).filter((l) => !banner.test(`${l[1]}`));
+	const prelude = Array.isArray(report.prelude) ? report.prelude : [];
+	const shown = $allLog ? log : log.slice(-40);
+	const history = Array.isArray(report.history) ? report.history : [];
+	const progress = $p.state.progress || {};
+	const title = (
+		<span>
+			{ROLE[$p.role] || ROLE.other}
+			{$p.name ? `: ${$p.name}` : ''}
+		</span>
+	);
+
+	const downloadLog = () => {
+		const text = [...prelude, '', ...log.map((l) => `${new Date(l[0] * 1000).toISOString()} ${l[1]}`)].join('\n');
+		const blob = new Blob([show(text)], { type: 'text/plain' });
+		const a = document.createElement('a');
+		a.href = URL.createObjectURL(blob);
+		a.download = `${$p.role}-${new Date().toISOString().slice(0, 19).replace(/[:T]/g, '-')}.log`;
+		a.click();
+		URL.revokeObjectURL(a.href);
+	};
+
+	const restart = async () => {
+		if ($restart === 0) {
+			setRestart(1);
+			return;
+		}
+		setRestart(2);
+		await props.restreamer.RestartProcess(_channelid, _pid);
+		await load();
+		setRestart(0);
+	};
+
+	const state = $p.running ? (
+		<Trans>Running</Trans>
+	) : $p.order === 'start' ? (
+		$p.reconnect >= 0 ? (
+			<Trans>Not running, next try in {Math.round($p.reconnect)} s</Trans>
+		) : (
+			EXEC[$p.exec] || <Trans>Not running</Trans>
+		)
+	) : (
+		<Trans>Off</Trans>
+	);
+
+	return (
+		<Grid container justifyContent="center" spacing={1} sx={{ mb: '6em' }}>
+			<Grid item xs={12} lg={10} xl={9}>
+				<Button size="small" color="inherit" startIcon={<ArrowBackIcon />} onClick={back}>
+					<Trans>Status and tools</Trans>
+				</Button>
+				<Box sx={{ display: 'flex', flexWrap: 'wrap', alignItems: 'flex-end', justifyContent: 'space-between', gap: 2, mb: 2 }}>
+					<Box sx={{ flex: '1 1 420px', minWidth: 0 }}>
+						<Box sx={{ display: 'flex', flexWrap: 'wrap', alignItems: 'center', gap: '4px 16px' }}>
+							<Typography variant="h1">{title}</Typography>
+							<Box sx={{ display: 'flex', alignItems: 'center', gap: 1, fontWeight: 600 }} role="status">
+								<Box
+									component="span"
+									sx={{
+										width: 9,
+										height: 9,
+										borderRadius: '50%',
+										flexShrink: 0,
+										backgroundColor: dot($p) || 'transparent',
+										border: dot($p) ? 0 : `2px solid ${Palette.tally.off}`,
+									}}
+								/>
+								{state}
+								{$p.running ? `, ${duration($p.runtime)}` : ''}
+							</Box>
+						</Box>
+						<Typography variant="body1" sx={{ color: 'text.secondary', mt: 0.5, maxWidth: '75ch' }}>
+							{ROLE_TEXT[$p.role] || ROLE_TEXT.other}
+						</Typography>
+					</Box>
+					<TextField
+						select
+						size="small"
+						label={<Trans>Process</Trans>}
+						value={$p.id}
+						onChange={(e) => navigate(`/${_channelid}/process/${encodeURIComponent(e.target.value)}`)}
+						sx={{ flex: '0 1 320px', minWidth: 220 }}
+					>
+						{$p.processes.map((x) => (
+							<MenuItem key={x.id} value={x.id}>
+								{ROLE[x.role] || ROLE.other}
+								{x.name ? `: ${x.name}` : ''}
+							</MenuItem>
+						))}
+					</TextField>
+				</Box>
+
+				<CommandView command={command} config={$p.config} resetKey={$p.id} secrets={$secrets} onSecrets={setSecrets} />
+				<Box sx={{ display: 'flex', flexWrap: 'wrap', gap: 2, alignItems: 'flex-start' }}>
+					<Box
+						component="section"
+						sx={{ flex: '999 1 440px', minWidth: 0, backgroundColor: Palette.background.paper, border: `1px solid ${Palette.background.line}`, borderRadius: 1.5, p: { xs: 2, md: 2.5 } }}
+					>
+						<Typography variant="h3" component="h2" sx={{ mb: 1.5 }}>
+							<Trans>Log</Trans>
+						</Typography>
+						{log.length === 0 && prelude.length === 0 ? (
+							<Typography variant="body1" sx={{ color: 'text.secondary' }}>
+								<Trans>No log lines yet.</Trans>
+							</Typography>
+						) : (
+							<Box
+								sx={{
+									backgroundColor: Palette.background.surround,
+									border: `1px solid ${Palette.background.line}`,
+									borderRadius: 1,
+									p: 1.5,
+									fontFamily: MONO,
+									fontSize: '.8rem',
+									lineHeight: 1.55,
+									maxHeight: $allLog ? 'none' : 420,
+									overflowY: 'auto',
+								}}
+							>
+								{shown.map((l, i) => {
+									const warn = /error|warning|fail|invalid|corrupt|timed out|refused/i.test(`${l[1]}`);
+									return (
+										<Box key={i} sx={{ display: 'flex', gap: 1.5 }}>
+											<Box component="span" sx={{ flex: 'none', color: 'text.secondary' }}>
+												{new Date(l[0] * 1000).toLocaleTimeString(i18n.locale)}
+											</Box>
+											<Box component="span" sx={{ minWidth: 0, whiteSpace: 'pre-wrap', overflowWrap: 'anywhere', color: warn ? Palette.warning.main : 'inherit' }}>
+												{show(`${l[1]}`)}
+											</Box>
+										</Box>
+									);
+								})}
+							</Box>
+						)}
+						<Box sx={{ display: 'flex', flexWrap: 'wrap', gap: 1, mt: 1.5 }}>
+							{log.length > 40 && (
+								<Button variant="outlined" color="inherit" onClick={() => setAllLog(!$allLog)}>
+									{$allLog ? <Trans>Last 40 lines</Trans> : <Trans>Whole log ({log.length} lines)</Trans>}
+								</Button>
+							)}
+							<Button variant="outlined" color="inherit" startIcon={<DownloadIcon />} onClick={downloadLog} disabled={log.length === 0 && prelude.length === 0}>
+								<Trans>Download log</Trans>
+							</Button>
+						</Box>
+					</Box>
+
+					<Box
+						component="section"
+						sx={{ flex: '1 1 280px', minWidth: 0, backgroundColor: Palette.background.paper, border: `1px solid ${Palette.background.line}`, borderRadius: 1.5, p: { xs: 2, md: 2.5 } }}
+					>
+						<Typography variant="h3" component="h2" sx={{ mb: 1.5 }}>
+							<Trans>Summary</Trans>
+						</Typography>
+						<Box component="dl" sx={{ m: 0, display: 'grid', gridTemplateColumns: 'auto minmax(0, 1fr)', gap: '8px 16px', '& dt': { color: 'text.secondary' }, '& dd': { m: 0, fontWeight: 600 } }}>
+							<dt>
+								<Trans>State</Trans>
+							</dt>
+							<dd>{state}</dd>
+							<dt>
+								<Trans>Running for</Trans>
+							</dt>
+							<dd className="tabular">{$p.running ? duration($p.runtime) : '–'}</dd>
+							<dt>
+								<Trans>Earlier runs</Trans>
+							</dt>
+							<dd className="tabular">{history.length}</dd>
+							{$p.running && progress.fps > 0 && (
+								<React.Fragment>
+									<dt>
+										<Trans>Frame rate</Trans>
+									</dt>
+									<dd className="tabular">
+										{i18n.number(progress.fps, { maximumFractionDigits: 1 })} FPS, <Trans>speed</Trans> {i18n.number(progress.speed || 0, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}×
+									</dd>
+								</React.Fragment>
+							)}
+							{$p.running && progress.bitrate_kbit > 0 && (
+								<React.Fragment>
+									<dt>
+										<Trans>Bitrate</Trans>
+									</dt>
+									<dd className="tabular">{i18n.number(Math.round(progress.bitrate_kbit))} kbit/s</dd>
+								</React.Fragment>
+							)}
+							{$p.running && (
+								<React.Fragment>
+									<dt>
+										<Trans>Processor, memory</Trans>
+									</dt>
+									<dd className="tabular">
+										{i18n.number(Math.round($p.cpu))} %, {i18n.number(Math.round($p.memory / 1024 / 1024))} MB
+									</dd>
+								</React.Fragment>
+							)}
+							<dt>
+								<Trans>Picture</Trans>
+							</dt>
+							<dd>
+								{$p.encoder === 'nvenc' ? (
+									<Trans>NVENC (graphics card)</Trans>
+								) : $p.encoder === 'cpu' ? (
+									<Trans>Processor</Trans>
+								) : $p.encoder === 'copy' ? (
+									<Trans>Copy, no encoder</Trans>
+								) : (
+									<Trans>None</Trans>
+								)}
+							</dd>
+						</Box>
+						{$p.state.last_logline && $p.order === 'start' && !$p.running && (
+							<Alert severity="warning" sx={{ mt: 2 }}>
+								{show($p.state.last_logline)}
+							</Alert>
+						)}
+						<Box sx={{ mt: 2, pt: 2, borderTop: `1px solid ${Palette.background.line}` }}>
+							<Button
+								variant="outlined"
+								color={$restart === 1 ? 'warning' : 'inherit'}
+								startIcon={<RestartAltIcon />}
+								disabled={$restart === 2 || $p.order !== 'start'}
+								onClick={restart}
+								onBlur={() => $restart === 1 && setRestart(0)}
+							>
+								{$restart === 1 ? <Trans>Press again to restart</Trans> : <Trans>Restart process</Trans>}
+							</Button>
+							<Typography variant="caption" sx={{ display: 'block', mt: 1 }}>
+								{$p.order !== 'start' ? (
+									<Trans>The process is off; it starts with the channel.</Trans>
+								) : $p.role === 'source' ? (
+									<Trans>While the source restarts, viewers see the backup for a few seconds.</Trans>
+								) : (
+									<Trans>The process stops and starts again; this takes a few seconds.</Trans>
+								)}
+							</Typography>
+						</Box>
+					</Box>
+				</Box>
+			</Grid>
+		</Grid>
+	);
+}
