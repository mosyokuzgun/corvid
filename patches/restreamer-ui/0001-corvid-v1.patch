+function Bar(props) {
+	const level = props.level;
+	const none = level === null || level === undefined;
+	const silent = !none && level <= SILENCE_DB;
+	const width = none || silent ? 0 : Math.min(100, Math.max(2, ((level - FLOOR) / -FLOOR) * 100));
+	// Louder than -6 dBFS on average is too hot; that is the one thing the colour says here.
+	const hot = !none && level > -6;
