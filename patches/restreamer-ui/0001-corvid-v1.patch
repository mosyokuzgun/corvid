+++ b/src/utils/diagnostics.test.js
@@ -0,0 +1,44 @@
+import { maskDeep, collectDiagnostics } from './diagnostics';
+
+test('secrets are hidden, the rest stays', () => {
+	const input = {
+		config: {
+			api: { auth: { username: 'admin', password: 'pw123456', jwt: { secret: 'jwtsecret' } } },
+			rtmp: { token: 'rtmptoken', address: ':1935' },
+			srt: { passphrase: 'srtpassphrase', token: '' },
+		},
+		metadata: { guestKeys: [{ token: 'g1' }], watchKey: 'wk', name: 'Studyo' },
+		processes: [
+			{
+				id: 'restreamer-ui:egress:youtube:1',
+				config: {
+					input: [{ address: '{rtmp,name=ch.stream}' }],
+					output: [{ address: 'rtmps://a.rtmps.youtube.com/live2/abcd-efgh-ijkl', options: ['-f', 'flv'] }],
+				},
+				command: ['-i', 'srt://1.2.3.4:6000?streamid=ch,mode:request,token:srttoken', '-passphrase', 'clearpass', 'http://user:secretpw@host/x'],
+			},
+		],
+		log: ['ts=1 url=rtmp://localhost:1935/live/ch.stream?token=rtmptoken'],
+	};
+	const text = JSON.stringify(maskDeep(input));
+	for (const leak of ['pw123456', 'jwtsecret', 'rtmptoken', 'srtpassphrase', '"g1"', '"wk"', 'abcd-efgh-ijkl', 'srttoken', 'clearpass', 'secretpw']) {
+		expect(text).not.toContain(leak);
+	}
+	for (const keep of ['"admin"', ':1935', 'Studyo', '{rtmp,name=ch.stream}', 'rtmps://a.rtmps.youtube.com/live2/', 'rtmp://localhost:1935/live/ch.stream']) {
+		expect(text).toContain(keep);
+	}
+	// an empty secret stays empty: it tells that none is set
+	expect(maskDeep({ token: '' }).token).toBe('');
+});
+
+test('a failing part does not stop the others', async () => {
+	const d = await collectDiagnostics({
+		about: async () => ({ version: '16' }),
+		log: async () => {
+			throw new Error('down');
+		},
+	});
+	expect(d.about.version).toBe('16');
+	expect(d.log.error).toBe('down');
+	expect(d.format).toBe('yayin-paneli-diagnostics');
+});
