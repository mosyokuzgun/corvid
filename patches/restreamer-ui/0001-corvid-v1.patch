@@ -0,0 +1,72 @@
+// The name of this application, in one place (fork).
+//
+// This panel grew out of datarhei Restreamer but is a product of its own: Corvid. The name can be changed under System > General; it is kept in the
+// server's metadata and remembered in this browser, so the login page shows it as well.
+// The origin is credited in the footer and under Help > About.
+
+const DEFAULT_NAME = 'Corvid';
+// names this application had before; a stored one of these means "the default"
+const OLD_DEFAULTS = ['Yayın Paneli'];
+
+const KEY = 'brand';
+
+let current = null;
+const listeners = new Set();
+
+const clean = (brand) => {
+	const b = brand && typeof brand === 'object' ? brand : {};
+	const text = (v, max) => (typeof v === 'string' ? v.replace(/\s+/g, ' ').trim().slice(0, max) : '');
+	return {
+		name: OLD_DEFAULTS.includes(text(b.name, 40)) ? DEFAULT_NAME : text(b.name, 40) || DEFAULT_NAME,
+		// free text shown under Help > Support: whom to call, an e-mail address
+		support: typeof b.support === 'string' ? b.support.trim().slice(0, 400) : '',
+	};
+};
+
+const read = () => {
+	if (current === null) {
+		let stored = null;
+		try {
+			stored = JSON.parse(window.localStorage.getItem(KEY) || 'null');
+		} catch (e) {}
+		current = clean(stored);
+	}
+	return current;
+};
+
+const getBrand = () => read();
+
+const setBrand = (brand) => {
+	current = clean(brand);
+	try {
+		window.localStorage.setItem(KEY, JSON.stringify(current));
+	} catch (e) {}
+	if (typeof document !== 'undefined') {
+		document.title = current.name;
+	}
+	for (const fn of listeners) {
+		fn(current);
+	}
+	return current;
+};
+
+// React hook: the brand, re-rendering when it changes.
+const useBrand = (React) => {
+	const [brand, set] = React.useState(read());
+	React.useEffect(() => {
+		listeners.add(set);
+		set(read());
+		return () => {
+			listeners.delete(set);
+		};
+	}, []);
+	return brand;
+};
+
+// The projects this application is built on. Shown wherever credit is given.
+const ORIGIN = {
+	ui: { name: 'datarhei Restreamer', url: 'https://github.com/datarhei/restreamer', license: 'Apache License 2.0' },
+	core: { name: 'datarhei Core', url: 'https://github.com/datarhei/core', license: 'Apache License 2.0' },
+};
+
+export { DEFAULT_NAME, ORIGIN, clean as cleanBrand, getBrand, setBrand, useBrand };
