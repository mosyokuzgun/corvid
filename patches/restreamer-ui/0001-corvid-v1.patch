diff --git a/src/misc/SecurityHints.js b/src/misc/SecurityHints.js
new file mode 100644
index 0000000..3a6623e
--- /dev/null
+++ b/src/misc/SecurityHints.js
@@ -0,0 +1,132 @@
+import React from 'react';
+
+import { Trans } from '@lingui/macro';
+import Alert from '@mui/material/Alert';
+import Button from '@mui/material/Button';
+
+import { securityProblems } from '../utils/security';
+
+const TEXT = {
+	rtmp_no_token: <Trans>The RTMP server has no stream key: anyone who can reach its port can send or watch streams.</Trans>,
+	srt_no_token: <Trans>The SRT server has neither a key nor a passphrase: anyone who can reach its port can send or watch streams.</Trans>,
+	http: (
+		<Trans>
+			This panel is opened over plain HTTP: the password and the stream keys travel unencrypted. Use HTTPS, or open the panel only inside a trusted
+			network.
+		</Trans>
+	),
+};
+
+const KEY = 'security-hints-dismissed';
+
+// on a phone the buttons go below the text instead of squeezing it
+const ALERT = {
+	py: 0.25,
+	flexWrap: { xs: 'wrap', sm: 'nowrap' },
+	'& .MuiAlert-message': { py: 0.75, flex: { xs: '1 1 calc(100% - 40px)', sm: '1 1 auto' } },
+	'& .MuiAlert-action': {
+		ml: { xs: 0, sm: 'auto' },
+		pl: { xs: 0, sm: 2 },
+		width: { xs: '100%', sm: 'auto' },
+		justifyContent: 'flex-end',
+		pt: { xs: 0, sm: 0.5 },
+	},
+};
+
+// A dismissible list of security problems of the active configuration (fork). It comes
+// back when the set of problems changes.
+export default function SecurityHints(props) {
+	const loc = typeof window !== 'undefined' ? window.location : { protocol: '', hostname: '' };
+	const problems = securityProblems(props.config, loc.protocol, loc.hostname);
+	const id = problems.join(',');
+	const read = () => {
+		try {
+			return window.localStorage.getItem(KEY) || '';
+		} catch (e) {
+			return '';
+		}
+	};
+	const [$dismissed, setDismissed] = React.useState(read());
+
+	// Left by "Status and tools" when a stream key was set: what the sending devices need.
+	const readNote = () => {
+		try {
+			const v = window.localStorage.getItem('stream-key-note') || '';
+			// The mark is the time the key was set. Earlier versions stored the key itself: remove it.
+			if (!/^\d{10,}$/.test(v) || Date.now() - parseInt(v) > 24 * 3600 * 1000) {
+				if (v) {
+					window.localStorage.removeItem('stream-key-note');
+				}
+				return '';
+			}
+			return v;
+		} catch (e) {
+			return '';
+		}
+	};
+	const [$note, setNote] = React.useState(readNote());
+	const token = props.config && props.config.source && props.config.source.network.rtmp ? props.config.source.network.rtmp.token || '' : '';
+	if ($note && token) {
+		const hide = () => {
+			try {
+				window.localStorage.removeItem('stream-key-note');
+			} catch (e) {}
+			setNote('');
+		};
+		return (
+			<Alert
+				severity="success"
+				sx={ALERT}
+				action={
+					<React.Fragment>
+						{props.onSetKey && (
+							<Button color="inherit" size="small" onClick={props.onSetKey}>
+								<Trans>Show the key</Trans>
+							</Button>
+						)}
+						<Button color="inherit" size="small" onClick={hide}>
+							<Trans>Hide</Trans>
+						</Button>
+					</React.Fragment>
+				}
+			>
+				<Trans>The stream key is set. Every device that sends to this server needs it in its address.</Trans>{' '}
+				<Trans>You find the key under Status and tools → Keys.</Trans>
+			</Alert>
+		);
+	}
+
+	if (problems.length === 0 || $dismissed === id) {
+		return null;
+	}
+
+	const dismiss = () => {
+		try {
+			window.localStorage.setItem(KEY, id);
+		} catch (e) {}
+		setDismissed(id);
+	};
+
+	return (
+		<Alert
+			severity="warning"
+			sx={ALERT}
+			action={
+				<React.Fragment>
+					{props.onSetKey && (problems.includes('rtmp_no_token') || problems.includes('srt_no_token')) && (
+						<Button color="inherit" size="small" onClick={props.onSetKey} sx={{ whiteSpace: 'nowrap' }}>
+							<Trans>Set a key</Trans>
+						</Button>
+					)}
+					<Button color="inherit" size="small" onClick={dismiss}>
+						<Trans>Hide</Trans>
+					</Button>
+				</React.Fragment>
+			}
+		>
+			{problems.map((p) => (
+				<div key={p}>{TEXT[p]}</div>
+			))}
+		</Alert>
+	);
+}
