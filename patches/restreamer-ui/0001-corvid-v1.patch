+++ b/src/views/SettingsKeys.js
@@ -0,0 +1,191 @@
+import React from 'react';
+
+import { Trans } from '@lingui/macro';
+import Alert from '@mui/material/Alert';
+import Box from '@mui/material/Box';
+import Button from '@mui/material/Button';
+import Typography from '@mui/material/Typography';
+
+import Palette from '../theme/base/palette';
+import { randomKey } from '../utils/address';
+
+// Stream keys at the top of System > Streaming servers (fork). The main key is shown, not
+// edited: changing it rewrites the addresses of every channel, which the key tool under
+// "Status and tools" > Keys does. The watch key is set here (system metadata, no restart).
+
+const masked = (key) => (key ? '•'.repeat(Math.min(16, key.length)) : '');
+
+function KeyLine(props) {
+	const [$show, setShow] = React.useState(false);
+	const copy = () => {
+		try {
+			navigator.clipboard.writeText(props.value);
+		} catch (e) {}
+	};
+	return (
+		<Box sx={{ display: 'flex', flexWrap: 'wrap', alignItems: 'center', gap: 1 }}>
+			<Box
+				component="code"
+				sx={{
+					flex: '1 1 220px',
+					minWidth: 0,
+					minHeight: 40,
+					display: 'flex',
+					alignItems: 'center',
+					px: 1.5,
+					borderRadius: 1,
+					backgroundColor: Palette.background.surround,
+					border: `1px solid ${Palette.background.line}`,
+					fontFamily: '"IBM Plex Mono", monospace',
+					fontSize: '.9rem',
+					overflowWrap: 'anywhere',
+				}}
+			>
+				{$show ? props.value : masked(props.value)}
+			</Box>
+			<Button variant="outlined" color="inherit" onClick={() => setShow(!$show)}>
+				{$show ? <Trans>Hide</Trans> : <Trans>Show</Trans>}
+			</Button>
+			<Button variant="outlined" color="inherit" onClick={copy}>
+				<Trans>Copy</Trans>
+			</Button>
+		</Box>
+	);
+}
+
+export default function SettingsKeys(props) {
+	const r = props.restreamer;
+	const [$watch, setWatch] = React.useState(null);
+	const [$note, setNote] = React.useState(null);
+	const [$armed, setArmed] = React.useState(false);
+
+	React.useEffect(() => {
+		r.GetWatchKey().then((k) => setWatch(k));
+		// eslint-disable-next-line react-hooks/exhaustive-deps
+	}, []);
+
+	const cfg = props.config;
+	const main = (cfg.rtmp && cfg.rtmp.token) || (cfg.srt && cfg.srt.token) || '';
+	const same = cfg.rtmp && cfg.srt && cfg.rtmp.token && cfg.srt.token && cfg.rtmp.token !== cfg.srt.token;
+	const channel = r.GetCurrentChannelID ? r.GetCurrentChannelID() : '';
+
+	const create = async () => {
+		const res = await r.SetWatchKey(randomKey(24));
+		setNote(
+			res === 'ok'
+				? { severity: 'success', text: <Trans>A new watch key is set. Watch addresses on the main screen now carry it.</Trans> }
+				: { severity: 'error', text: <Trans>The watch key could not be saved.</Trans> },
+		);
+		setWatch(r.WatchKeyCached());
+		setArmed(false);
+	};
+	const remove = async () => {
+		if (!$armed) {
+			setArmed(true);
+			return;
+		}
+		const res = await r.SetWatchKey('');
+		setNote(
+			res === 'ok'
+				? { severity: 'success', text: <Trans>The watch key is removed. The main key watches from anywhere again.</Trans> }
+				: { severity: 'error', text: <Trans>The watch key could not be removed.</Trans> },
+		);
+		setWatch(r.WatchKeyCached());
+		setArmed(false);
+	};
+
+	return (
+		<Box
+			component="section"
+			sx={{
+				backgroundColor: Palette.background.paper,
+				border: `1px solid ${Palette.background.line}`,
+				borderRadius: 1.5,
+				p: { xs: 2, md: 2.5 },
+				display: 'flex',
+				flexDirection: 'column',
+				gap: 2,
+			}}
+		>
+			<Typography variant="h3" component="h2">
+				<Trans>Stream keys</Trans>
+			</Typography>
+
+			<Box>
+				<Typography variant="h4" sx={{ mb: 0.5 }}>
+					<Trans>Main key</Trans>
+				</Typography>
+				{main ? (
+					<React.Fragment>
+						<Typography variant="body1" sx={{ color: 'text.secondary', mb: 1, maxWidth: '75ch' }}>
+							<Trans>Part of the RTMP and SRT addresses. Without it nobody can send to this server.</Trans>
+							{same && (
+								<span>
+									{' '}
+									<Trans>RTMP and SRT have different keys; the RTMP key is shown.</Trans>
+								</span>
+							)}
+						</Typography>
+						<KeyLine value={main} />
+					</React.Fragment>
+				) : (
+					<Alert severity="warning">
+						<Trans>No main key is set: anybody who reaches the RTMP or SRT port can send and watch.</Trans>
+					</Alert>
+				)}
+				<Box sx={{ display: 'flex', flexWrap: 'wrap', alignItems: 'center', gap: '4px 12px', mt: 1 }}>
+					{channel && (
+						<Button variant="outlined" color="inherit" href={`#/${channel}/status/keys`}>
+							{main ? <Trans>Change the main key</Trans> : <Trans>Set a main key</Trans>}
+						</Button>
+					)}
+					<Typography variant="caption">
+						<Trans>The key tool updates the addresses of every channel at the same time.</Trans>
+					</Typography>
+				</Box>
+			</Box>
+
+			<Box sx={{ pt: 2, borderTop: `1px solid ${Palette.background.line}` }}>
+				<Typography variant="h4" sx={{ mb: 0.5 }}>
+					<Trans>Watch key</Trans>
+				</Typography>
+				<Typography variant="body1" sx={{ color: 'text.secondary', mb: 1, maxWidth: '75ch' }}>
+					<Trans>
+						With a watch key the main key only sends from the internet; whoever watches from there uses the watch key, which cannot send. The server
+						itself and the private network (10.x, 172.16–31.x, 192.168.x) keep using the main key, so the server's own processes and the local
+						network are not affected.
+					</Trans>
+				</Typography>
+				{!main ? (
+					<Typography variant="body1" sx={{ color: 'text.secondary' }}>
+						<Trans>Set a main key first.</Trans>
+					</Typography>
+				) : $watch === null ? null : $watch ? (
+					<React.Fragment>
+						<KeyLine value={$watch} />
+						<Box sx={{ display: 'flex', flexWrap: 'wrap', gap: 1, mt: 1 }}>
+							<Button variant="outlined" color="inherit" onClick={create}>
+								<Trans>New watch key</Trans>
+							</Button>
+							<Button variant="text" color={$armed ? 'error' : 'inherit'} onClick={remove} onBlur={() => setArmed(false)}>
+								{$armed ? <Trans>Press again to remove</Trans> : <Trans>Remove the watch key</Trans>}
+							</Button>
+						</Box>
+						<Typography variant="caption" sx={{ display: 'block', mt: 1 }}>
+							<Trans>A new watch key ends every watch link handed out with the old one.</Trans>
+						</Typography>
+					</React.Fragment>
+				) : (
+					<Button variant="outlined" color="inherit" onClick={create}>
+						<Trans>Create a watch key</Trans>
+					</Button>
+				)}
+				{$note && (
+					<Alert severity={$note.severity} sx={{ mt: 1.5 }}>
+						{$note.text}
+					</Alert>
+				)}
+			</Box>
+		</Box>
+	);
+}
