diff --git a/src/utils/password.js b/src/utils/password.js
new file mode 100644
index 0000000..0fefe35
--- /dev/null
+++ b/src/utils/password.js
@@ -0,0 +1,45 @@
+// Is this panel password too easy to guess? (fork) The panel can be reached from the
+// internet, so a short or common password is the weakest point of the whole setup.
+// Returns '' if the password is fine, otherwise the reason: 'short', 'username', 'common', 'simple'.
+
+const COMMON = ['password', 'parola', 'sifre', 'şifre', 'admin', 'qwerty', '123456', 'restreamer', 'datarhei', 'corvid', 'letmein', 'welcome'];
+
+const MIN_LENGTH = 12;
+
+const weakPassword = (password, username = '') => {
+	const pw = String(password || '');
+
+	if (pw.length < MIN_LENGTH) {
+		return 'short';
+	}
+
+	const lower = pw.toLowerCase();
+
+	if (username && lower.includes(String(username).toLowerCase()) && String(username).length >= 3) {
+		return 'username';
+	}
+
+	// The password without digits and punctuation is a well known word.
+	const letters = lower.replace(/[^a-zçğıöşü]/g, '');
+	if (COMMON.some((w) => letters === w || lower.startsWith(w + '123'))) {
+		return 'common';
+	}
+
+	// One character repeated, or a plain run such as 123456789012.
+	if (/^(.)\1+$/.test(pw) || '01234567890123456789'.includes(pw) || 'abcdefghijklmnopqrstuvwxyz'.includes(lower)) {
+		return 'simple';
+	}
+
+	let classes = 0;
+	if (/[a-zçğıöşü]/.test(pw)) classes++;
+	if (/[A-ZÇĞİÖŞÜ]/.test(pw)) classes++;
+	if (/[0-9]/.test(pw)) classes++;
+	if (/[^A-Za-z0-9çğıöşüÇĞİÖŞÜ]/.test(pw)) classes++;
+	if (classes < 2) {
+		return 'simple';
+	}
+
+	return '';
+};
+
+export { weakPassword, MIN_LENGTH };
diff --git a/src/utils/password.test.js b/src/utils/password.test.js
new file mode 100644
index 0000000..2c73bcd
--- /dev/null
+++ b/src/utils/password.test.js
@@ -0,0 +1,26 @@
+import { weakPassword } from './password';
+
+test('short passwords are weak', () => {
+	expect(weakPassword('abc123')).toBe('short');
+	expect(weakPassword('')).toBe('short');
+});
+
+test('a password with the user name in it is weak', () => {
+	expect(weakPassword('admin-2026-xyz', 'admin')).toBe('username');
+});
+
+test('common words are weak', () => {
+	expect(weakPassword('password123456')).toBe('common');
+	expect(weakPassword('Corvid!!!!2026', 'yonetici')).toBe('common');
+});
+
+test('one kind of character only is weak', () => {
+	expect(weakPassword('aaaaaaaaaaaaaa')).toBe('simple');
+	expect(weakPassword('123456789012')).toBe('simple');
+	expect(weakPassword('qlwmznxbcvgh')).toBe('simple');
+});
+
+test('the generated form and long mixed passwords pass', () => {
+	expect(weakPassword('aB3dE6-gH9jK2-mN5pQ8', 'admin')).toBe('');
+	expect(weakPassword('mavi-kapi-42-yagmur', 'admin')).toBe('');
+});
diff --git a/src/utils/processConfig.js b/src/utils/processConfig.js
new file mode 100644
index 0000000..21b5780
--- /dev/null
+++ b/src/utils/processConfig.js
@@ -0,0 +1,45 @@
+// Comparing process configs (fork). The core restarts a process on every update, even an
+// identical one; saving a channel would then also restart its HLS, recording and level
+// meter. The UI skips the update when the stored config already is what it would send.
+
+// canonical drops empty values (the core echoes defaults like 0, false, [] that the UI
+// leaves out) and sorts object keys, so equal configs give equal strings.
+const canonical = (v) => {
+	if (Array.isArray(v)) {
+		return v.length === 0 ? undefined : v.map(canonical);
+	}
+	if (v && typeof v === 'object') {
+		const out = {};
+		for (const k of Object.keys(v).sort()) {
+			const c = canonical(v[k]);
+			if (c === undefined) {
+				continue;
+			}
+			out[k] = c;
+		}
+		return Object.keys(out).length === 0 ? undefined : out;
+	}
+	if (v === null || v === undefined || v === 0 || v === false || v === '') {
+		return undefined;
+	}
+	return v;
+};
+
+const relevant = (c) => {
+	const { created_at, updated_at, ...rest } = c || {};
+	return rest;
+};
+
+// sameProcessConfig reports whether the config stored in the core (as returned by
+// GET /process/<id>?filter=config, its .config) equals the one the UI is about to send.
+export const sameProcessConfig = (stored, wanted) => {
+	if (!stored || !wanted) {
+		return false;
+	}
+	const a = canonical(relevant(stored));
+	const b = canonical(relevant(wanted));
+	if (b && !b.type) {
+		b.type = 'ffmpeg'; // the core's default
+	}
+	return JSON.stringify(a) === JSON.stringify(b);
+};
