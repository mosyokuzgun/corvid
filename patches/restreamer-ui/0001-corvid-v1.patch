diff --git a/src/utils/command.js b/src/utils/command.js
new file mode 100644
index 0000000..bba083d
--- /dev/null
+++ b/src/utils/command.js
@@ -0,0 +1,237 @@
+// Reading an FFmpeg command (fork): split the command the core runs into the parts a person
+// thinks in - general, input, picture, sound, information, output - and quote it so it can be
+// pasted into a terminal.
+//
+// The core builds the command as: global options, then per input its options and "-i address",
+// then per output its options and the address (restream/app CreateCommand). The configuration
+// of the process has the same number of arguments in each part, so the running command is cut
+// along the configuration. If the two do not agree (an older core), the command is cut at "-i".
+
+// Options that take no value.
+const FLAGS = new Set([
+	'-y', '-n', '-re', '-dn', '-sn', '-vn', '-an', '-nostdin', '-shortest', '-copyts', '-start_at_zero',
+	'-hide_banner', '-stats', '-nostats', '-autoexit', '-readrate_catchup', '-ignore_unknown', '-copy_unknown',
+]);
+
+const VIDEO = /^-(c:v|codec:v|vcodec|b:v|maxrate|minrate|bufsize|preset|tune|profile|level|rc|cq|crf|qp|g|keyint_min|sc_threshold|bf|refs|r|s|aspect|pix_fmt|vf|filter_complex|fps_mode|vsync|vtag|tag:v|forced-idr|strict_gop|no-scenecut|zerolatency|delay|rc-lookahead|spatial-aq|temporal-aq|gpu|force_key_frames|x264opts|x264-params|x265-params|bsf:v|top|field_order|color_range|colorspace|color_primaries|color_trc)(:.*)?$/;
+const AUDIO = /^-(c:a|codec:a|acodec|b:a|ar|ac|af|aq|sample_fmt|channel_layout|tag:a|bsf:a|aac_coder)(:.*)?$/;
+const INFO = /^-(metadata|metadata:.*)$/;
+
+// Pairs an option with its value: [['-c:v', 'copy'], ['-y'], ...]
+const pairs = (tokens) => {
+	const out = [];
+	for (let i = 0; i < tokens.length; i++) {
+		const t = `${tokens[i]}`;
+		if (t.startsWith('-') && t.length > 1 && !FLAGS.has(t) && i + 1 < tokens.length) {
+			out.push([t, `${tokens[i + 1]}`]);
+			i++;
+		} else {
+			out.push([t]);
+		}
+	}
+	return out;
+};
+
+// Which part an output option belongs to.
+const kindOf = (pair) => {
+	const [opt, val] = pair;
+	if (opt === '-map') {
+		if (/:v|^\[?v/.test(val || '')) return 'video';
+		if (/:a|^\[?a/.test(val || '')) return 'audio';
+		return 'output';
+	}
+	if (opt === '-vn' || opt === '-dn' || opt === '-sn') return 'video';
+	if (opt === '-an') return 'audio';
+	if (VIDEO.test(opt)) return 'video';
+	if (AUDIO.test(opt)) return 'audio';
+	if (INFO.test(opt)) return 'info';
+	return 'output';
+};
+
+// The command cut where the core joins it: [general, input 0, ..., output 0, ...], each
+// { kind: 'general' | 'input' | 'output', index, tokens }. Nothing is reordered.
+const commandParts = (command, config) => {
+	const cmd = (command || []).map((t) => `${t}`);
+	const parts = [];
+	const add = (kind, index, tokens) => {
+		if (tokens.length !== 0) {
+			parts.push({ kind, index, tokens });
+		}
+	};
+
+	if (config && Array.isArray(config.input) && Array.isArray(config.output)) {
+		const general = (config.options || []).length;
+		const inputs = config.input.map((i) => (i.options || []).length + 2);
+		const outputs = config.output.map((o) => (o.options || []).length + 1);
+		if (general + inputs.reduce((a, b) => a + b, 0) + outputs.reduce((a, b) => a + b, 0) === cmd.length) {
+			let pos = 0;
+			add('general', 0, cmd.slice(0, general));
+			pos = general;
+			inputs.forEach((len, i) => {
+				add('input', i, cmd.slice(pos, pos + len));
+				pos += len;
+			});
+			outputs.forEach((len, i) => {
+				add('output', i, cmd.slice(pos, pos + len));
+				pos += len;
+			});
+			return parts;
+		}
+	}
+
+	// Without a matching configuration: everything up to the last "-i address" is input.
+	let last = -1;
+	for (let i = 0; i < cmd.length - 1; i++) {
+		if (cmd[i] === '-i') last = i;
+	}
+	if (last === -1) {
+		add('output', 0, cmd);
+	} else {
+		add('input', 0, cmd.slice(0, last + 2));
+		add('output', 0, cmd.slice(last + 2));
+	}
+	return parts;
+};
+
+// For reading: each output is split further into picture, sound, information and the rest
+// (address last). Groups: [{ kind, index, tokens }], kind general, input, video, audio, info,
+// output. All arguments are there, but inside an output they are sorted by kind; use
+// commandParts() for the order FFmpeg gets them in.
+const splitCommand = (command, config) => {
+	const groups = [];
+	const add = (kind, index, tokens, output) => {
+		if (tokens.length !== 0) {
+			groups.push(output ? { kind, index, tokens, output } : { kind, index, tokens });
+		}
+	};
+	for (const part of commandParts(command, config)) {
+		if (part.kind === 'output') {
+			splitOutput(part.tokens, part.index, add);
+		} else {
+			add(part.kind, part.index, part.tokens);
+		}
+	}
+	return groups;
+};
+
+// Did sorting by kind move anything? Then the screen says that the copy keeps the real order.
+const regrouped = (command, config) => {
+	const sorted = splitCommand(command, config).flatMap((g) => g.tokens);
+	const cmd = (command || []).map((t) => `${t}`);
+	return sorted.length !== cmd.length || sorted.some((t, i) => t !== cmd[i]);
+};
+
+// An output: its options sorted into picture, sound, information and the rest, the address last.
+function splitOutput(tokens, index, add) {
+	if (tokens.length === 0) return;
+	const address = tokens[tokens.length - 1];
+	const by = { video: [], audio: [], info: [], output: [] };
+	// "-map 0:0" names no stream type: it belongs to the picture or sound options after it.
+	let pending = [];
+	for (const p of pairs(tokens.slice(0, -1))) {
+		const kind = kindOf(p);
+		if (p[0] === '-map' && kind === 'output') {
+			pending.push(...p);
+			continue;
+		}
+		if (pending.length !== 0 && (kind === 'video' || kind === 'audio')) {
+			by[kind].push(...pending);
+			pending = [];
+		}
+		by[kind].push(...p);
+	}
+	by.output.unshift(...pending);
+	// every group of an output knows the whole output: "-codec copy" or "-f null" there
+	// tell what happens to the picture and the sound as well
+	add('video', index, by.video, tokens);
+	add('audio', index, by.audio, tokens);
+	add('info', index, by.info, tokens);
+	add('output', index, [...by.output, address], tokens);
+}
+
+// The value of an option in a list of tokens, the last one wins (as in FFmpeg).
+const optionValue = (tokens, ...names) => {
+	let value = null;
+	for (const [opt, val] of pairs(tokens)) {
+		if (names.includes(opt) && val !== undefined) value = val;
+	}
+	return value;
+};
+
+// One argument for a POSIX shell.
+const shellQuote = (token) => {
+	const t = `${token}`;
+	if (t === '') return "''";
+	if (/^[A-Za-z0-9_@%+=:,./-]+$/.test(t)) return t;
+	return `'${t.replace(/'/g, `'\\''`)}'`;
+};
+
+const shellLine = (tokens) => tokens.map(shellQuote).join(' ');
+
+// The whole command for a terminal, in the order FFmpeg gets it: one line, or one part
+// (general, each input, each output) per line with continuations.
+const shellCommand = (command, config, readable) => {
+	const lines = commandParts(command, config)
+		.map((g) => shellLine(g.tokens))
+		.filter((l) => l.length !== 0);
+	if (lines.length === 0) return 'ffmpeg';
+	return readable ? ['ffmpeg', ...lines].join(' \\\n  ') : ['ffmpeg', ...lines].join(' ');
+};
+
+// What a group does, as plain facts for the sentence next to it.
+const describe = (group) => {
+	const t = group.tokens;
+	switch (group.kind) {
+		case 'input': {
+			const address = t[t.length - 1] || '';
+			const m = /^([a-z0-9+]+):/i.exec(address);
+			const proto = address.startsWith('{') ? 'own' : m ? m[1].toLowerCase() : address.startsWith('/') ? 'file' : '';
+			return { proto, format: optionValue(t, '-f'), loop: optionValue(t, '-loop', '-stream_loop'), realtime: t.includes('-re') || optionValue(t, '-readrate') !== null };
+		}
+		case 'video': {
+			const all = group.output || t;
+			const codec = optionValue(t, '-codec:v', '-c:v', '-vcodec') || optionValue(all, '-codec', '-c');
+			const fps = optionValue(t, '-r');
+			const gop = optionValue(t, '-g');
+			const seconds = fps && gop && Number(fps) > 0 ? Math.round((Number(gop) / Number(fps)) * 10) / 10 : null;
+			return {
+				codec,
+				copy: codec === 'copy',
+				nvenc: /nvenc/.test(codec || ''),
+				none: t.includes('-vn'),
+				bitrate: optionValue(t, '-b:v'),
+				fps,
+				keyframe: seconds,
+				filter: optionValue(t, '-vf', '-filter:v', '-filter_complex') !== null,
+				size: optionValue(t, '-s'),
+				measured: optionValue(all, '-f') === 'null',
+			};
+		}
+		case 'audio': {
+			const all = group.output || t;
+			const codec = optionValue(t, '-codec:a', '-c:a', '-acodec') || optionValue(all, '-codec', '-c');
+			return {
+				codec,
+				copy: codec === 'copy',
+				none: t.includes('-an'),
+				bitrate: optionValue(t, '-b:a'),
+				rate: optionValue(t, '-ar'),
+				channels: optionValue(t, '-ac'),
+				measured: optionValue(all, '-f') === 'null',
+			};
+		}
+		case 'output': {
+			const address = t[t.length - 1] || '';
+			const format = optionValue(t, '-f');
+			const m = /^(?:\[[^\]]*\])?([a-z0-9+]+):/i.exec(address);
+			// local: this server (localhost, the core's placeholders) or a file; for a tee every target
+			const isLocal = (a) => /^(?:\[[^\]]*\])?(?:[a-z0-9+]+:\/\/(?:[^@/\s]*@)?(?:localhost|127\.0\.0\.1)[:/]|\{|\/)/i.test(a) || a === '-';
+			const local = address.split('|').every((a) => isLocal(a.trim()));
+			return { format, proto: m ? m[1].toLowerCase() : '', local, tee: format === 'tee', discard: format === 'null' || address === '-' };
+		}
+		default:
+			return {};
+	}
+};
+
+export { FLAGS, pairs, kindOf, commandParts, splitCommand, regrouped, optionValue, shellQuote, shellLine, shellCommand, describe };
