+			});
+	}
+
+	// What happened to a channel lately, newest first, from the core log (which keeps a
+	// limited number of lines in memory).
+	async GetChannelEvents(channelid) {
+		const channel = this.GetChannel(channelid);
+		if (channel === null) {
+			return [];
+		}
+		const names = {};
+		for (const p of await this.ListIngestEgresses(channelid)) {
+			names[p.id] = p.name;
+		}
+		return channelEvents(await this.Log(), channel.channelid, names);
+	}
+
+	// Everything Restreamer stores in the core: system metadata and all its processes.
+	async ExportConfig() {
+		const list = await this._listProcesses(['config', 'metadata']);
+		return {
+			format: BACKUP_FORMAT,
+			version: 1,
+			created: new Date().toISOString(),
+			metadata: (await this._getMetadata()) || {},
+			processes: list.filter((p) => /^restreamer-ui:/.test(p.id)).map((p) => ({ config: p.config, metadata: uiMetadata(p.metadata) })),
+		};
+	}
+
+	// Restore a backup. Processes that exist already are left alone; added ones do not start
+	// on their own (connect the channel / start the publication by hand). Returns the counts.
+	async ImportConfig(data) {
+		const result = { added: 0, skipped: 0, failed: 0 };
+		if (!data || data.format !== BACKUP_FORMAT || !Array.isArray(data.processes)) {
+			throw new Error('This is not a Corvid configuration backup.');
+		}
+		const have = new Set((await this._listProcesses([])).map((p) => p.id));
+		for (const p of data.processes) {
+			if (!p || !p.config || !/^restreamer-ui:/.test(`${p.config.id}`)) {
+				result.failed++;
+				continue;
+			}
+			if (have.has(p.config.id)) {
+				result.skipped++;
+				continue;
+			}
+			const [, err] = await this._call(this.api.ProcessAdd, { ...p.config, autostart: false });
+			if (err !== null) {
+				result.failed++;
+				continue;
+			}
+			await this._setProcessMetadata(p.config.id, p.metadata || {});
+			result.added++;
+		}
+		if (data.metadata && typeof data.metadata === 'object' && data.metadata.canvasTemplates) {
+			const metadata = (await this._getMetadata()) || {};
+			metadata.canvasTemplates = { ...data.metadata.canvasTemplates, ...(metadata.canvasTemplates || {}) };
+			await this._setMetadata(metadata);
+		}
+		await this._discoverChannels();
+		return result;
+	}
+
+	// Copy a channel with its settings (source, encoding, canvas, fallback, recording), but
+	// without its publications: two channels must not send to the same stream key.
+	async CopyChannel(channelid, name) {
+		const channel = this.GetChannel(channelid);
+		if (channel === null) {
+			return '';
+		}
+		const copyid = uuidv4();
+		const list = (await this._listProcesses(['config', 'metadata'], channel.channelid)).filter((p) => p.id.startsWith(channel.id));
+		let ok = false;
+		for (const p of list) {
+			const copy = copyChannelData({ config: p.config, metadata: uiMetadata(p.metadata) }, channel.channelid, copyid);
+			copy.config.autostart = false;
+			if (p.id === channel.id) {
+				copy.metadata.meta = { ...(copy.metadata.meta || {}), name: name };
+			}
+			if (p.id.endsWith(RECORD_SUFFIX)) {
+				continue; // the recording gets a folder of its own when the copy is saved
+			}
+			const [, err] = await this._call(this.api.ProcessAdd, copy.config);
+			if (err !== null) {
+				continue;
+			}
+			await this._setProcessMetadata(copy.config.id, copy.metadata);
+			ok = ok || p.id === channel.id;
+		}
+		if (!ok) {
+			return '';
+		}
+		await this._discoverChannels();
