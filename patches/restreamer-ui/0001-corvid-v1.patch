+							</Box>
+						</Box>
+					</Box>
+				</Box>
+
+				<Summary label="summary" settings={s} mode={props.mode} unsaved={props.unsaved} running={props.running} />
+			</Box>
+
+			<Box
+				sx={{
+					position: 'sticky',
+					// above the application's own footer, which is fixed to the bottom of the window
+					bottom: 68,
+					zIndex: 5,
+					mt: 2,
+					backgroundColor: Palette.background.footer2,
+					border: `1px solid ${Palette.background.line}`,
+					borderRadius: 1.5,
+					px: { xs: 2, md: 2.5 },
+					py: 1.5,
+					display: 'flex',
+					flexWrap: 'wrap',
+					alignItems: 'center',
+					gap: '8px 12px',
+				}}
+			>
