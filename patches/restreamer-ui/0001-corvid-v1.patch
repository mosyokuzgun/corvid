+test('canvas:image background resolves into diskfs and is uploaded once', () => {
+	const g = Canvas.createGraph({ ...base, bg: 'image', image: '/channels/abc/canvas.png', fit: 'cover' });
+	expect(g).toContain("movie=filename='{diskfs}/channels/abc/canvas.png'");
+	expect(g).toContain('hwupload[cvbgi]');
+	expect(g).toContain('[cvb][cvbig]overlay_cuda');
+});
+
+// Runs the identical topology with CPU filters through a real FFmpeg (skipped without ffmpeg).
+let ffmpeg = null;
+try {
+	execFileSync('ffmpeg', ['-hide_banner', '-version']);
+	ffmpeg = 'ffmpeg';
+} catch (e) {}
+
+const cases = [];
+for (let fit of ['contain', 'cover', 'stretch']) {
+	for (let bg of ['blur', 'color', 'image']) {
+		cases.push([fit, bg]);
+	}
+}
+
+(ffmpeg ? test.each(cases) : test.skip.each(cases))('canvas:ffmpeg %s/%s produces 1080x1920', (fit, bg) => {
+	const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'canvas-'));
+	const img = path.join(dir, 'bg.png');
+	execFileSync('ffmpeg', ['-v', 'error', '-y', '-f', 'lavfi', '-i', 'gradients=s=800x1200', '-frames:v', '1', img]);
+	const graph = Canvas.createGraph({ ...base, fit, bg, image: '/bg.png', color: '#203040' }, { cpu: true, path: () => img });
+	const out = path.join(dir, 'out.mp4');
+	execFileSync('ffmpeg', [
+		'-v',
+		'error',
+		'-y',
+		'-f',
+		'lavfi',
+		'-i',
+		'testsrc2=s=1920x1080:r=25:d=1',
+		'-filter:v',
+		graph,
+		'-c:v',
+		'libx264',
+		'-preset',
+		'ultrafast',
+		out,
+	]);
+	const probe = execFileSync('ffprobe', [
+		'-v',
+		'error',
+		'-select_streams',
+		'v:0',
+		'-show_entries',
+		'stream=width,height,sample_aspect_ratio,nb_frames',
+		'-of',
+		'csv=p=0',
+		out,
+	])
+		.toString()
+		.trim();
+	// Square pixels: with any other SAR, players show the 1080x1920 frame as 16:9.
+	expect(probe).toBe('1080,1920,1:1,25');
+	fs.rmSync(dir, { recursive: true, force: true });
+});
+
+test('canvas:component renders and emits a graph', async () => {
+	i18n.load('en', {});
+	i18n.activate('en');
+	let graph = null;
+	render(
+		<I18nProvider i18n={i18n}>
