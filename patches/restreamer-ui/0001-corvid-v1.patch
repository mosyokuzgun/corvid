+	return (
+		<Box sx={{ display: 'flex', alignItems: 'center', gap: 1, minWidth: 0 }}>
+			<Box component="span" sx={{ width: props.name ? 28 : 0, fontSize: '.85rem', color: 'text.secondary', flexShrink: 0 }} aria-hidden="true">
+				{props.name}
+			</Box>
+			<Box
+				role="meter"
+				aria-label={props.label}
+				aria-valuemin={FLOOR}
+				aria-valuemax={0}
+				aria-valuenow={none || silent ? FLOOR : Math.round(level)}
+				aria-valuetext={none ? i18n._(t`no channel`) : silent ? i18n._(t`silent`) : `${Math.round(level)} dB`}
