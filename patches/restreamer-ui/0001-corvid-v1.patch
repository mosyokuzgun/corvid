+							<Grid item xs={12}>
+								<Select
+									label={<Trans>Canvas size</Trans>}
+									value={`${settings.width}x${settings.height}`}
+									onChange={(e) => {
+										const [w, h] = e.target.value.split('x');
+										patch({ width: w, height: h });
