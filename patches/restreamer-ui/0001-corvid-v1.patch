diff --git a/src/utils/address.js b/src/utils/address.js
new file mode 100644
index 0000000..f778249
--- /dev/null
+++ b/src/utils/address.js
@@ -0,0 +1,147 @@
+// Checks of addresses a process reads from (fork). They catch mistakes that otherwise only
+// show up as a process that keeps restarting. Returns a list of problem codes.
+export function checkInputAddress(address) {
+	const a = `${address || ''}`;
+	const problems = [];
+	if (a.length === 0) {
+		return problems;
+	}
+
+	if (a !== a.trim() || /\s/.test(a.trim())) {
+		problems.push('whitespace');
+	}
+
+	const m = /^([a-z][a-z0-9+.-]*):\/\//i.exec(a.trim());
+	const proto = m ? m[1].toLowerCase() : '';
+
+	if (proto === 'srt') {
+		const query = a.includes('?') ? a.slice(a.indexOf('?') + 1) : '';
+		let streamid = '';
+		for (const kv of query.split('&')) {
+			if (kv.toLowerCase().startsWith('streamid=')) {
+				streamid = kv.slice(9);
+				try {
+					streamid = decodeURIComponent(streamid);
+				} catch (e) {}
+			}
+		}
+		// Restreamer's SRT server: "<name>,mode:publish" sends, "<name>,mode:request" reads.
+		if (/(^|,)mode:publish(,|$)/.test(streamid) || /(^|,|#!:)m=publish(,|$)/.test(streamid)) {
+			problems.push('srt_publish');
+		}
+	}
+
+	if ((proto === 'rtmp' || proto === 'rtmps') && /^rtmps?:\/\/[^/]+\/?$/i.test(a.trim())) {
+		problems.push('rtmp_no_path');
+	}
+
+	return problems;
+}
+
+// Is the backup address the same stream as one of the sources? Then it fails together
+// with the source and is no backup.
+export function sameStream(address, sources) {
+	const norm = (a) => `${a || ''}`.trim().replace(/\/+$/, '').toLowerCase();
+	const a = norm(address);
+	return a.length !== 0 && (sources || []).some((s) => norm(s) === a);
+}
+
+// ---- Stream key (fork) ------------------------------------------------------------------
+
+// Protocol, host and port of an RTMP or SRT address (port: the protocol's default if none).
+export function serverOf(address) {
+	const m = /^(rtmps?|srt):\/\/(\[[^\]]+\]|[^:/?#]+)(?::(\d+))?/i.exec(`${address || ''}`.trim());
+	if (!m) {
+		return null;
+	}
+	const proto = m[1].toLowerCase().startsWith('rtmp') ? 'rtmp' : 'srt';
+	return { proto, host: m[2].replace(/^\[|\]$/g, '').toLowerCase(), port: m[3] ? parseInt(m[3]) : proto === 'rtmp' ? 1935 : 0 };
+}
+
+// Put the stream key into an address of Restreamer's RTMP or SRT server, replacing one that
+// is there. An empty token removes it. Other addresses are returned unchanged.
+export function withStreamKey(address, token) {
+	const a = `${address || ''}`.trim();
+	const server = serverOf(a);
+	if (!server) {
+		return a;
+	}
+
+	if (server.proto === 'rtmp') {
+		const [base, query = ''] = a.split('?');
+		const params = query.split('&').filter((kv) => kv.length !== 0 && !/^token=/i.test(kv));
+		if (token) {
+			params.push('token=' + encodeURIComponent(token));
+		}
+		return params.length !== 0 ? `${base}?${params.join('&')}` : base;
+	}
+
+	// srt://host:port?...&streamid=<name>,mode:<mode>,token:<token>
+	return a.replace(/([?&]streamid=)([^&]*)/i, (all, key, value) => {
+		const encoded = /%[0-9a-f]{2}/i.test(value);
+		let id = value;
+		if (encoded) {
+			try {
+				id = decodeURIComponent(value);
+			} catch (e) {}
+		}
+		if (id.startsWith('#!:')) {
+			const parts = id
+				.slice(3)
+				.split(',')
+				.filter((kv) => kv.length !== 0 && !/^token=/.test(kv));
+			if (token) {
+				parts.push('token=' + token);
+			}
+			id = '#!:' + parts.join(',');
+		} else {
+			id = id.replace(/,token:[^,]*/g, '');
+			if (token) {
+				id += ',token:' + token;
+			}
+		}
+		return key + (encoded ? encodeURIComponent(id) : id);
+	});
+}
+
+// Is this an address of Restreamer's own RTMP/SRT server? hosts: the names and IPs the
+// server is reached by; ports: { rtmp, srt }.
+export function isOwnServer(address, hosts, ports) {
+	const server = serverOf(address);
+	if (!server || !ports[server.proto] || server.port !== ports[server.proto]) {
+		return false;
+	}
+	return (hosts || []).map((h) => `${h}`.trim().toLowerCase()).includes(server.host);
+}
+
+// An address of this server's own RTMP or SRT server, written with one of its outside names
+// or addresses (hosts), is read through the local address instead (locals: { rtmp, srt },
+// such as "localhost" and "localhost:6000"): behind a router the outside address makes the
+// stream leave the server and come back through the router, which costs bandwidth and makes
+// the broadcast depend on the router. Only plain RTMP and SRT on the server's own port
+// (ports: { rtmp, srt }); the path and the parameters (stream key, stream ID) stay.
+export function localAddress(address, hosts, ports, locals) {
+	const a = `${address || ''}`.trim();
+	const m = /^(rtmp|srt):\/\/(\[[^\]]+\]|[^:/?#]+)(?::(\d+))?/i.exec(a);
+	if (!m || !isOwnServer(a, hosts, ports)) {
+		return address;
+	}
+	const proto = m[1].toLowerCase();
+	const host = m[2].replace(/^\[|\]$/g, '').toLowerCase();
+	if (['localhost', '127.0.0.1', '::1'].includes(host) || !locals || !locals[proto]) {
+		return address;
+	}
+	return `${proto}://${locals[proto]}${a.slice(m[0].length)}`;
+}
+
+export function randomKey() {
+	const a = new Uint8Array(12);
+	if (typeof window !== 'undefined' && window.crypto && window.crypto.getRandomValues) {
+		window.crypto.getRandomValues(a);
+	} else {
+		for (let i = 0; i < a.length; i++) {
+			a[i] = Math.floor(Math.random() * 256);
+		}
+	}
+	return Array.from(a, (b) => b.toString(16).padStart(2, '0')).join('');
+}
diff --git a/src/utils/address.test.js b/src/utils/address.test.js
