diff --git a/src/misc/filters/video/ScaleCUDA.js b/src/misc/filters/video/ScaleCUDA.js
new file mode 100644
index 0000000..de15fc3
--- /dev/null
+++ b/src/misc/filters/video/ScaleCUDA.js
@@ -0,0 +1,132 @@
+import React from 'react';
+
+import { Trans } from '@lingui/macro';
+import Grid from '@mui/material/Grid';
+import MenuItem from '@mui/material/MenuItem';
+
+import Select from '../../Select';
+import Video from '../../coders/settings/Video';
+
+// GPU scaler (fork): https://ffmpeg.org/ffmpeg-filters.html#scale_005fcuda
+// Works on CUDA frames (NVDEC zero-copy). With a software decoder the frames are
+// uploaded automatically (see metadata.js).
+
+function init(initialState) {
+	return {
+		mode: 'none',
+		fix: '1280x720',
+		width: '1280',
+		height: '720',
+		interp: 'lanczos',
+		...initialState,
+	};
+}
+
+function createGraph(settings) {
+	settings = init(settings);
+	const interp = `interp_algo=${settings.interp}`;
+
+	if (settings.mode === 'height') {
+		return `scale_cuda=w=-2:h=${settings.height}:${interp}`;
+	} else if (settings.mode === 'width') {
+		return `scale_cuda=w=${settings.width}:h=-2:${interp}`;
+	} else if (settings.mode === 'fix') {
+		const [w, h] = settings.fix.split('x');
+		return `scale_cuda=w=${w}:h=${h}:${interp}`;
+	}
+
+	return '';
+}
+
+function Filter(props) {
+	const settings = init(props.settings);
+
+	const handleChange = (newSettings) => {
+		let automatic = false;
+		if (!newSettings) {
+			newSettings = settings;
+			automatic = true;
+		}
+
+		props.onChange(newSettings, createGraph(newSettings), automatic);
+	};
+
+	const update = (what) => (event) => {
+		handleChange({ ...settings, [what]: event.target.value });
+	};
+
+	React.useEffect(() => {
+		handleChange(null);
+		// eslint-disable-next-line react-hooks/exhaustive-deps
+	}, []);
+
+	return (
+		<React.Fragment>
+			<Grid item xs={settings.mode === 'none' ? 12 : 4}>
+				<Select label={<Trans>Scale (GPU)</Trans>} value={settings.mode} onChange={update('mode')}>
+					<MenuItem value="none">
+						<Trans>None</Trans>
+					</MenuItem>
+					<MenuItem value="fix">
+						<Trans>Fix size</Trans>
+					</MenuItem>
+					<MenuItem value="height">
+						<Trans>By height</Trans>
+					</MenuItem>
+					<MenuItem value="width">
+						<Trans>By width</Trans>
+					</MenuItem>
+				</Select>
+			</Grid>
+			{settings.mode === 'fix' && (
+				<Grid item xs={4}>
+					<Video.Size allowCustom label={<Trans>Scale size</Trans>} value={settings.fix} onChange={update('fix')} />
+				</Grid>
+			)}
+			{settings.mode === 'width' && (
+				<Grid item xs={4}>
+					<Video.Width allowCustom label={<Trans>Scale size</Trans>} value={settings.width} onChange={update('width')} />
+				</Grid>
+			)}
+			{settings.mode === 'height' && (
+				<Grid item xs={4}>
+					<Video.Height allowCustom label={<Trans>Scale size</Trans>} value={settings.height} onChange={update('height')} />
+				</Grid>
+			)}
+			{settings.mode !== 'none' && (
+				<Grid item xs={4}>
+					<Select label={<Trans>Interpolation</Trans>} value={settings.interp} onChange={update('interp')}>
+						<MenuItem value="bilinear">bilinear</MenuItem>
+						<MenuItem value="bicubic">bicubic</MenuItem>
+						<MenuItem value="lanczos">lanczos</MenuItem>
+					</Select>
+				</Grid>
+			)}
+		</React.Fragment>
+	);
+}
+
+Filter.defaultProps = {
+	settings: {},
+	onChange: function (settings, mapping) {},
+};
+
+const filter = 'scale_cuda';
+const name = 'Scale (CUDA)';
+const type = 'video';
+const hwaccel = true;
+
+function summarize(settings) {
+	settings = init(settings);
+	if (settings.mode === 'none') {
+		return '';
+	}
+	return `${name} (${createGraph(settings)})`;
+}
+
+function defaults() {
+	const settings = init({});
+	return { settings: settings, graph: createGraph(settings) };
+}
+
+export { name, filter, type, hwaccel, summarize, defaults, createGraph, Filter as component };
