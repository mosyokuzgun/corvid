+// Shared implementation for the NVENC encoders (h264_nvenc, hevc_nvenc, av1_nvenc).
+//
+// Modern NVENC (SDK >= 10, FFmpeg >= 4.3) uses presets p1..p7 plus a separate tuning
+// info. The legacy presets (slow, medium, fast, hp, hq, ll, llhq, llhp, ...) and the
+// legacy rate controls (cbr_ld_hq, cbr_hq, vbr_hq) are deprecated and removed in recent
+// FFmpeg releases, so stored settings are migrated transparently in init().
+//
+// "{gpu}" is resolved by the core at every (re)start to the least loaded GPU.
+
+import React from 'react';
+
+import Grid from '@mui/material/Grid';
+import MenuItem from '@mui/material/MenuItem';
+import Typography from '@mui/material/Typography';
+
+import { Trans } from '@lingui/macro';
+
+import Checkbox from '../../../Checkbox';
+import Select from '../../../Select';
+import Video from '../../settings/Video';
+import Helper from '../../helper';
+
+const legacyPresets = {
+	default: ['p4', null],
+	slow: ['p7', 'hq'],
+	medium: ['p4', 'hq'],
+	fast: ['p2', 'hq'],
+	hp: ['p1', 'hq'],
+	hq: ['p6', 'hq'],
+	bd: ['p7', 'hq'],
+	ll: ['p4', 'll'],
+	llhq: ['p5', 'll'],
+	llhp: ['p2', 'll'],
+	lossless: ['p4', 'lossless'],
+	losslesshp: ['p1', 'lossless'],
+	losslesshq: ['p7', 'lossless'],
+};
+
+const legacyRC = {
+	cbr_ld_hq: ['cbr', 'll'],
+	cbr_hq: ['cbr', null],
+	vbr_hq: ['vbr', null],
+};
+
+export function init(initialState) {
+	const state = {
+		bitrate: '4096',
+		fps: '25',
+		gop: '2',
+		preset: 'p4',
+		tune: 'll',
+		rc: 'cbr',
+		multipass: 'qres',
+		bframes: '0',
+		lookahead: '0',
+		spatial_aq: true,
+		temporal_aq: false,
+		cq: '0',
+		qp: '23',
+		profile: 'auto',
+		level: 'auto',
+		gpu: 'auto',
+		...initialState,
+	};
+
+	// Migrate settings from the stock Restreamer UI.
+	if (legacyPresets[state.preset]) {
+		const [preset, tune] = legacyPresets[state.preset];
+		state.preset = preset;
+		if (tune !== null) {
+			state.tune = tune;
+		}
+	}
+	if (legacyRC[state.rc]) {
+		const [rc, tune] = legacyRC[state.rc];
+		state.rc = rc;
+		if (tune !== null) {
+			state.tune = tune;
+		}
+	}
+	if (state.rc === 'auto') {
+		state.rc = 'cbr';
+	}
+
+	// Low latency tunings must not use B-frames (reorder delay; WebRTC rejects them).
+	if (state.tune === 'll' || state.tune === 'ull') {
+		state.bframes = '0';
+	}
+	if (state.tune === 'ull') {
+		state.lookahead = '0';
+	}
+
+	return state;
+}
+
+export function createMapping(encoder, settings, stream, skills) {
+	stream = Helper.InitStream(stream);
+	skills = Helper.InitSkills(skills);
+
+	const gpu = settings.gpu === 'auto' ? '{gpu}' : `${settings.gpu}`;
+
+	const local = ['-codec:v', encoder, '-gpu', gpu, '-preset:v', `${settings.preset}`, '-tune:v', `${settings.tune}`];
+
+	if (settings.multipass !== 'disabled') {
+		local.push('-multipass', `${settings.multipass}`);
+	}
+
+	switch (settings.rc) {
+		case 'constqp':
+			local.push('-rc:v', 'constqp', '-qp', `${settings.qp}`);
+			break;
+		case 'vbr':
+			local.push('-rc:v', 'vbr', '-b:v', `${settings.bitrate}k`, '-maxrate', `${Math.round(parseInt(settings.bitrate) * 1.5)}k`);
+			local.push('-bufsize', `${parseInt(settings.bitrate) * 2}k`);
+			if (parseInt(settings.cq) > 0) {
+				local.push('-cq', `${settings.cq}`);
+			}
+			break;
+		default:
+			// CBR with a 1x VBV keeps the latency added by the rate control at ~1 frame.
+			local.push('-rc:v', 'cbr', '-b:v', `${settings.bitrate}k`, '-maxrate', `${settings.bitrate}k`, '-bufsize', `${settings.bitrate}k`);
+	}
+
+	if (settings.tune === 'll' || settings.tune === 'ull') {
+		// zerolatency: no reordering delay; delay 0: hand out packets immediately.
+		local.push('-zerolatency', '1', '-delay', '0');
+	}
+
+	local.push('-bf', `${settings.bframes}`, '-rc-lookahead', `${settings.lookahead}`);
+
+	if (settings.spatial_aq) {
+		local.push('-spatial-aq', '1');
+	}
+	if (settings.temporal_aq && encoder !== 'av1_nvenc') {
+		local.push('-temporal-aq', '1');
+	}
+
+	local.push('-r', `${settings.fps}`);
+
+	if (settings.gop !== 'auto') {
+		const gop = Math.round(parseInt(settings.fps) * parseFloat(settings.gop)).toFixed(0);
+		// Fixed GOP: egress/HLS segments and the RTMP failover switch on keyframes.
+		local.push('-g', gop, '-keyint_min', gop, '-forced-idr', '1', '-strict_gop', '1', '-no-scenecut', '1');
+	}
+
+	if (settings.profile !== 'auto') {
+		local.push('-profile:v', `${settings.profile}`);
+	}
+
+	if (settings.level !== 'auto') {
+		local.push('-level:v', `${settings.level}`);
+	}
+
+	// No -pix_fmt here: with NVDEC zero-copy the frames are CUDA surfaces and forcing a
+	// software pixel format would make FFmpeg insert an impossible conversion. For software
+	// decoded input NVENC accepts yuv420p/nv12 directly. (metadata.js adds format=yuv420p
+	// for CPU frames.)
+	return {
+		global: [],
+		local: local,
+		filter: [],
+	};
+}
+
+const PRESET_HELP = {
+	p1: <Trans>fastest, lowest quality</Trans>,
+	p4: <Trans>balanced</Trans>,
+	p7: <Trans>slowest, best quality</Trans>,
+};
+
+function Preset(props) {
+	return (
+		<Select label={<Trans>Preset</Trans>} value={props.value} onChange={props.onChange}>
+			{['p1', 'p2', 'p3', 'p4', 'p5', 'p6', 'p7'].map((p) => (
+				<MenuItem key={p} value={p}>
+					{p}
+					{PRESET_HELP[p] ? <span>&nbsp;({PRESET_HELP[p]})</span> : null}
+				</MenuItem>
+			))}
+		</Select>
+	);
+}
+
+function Tune(props) {
+	return (
+		<Select label={<Trans>Tuning</Trans>} value={props.value} onChange={props.onChange}>
+			<MenuItem value="hq">hq – high quality</MenuItem>
+			<MenuItem value="ll">ll – low latency</MenuItem>
+			<MenuItem value="ull">ull – ultra low latency</MenuItem>
+			<MenuItem value="lossless">lossless</MenuItem>
+		</Select>
+	);
+}
+
+function RateControl(props) {
+	return (
+		<Select label={<Trans>Rate control</Trans>} value={props.value} onChange={props.onChange}>
+			<MenuItem value="cbr">CBR</MenuItem>
+			<MenuItem value="vbr">VBR</MenuItem>
+			<MenuItem value="constqp">CQP (constqp)</MenuItem>
+		</Select>
+	);
+}
+
+function Multipass(props) {
+	return (
+		<Select label={<Trans>Multipass</Trans>} value={props.value} onChange={props.onChange}>
+			<MenuItem value="disabled">disabled</MenuItem>
+			<MenuItem value="qres">qres – quarter resolution</MenuItem>
+			<MenuItem value="fullres">full – full resolution</MenuItem>
+		</Select>
+	);
+}
+
+function GPU(props) {
+	const gpus = props.gpus || [];
+	return (
+		<Select label={<Trans>GPU</Trans>} value={props.value} onChange={props.onChange}>
+			<MenuItem value="auto">
+				<Trans>Automatic (least loaded GPU)</Trans>
+			</MenuItem>
+			{gpus.length === 0
+				? [0, 1, 2, 3].map((i) => (
+						<MenuItem key={i} value={`${i}`}>
+							GPU {i}
+						</MenuItem>
+					))
+				: gpus.map((g) => (
+						<MenuItem key={g.device.index} value={`${g.device.index}`}>
+							GPU {g.device.index} – {g.device.name}
+						</MenuItem>
+					))}
+		</Select>
+	);
+}
+
+function Profile(props) {
+	return (
+		<Select label={<Trans>Profile</Trans>} value={props.value} onChange={props.onChange}>
+			{props.profiles.map((p) => (
+				<MenuItem key={p} value={p}>
+					{p}
+				</MenuItem>
+			))}
+		</Select>
+	);
+}
+
+function Number(props) {
+	return (
+		<Select label={props.label} value={props.value} onChange={props.onChange} disabled={props.disabled}>
+			{props.values.map((v) => (
+				<MenuItem key={v} value={`${v}`}>
+					{v}
+				</MenuItem>
+			))}
+		</Select>
+	);
+}
+
+export function makeCoder(encoder, profiles) {
+	function Coder(props) {
+		const settings = init(props.settings);
+		const stream = Helper.InitStream(props.stream);
+		const skills = Helper.InitSkills(props.skills);
+		const gpus = skills.gpus || [];
+
+		const handleChange = (newSettings) => {
+			let automatic = false;
+			if (!newSettings) {
+				newSettings = settings;
+				automatic = true;
+			}
+
+			props.onChange(newSettings, createMapping(encoder, newSettings, stream, skills), automatic);
+		};
+
+		const update = (what) => (event) => {
+			let value = event.target.value;
+			if (['spatial_aq', 'temporal_aq'].includes(what)) {
+				value = !settings[what];
+			}
+			const newSettings = { ...settings, [what]: value };
+			if (what === 'tune' && (value === 'll' || value === 'ull')) {
+				newSettings.bframes = '0';
+				if (value === 'ull') {
+					newSettings.lookahead = '0';
+				}
+			}
+			handleChange(newSettings);
+		};
+
+		React.useEffect(() => {
+			handleChange(null);
+			// eslint-disable-next-line react-hooks/exhaustive-deps
+		}, []);
+
+		const lowLatency = settings.tune === 'll' || settings.tune === 'ull';
+
+		return (
+			<Grid container spacing={2}>
+				{settings.rc !== 'constqp' && (
+					<Grid item xs={12}>
+						<Video.Bitrate value={settings.bitrate} onChange={update('bitrate')} allowCustom />
+					</Grid>
+				)}
+				<Grid item xs={12}>
+					<Video.Framerate value={settings.fps} onChange={update('fps')} allowCustom />
+				</Grid>
+				<Grid item xs={12}>
+					<Video.GOP value={settings.gop} onChange={update('gop')} allowAuto allowCustom />
+				</Grid>
+				<Grid item xs={6}>
+					<Preset value={settings.preset} onChange={update('preset')} />
+				</Grid>
+				<Grid item xs={6}>
+					<Tune value={settings.tune} onChange={update('tune')} />
+				</Grid>
+				<Grid item xs={6}>
+					<RateControl value={settings.rc} onChange={update('rc')} />
+				</Grid>
+				<Grid item xs={6}>
+					<Multipass value={settings.multipass} onChange={update('multipass')} />
+				</Grid>
+				{settings.rc === 'vbr' && (
+					<Grid item xs={6}>
+						<Number label={<Trans>CQ (0 = auto)</Trans>} value={settings.cq} values={[0, 18, 20, 23, 26, 28, 30, 34]} onChange={update('cq')} />
+					</Grid>
+				)}
+				{settings.rc === 'constqp' && (
+					<Grid item xs={6}>
+						<Number label={<Trans>QP</Trans>} value={settings.qp} values={[15, 18, 20, 23, 26, 28, 30, 34, 40]} onChange={update('qp')} />
+					</Grid>
+				)}
+				<Grid item xs={6}>
+					<Number
+						label={<Trans>B-frames</Trans>}
+						value={settings.bframes}
+						values={[0, 1, 2, 3, 4]}
+						onChange={update('bframes')}
+						disabled={lowLatency}
+					/>
+				</Grid>
+				<Grid item xs={6}>
+					<Number
+						label={<Trans>Lookahead (frames)</Trans>}
+						value={settings.lookahead}
+						values={[0, 4, 8, 16, 32]}
+						onChange={update('lookahead')}
+						disabled={settings.tune === 'ull'}
+					/>
+				</Grid>
+				<Grid item xs={6}>
+					<GPU value={settings.gpu} onChange={update('gpu')} gpus={gpus} />
+				</Grid>
+				<Grid item xs={6}>
+					<Profile value={settings.profile} onChange={update('profile')} profiles={profiles} />
+				</Grid>
+				<Grid item xs={12}>
+					<Checkbox label={<Trans>Spatial AQ</Trans>} checked={settings.spatial_aq} onChange={update('spatial_aq')} />
+					{encoder !== 'av1_nvenc' && <Checkbox label={<Trans>Temporal AQ</Trans>} checked={settings.temporal_aq} onChange={update('temporal_aq')} />}
+				</Grid>
+				{lowLatency && (
+					<Grid item xs={12}>
+						<Typography variant="caption">
+							<Trans>Low latency tuning: B-frames disabled, zerolatency and delay 0 are set automatically.</Trans>
+						</Typography>
+					</Grid>
+				)}
+			</Grid>
+		);
+	}
+
+	Coder.defaultProps = {
+		stream: {},
+		settings: {},
+		skills: {},
+		onChange: function (settings, mapping) {},
+	};
+
+	return Coder;
+}
+
+export function summarize(name, settings) {
+	const s = init(settings);
+	const rate = s.rc === 'constqp' ? `QP ${s.qp}` : `${s.bitrate} kbit/s ${s.rc.toUpperCase()}`;
+	return `${name}, ${rate}, ${s.fps} FPS, ${s.preset}/${s.tune}, GPU ${s.gpu}`;
+}
diff --git a/src/misc/controls/Fallback.js b/src/misc/controls/Fallback.js
new file mode 100644
index 0000000..a25e26f
--- /dev/null
+++ b/src/misc/controls/Fallback.js
@@ -0,0 +1,242 @@
+import React from 'react';
+
+import { Trans } from '@lingui/macro';
+import Alert from '@mui/material/Alert';
+import CircularProgress from '@mui/material/CircularProgress';
+import Box from '@mui/material/Box';
+import Button from '@mui/material/Button';
+import Grid from '@mui/material/Grid';
+import MenuItem from '@mui/material/MenuItem';
+import TextField from '@mui/material/TextField';
+import Typography from '@mui/material/Typography';
+
+import AddressHints from '../AddressHints';
+import { sameStream } from '../../utils/address';
+import Checkbox from '../Checkbox';
+import Select from '../Select';
+import RestreamerContext from '../../contexts/Restreamer';
+
+// Fallback (fork): up to two helper processes publish to the internal RTMP server – the
+// backup stream ("<id>_fallback.stream") and a slate image ("<id>_fallback2.stream", the
+// last resort). When the main ingest drops, the core RTMP server switches every RTMP player
+// (the egress processes) to the first fallback that delivers, at a keyframe, and back when
+// the main source returns – without disconnecting the publications from YouTube, Twitch, etc.
+
+function init(settings) {
+	return {
+		enable: false,
+		type: 'image',
+		image: '',
+		url: '',
+		...settings,
+	};
+}
+
+const PROBLEMS = {
+	disabled: <Trans>The fallback is not enabled in the saved channel. Enable it and save.</Trans>,
+	rtmp_off: <Trans>The RTMP server is switched off (Settings → RTMP). The fallback needs it.</Trans>,
+	no_fallback_process: <Trans>No helper process exists. Save the channel with an image or a backup stream address.</Trans>,
+	backup_not_running: <Trans>The backup stream process is not running (it cannot reach the backup address, see its log).</Trans>,
+	slate_not_running: <Trans>The image process is not running. Start the channel.</Trans>,
+	program_not_published: <Trans>The ingest does not publish its program to the RTMP server. Save the channel and restart it.</Trans>,
+	no_fallback_stream: <Trans>Neither the backup stream nor the image is being published, so there is nothing to switch to.</Trans>,
+	egress_not_on_failover: <Trans>Some publications still read the HLS playlist and will not follow the fallback.</Trans>,
+	relay_not_running: <Trans>The preview and the player do not follow the fallback yet (the HLS relay is not running). Save the channel.</Trans>,
+};
+
+function Report(props) {
+	const { report } = props;
+	const mark = (ok) => (ok ? '✓' : '✗');
+
+	return (
+		<Box sx={{ mt: 1 }}>
+			{report.problems.length === 0 ? (
+				<Alert severity="success">
+					<Trans>Everything needed for the fallback is in place.</Trans>
+				</Alert>
+			) : (
+				<Alert severity="warning">
+					{report.problems.map((p) => (
+						<div key={p}>{PROBLEMS[p] || p}</div>
+					))}
+				</Alert>
+			)}
+			{report.problems.includes('egress_not_on_failover') && (
+				<Button size="small" onClick={props.onFix} sx={{ mt: 1 }}>
+					<Trans>Point publications at the fallback</Trans>
+				</Button>
+			)}
+			{props.fixed >= 0 && (
+				<Typography variant="caption" component="div">
+					<Trans>Changed publications</Trans>: {props.fixed}
+				</Typography>
+			)}
+			<Typography variant="caption" component="div" sx={{ mt: 1, whiteSpace: 'pre-wrap', fontFamily: 'monospace' }}>
+				{[
+					`${mark(report.rtmpEnabled)} RTMP server`,
+					`${mark(report.ingest.exec === 'running')} ingest: ${report.ingest.exec || '-'}`,
+					// the program, and the fallbacks that are configured (not a ✗ for one that is not in use)
+					...report.streams
+						.filter((x, i) => i === 0 || (report.processes[i - 1] && report.processes[i - 1].exists))
+						.map((x) => `${mark(x.live)} ${x.name}`),
+					...report.processes.filter((x) => x.exists).map((x) => `${mark(x.exec === 'running')} ${x.id}: ${x.exec} ${x.last ? '– ' + x.last : ''}`),
+					`${mark(report.relay && report.relay.exec === 'running')} HLS (preview/player): ${(report.relay && report.relay.exec) || '-'}`,
+					...report.egresses.map((x) => `${mark(x.onFailover)} ${x.id.replace('restreamer-ui:egress:', '')}: ${x.input}`),
+				].join('\n')}
+			</Typography>
+		</Box>
+	);
+}
+
+export default function Control(props) {
+	const settings = init(props.settings);
+	const ctx = React.useContext(RestreamerContext);
+	const [uploading, setUploading] = React.useState(false);
+	const [error, setError] = React.useState('');
+
+	React.useEffect(() => {
+		props.onChange(settings, true);
+		// eslint-disable-next-line react-hooks/exhaustive-deps
+	}, []);
+
+	const handleChange = (what) => (event) => {
+		if (what === 'enable') {
+			settings.enable = !settings.enable;
+		} else {
+			settings[what] = event.target.value;
+		}
+		props.onChange(settings, false);
+	};
+
+	const handleUpload = async (event) => {
+		const file = event.target.files[0];
+		if (!file) {
+			return;
+		}
+		if (!['image/png', 'image/jpeg'].includes(file.type) || file.size > 10 * 1024 * 1024) {
+			setError('PNG/JPEG, max. 10 MB');
+			return;
+		}
+		setUploading(true);
+		setError('');
+		const data = await file.arrayBuffer();
+		const ext = file.type === 'image/png' ? 'png' : 'jpg';
+		const path = await ctx.upload('fallback.' + ext, data);
+		setUploading(false);
+		if (!path) {
+			setError('Upload failed');
+			return;
+		}
+		settings.image = path;
+		props.onChange(settings, false);
+	};
+
+	const [report, setReport] = React.useState(null);
+	const [checking, setChecking] = React.useState(false);
+	const [fixed, setFixed] = React.useState(-1);
+
+	const check = async () => {
+		setChecking(true);
+		setReport(await ctx.diagnose());
+		setChecking(false);
+	};
+
+	const fix = async () => {
+		setChecking(true);
+		setFixed(await ctx.retarget());
+		setReport(await ctx.diagnose());
+		setChecking(false);
+	};
+
+	return (
+		<Grid container spacing={2}>
+			<Grid item xs={12}>
+				<Checkbox label={<Trans>Enable seamless fallback</Trans>} checked={settings.enable} onChange={handleChange('enable')} />
+				<Typography variant="caption" component="div">
+					<Trans>
+						If the source drops, all publications that use the internal RTMP server switch to the fallback without disconnecting and switch back
+						when the source returns. Requires the RTMP server to be enabled.
+					</Trans>
+				</Typography>
+			</Grid>
+			{settings.enable && !ctx.rtmpEnabled && (
+				<Grid item xs={12}>
+					<Alert severity="warning">
+						<Trans>
+							The RTMP server is switched off, so the fallback cannot work. Enable it under Settings → RTMP, then save this channel again.
+						</Trans>
+					</Alert>
+				</Grid>
+			)}
+			{settings.enable && (
+				<React.Fragment>
+					<Grid item xs={12} md={4}>
+						<Select label={<Trans>Fallback source</Trans>} value={settings.type} onChange={handleChange('type')}>
+							<MenuItem value="image">
+								<Trans>Image (slate)</Trans>
+							</MenuItem>
+							<MenuItem value="stream">
+								<Trans>Backup stream (URL)</Trans>
+							</MenuItem>
+						</Select>
+					</Grid>
+					{settings.type === 'stream' && (
+						<Grid item xs={12} md={8}>
+							<TextField
+								variant="outlined"
+								fullWidth
+								label={<Trans>Backup stream address</Trans>}
+								placeholder="rtmp://backup.example.com/live/key"
+								value={settings.url}
+								onChange={handleChange('url')}
+							/>
+							<AddressHints address={settings.url} />
+							{sameStream(settings.url, props.sources) && (
+								<Alert severity="warning" sx={{ mt: 1 }}>
+									<Trans>This is the address of the source itself. When the source fails, this backup fails with it; use a different stream.</Trans>
+								</Alert>
+							)}
+						</Grid>
+					)}
+					<Grid item xs={12}>
+						<Button variant="outlined" component="label" disabled={uploading}>
+							{uploading ? (
+								<Trans>Uploading…</Trans>
+							) : settings.type === 'stream' ? (
+								<Trans>Upload last-resort image</Trans>
+							) : (
+								<Trans>Upload image</Trans>
+							)}
+							<input type="file" hidden accept="image/png,image/jpeg" onChange={handleUpload} />
+						</Button>
+						<Typography variant="caption" component="div">
+							{settings.image ? settings.image : <Trans>No image uploaded yet.</Trans>} {error}
+						</Typography>
+						{settings.type === 'stream' && (
+							<Typography variant="caption" component="div">
+								<Trans>The image is shown whenever the backup stream cannot be reached either, so the output never goes black.</Trans>
+							</Typography>
+						)}
+					</Grid>
+					{ctx.diagnose && (
+						<Grid item xs={12}>
+							<Button variant="outlined" size="small" onClick={check} disabled={checking}>
+								<Trans>Check fallback</Trans>
+							</Button>{' '}
+							{checking && <CircularProgress size={16} />}
+							<Typography variant="caption" component="div">
+								<Trans>Checks the saved channel: RTMP server, helper processes and where each publication reads from.</Trans>
+							</Typography>
+							{report && <Report report={report} onFix={fix} fixed={fixed} />}
+						</Grid>
+					)}
+				</React.Fragment>
+			)}
+		</Grid>
+	);
+}
+
+Control.defaultProps = {
+	settings: {},
+	onChange: function (settings, automatic) {},
+};
