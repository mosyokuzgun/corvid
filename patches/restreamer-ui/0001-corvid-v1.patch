+import Restreamer, { recordFolder, recordSettings } from './restreamer';
+
+test('record: settings are limited and need a secret', () => {
+	expect(recordSettings(undefined).enable).toBe(false);
+	expect(recordSettings({ enable: true }).enable).toBe(false);
+	const r = recordSettings({ enable: true, secret: 'abcdef0123456789', minutes: '0', days: '-3', format: 'exe' });
+	expect(r).toEqual({ enable: true, auto: false, secret: 'abcdef0123456789', format: 'mp4', minutes: 0, files: 0, prefix: '', days: 0 });
+	expect(recordSettings({ enable: true, secret: 'abcdef0123', minutes: 30, days: 14, format: 'mkv' })).toMatchObject({
+		minutes: 30,
+		days: 14,
+		format: 'mkv',
+	});
+});
+
+test('record: the folder cannot leave /recordings', () => {
+	expect(recordFolder('abc', '../../etc')).toBe('/recordings/abc_etc');
+	expect(recordFolder('abc', 'a1b2')).toBe('/recordings/abc_a1b2');
+});
+
+test('record: prefix and file limit are sanitised', () => {
+	const r = recordSettings({ enable: true, secret: 'abcdef0123456789', prefix: 'Stud yo/../x', files: '-5', minutes: '' });
+	expect(r.prefix).toBe('Studyox');
+	expect(r.files).toBe(0);
+	expect(r.minutes).toBe(60);
+	expect(recordSettings({ secret: 'abcdef0123456789', files: '48' }).files).toBe(48);
+});
+
+test('helpers added to a disconnected channel do not start on their own', async () => {
+	const r = Object.create(Restreamer.prototype);
+	const channel = { id: 'restreamer-ui:ingest:abc' };
+	const control = { process: { autostart: true } };
+	r._getProcess = async () => ({ state: { order: 'stop' } });
+	expect(await r._helperAutostart(channel, control)).toBe(false);
+	r._getProcess = async () => ({ state: { order: 'start' } });
+	expect(await r._helperAutostart(channel, control)).toBe(true);
+	// a channel that does not exist yet: as configured
+	r._getProcess = async () => null;
+	expect(await r._helperAutostart(channel, control)).toBe(true);
+	r._getProcess = async () => {
+		throw new Error('x');
+	};
+	expect(await r._helperAutostart(channel, { process: { autostart: false } })).toBe(false);
+});
