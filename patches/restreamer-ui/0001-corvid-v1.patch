+				<Button variant="text" color="inherit" onClick={props.onAbort}>
+					<Trans>Cancel</Trans>
+				</Button>
+				{props.right}
+			</Box>
+
+			<Modal open={$preview !== null} onClose={() => setPreview(null)} className="modal">
