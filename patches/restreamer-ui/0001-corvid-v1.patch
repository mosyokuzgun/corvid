+++ b/src/utils/address.test.js
@@ -0,0 +1,76 @@
+import { checkInputAddress, isOwnServer, localAddress, sameStream, serverOf, withStreamKey } from './address';
+
+test('address: a good SRT/RTMP input has no warnings', () => {
+	expect(checkInputAddress('srt://203.0.113.10:6000?mode=caller&transtype=live&streamid=kanal.stream,mode:request')).toEqual([]);
+	expect(checkInputAddress('rtmp://10.20.0.5/live')).toEqual([]);
+	expect(checkInputAddress('rtmp://backup.example.com/live/key')).toEqual([]);
+	expect(checkInputAddress('')).toEqual([]);
+	expect(checkInputAddress('srt://1.2.3.4:6000?streamid=abc')).toEqual([]);
+});
+
+test('address: an SRT input that would publish is flagged', () => {
+	expect(checkInputAddress('srt://1.2.3.4:6000?mode=caller&streamid=kanal2.stream,mode:publish')).toEqual(['srt_publish']);
+	expect(checkInputAddress('srt://1.2.3.4:6000?mode=caller&streamid=kanal2.stream,mode:publish,token:x')).toEqual(['srt_publish']);
+	expect(checkInputAddress('srt://1.2.3.4:6000?streamid=' + encodeURIComponent('#!:m=publish,r=abc'))).toEqual(['srt_publish']);
+});
+
+test('address: whitespace and an empty RTMP path are flagged', () => {
+	expect(checkInputAddress(' rtmp://a/b')).toEqual(['whitespace']);
+	expect(checkInputAddress('rtmp://server')).toEqual(['rtmp_no_path']);
+	expect(checkInputAddress('rtmp://server:1935/')).toEqual(['rtmp_no_path']);
+});
+
+test('address: a backup that is the source itself is recognised', () => {
+	const src = ['srt://1.2.3.4:6000?mode=caller&streamid=kanal.stream,mode:request'];
+	expect(sameStream(' srt://1.2.3.4:6000?mode=caller&streamid=kanal.stream,mode:request ', src)).toBe(true);
+	expect(sameStream('rtmp://10.20.0.5/live', src)).toBe(false);
+	expect(sameStream('', src)).toBe(false);
+});
+
+test('stream key: is added to, replaced in and removed from RTMP and SRT addresses', () => {
+	expect(withStreamKey('rtmp://10.20.0.5/live', 'abc')).toBe('rtmp://10.20.0.5/live?token=abc');
+	expect(withStreamKey('rtmp://h:1935/live/x.stream?token=old&foo=1', 'new')).toBe('rtmp://h:1935/live/x.stream?foo=1&token=new');
+	expect(withStreamKey('rtmp://h/live?token=old', '')).toBe('rtmp://h/live');
+	const srt = 'srt://203.0.113.10:6000?mode=caller&transtype=live&streamid=kanal.stream,mode:request';
+	expect(withStreamKey(srt, 'abc')).toBe(srt + ',token:abc');
+	expect(withStreamKey(srt + ',token:old', 'new')).toBe(srt + ',token:new');
+	expect(withStreamKey('srt://h:6000?streamid=x,token:old,mode:request&latency=2000000', 'new')).toBe('srt://h:6000?streamid=x,mode:request,token:new&latency=2000000');
+	expect(withStreamKey(srt + ',token:old', '')).toBe(srt);
+	expect(withStreamKey('srt://h:6000?streamid=' + encodeURIComponent('#!:m=request,r=x'), 'k')).toBe('srt://h:6000?streamid=' + encodeURIComponent('#!:m=request,r=x,token=k'));
+	// not touched
+	expect(withStreamKey('http://h/live.m3u8', 'abc')).toBe('http://h/live.m3u8');
+	expect(withStreamKey('{rtmp,name=x.stream}', 'abc')).toBe('{rtmp,name=x.stream}');
+	expect(withStreamKey('srt://h:6000?mode=caller', 'abc')).toBe('srt://h:6000?mode=caller');
+});
+
+test('stream key: only addresses of the own server are candidates', () => {
+	const hosts = ['localhost', '10.20.0.5', '203.0.113.10'];
+	const ports = { rtmp: 1935, srt: 6000 };
+	expect(serverOf('rtmp://10.20.0.5/live')).toEqual({ proto: 'rtmp', host: '10.20.0.5', port: 1935 });
+	expect(isOwnServer('rtmp://10.20.0.5/live', hosts, ports)).toBe(true);
+	expect(isOwnServer('srt://203.0.113.10:6000?streamid=kanal.stream', hosts, ports)).toBe(true);
+	expect(isOwnServer('rtmp://a.rtmp.youtube.com/live2/key', hosts, ports)).toBe(false);
+	expect(isOwnServer('rtmp://10.20.0.5:1936/live', hosts, ports)).toBe(false);
+	expect(isOwnServer('srt://203.0.113.10:7000?streamid=x', hosts, ports)).toBe(false);
+	expect(isOwnServer('srt://localhost:6000?streamid=x', hosts, { rtmp: 1935, srt: 0 })).toBe(false);
+});
+
+test('localAddress: own server through its outside address is read locally', () => {
+	const hosts = ['203.0.113.10', '10.20.0.5'];
+	const ports = { rtmp: 1935, srt: 6000 };
+	const locals = { rtmp: 'localhost', srt: 'localhost:6000' };
+	const L = (a) => localAddress(a, hosts, ports, locals);
+	expect(L('srt://203.0.113.10:6000?mode=caller&streamid=kanal,mode:request,token:abc&latency=20000')).toBe(
+		'srt://localhost:6000?mode=caller&streamid=kanal,mode:request,token:abc&latency=20000',
+	);
+	expect(L('rtmp://203.0.113.10/live')).toBe('rtmp://localhost/live');
+	expect(L('rtmp://203.0.113.10:1935/live/x?token=k')).toBe('rtmp://localhost/live/x?token=k');
+	expect(L('rtmp://10.20.0.5/live')).toBe('rtmp://localhost/live');
+	// other servers, other ports, TLS, already local: unchanged
+	expect(L('rtmp://a.rtmp.youtube.com/live2/key')).toBe('rtmp://a.rtmp.youtube.com/live2/key');
+	expect(L('srt://203.0.113.10:7000?streamid=x')).toBe('srt://203.0.113.10:7000?streamid=x');
+	expect(L('rtmps://203.0.113.10/live')).toBe('rtmps://203.0.113.10/live');
+	expect(L('rtmp://localhost/live')).toBe('rtmp://localhost/live');
+	expect(L('http://203.0.113.10:1935/x')).toBe('http://203.0.113.10:1935/x');
+	expect(localAddress('rtmp://203.0.113.10/live', hosts, { rtmp: 1936, srt: 6000 }, { rtmp: 'localhost:1936' })).toBe('rtmp://203.0.113.10/live');
+});
