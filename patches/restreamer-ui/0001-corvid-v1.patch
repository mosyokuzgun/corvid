+					await this._stopProcess(channel.id + suffix);
+				}
+			}
+			return ok;
+		} finally {
+			delete this._stopping[channel.id];
+		}
+	}
+
+	// ---- Stream key (fork) ----------------------------------------------------------------
+	//
+	// One key (token) for the RTMP and the SRT server. Senders and players must carry it;
+	// without one, anybody who reaches the ports can send or watch. Addresses that use the
+	// {rtmp}/{srt} placeholders get the key from the core by themselves; addresses typed in
+	// by hand that point at this server are rewritten here.
+
+	// What would change: { rtmp, srt, hosts, ports, locked, changes: [{ id, old, new }] }.
+	async StreamKeyPlan(token, hosts) {
+		const data = await this.Config();
+		if (data === null) {
+			return null;
+		}
+		const cfg = data.config;
+		const port = (address) => parseInt(`${address || ''}`.split(':').pop()) || 0;
+		const ports = { rtmp: cfg.rtmp.enable ? port(cfg.rtmp.address) : 0, srt: cfg.srt.enable ? port(cfg.srt.address) : 0 };
+		const known = ['localhost', '127.0.0.1', '::1', ...(cfg.host.name || [])];
+		if (typeof window !== 'undefined' && window.location && window.location.hostname) {
+			known.push(window.location.hostname);
+		}
+
+		const list = (await this._listProcesses(['config'])).filter((p) => /^restreamer-ui:/.test(p.id) && p.config);
+		// Hosts of addresses that look like this server (same protocol and port): offered to
+		// the user, who knows which of them really are this server.
+		const seen = [];
+		for (const p of list) {
+			for (const input of p.config.input || []) {
+				const server = A.serverOf(input.address);
+				if (server && ports[server.proto] && server.port === ports[server.proto]) {
+					seen.push(server.host);
+				}
+			}
+		}
+		const all = [...new Set((hosts || [...known, ...seen]).map((h) => `${h}`.trim().toLowerCase()).filter((h) => h.length !== 0))];
+
+		const changes = [];
+		for (const p of list) {
+			for (const input of p.config.input || []) {
+				if (!A.isOwnServer(input.address, all, ports)) {
+					continue;
+				}
+				const next = A.withStreamKey(input.address, token);
+				if (next !== input.address) {
+					changes.push({ id: p.id, old: input.address, new: next });
+				}
+			}
+		}
+
+		const overrides = data.overrides || [];
+		return {
+			rtmp: { enabled: !!cfg.rtmp.enable, token: cfg.rtmp.token || '' },
+			srt: { enabled: !!cfg.srt.enable, token: cfg.srt.token || '' },
+			// set by environment variables: cannot be changed from here
+			locked: overrides.includes('rtmp.token') || overrides.includes('srt.token'),
+			hosts: all,
+			ports,
+			changes,
+		};
+	}
+
+	// Set (or, with an empty token, remove) the key: store it in the configuration, rewrite
+	// the addresses, restart the core. Returns { ok, changed, error }.
+	async StreamKeyApply(token, hosts) {
+		const plan = await this.StreamKeyPlan(token, hosts);
+		if (plan === null || plan.locked) {
+			return { ok: false, changed: 0, error: plan ? 'locked' : 'config' };
+		}
+		const data = await this.Config();
+		const cfg = JSON.parse(JSON.stringify(data.config));
+		cfg.rtmp.token = token;
+		cfg.srt.token = token;
+		const [, err] = await this.ConfigSet(cfg);
+		if (err !== null) {
+			return { ok: false, changed: 0, error: 'config' };
+		}
+
+		// The server does not check the key before it is restarted, and ignores one it does
+		// not ask for, so the processes can be rewritten first.
+		// An address is stored in more than one place (the fallback address is in the fallback
+		// process and in the metadata of the channel), so every process is searched for all of them.
+		const pairs = plan.changes.map((c) => [JSON.stringify(c.old), JSON.stringify(c.new)]);
+		let changed = 0;
+		const list = pairs.length !== 0 ? (await this._listProcesses(['config', 'metadata'])).filter((p) => /^restreamer-ui:/.test(p.id) && p.config) : [];
+		for (const proc of list) {
+			const before = [JSON.stringify(proc.config), JSON.stringify(proc.metadata || {})];
+			let [config, metadata] = before;
+			for (const [from, to] of pairs) {
+				// whole values only: an address can be the beginning of another one
+				config = config.split(from).join(to);
+				metadata = metadata.split(from).join(to);
+			}
+			if (config !== before[0]) {
+				const [, e] = await this._call(this.api.ProcessUpdate, proc.id, JSON.parse(config));
+				if (e !== null) {
+					continue;
+				}
+				changed++;
+			}
+			if (metadata !== before[1]) {
+				await this._setProcessMetadata(proc.id, JSON.parse(metadata));
+			}
+		}
+
+		const ok = await this.ConfigReload();
+		return { ok, changed, error: ok ? '' : 'reload' };
+	}
+
+	// ---- Guest keys (fork) ----------------------------------------------------------------
+	//
+	// A guest key lets a third party send one named stream to the RTMP or SRT server until
+	// it expires, without knowing the main stream key; it cannot be used to watch. The core
+	// reads the keys from the system metadata on every connection.
+
+	async GetGuestKeys() {
+		const metadata = (await this._getMetadata()) || {};
+		return Array.isArray(metadata.guestKeys) ? metadata.guestKeys.filter((k) => k && k.token && k.name) : [];
+	}
+
+	async _setGuestKeys(keys) {
+		const metadata = (await this._getMetadata()) || {};
+		// keys that expired more than a day ago are dropped
+		const limit = Math.floor(Date.now() / 1000) - 86400;
+		metadata.guestKeys = keys.filter((k) => k.expires > limit);
+		await this._setMetadata(metadata);
+		return metadata.guestKeys;
+	}
+
+	// Returns the new list, or null if the name is not usable.
+	// mode: 'publish' (the guest sends the stream) or 'play' (the guest watches it).
+	async AddGuestKey(name, hours, mode = 'publish') {
+		const clean = guestStreamName(name);
+		const h = Math.min(24 * 30, Math.max(1, parseInt(hours) || 24));
+		if (!clean) {
+			return null;
+		}
+		// A key for sending must not name a channel's own stream: the guest would take the
+		// channel's place on air.
+		if (mode !== 'play' && this.ListChannels().some((c) => clean.startsWith(c.channelid))) {
+			return 'reserved';
+		}
+		const keys = await this.GetGuestKeys();
+		keys.push({
+			token: A.randomKey(),
+			name: clean,
+			mode: mode === 'play' ? 'play' : 'publish',
+			expires: Math.floor(Date.now() / 1000) + h * 3600,
+			created: Math.floor(Date.now() / 1000),
+		});
+		return await this._setGuestKeys(keys);
+	}
+
+	async DeleteGuestKey(token) {
+		return await this._setGuestKeys((await this.GetGuestKeys()).filter((k) => k.token !== token));
+	}
+
+	// The addresses for a guest key: what the guest sends to, and what a channel reads from.
+	async GuestAddresses(key, host) {
+		const data = await this.Config();
+		if (data === null) {
+			return null;
+		}
+		const cfg = data.config;
+		const port = (address) => parseInt(`${address || ''}`.split(':').pop()) || 0;
+		return guestAddresses(key, host, {
+			rtmp: cfg.rtmp.enable ? port(cfg.rtmp.address) : 0,
+			srt: cfg.srt.enable ? port(cfg.srt.address) : 0,
+			app: cfg.rtmp.app || '/',
+			// the address the operator uses to watch a guest's stream: the watch key if there is one
+			token: (cfg.rtmp.token && this.WatchKeyCached()) || cfg.rtmp.token || '',
+			srtToken: (cfg.srt.token && this.WatchKeyCached()) || cfg.srt.token || '',
+		});
+	}
+
+	// The FFmpeg processes of a channel and what they are for.
+	async GetChannelProcesses(channelid) {
+		const channel = this.GetChannel(channelid);
+		if (channel === null) {
+			return [];
+		}
+		const roles = { '': 'source', _fallback: 'fallback', _fallback2: 'slate', [RELAY_SUFFIX]: 'relay', [RECORD_SUFFIX]: 'record', [WATCH_SUFFIX]: 'watch', _snapshot: 'snapshot' };
+		const order = ['source', 'fallback', 'slate', 'relay', 'record', 'watch', 'snapshot', 'target', 'other'];
+		const list = await this._listProcesses(['state', 'config'], channel.channelid);
+		return list
+			.map((p) => {
+				const state = p.state || {};
+				let role = 'target';
+				let name = '';
+				if (p.id.startsWith(channel.id)) {
+					role = roles[p.id.slice(channel.id.length)] || 'other';
+				} else {
+					const egress = this.GetChannelEgress(channelid, p.id);
+					name = egress ? egress.name : '';
+				}
+				return {
+					id: p.id,
+					role,
+					name,
+					order: state.order || 'stop',
+					exec: state.exec || '',
+					running: state.exec === 'running' || state.exec === 'starting',
+					runtime: state.runtime_seconds || 0,
+					reconnect: typeof state.reconnect_seconds === 'number' ? state.reconnect_seconds : -1,
+					cpu: state.cpu_usage || 0,
+					memory: state.memory_bytes || 0,
+					encoder: encoderOf(p.config),
+				};
+			})
+			.sort((a, b) => order.indexOf(a.role) - order.indexOf(b.role) || (a.name < b.name ? -1 : a.name > b.name ? 1 : 0));
+	}
+
+	// Everything about one process of a channel (fork): configuration, state with the command
+	// as the core runs it, and the log. null if the process does not belong to the channel.
+	async GetProcessDetail(channelid, pid) {
+		const procs = await this.GetChannelProcesses(channelid);
+		const meta = procs.find((p) => p.id === pid);
+		if (!meta) {
+			return null;
+		}
+		const p = await this._getProcess(pid, ['config', 'state', 'report']);
+		if (p === null) {
+			return null;
+		}
+		return { ...meta, config: p.config || null, state: p.state || {}, report: p.report || null, processes: procs };
+	}
+
+	// Restart one process of a channel (fork). The core stops and starts it again.
+	async RestartProcess(channelid, pid) {
+		const procs = await this.GetChannelProcesses(channelid);
+		if (!procs.some((p) => p.id === pid)) {
+			return false;
+		}
+		const [, err] = await this._call(this.api.ProcessCommand, pid, 'restart');
+		return err === null;
+	}
+
+	// Statistics of the SRT connection that feeds a channel, or null if its source is not a
+	// stream of the internal SRT server (or nobody is publishing it).
+	async GetSRTSourceStats(channelid) {
+		const channel = this.GetChannel(channelid);
+		if (channel === null) {
+			return null;
+		}
+		const proc = await this._getProcess(channel.id, ['config']);
+		const resource = proc && proc.config ? srtResourceOf(proc.config.input.map((i) => i.address)) : '';
+		if (!resource) {
+			return null;
+		}
+		const [val, err] = await this._call(this.api.SRTRaw);
+		if (err !== null || !val || !val.publisher) {
+			return { resource, online: false };
+		}
+		const id = val.publisher[resource];
+		const conn = id !== undefined && val.connections ? val.connections[id] : null;
+		if (!conn || !conn.stats) {
+			return { resource, online: false };
+		}
+		return { resource, online: true, ...srtSummary(conn.stats) };
+	}
+
+	// State of the publications of a channel.
+	async GetTargetsHealth(channelid) {
+		const list = await this.ListIngestEgresses(channelid);
+		return list
+			.filter((p) => p.service !== 'player')
+			.map((p) => {
+				const state = p.state || {};
+				const progress = state.progress || {};
+				return {
+					id: p.id,
+					name: p.name,
+					service: p.service,
+					order: state.order || 'stop',
+					exec: state.exec || '',
+					bitrate_kbit: Math.round(progress.bitrate_kbit || 0),
+					runtime_seconds: Math.max(0, Math.round(state.runtime_seconds || 0)),
+					reconnect_seconds: state.reconnect_seconds === undefined ? -1 : state.reconnect_seconds,
+					error: state.last_logline && state.exec === 'failed' ? `${state.last_logline}`.slice(0, 200) : '',
