--- /dev/null
+++ b/src/utils/watch.js
@@ -0,0 +1,190 @@
+// Sound and picture watch (fork).
+//
+// A small FFmpeg process per channel reads the program (what the viewers get) and prints
+// one measurement per second for the sound (RMS level per channel) and one per keyframe
+// for the picture (average brightness, difference to the previous keyframe). Only
+// keyframes are decoded, so this costs next to nothing and needs no encoder.
+//
+// The core keeps only the last lines of a process log, so the durations ("silent for
+// 25 s") are kept here: fold() takes whatever lines the log holds right now and is safe
+// to call again with lines it has already seen.
+
+export const WATCH_SUFFIX = '_watch';
+
+// Below this RMS level a channel counts as silent (dBFS).
+export const SILENCE_DB = -60;
+// Average luma below this is a black picture (16 is black in video range).
+export const BLACK_YAVG = 24;
+// Keyframes that differ less than this are the same picture. A still camera with sensor
+// noise measures around 0.5, a repeated frame below 0.01.
+export const FREEZE_YDIF = 0.05;
+// No measurement for this long: the watch itself is not running.
+export const STALE_SECONDS = 15;
+
+const num = (v, def, min, max) => {
+	const n = parseInt(v);
+	return isNaN(n) ? def : Math.min(max, Math.max(min, n));
+};
+
+// Settings as stored in the channel metadata (control.watch), with defaults and limits.
+export const watchSettings = (watch) => {
+	const w = watch || {};
+	return {
+		enable: w.enable !== false,
+		// seconds before a warning; 0 switches that warning off
+		silence: num(w.silence, 20, 0, 600),
+		black: num(w.black, 5, 0, 600),
+		freeze: num(w.freeze, 10, 0, 600),
+		sound: w.sound !== false,
+	};
+};
+
+// The output options of the watch process.
+export const watchOptions = () => [
+	'-map',
+	'0:v:0?',
+	'-vf',
+	'scale=320:-2,signalstats,metadata=mode=print:key=lavfi.signalstats.YAVG,metadata=mode=print:key=lavfi.signalstats.YDIF',
+	'-map',
+	'0:a:0?',
+	'-af',
+	'asetnsamples=n=48000:p=0,astats=metadata=1:reset=1:measure_overall=none:measure_perchannel=RMS_level,ametadata=mode=print:key=lavfi.astats.1.RMS_level,ametadata=mode=print:key=lavfi.astats.2.RMS_level',
+	'-f',
+	'null',
+];
+
+export const emptyWatch = () => ({
+	first: 0, // time of the first measurement seen
+	audio: 0, // time of the latest sound measurement
+	loud: 0, // latest time any channel was above SILENCE_DB
+	loudL: 0,
+	loudR: 0,
+	rms: [null, null], // latest level per channel, dBFS (-Infinity: digital silence)
+	rmsAt: [0, 0],
+	video: 0, // time of the latest picture measurement
+	bright: 0, // latest time the picture was not black
+	moving: 0, // latest time the picture changed
+	frames: 0, // picture measurements seen (the first has no previous frame to compare with)
+});
+
+const LINE = /lavfi\.(astats\.([12])\.RMS_level|signalstats\.(YAVG|YDIF))=(\S+)/;
+
+// Fold log entries ([[unixSeconds, line], ...]) into the state. Returns a new state.
+export const foldWatch = (state, log) => {
+	const s = { ...emptyWatch(), ...(state || {}) };
+	s.rms = [...s.rms];
+	s.rmsAt = [...s.rmsAt];
+
+	for (const entry of log || []) {
+		if (!Array.isArray(entry) || entry.length < 2) {
+			continue;
+		}
+		const time = Number(entry[0]);
+		const m = LINE.exec(`${entry[1]}`);
+		if (!m || !isFinite(time)) {
+			continue;
+		}
+
+		const seen = () => {
+			if (s.first === 0 || time < s.first) {
+				s.first = time;
+			}
+		};
+
+		if (m[2]) {
+			const ch = m[2] === '1' ? 0 : 1;
+			const level = m[4] === '-inf' ? -Infinity : parseFloat(m[4]);
+			if (isNaN(level)) {
+				continue;
+			}
+			seen();
+			s.audio = Math.max(s.audio, time);
+			if (time >= s.rmsAt[ch]) {
+				s.rms[ch] = level;
+				s.rmsAt[ch] = time;
+			}
+			if (level > SILENCE_DB) {
+				s.loud = Math.max(s.loud, time);
+				if (ch === 0) s.loudL = Math.max(s.loudL, time);
+				else s.loudR = Math.max(s.loudR, time);
+			}
+		} else {
+			const value = parseFloat(m[4]);
+			if (isNaN(value)) {
+				continue;
+			}
+			seen();
+			s.video = Math.max(s.video, time);
+			if (m[3] === 'YAVG') {
+				if (value >= BLACK_YAVG) {
+					s.bright = Math.max(s.bright, time);
+				}
+			} else if (value >= FREEZE_YDIF) {
+				s.moving = Math.max(s.moving, time);
+			}
+		}
+	}
+
+	// A channel measured long ago is gone (the source went from stereo to mono).
+	for (const ch of [0, 1]) {
+		if (s.rmsAt[ch] !== 0 && s.audio - s.rmsAt[ch] > 5) {
+			s.rms[ch] = null;
+		}
+	}
+
+	return s;
+};
+
+// What the state means right now.
+//   fresh:      measurements are arriving (stale: seconds without a new one, as counted by the caller)
+//   hasAudio / hasVideo
+//   rms:        [left, right] in dBFS, null if that channel does not exist
+//   silentFor / blackFor / frozenFor: seconds, 0 if not the case
+//   oneSided:   'left' | 'right' if only that channel is silent (for sideFor seconds); never an alarm
+//   alarms:     ['silence' | 'black' | 'freeze'] over the limits of the settings
+export const readWatch = (state, settings, stale = 0) => {
+	const s = state || emptyWatch();
+	const w = watchSettings(settings);
+	const fresh = (s.audio !== 0 || s.video !== 0) && stale < STALE_SECONDS;
+	const hasAudio = fresh && s.audio !== 0 && s.audio >= Math.max(s.audio, s.video) - STALE_SECONDS;
+	const hasVideo = fresh && s.video !== 0 && s.video >= Math.max(s.audio, s.video) - STALE_SECONDS;
+	const since = (latest, good) => (latest === 0 ? 0 : Math.max(0, Math.round(latest - Math.max(good, s.first))));
+
+	const out = { fresh, hasAudio, hasVideo, rms: hasAudio ? s.rms : [null, null], silentFor: 0, sideFor: 0, blackFor: 0, frozenFor: 0, oneSided: '', alarms: [] };
+	if (!fresh) {
+		return out;
+	}
+
+	if (hasAudio) {
+		const silent = s.rms.every((v) => v === null || v <= SILENCE_DB);
+		if (silent) {
+			out.silentFor = since(s.audio, s.loud);
+		} else if (s.rms[0] !== null && s.rms[1] !== null) {
+			// Stereo with one dead side. Often on purpose (one microphone on the left channel),
+			// so this is shown next to the meter and never raises the alarm.
+			if (s.rms[0] <= SILENCE_DB) {
+				out.oneSided = 'left';
+				out.sideFor = since(s.audio, s.loudL);
+			} else if (s.rms[1] <= SILENCE_DB) {
+				out.oneSided = 'right';
+				out.sideFor = since(s.audio, s.loudR);
+			}
+		}
+	}
+
+	if (hasVideo) {
+		if (s.bright < s.video) {
+			out.blackFor = since(s.video, s.bright);
+		}
+		if (s.moving < s.video) {
+			out.frozenFor = since(s.video, s.moving);
+		}
+	}
+
+	if (w.silence > 0 && out.silentFor >= w.silence) out.alarms.push('silence');
+	if (w.black > 0 && out.blackFor >= w.black) out.alarms.push('black');
+	// A black picture does not move either; say the more useful thing only.
+	if (w.freeze > 0 && out.frozenFor >= w.freeze && !out.alarms.includes('black')) out.alarms.push('freeze');
+
+	return out;
+};
diff --git a/src/utils/watch.test.js b/src/utils/watch.test.js
new file mode 100644
index 0000000..6a8d1eb
--- /dev/null
+++ b/src/utils/watch.test.js
@@ -0,0 +1,125 @@
+import { emptyWatch, foldWatch, readWatch, watchSettings, watchOptions } from './watch';
+
+const A = (t, ch, v) => [t, `[Parsed_ametadata_${ch + 1} @ 0x55d] lavfi.astats.${ch}.RMS_level=${v}`];
+const Y = (t, v) => [t, `[Parsed_metadata_2 @ 0x55d] lavfi.signalstats.YAVG=${v}`];
+const D = (t, v) => [t, `[Parsed_metadata_3 @ 0x55d] lavfi.signalstats.YDIF=${v}`];
+
+const run = (from, to, fn) => {
+	const log = [];
+	for (let t = from; t <= to; t++) log.push(...fn(t));
+	return log;
+};
+const good = (t) => [A(t, 1, -23.5), A(t, 2, -24.1), ...(t % 2 === 0 ? [Y(t, 110.2), D(t, 1.8)] : [])];
+
+test('settings have defaults and limits', () => {
+	expect(watchSettings(undefined)).toEqual({ enable: true, silence: 20, black: 5, freeze: 10, sound: true });
+	expect(watchSettings({ enable: false, silence: '45', black: -3, freeze: 99999, sound: false })).toEqual({ enable: false, silence: 45, black: 0, freeze: 600, sound: false });
+});
+
+test('a healthy programme raises nothing', () => {
+	const s = foldWatch(emptyWatch(), run(1000, 1040, good));
+	const r = readWatch(s, {});
+	expect(r.fresh).toBe(true);
+	expect(r.hasAudio && r.hasVideo).toBe(true);
+	expect(r.rms).toEqual([-23.5, -24.1]);
+	expect(r.alarms).toEqual([]);
+	expect(r.silentFor + r.blackFor + r.frozenFor).toBe(0);
+});
+
+test('silence is counted across polls although the log only holds the last seconds', () => {
+	let s = foldWatch(emptyWatch(), run(1000, 1010, good));
+	const silent = (t) => [A(t, 1, '-inf'), A(t, 2, -71.2), ...(t % 2 === 0 ? [Y(t, 110), D(t, 2)] : [])];
+	// three polls, each sees only a window of ten seconds, overlapping
+	s = foldWatch(s, run(1011, 1020, silent));
+	expect(readWatch(s, {}).alarms).toEqual([]);
+	s = foldWatch(s, run(1016, 1026, silent));
+	s = foldWatch(s, run(1022, 1032, silent));
+	const r = readWatch(s, {});
+	expect(r.silentFor).toBe(22);
+	expect(r.alarms).toEqual(['silence']);
+	expect(r.rms).toEqual([-Infinity, -71.2]);
+
+	// sound comes back
+	s = foldWatch(s, run(1033, 1034, good));
+	expect(readWatch(s, {}).silentFor).toBe(0);
+	expect(readWatch(s, {}).alarms).toEqual([]);
+});
+
+test('folding the same lines twice changes nothing', () => {
+	const log = run(1000, 1012, good);
+	const once = foldWatch(emptyWatch(), log);
+	expect(foldWatch(once, log)).toEqual(once);
+});
+
+test('a page opened during silence counts from the first line it sees', () => {
+	const s = foldWatch(emptyWatch(), run(2000, 2012, (t) => [A(t, 1, '-inf'), A(t, 2, '-inf')]));
+	expect(readWatch(s, {}).silentFor).toBe(12);
+});
+
+test('one dead side of a stereo signal is reported, without the silence alarm', () => {
+	const s = foldWatch(foldWatch(emptyWatch(), run(1000, 1005, good)), run(1006, 1040, (t) => [A(t, 1, -22), A(t, 2, '-inf')]));
+	const r = readWatch(s, {});
+	expect(r.oneSided).toBe('right');
+	expect(r.sideFor).toBe(35);
+	expect(r.silentFor).toBe(0);
+	expect(r.alarms).toEqual([]);
+});
+
+test('mono sources have one channel', () => {
+	const s = foldWatch(emptyWatch(), run(1000, 1010, (t) => [A(t, 1, -30)]));
+	const r = readWatch(s, {});
+	expect(r.rms).toEqual([-30, null]);
+	expect(r.alarms).toEqual([]);
+});
+
+test('black picture', () => {
+	let s = foldWatch(emptyWatch(), run(1000, 1010, good));
+	s = foldWatch(s, run(1011, 1020, (t) => [A(t, 1, -20), A(t, 2, -20), ...(t % 2 === 0 ? [Y(t, 16.0), D(t, 0)] : [])]));
+	const r = readWatch(s, {});
+	expect(r.blackFor).toBe(10);
+	expect(r.alarms).toEqual(['black']);
+});
+
+test('frozen picture, and a still camera with noise is not frozen', () => {
+	let s = foldWatch(emptyWatch(), run(1000, 1010, good));
+	s = foldWatch(s, run(1011, 1024, (t) => [A(t, 1, -20), A(t, 2, -20), ...(t % 2 === 0 ? [Y(t, 120), D(t, 0.004)] : [])]));
+	expect(readWatch(s, {}).frozenFor).toBe(14);
+	expect(readWatch(s, {}).alarms).toEqual(['freeze']);
+
+	let n = foldWatch(emptyWatch(), run(1000, 1040, (t) => [A(t, 1, -20), ...(t % 2 === 0 ? [Y(t, 120), D(t, 0.67)] : [])]));
+	expect(readWatch(n, {}).alarms).toEqual([]);
+});
+
+test('warnings can be switched off one by one', () => {
+	const s = foldWatch(emptyWatch(), run(1000, 1100, (t) => [A(t, 1, '-inf'), A(t, 2, '-inf')]));
+	expect(readWatch(s, { silence: 0 }).alarms).toEqual([]);
+	expect(readWatch(s, { silence: 120 }).alarms).toEqual([]);
+	expect(readWatch(s, { silence: 100 }).alarms).toEqual(['silence']);
+});
+
+test('no measurements, or none for a while, is not fresh', () => {
+	expect(readWatch(emptyWatch(), {}).fresh).toBe(false);
+	const s = foldWatch(emptyWatch(), run(1000, 1100, (t) => [A(t, 1, '-inf')]));
+	const r = readWatch(s, {}, 20);
+	expect(r.fresh).toBe(false);
+	expect(r.alarms).toEqual([]);
+});
+
+test('audio only source', () => {
+	const s = foldWatch(emptyWatch(), run(1000, 1030, (t) => [A(t, 1, -20), A(t, 2, -20)]));
+	const r = readWatch(s, {});
+	expect(r.hasVideo).toBe(false);
+	expect(r.alarms).toEqual([]);
+});
+
+test('other log lines are ignored', () => {
+	const s = foldWatch(emptyWatch(), [[1000, 'frame=  100 fps=25'], [1000, 'Input #0, flv'], 'junk', [1001, 'lavfi.astats.1.RMS_level=abc']]);
+	expect(s).toEqual(emptyWatch());
+});
+
+test('the process options map both streams optionally', () => {
+	const o = watchOptions();
+	expect(o).toContain('0:v:0?');
+	expect(o).toContain('0:a:0?');
+	expect(o.slice(-2)).toEqual(['-f', 'null']);
+});
