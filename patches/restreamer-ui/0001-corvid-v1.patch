+
+// The video box is measured by the display aspect ratio. Here the source is a red 16:9 picture
+// that was squeezed to 1080x1920 before the canvas (like "Scale" 1080x1920 in front of it):
+// it must still fill the 1080x608 box (full width), not shrink to 342x608.
+(ffmpeg ? test : test.skip)('canvas:ffmpeg a squeezed source still fills its box', () => {
+	const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'canvas-'));
+	const graph = Canvas.createGraph({ ...base, x: '0', y: '656', vw: '1080', vh: '608', fit: 'contain', bg: 'color', color: '#000000' }, { cpu: true });
+	const out = path.join(dir, 'f.rgb');
+	execFileSync('ffmpeg', [
+		'-v',
+		'error',
+		'-y',
+		'-f',
+		'lavfi',
+		'-i',
+		'color=c=red:s=1920x1080:r=25:d=1',
