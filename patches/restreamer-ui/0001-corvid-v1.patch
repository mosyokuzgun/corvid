+				<Box sx={{ width: `${width}%`, height: '100%', backgroundColor: hot ? Palette.tally.standby : '#B4B7BB', transition: 'width .4s linear' }} />
+			</Box>
+			<Box component="span" className="tabular" sx={{ width: 58, textAlign: 'right', fontSize: '.85rem', color: silent ? Palette.warning.main : 'text.secondary', flexShrink: 0 }}>
