+++ b/src/utils/restreamer.disconnect.test.js
@@ -0,0 +1,44 @@
+import Restreamer from './restreamer';
+
+// A disconnect while the main view keeps polling: the fallbacks must end up stopped.
+const make = () => {
+	const id = 'restreamer-ui:ingest:abc';
+	const order = { [id]: 'start', [id + '_fallback']: 'start', [id + '_fallback2']: 'start', [id + '_hls']: 'start' };
+	const r = Object.create(Restreamer.prototype);
+	r.GetChannel = () => ({ id, channelid: 'abc', egresses: [] });
+	r._hasProcess = async (p) => p in order;
+	r._getProcessState = async (p) => (p in order ? { order: order[p] } : null);
+	r._startProcess = async (p) => {
+		order[p] = 'start';
+		return true;
+	};
+	r._stopProcess = async (p) => {
+		order[p] = 'stop';
+		// the main view polls in between, as it does every second; here right after the
+		// standby image was stopped
+		if (p.endsWith('_fallback2')) {
+			await r.EnsureFallbacks('abc', true);
+		}
+		return true;
+	};
+	r.StopAllEgresses = async () => {};
+	return [r, order, id];
+};
+
+test('the polling during a disconnect does not start the fallbacks again', async () => {
+	const [r, order, id] = make();
+	await r.StopBroadcast('abc');
+	expect(order[id]).toBe('stop');
+	expect(order[id + '_fallback']).toBe('stop');
+	expect(order[id + '_fallback2']).toBe('stop');
+	// and later polls of a disconnected channel leave them stopped
+	expect(await r.EnsureFallbacks('abc', false)).toBe(false);
+	expect(order[id + '_fallback2']).toBe('stop');
+});
+
+test('a connected channel still gets its fallbacks', async () => {
+	const [r, order, id] = make();
+	order[id + '_fallback2'] = 'stop';
+	expect(await r.EnsureFallbacks('abc', true)).toBe(true);
+	expect(order[id + '_fallback2']).toBe('start');
+});
diff --git a/src/utils/restreamer.fallback.test.js b/src/utils/restreamer.fallback.test.js
new file mode 100644
index 0000000..e34d97a
--- /dev/null
+++ b/src/utils/restreamer.fallback.test.js
@@ -0,0 +1,354 @@
+import Restreamer from './restreamer';
+
+// Runs the real RetargetEgresses/_egressInput against a stubbed core.
+const make = (fallback, rtmpEnabled, procs, ingestInput = 'http://cam.example/live.m3u8') => {
+	const upserts = [];
+	const r = Object.create(Restreamer.prototype);
+	r.GetChannel = () => ({ id: 'restreamer-ui:ingest:abc', channelid: 'abc', egresses: Object.keys(procs) });
+	r.GetIngestMetadata = async () => ({ control: { fallback: { enable: fallback } } });
+	r.ConfigActive = () => ({ source: { network: { rtmp: { enabled: rtmpEnabled } } } });
+	r.Skills = () => ({ ffmpeg: { version_major: 6 }, codecs: { video: {} } });
+	r._getProcess = async (id) => {
+		if (id === 'restreamer-ui:ingest:abc') {
+			return { config: { input: [{ address: ingestInput }] } };
+		}
+		return { config: JSON.parse(JSON.stringify(procs[id])) };
+	};
+	r.GetEgressMetadata = async () => ({ control: { source: { source: 'hls+memfs' } } });
+	r._upsertProcess = async (id, config) => {
+		upserts.push([id, config]);
+		return [null, null];
+	};
+	return [r, upserts];
+};
+
+const hls = () => ({ id: 'e1', input: [{ id: 'input_0', address: '{memfs}/abc.m3u8', options: ['-re', '-fflags', '+genpts'] }], output: [] });
+
+test('fallback on: existing HLS publications are switched to the RTMP input', async () => {
+	const [r, upserts] = make(true, true, { e1: hls() });
+	expect(await r.RetargetEgresses('abc')).toBe(1);
+	expect(upserts[0][1].input[0].address).toBe('{rtmp,name=abc.stream}');
+	expect(upserts[0][1].input[0].options).toEqual(['-fflags', '+genpts']);
+});
+
+test('pushed RTMP input: publications play the processed program, not the raw input', async () => {
+	const [r, upserts] = make(true, true, { e1: hls() }, 'rtmp://localhost:1935/live/abc.stream');
+	expect(await r.RetargetEgresses('abc')).toBe(1);
+	expect(upserts[0][1].input[0].address).toBe('{rtmp,name=abc_program.stream}');
+});
+
+test('fallback off again: publications go back to HLS', async () => {
+	const rtmp = { id: 'e1', input: [{ id: 'input_0', address: '{rtmp,name=abc.stream}', options: ['-fflags', '+genpts'] }], output: [] };
+	const [r, upserts] = make(false, true, { e1: rtmp });
+	expect(await r.RetargetEgresses('abc')).toBe(1);
+	expect(upserts[0][1].input[0].address).toBe('{memfs}/abc.m3u8');
+	expect(upserts[0][1].input[0].options).toEqual(['-re', '-fflags', '+genpts']);
+});
+
+test('RTMP server off: nothing is retargeted', async () => {
+	const [r, upserts] = make(true, false, { e1: hls() });
+	expect(await r.RetargetEgresses('abc')).toBe(0);
+	expect(upserts).toHaveLength(0);
+});
+
+test('custom inputs are left alone', async () => {
+	const custom = { id: 'e1', input: [{ id: 'input_0', address: 'rtmp://other/live/x', options: [] }], output: [] };
+	const [r, upserts] = make(true, true, { e1: custom });
+	expect(await r.RetargetEgresses('abc')).toBe(0);
+	expect(upserts).toHaveLength(0);
+});
+
+// UpsertIngest builds the real ingest command: with the fallback on, the ingest must also
+// publish to the internal RTMP server (control.rtmp.enable is false by default).
+const ingest = async (fallback, rtmpControl, input = 'rtmp://example.com/live/x') => {
+	const r = Object.create(Restreamer.prototype);
+	r.GetChannel = () => ({ id: 'restreamer-ui:ingest:abc', channelid: 'abc', egresses: [] });
+	r.ConfigActive = () => ({
+		http: { secure: false, host: 'localhost:8080' },
+		source: { network: { rtmp: { enabled: true }, srt: { enabled: false } } },
+	});
+	r.Skills = () => ({ ffmpeg: { version_major: 6 }, codecs: { video: {} } });
+	r.SetChannel = () => true;
+	const procs = {};
+	const calls = [];
+	r._upsertProcess = async (id, config) => {
+		procs[id] = config;
+		calls.push('upsert ' + id);
+		return [null, null];
+	};
+	r._deleteProcess = async (id) => {
+		delete procs[id];
+		calls.push('delete ' + id);
+		return true;
+	};
+	const M = require('./metadata');
+	const control = M.initIngestMetadata().control;
+	control.rtmp.enable = rtmpControl;
+	control.fallback.enable = fallback;
+	await r.UpsertIngest(
+		'abc',
+		[],
+		[{ address: input, options: [] }],
+		[{ address: '', options: ['-map', '0:0', '-codec:v', 'copy', '-map', '0:1', '-codec:a', 'copy'] }],
+		control,
+	);
+	lastIngest = { procs, calls };
+	return JSON.stringify(procs['restreamer-ui:ingest:abc']);
+};
+let lastIngest = null;
+
+test('ingest publishes to the internal RTMP server when the fallback is on', async () => {
+	expect(await ingest(true, false)).toContain('{rtmp,name=abc.stream}');
+});
+
+test('pushed input: the program gets its own RTMP path, the raw path stays untouched', async () => {
+	const cmd = await ingest(true, false, 'rtmp://localhost:1935/live/abc.stream');
+	expect(cmd).toContain('{rtmp,name=abc_program.stream}');
+	expect(cmd).not.toContain('{rtmp,name=abc.stream}');
+});
+
+test('pushed input without fallback: nothing is published back (stock behaviour)', async () => {
+	const cmd = await ingest(false, false, 'rtmp://localhost:1935/live/abc.stream');
+	expect(cmd).not.toContain('{rtmp,name=');
+});
+
+test('ingest does not publish to RTMP when neither RTMP nor the fallback is on', async () => {
+	expect(await ingest(false, false)).not.toContain('{rtmp,name=abc.stream}');
+});
+
+// The fallback processes: backup stream (_fallback) first, slate image (_fallback2) as the last resort.
+const fallbackProcs = async (fb, rtmpEnabled = true, target = { width: 1080, height: 1920, fps: 25 }) => {
+	const r = Object.create(Restreamer.prototype);
+	r.GetChannel = () => ({ id: 'restreamer-ui:ingest:abc', channelid: 'abc', egresses: [] });
+	r.ConfigActive = () => ({ source: { network: { rtmp: { enabled: rtmpEnabled } } } });
+	r._getProcess = async () => ({ config: { input: [{ address: 'http://cam.example/live.m3u8' }] } });
+	const upserts = {};
+	const deleted = [];
+	r._upsertProcess = async (id, config) => {
+		upserts[id] = config;
+		return [null, null];
+	};
+	r._deleteProcess = async (id) => {
+		deleted.push(id);
+		return true;
+	};
+	const outputs = [{ options: ['-map', '0:0', '-codec:v', 'libx264', '-map', '0:1', '-codec:a', 'aac'] }];
+	const control = { process: { autostart: true }, fallback: fb };
+	const res = await r.UpsertIngestFallback('abc', outputs, control, target);
+	return { res, upserts, deleted };
+};
+
+test('fallback: backup stream and image become two processes, the backup is tried first', async () => {
+	const { res, upserts, deleted } = await fallbackProcs({
+		enable: true,
+		type: 'stream',
+		url: 'srt://b.example:6000?streamid=x',
+		image: '/channels/abc/fallback.png',
+	});
+	expect(res[1]).toBeNull();
+	expect(Object.keys(upserts).sort()).toEqual(['restreamer-ui:ingest:abc_fallback', 'restreamer-ui:ingest:abc_fallback2']);
+	expect(deleted).toEqual([]);
+	const backup = upserts['restreamer-ui:ingest:abc_fallback'];
+	expect(backup.input[0].address).toBe('srt://b.example:6000?streamid=x');
+	expect(backup.output[0].address).toBe('{rtmp,name=abc_fallback.stream}');
+	const slate = upserts['restreamer-ui:ingest:abc_fallback2'];
+	expect(slate.input[0].address).toBe('{diskfs}/channels/abc/fallback.png');
+	expect(slate.output[0].address).toBe('{rtmp,name=abc_fallback2.stream}');
+});
+
+test('fallback: image only publishes the slate and removes a stale backup process', async () => {
+	const { upserts, deleted } = await fallbackProcs({ enable: true, type: 'image', url: '', image: '/channels/abc/fallback.png' });
+	expect(Object.keys(upserts)).toEqual(['restreamer-ui:ingest:abc_fallback2']);
+	expect(deleted).toEqual(['restreamer-ui:ingest:abc_fallback']);
+});
+
+test('fallback: backup stream without an image only has the backup process', async () => {
+	const { upserts, deleted } = await fallbackProcs({ enable: true, type: 'stream', url: 'rtmp://b.example/live/k', image: '' });
+	expect(Object.keys(upserts)).toEqual(['restreamer-ui:ingest:abc_fallback']);
+	expect(deleted).toEqual(['restreamer-ui:ingest:abc_fallback2']);
+});
+
+test('fallback off: both helper processes are removed', async () => {
+	const { res, upserts, deleted } = await fallbackProcs({
+		enable: false,
+		type: 'stream',
+		url: 'rtmp://b.example/live/k',
+		image: '/channels/abc/fallback.png',
+	});
+	expect(res[1]).toBeNull();
+	expect(Object.keys(upserts)).toHaveLength(0);
+	expect(deleted.sort()).toEqual(['restreamer-ui:ingest:abc_fallback', 'restreamer-ui:ingest:abc_fallback2']);
+});
+
+test('fallback: RTMP server off is reported instead of silently doing nothing', async () => {
+	const { res, upserts } = await fallbackProcs({ enable: true, type: 'image', image: '/channels/abc/fallback.png' }, false);
+	expect(res[1]).not.toBeNull();
+	expect(Object.keys(upserts)).toHaveLength(0);
+});
+
+// DiagnoseFallback: what the check button shows.
+const diagnose = async ({ fallback = true, rtmpEnabled = true, streams = [], procs = {}, egress = '{memfs}/abc.m3u8', relay = 'running' }) => {
+	procs = { ...(relay ? { 'restreamer-ui:ingest:abc_hls': { state: { exec: relay } } } : {}), ...procs };
+	const r = Object.create(Restreamer.prototype);
+	r.GetChannel = () => ({ id: 'restreamer-ui:ingest:abc', channelid: 'abc', egresses: ['restreamer-ui:egress:yt:1'] });
+	r.GetIngestMetadata = async () => ({ control: { fallback: { enable: fallback } } });
+	r.ConfigActive = () => ({ source: { network: { rtmp: { enabled: rtmpEnabled } } } });
+	r.ListRTMPChannels = async () => streams;
+	r._getProcess = async (id) => {
+		if (id === 'restreamer-ui:egress:yt:1') {
+			return { config: { input: [{ address: egress }] }, state: { exec: 'running' } };
+		}
+		if (id === 'restreamer-ui:ingest:abc') {
+			return { config: { input: [{ address: 'http://cam.example/live.m3u8' }] }, state: { exec: 'running' } };
+		}
+		return procs[id] || null;
+	};
+	return r.DiagnoseFallback('abc');
+};
+
+test('diagnose: publications that still read HLS are called out', async () => {
+	const rep = await diagnose({
+		streams: ['/live/abc.stream', '/live/abc_fallback2.stream'],
+		procs: { 'restreamer-ui:ingest:abc_fallback2': { state: { exec: 'running' } } },
+	});
+	expect(rep.problems).toEqual(['egress_not_on_failover']);
+	expect(rep.egresses[0].onFailover).toBe(false);
+});
+
+test('diagnose: a backup stream that cannot be reached and no slate means nothing to switch to', async () => {
+	const rep = await diagnose({
+		streams: ['/live/abc.stream'],
+		procs: { 'restreamer-ui:ingest:abc_fallback': { state: { exec: 'failed', last_logline: 'Peer rejected connection' } } },
+		egress: '{rtmp,name=abc.stream}',
+	});
+	expect(rep.problems).toEqual(['backup_not_running', 'no_fallback_stream']);
+	expect(rep.processes[0].last).toBe('Peer rejected connection');
+	expect(rep.egresses[0].onFailover).toBe(true);
+});
+
+test('diagnose: everything in place', async () => {
+	const rep = await diagnose({
+		streams: ['/live/abc.stream', '/live/abc_fallback.stream', '/live/abc_fallback2.stream'],
+		procs: {
+			'restreamer-ui:ingest:abc_fallback': { state: { exec: 'running' } },
+			'restreamer-ui:ingest:abc_fallback2': { state: { exec: 'running' } },
+		},
+		egress: '{rtmp,name=abc.stream}',
+	});
+	expect(rep.problems).toEqual([]);
+});
+
+test('diagnose: RTMP server off', async () => {
+	const rep = await diagnose({ rtmpEnabled: false });
+	expect(rep.problems).toContain('rtmp_off');
+});
+
+test('fallback: the slate audio matches the program (44.1 kHz source)', async () => {
+	const { upserts } = await fallbackProcs({ enable: true, type: 'image', image: '/channels/abc/fallback.png' }, true, {
+		width: 1080,
+		height: 1920,
+		fps: 30,
+		sampleRate: 44100,
+		layout: 'stereo',
+	});
+	const slate = upserts['restreamer-ui:ingest:abc_fallback2'];
+	expect(slate.input[1].address).toBe('anullsrc=r=44100:cl=stereo');
+	const opts = slate.output[0].options;
+	expect(opts[opts.indexOf('-ar') + 1]).toBe('44100');
+	expect(opts[opts.indexOf('-ac') + 1]).toBe('2');
+	expect(opts[opts.indexOf('-r') + 1]).toBe('30');
+	expect(opts.join(' ')).toContain('setsar=1');
+});
+
+test('retarget: the old 60 s backoff cap of a publication is lowered, nothing else changes', async () => {
+	const rtmp = { id: 'e1', input: [{ id: 'input_0', address: '{rtmp,name=abc.stream}', options: [] }], output: [], reconnect_delay_max_seconds: 60 };
+	const [r, upserts] = make(true, true, { e1: rtmp });
+	expect(await r.RetargetEgresses('abc')).toBe(1);
+	expect(upserts[0][1].reconnect_delay_max_seconds).toBe(10);
+	expect(upserts[0][1].input[0].address).toBe('{rtmp,name=abc.stream}');
+	const [r2, upserts2] = make(true, true, { e1: { ...rtmp, reconnect_delay_max_seconds: 10 } });
+	expect(await r2.RetargetEgresses('abc')).toBe(0);
+	expect(upserts2).toHaveLength(0);
+});
+
+// With the fallback on, the HLS (preview, player, snapshot) is written by the relay, which plays
+// the program through the failover; the ingest only publishes the program.
+test('fallback on: the HLS moves to the relay, which reads the program through the failover', async () => {
+	const cmd = await ingest(true, false);
+	const ing = lastIngest.procs['restreamer-ui:ingest:abc'];
+	const relay = lastIngest.procs['restreamer-ui:ingest:abc_hls'];
+	expect(ing.output[0].address).not.toContain('.m3u8');
+	expect(ing.output[0].address).toContain('{rtmp,name=abc.stream}');
+	expect(ing.output[0].cleanup).toEqual([]);
+	expect(cmd).not.toContain('hls_segment_filename');
+	expect(relay.input[0].address).toBe('{rtmp,name=abc.stream}');
+	expect(relay.output[0].address).toContain('{memfs}/abc');
+	expect(relay.output[0].address).toContain('.m3u8');
+	expect(relay.output[0].address).not.toContain('{rtmp');
+	expect(relay.output[0].address).toContain('hls_flags=omit_endlist+append_list');
+	expect(relay.output[0].options).toEqual(expect.arrayContaining(['-codec', 'copy', '-f', 'tee']));
+	expect(relay.output[0].cleanup.length).toBeGreaterThan(0);
+	// the ingest stops writing the HLS before the relay starts writing it
+	expect(lastIngest.calls).toEqual(['upsert restreamer-ui:ingest:abc', 'upsert restreamer-ui:ingest:abc_hls']);
+});
+
+test('pushed input + fallback: the relay reads the processed program, not the raw input', async () => {
+	await ingest(true, false, 'rtmp://localhost:1935/live/abc.stream');
+	expect(lastIngest.procs['restreamer-ui:ingest:abc_hls'].input[0].address).toBe('{rtmp,name=abc_program.stream}');
+});
+
+test('fallback off: the ingest writes the HLS itself and the relay is removed first', async () => {
+	const cmd = await ingest(false, true);
+	expect(cmd).toContain('.m3u8');
+	expect(lastIngest.procs['restreamer-ui:ingest:abc_hls']).toBeUndefined();
+	expect(lastIngest.calls).toEqual(['delete restreamer-ui:ingest:abc_hls', 'upsert restreamer-ui:ingest:abc']);
+});
+
+test('disconnecting a channel stops only the ingest, the fallback and the relay stay on air', async () => {
+	const r = Object.create(Restreamer.prototype);
+	r.GetChannel = () => ({ id: 'restreamer-ui:ingest:abc', channelid: 'abc', egresses: [] });
+	const stopped = [];
+	r._stopProcess = async (id) => {
+		stopped.push(id);
+		return true;
+	};
+	r._hasProcess = async () => true;
+	await r.StopIngest('abc');
+	// the recording stops with the channel; the fallback and the relay do not
+	expect(stopped).toEqual(['restreamer-ui:ingest:abc_record', 'restreamer-ui:ingest:abc']);
+});
+
+test("fallback: the slate is encoded with the program's own encoder settings (identical SPS/PPS)", async () => {
+	const r = Object.create(Restreamer.prototype);
+	r.GetChannel = () => ({ id: 'restreamer-ui:ingest:abc', channelid: 'abc', egresses: [] });
+	r.ConfigActive = () => ({ source: { network: { rtmp: { enabled: true } } } });
+	r._getProcess = async () => ({ config: { input: [{ address: 'http://cam.example/live.m3u8' }] } });
+	const upserts = {};
+	r._upsertProcess = async (id, config) => {
+		upserts[id] = config;
+		return [null, null];
+	};
+	r._deleteProcess = async () => true;
+	const main = ['-codec:v', 'h264_nvenc', '-preset:v', 'p4', '-gpu', '{gpu}', '-b:v', '6000k', '-g', '50', '-bf', '2'];
+	const outputs = [{ options: ['-map', '0:0', ...main, '-filter:v', 'scale_cuda=1080:1920', '-map', '0:1', '-codec:a', 'aac'] }];
+	await r.UpsertIngestFallback(
+		'abc',
+		outputs,
+		{ process: { autostart: true }, fallback: { enable: true, type: 'image', image: '/x.png' } },
+		{ width: 1080, height: 1920, fps: 25 },
+	);
+	const opts = upserts['restreamer-ui:ingest:abc_fallback2'].output[0].options;
+	const v = opts.slice(opts.indexOf('-codec:v'), opts.indexOf('-filter:v'));
+	expect(v).toEqual(main);
+	expect(opts).not.toContain('scale_cuda=1080:1920');
+});
+
+test('diagnose: the HLS relay is missing -> the preview does not follow the fallback', async () => {
+	const rep = await diagnose({
+		streams: ['/live/abc.stream', '/live/abc_fallback2.stream'],
+		procs: { 'restreamer-ui:ingest:abc_fallback2': { state: { exec: 'running' } } },
+		egress: '{rtmp,name=abc.stream}',
+		relay: null,
+	});
+	expect(rep.problems).toEqual(['relay_not_running']);
+});
