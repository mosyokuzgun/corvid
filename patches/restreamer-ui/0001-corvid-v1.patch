diff --git a/src/views/Main/OnAir.js b/src/views/Main/OnAir.js
new file mode 100644
index 0000000..20412d0
--- /dev/null
+++ b/src/views/Main/OnAir.js
@@ -0,0 +1,114 @@
+import React from 'react';
+
+import { Trans } from '@lingui/macro';
+import Box from '@mui/material/Box';
+
+import Palette from '../../theme/base/palette';
+
+// On-air strip (fork): the feeds of a channel in the order the failover uses them, the one
+// viewers get lit like a tally light. Green: the source is on air. Amber: a fallback is on air.
+// Every state is also said in words, so it does not depend on telling colours apart.
+
+const NAME = {
+	source: <Trans>Source</Trans>,
+	stream: <Trans>Backup stream</Trans>,
+	slate: <Trans>Standby image</Trans>,
+};
+
+const STATE = {
+	onair: <Trans>On air</Trans>,
+	ready: <Trans>Ready</Trans>,
+	waiting: <Trans>No signal yet</Trans>,
+	off: <Trans>Off</Trans>,
+	lost: <Trans>Lost, retrying</Trans>,
+	connecting: <Trans>Connecting</Trans>,
+};
+
+const DOT = {
+	ready: Palette.tally.live,
+	waiting: Palette.tally.standby,
+	connecting: Palette.tally.standby,
+	lost: Palette.tally.fault,
+	off: Palette.tally.off,
+};
+
+function Segment(props) {
+	const lit = props.state === 'onair';
+	const color = props.feed === 'source' ? Palette.tally.live : Palette.tally.standby;
+
+	return (
+		<Box
+			sx={{
+				flex: '1 1 0',
+				minWidth: 0,
+				px: 1.5,
+				py: { xs: 0.7, sm: 0.9 },
+				// on a phone: one feed per line, its state at the right
+				display: { xs: 'flex', sm: 'block' },
+				alignItems: 'center',
+				justifyContent: 'space-between',
+				gap: 1,
+				backgroundColor: lit ? color : Palette.background.raised,
+				color: lit ? Palette.background.surround : Palette.text.primary,
+				transition: 'background-color .25s',
+			}}
+		>
+			<Box sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>
+				{!lit && <Box component="span" sx={{ width: 8, height: 8, borderRadius: '50%', flexShrink: 0, backgroundColor: DOT[props.state] }} />}
+				<Box
+					component="span"
+					sx={{
+						fontFamily: '"Barlow Semi Condensed", "Barlow", sans-serif',
+						fontWeight: 600,
+						fontSize: '1.05rem',
+						whiteSpace: 'nowrap',
+						overflow: 'hidden',
+						textOverflow: 'ellipsis',
+					}}
+				>
+					{NAME[props.feed]}
+				</Box>
+			</Box>
+			<Box
+				sx={{
+					fontSize: '.85rem',
+					fontWeight: lit ? 600 : 400,
+					opacity: lit ? 1 : 0.75,
+					whiteSpace: 'nowrap',
+					overflow: 'hidden',
+					textOverflow: 'ellipsis',
+				}}
+			>
+				{STATE[props.state]}
+			</Box>
+		</Box>
+	);
+}
+
+export default function OnAir(props) {
+	const feeds = ['source', 'stream', 'slate'].filter((f) => props.feeds[f] !== null && props.feeds[f] !== undefined);
+
+	return (
+		<Box
+			role="status"
+			aria-live="polite"
+			sx={{
+				display: 'flex',
+				flexDirection: { xs: 'column', sm: 'row' },
+				gap: '1px',
+				backgroundColor: Palette.background.line,
+				border: `1px solid ${Palette.background.line}`,
+				borderRadius: 1,
+				overflow: 'hidden',
+			}}
+		>
+			{feeds.map((f) => (
+				<Segment key={f} feed={f} state={props.feeds[f]} />
+			))}
+		</Box>
+	);
+}
+
+OnAir.defaultProps = {
+	feeds: { source: 'off', stream: null, slate: null },
+};
