+import { pairs, commandParts, splitCommand, regrouped, shellQuote, shellCommand, describe, optionValue } from './command';
+
+const config = {
+	options: ['-loglevel', 'level+info', '-err_detect', 'ignore_err', '-y'],
+	input: [{ options: ['-fflags', '+genpts', '-thread_queue_size', '512'], address: 'srt://h:6000?mode=caller&streamid=a.stream,mode:request' }],
+	output: [
+		{
+			options: ['-dn', '-sn', '-map', '0:0', '-codec:v', 'h264_nvenc', '-gpu', '0', '-b:v', '4096k', '-r', '25', '-g', '50', '-map', '0:1', '-codec:a', 'copy', '-metadata', 'title=x', '-flags', '+global_header', '-f', 'tee'],
+			address: '[f=flv]{rtmp,name=a.stream}',
+		},
+	],
+};
+const command = [...config.options, ...config.input[0].options, '-i', config.input[0].address, ...config.output[0].options, config.output[0].address];
+
+test('pairs options with values and knows the flags', () => {
+	expect(pairs(['-y', '-i', 'a', '-dn', '-stream_loop', '-1', 'out'])).toEqual([['-y'], ['-i', 'a'], ['-dn'], ['-stream_loop', '-1'], ['out']]);
+});
+
+test('splits along the configuration and keeps every argument', () => {
+	const g = splitCommand(command, config);
+	expect(g.map((x) => x.kind)).toEqual(['general', 'input', 'video', 'audio', 'info', 'output']);
+	expect(g[0].tokens).toEqual(config.options);
+	expect(g[1].tokens.slice(-2)).toEqual(['-i', config.input[0].address]);
+	expect(g[2].tokens).toEqual(['-dn', '-sn', '-map', '0:0', '-codec:v', 'h264_nvenc', '-gpu', '0', '-b:v', '4096k', '-r', '25', '-g', '50']);
+	expect(g[3].tokens).toEqual(['-map', '0:1', '-codec:a', 'copy']);
+	expect(g[4].tokens).toEqual(['-metadata', 'title=x']);
+	expect(g[5].tokens).toEqual(['-flags', '+global_header', '-f', 'tee', '[f=flv]{rtmp,name=a.stream}']);
+	expect(g.reduce((a, x) => a + x.tokens.length, 0)).toBe(command.length);
+});
+
+test('falls back to the last -i when the configuration does not match', () => {
+	const g = splitCommand(['-y', '-i', 'a.ts', '-i', 'b.png', '-c:v', 'copy', 'out.mp4'], null);
+	expect(g.map((x) => x.kind)).toEqual(['input', 'video', 'output']);
+	expect(g[0].tokens).toEqual(['-y', '-i', 'a.ts', '-i', 'b.png']);
+});
+
+test('quotes for a shell', () => {
+	expect(shellQuote('rtmp://a.b/live/x')).toBe('rtmp://a.b/live/x');
+	expect(shellQuote('srt://h:6000?mode=caller&x=1')).toBe("'srt://h:6000?mode=caller&x=1'");
+	expect(shellQuote("it's")).toBe("'it'\\''s'");
+	expect(shellQuote('[f=flv]{rtmp,name=a}')).toBe("'[f=flv]{rtmp,name=a}'");
+	expect(shellQuote('')).toBe("''");
+});
+
+test('the copy keeps the order FFmpeg gets', () => {
+	const text = shellCommand(command, config, true);
+	expect(text.split('\n')).toHaveLength(4);
+	expect(text.startsWith('ffmpeg \\\n  -loglevel')).toBe(true);
+	const line = shellCommand(command, config, false);
+	expect(line.includes('\n')).toBe(false);
+	expect(line).toBe('ffmpeg ' + command.map(shellQuote).join(' '));
+	expect(commandParts(command, config).map((p) => p.kind)).toEqual(['general', 'input', 'output']);
+});
+
+test('tells when the reading view sorted options', () => {
+	expect(regrouped(command, config)).toBe(false);
+	const cfg = { options: [], input: [{ options: [], address: 'a' }], output: [{ options: ['-f', 'flv', '-codec:v', 'copy'], address: 'b' }] };
+	expect(regrouped(['-i', 'a', '-f', 'flv', '-codec:v', 'copy', 'b'], cfg)).toBe(true);
+});
+
+test('describes the parts', () => {
+	const g = splitCommand(command, config);
+	expect(describe(g[1])).toMatchObject({ proto: 'srt' });
+	expect(describe(g[2])).toMatchObject({ nvenc: true, bitrate: '4096k', fps: '25', keyframe: 2 });
+	expect(describe(g[3])).toMatchObject({ copy: true });
+	expect(describe(g[5])).toMatchObject({ tee: true, local: true });
+	expect(optionValue(['-b:v', '1k', '-b:v', '2k'], '-b:v')).toBe('2k');
+});
+
+test('a generic -codec, local tees and measuring outputs are recognised', () => {
+	const cfg = { options: [], input: [{ options: [], address: 'rtmp://localhost/live/a' }], output: [{ options: ['-map', '0:v:0?', '-map', '0:a:0?', '-codec', 'copy', '-f', 'tee'], address: '[f=hls]http://admin:x@localhost:8080/memfs/a.m3u8|[f=flv]rtmp://127.0.0.1/live/b' }] };
+	const cmd = ['-i', 'rtmp://localhost/live/a', ...cfg.output[0].options, cfg.output[0].address];
+	const g = splitCommand(cmd, cfg);
+	expect(describe(g.find((x) => x.kind === 'video'))).toMatchObject({ copy: true });
+	expect(describe(g.find((x) => x.kind === 'audio'))).toMatchObject({ copy: true });
+	expect(describe(g.find((x) => x.kind === 'output'))).toMatchObject({ local: true, tee: true });
+
+	const remote = { options: [], input: [{ options: [], address: 'a' }], output: [{ options: ['-f', 'tee'], address: '[f=flv]rtmp://a.rtmp.youtube.com/live2/k|[f=flv]rtmp://localhost/x' }] };
+	expect(describe(splitCommand(['-i', 'a', '-f', 'tee', remote.output[0].address], remote).pop())).toMatchObject({ local: false, tee: true });
+
+	const watch = { options: [], input: [{ options: [], address: 'a' }], output: [{ options: ['-map', '0:v:0?', '-vf', 'signalstats', '-f', 'null'], address: '-' }] };
+	const w = splitCommand(['-i', 'a', ...watch.output[0].options, '-'], watch);
+	expect(describe(w.find((x) => x.kind === 'video'))).toMatchObject({ measured: true });
+	expect(describe(w.find((x) => x.kind === 'output'))).toMatchObject({ discard: true });
+	expect(describe(splitCommand(['-i', 'a', '-f', 'mp4', '/data/rec/a.mp4'], null).pop())).toMatchObject({ local: true });
+});
