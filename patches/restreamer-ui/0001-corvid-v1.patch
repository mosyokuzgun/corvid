new file mode 100644
index 0000000..275bd4c
--- /dev/null
+++ b/src/contexts/Restreamer.js
@@ -0,0 +1,16 @@
+import React from 'react';
+
+// Gives deeply nested settings components (e.g. the Canvas filter) access to channel
+// specific helpers without threading the restreamer instance through every coder/filter.
+const RestreamerContext = React.createContext({
+	channelid: '',
+	upload: async (name, data) => '',
+	rtmpEnabled: true,
+	// Fallback diagnostics (see Restreamer.DiagnoseFallback / RetargetEgresses); absent outside the channel editor.
+	diagnose: null,
+	retarget: null,
+});
+
+export const RestreamerProvider = RestreamerContext.Provider;
+
+export default RestreamerContext;
