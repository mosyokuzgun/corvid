+++ b/src/misc/filters/video/Canvas.js
@@ -0,0 +1,865 @@
+import React from 'react';
+
+import { Trans } from '@lingui/macro';
+import Box from '@mui/material/Box';
+import Alert from '@mui/material/Alert';
+import Button from '@mui/material/Button';
+import Divider from '@mui/material/Divider';
+import Grid from '@mui/material/Grid';
+import MenuItem from '@mui/material/MenuItem';
+import Slider from '@mui/material/Slider';
+import TextField from '@mui/material/TextField';
+import Typography from '@mui/material/Typography';
+
+import Checkbox from '../../Checkbox';
+import Select from '../../Select';
+import * as L from './CanvasLayers';
+import RestreamerContext from '../../../contexts/Restreamer';
+
+// Canvas / vertical video (fork).
+//
+// Turns the program (e.g. 1920x1080) into a canvas (e.g. 1080x1920 for Shorts/Reels/
+// TikTok) with an image, colour or blurred-video background, and places the video at
+// X/Y with a given size. Everything runs on the GPU:
+//
+//   - mainstream FFmpeg has no pad_cuda/crop_cuda; both are emulated with overlay_cuda
+//     (overlaying onto a smaller frame crops, onto a bigger frame pads),
+//   - the live video drives the clock; background stills are single frames overlaid with
+//     eof_action=repeat, so they are uploaded to VRAM exactly once,
+//   - all sizes and offsets are rounded to even numbers (4:2:0 chroma),
+//   - fitting uses the *display* aspect ratio of the source (the dar expression), so a
+//     source that was squeezed before (e.g. "Scale" to 1080x1920 in front of the canvas,
+//     or anamorphic video) still lands undistorted in its box,
+//   - the result gets square pixels (setsar=1). Without it the canvas inherits the SAR of
+//     the scaled source (1920x1080 -> 1080x1920 gives 256:81) and every player shows the
+//     9:16 frame squeezed back into 16:9.
+//
+// It is a simple filtergraph (-filter:v), so the process layout of the ingest is
+// unchanged. Requires NVDEC (zero-copy) or is fed via hwupload by metadata.js.
+
+const even = (v) => Math.round(parseFloat(v || 0) / 2) * 2;
+
+function init(initialState) {
+	return {
+		mode: 'none',
+		width: '1080',
+		height: '1920',
+		x: '0',
+		y: '656',
+		vw: '1080',
+		vh: '608',
+		fit: 'contain',
+		bg: 'blur',
+		color: '#000000',
+		blur: '20',
+		image: '',
+		// Layers (titles, logo, images), see CanvasLayers.js. composed/top are the pictures the
+		// browser drew from them; layersKey tells what they were drawn from.
+		layers: [],
+		composed: '',
+		top: '',
+		layersKey: '',
+		...initialState,
+	};
+}
+
+// ops abstracts GPU vs CPU filters so tests can run the identical topology without a GPU.
+function ops(cpu) {
+	if (cpu) {
+		return {
+			scale: (w, h, extra = '') =>
+				`scale=w=${w}:h=${h}${extra.replace('interp_algo=nearest', 'flags=neighbor').replace('interp_algo=', 'flags=')},format=yuv420p`,
+			overlay: (x, y) => `overlay=x=${x}:y=${y}:eof_action=repeat:format=yuv420`,
+			upload: 'format=yuv420p',
+			uploadAlpha: 'format=yuva420p',
+		};
+	}
+	return {
+		scale: (w, h, extra = '') => `scale_cuda=w=${w}:h=${h}:format=yuv420p${extra}`,
+		overlay: (x, y) => `overlay_cuda=x=${x}:y=${y}:eof_action=repeat`,
+		upload: 'format=yuv420p,hwupload',
+		uploadAlpha: 'format=yuva420p,hwupload',
+	};
+}
+
+// Box fitting by display aspect ratio (dar), even sizes. Quoted: the commas of min/max
+// would otherwise end the filter.
+const fitW = (fn, w, h) => `'trunc(${fn}(${w},${h}*dar)/2)*2'`;
+const fitH = (fn, w, h) => `'trunc(${fn}(${h},${w}/dar)/2)*2'`;
+
+function createGraph(settings, options = {}) {
+	settings = init(settings);
+	if (settings.mode !== 'canvas') {
+		return '';
+	}
+
+	const o = ops(options.cpu === true);
+	const W = even(settings.width);
+	const H = even(settings.height);
+	const X = even(settings.x);
+	const Y = even(settings.y);
+	const vw = Math.max(16, even(settings.vw));
+	const vh = Math.max(16, even(settings.vh));
+
+	const resolve = options.path || ((p) => `{diskfs}${p}`);
+	let bg = settings.bg;
+	let image = settings.image;
+	if (bg === 'image' && !settings.image) {
+		bg = 'blur';
+	} else if (settings.composed && (bg === 'image' || bg === 'color')) {
+		// The background with the layers behind the video drawn into it.
+		bg = 'image';
+		image = settings.composed;
+	}
+	// The layers in front of the video: one transparent picture, overlaid last.
+	const end = settings.top ? '[cvmix]' : ',setsar=1';
+
+	const labels = ['[cvsrc]', '[cvref]'];
+	if (bg === 'blur') {
+		labels.push('[cvblur]');
+	}
+	if (settings.fit === 'cover') {
+		labels.push('[cvbox]');
+	}
+
+	const g = [];
+	g.push(`split=${labels.length}${labels.join('')}`);
+	// Canvas base: a WxH frame derived from the live video (carries the live clock).
+	g.push(`[cvref]${o.scale(W, H, ':interp_algo=nearest')}[cvbase]`);
+
+	if (bg === 'image') {
+		const path = resolve(image).replace(/'/g, '');
+		g.push(`movie=filename='${path}',scale=w=${W}:h=${H}:force_original_aspect_ratio=increase,crop=${W}:${H},${o.upload}[cvbgi]`);
+		g.push(`[cvbase][cvbgi]${o.overlay(0, 0)}[cvbg]`);
+	} else if (bg === 'blur') {
+		const k = Math.min(64, Math.max(4, parseInt(settings.blur) || 20));
+		const tw = Math.max(2, even(W / k));
+		const th = Math.max(2, even(H / k));
+		// Cheap GPU blur: downscale to ~1/k, upscale bicubic; the oversize cover result is
+		// centre-cropped for free by overlaying it on the WxH base.
+		g.push(`[cvblur]${o.scale(fitW('max', tw, th), fitH('max', tw, th))},${o.scale(fitW('max', W, H), fitH('max', W, H), ':interp_algo=bicubic')}[cvbl]`);
+		g.push(`[cvbase][cvbl]${o.overlay('(main_w-overlay_w)/2', '(main_h-overlay_h)/2')}[cvbg]`);
+	} else {
+		const color = (/^#?([0-9a-fA-F]{6})$/.exec(settings.color) || [null, '000000'])[1];
+		g.push(`color=c=0x${color}:s=${W}x${H}:r=1:d=1,${o.upload}[cvbgc]`);
+		g.push(`[cvbase][cvbgc]${o.overlay(0, 0)}[cvbg]`);
+	}
+
+	if (settings.fit === 'stretch') {
+		g.push(`[cvsrc]${o.scale(vw, vh, ':interp_algo=lanczos')}[cvfg]`);
+		g.push(`[cvbg][cvfg]${o.overlay(X, Y)}${end}`);
+	} else if (settings.fit === 'cover') {
+		// GPU crop: an oversized frame overlaid on a box-sized frame is clipped to the box.
+		g.push(`[cvbox]${o.scale(vw, vh, ':interp_algo=nearest')}[cvb]`);
+		g.push(`[cvsrc]${o.scale(fitW('max', vw, vh), fitH('max', vw, vh), ':interp_algo=lanczos')}[cvbig]`);
+		g.push(`[cvb][cvbig]${o.overlay('(main_w-overlay_w)/2', '(main_h-overlay_h)/2')}[cvfg]`);
+		g.push(`[cvbg][cvfg]${o.overlay(X, Y)}${end}`);
+	} else {
+		g.push(`[cvsrc]${o.scale(fitW('min', vw, vh), fitH('min', vw, vh), ':interp_algo=lanczos')}[cvfg]`);
+		g.push(`[cvbg][cvfg]${o.overlay(`${X}+(${vw}-overlay_w)/2`, `${Y}+(${vh}-overlay_h)/2`)}${end}`);
+	}
+
+	if (settings.top) {
+		g.push(`movie=filename='${resolve(settings.top).replace(/'/g, '')}',${o.uploadAlpha}[cvtop]`);
+		g.push(`[cvmix][cvtop]${o.overlay(0, 0)},setsar=1`);
+	}
+
+	return g.join(';');
+}
+
+const SIZES = {
+	'1080x1920': '9:16 Shorts / Reels / TikTok',
+	'720x1280': '9:16 (720p)',
+	'1080x1080': '1:1',
+	'1080x1350': '4:5',
+	'1920x1080': '16:9',
+	'1280x720': '16:9 (720p)',
+};
+
+// Drag & drop preview of the canvas (scaled to 400 px height).
+function Stage(props) {
+	const s = props.settings;
+	const W = even(s.width);
+	const H = even(s.height);
+	const scale = 400 / H;
+	const drag = React.useRef(null);
+
+	const down = (mode) => (e) => {
+		e.stopPropagation();
+		e.target.setPointerCapture(e.pointerId);
+		drag.current = { mode, sx: e.clientX, sy: e.clientY, x: even(s.x), y: even(s.y), w: even(s.vw), h: even(s.vh) };
+	};
+	const move = (e) => {
+		const d = drag.current;
+		if (!d) {
+			return;
+		}
+		const dx = (e.clientX - d.sx) / scale;
+		const dy = (e.clientY - d.sy) / scale;
+		if (d.mode === 'layer') {
+			props.onLayer(d.index, { x: `${Math.round(d.x + dx)}`, y: `${Math.round(d.y + dy)}` });
+		} else if (d.mode === 'move') {
+			props.onChange({ x: `${even(d.x + dx)}`, y: `${even(d.y + dy)}` });
+		} else {
+			const w = Math.max(32, d.w + dx);
+			const h = e.shiftKey ? w * (d.h / d.w) : Math.max(32, d.h + dy);
+			props.onChange({ vw: `${even(w)}`, vh: `${even(h)}` });
+		}
+	};
+	const up = () => {
+		drag.current = null;
+	};
+	const downLayer = (index, layer) => (e) => {
+		e.stopPropagation();
+		e.target.setPointerCapture(e.pointerId);
+		drag.current = { mode: 'layer', index, sx: e.clientX, sy: e.clientY, x: parseFloat(layer.x) || 0, y: parseFloat(layer.y) || 0 };
+	};
+
+	// The layers are drawn by the same code that draws the uploaded pictures, so the
+	// preview shows exactly what goes on air: behind the video box and in front of it.
+	const below = React.useRef(null);
+	const above = React.useRef(null);
+	const context = (ref) => {
+		try {
+			return ref.current && ref.current.getContext ? ref.current.getContext('2d') : null;
+		} catch (e) {
+			return null;
+		}
+	};
+	React.useEffect(() => {
+		for (const [ref, target] of [
+			[below, 'bg'],
+			[above, 'top'],
+		]) {
+			const c = context(ref);
+			if (!c) {
+				continue;
+			}
+			c.setTransform(1, 0, 0, 1, 0, 0);
+			c.clearRect(0, 0, ref.current.width, ref.current.height);
+			c.setTransform(scale, 0, 0, scale, 0, 0);
+			L.drawLayers(c, s, props.images, target);
+		}
+	});
+	const layers = (s.layers || []).map(L.initLayer);
+	const sheet = { position: 'absolute', left: 0, top: 0, pointerEvents: 'none' };
+
+	let background = '#333';
+	if (s.bg === 'color') {
+		background = s.color;
+	} else if (s.bg === 'image' && s.image) {
+		background = `center / cover no-repeat url(${s.image})`;
+	} else if (s.bg === 'blur') {
+		background = 'linear-gradient(135deg, #2b3340, #4a5568, #2b3340)';
+	}
+
+	return (
+		<Box
+			onPointerMove={move}
+			onPointerUp={up}
+			sx={{
+				position: 'relative',
+				width: W * scale,
+				height: H * scale,
+				overflow: 'hidden',
+				background,
+				outline: '1px solid #666',
+				touchAction: 'none',
+				userSelect: 'none',
+			}}
+		>
+			<canvas ref={below} width={Math.round(W * scale)} height={Math.round(H * scale)} style={sheet} />
+			<Box
+				onPointerDown={down('move')}
+				sx={{
+					position: 'absolute',
+					left: even(s.x) * scale,
+					top: even(s.y) * scale,
+					width: even(s.vw) * scale,
+					height: even(s.vh) * scale,
