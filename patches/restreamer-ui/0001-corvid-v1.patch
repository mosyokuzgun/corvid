@@ -0,0 +1,20 @@
+// Security checks of the active configuration (fork). Returns a list of problem codes.
+export function securityProblems(config, protocol, hostname) {
+	const problems = [];
+	const net = (config && config.source && config.source.network) || {};
+	const rtmp = net.rtmp || {};
+	const srt = net.srt || {};
+
+	if (rtmp.enabled && !`${rtmp.token || ''}`.length) {
+		problems.push('rtmp_no_token');
+	}
+	if (srt.enabled && !`${srt.token || ''}`.length && !`${srt.passphrase || ''}`.length) {
+		problems.push('srt_no_token');
+	}
+	const local = ['localhost', '127.0.0.1', '::1', '[::1]'].includes(hostname || '');
+	if (protocol === 'http:' && !local) {
+		problems.push('http');
+	}
+
+	return problems;
+}
