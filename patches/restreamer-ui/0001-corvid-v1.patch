--- /dev/null
+++ b/src/views/Main/Status.js
@@ -0,0 +1,907 @@
+import React from 'react';
+
+import { i18n } from '@lingui/core';
+import { Trans, t } from '@lingui/macro';
+import Alert from '@mui/material/Alert';
+import Box from '@mui/material/Box';
+import Button from '@mui/material/Button';
+import Divider from '@mui/material/Divider';
+import Grid from '@mui/material/Grid';
+import ArrowBackIcon from '@mui/icons-material/ArrowBack';
+import RefreshIcon from '@mui/icons-material/Refresh';
+import Modal from '@mui/material/Modal';
+import Tab from '@mui/material/Tab';
+import Tabs from '@mui/material/Tabs';
+import TextField from '@mui/material/TextField';
+import Typography from '@mui/material/Typography';
+
+import ModalContent from '../../misc/ModalContent';
+import Palette from '../../theme/base/palette';
+import { randomKey } from '../../utils/address';
+import { ConfigFileControls, DiagnosticsButton } from '../SettingsFile';
+
+// Status and tools of a channel (fork): the health of the SRT link that feeds it, the state
+// of its publications, what happened lately, a configuration backup and "copy channel".
+
+const WHO = {
+	source: <Trans>Source</Trans>,
+	fallback: <Trans>Backup stream</Trans>,
+	slate: <Trans>Standby image</Trans>,
+	relay: <Trans>Preview relay</Trans>,
+	record: <Trans>Recording</Trans>,
+	target: <Trans>Publication</Trans>,
+	snapshot: <Trans>Preview picture</Trans>,
+	watch: <Trans>Sound and picture watch</Trans>,
+	other: <Trans>Other</Trans>,
+};
+
+const KIND = {
+	started: <Trans>started</Trans>,
+	failed: <Trans>failed / lost its input</Trans>,
+	stale: <Trans>was restarted: no data for 30 s</Trans>,
+	passed: <Trans>was passed over: connected, but no data</Trans>,
+};
+
+const REASON = [
+	[/^no data for (.*)$/, (m) => <Trans>no data for {m[1]}</Trans>],
+	[/^publisher disconnected$/, () => <Trans>the sender disconnected</Trans>],
+	[/^primary is back$/, () => <Trans>the source is back</Trans>],
+	[/^preferred fallback is available again$/, () => <Trans>the backup stream is back</Trans>],
+];
+
+const reason = (text) => {
+	for (const [re, fn] of REASON) {
+		const m = re.exec(text);
+		if (m) {
+			return fn(m);
+		}
+	}
+	return text;
+};
+
+// in the language of the panel, not of the browser
+const clock = (ts) => {
+	const d = new Date(ts);
+	return isNaN(d.getTime()) ? ts : d.toLocaleTimeString(i18n.locale);
