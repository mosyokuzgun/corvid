+	const file = new File([new Uint8Array([1, 2, 3])], 'bg.png', { type: 'image/png' });
+	file.arrayBuffer = async () => new ArrayBuffer(3);
+	fireEvent.change(container.querySelector('input[type=file]'), { target: { files: [file] } });
