+// One-click diagnostics (fork): everything needed to look into a problem in one JSON file,
+// with passwords, keys and stream keys hidden, so it can be sent to whoever helps.
+
+import { maskSecrets, MASK } from './secrets';
+
+// Values under these names are secrets whatever they look like.
+const SECRET_NAME = /pass(word|phrase)?$|token|secret|^key$|streamkey|stream_key|^auth$|signature|cookie|credentials|guestkeys|watchkey/i;
+
+// Copy of value with secrets replaced: secret fields become MASK, every string is masked like
+// the commands on screen (user:password@, ?token=, SRT streamid tokens, stream keys in paths).
+export const maskDeep = (value, name = '') => {
+	if (value === null || value === undefined) {
+		return value;
+	}
+	if (SECRET_NAME.test(name)) {
+		if (typeof value === 'string') {
+			return value.length === 0 ? '' : MASK;
+		}
+		if (Array.isArray(value)) {
+			return value.map((v) => (typeof v === 'string' ? MASK : maskDeep(v)));
+		}
+		// an object (api.auth, jwt): its switches stay, its strings with secret names go
+	}
+	if (typeof value === 'string') {
+		return maskSecrets(value);
+	}
+	if (Array.isArray(value)) {
+		// FFmpeg arguments: the value after "-passphrase", "-password" etc. is a secret too
+		return value.map((v, i) => (i > 0 && typeof value[i - 1] === 'string' && /^-(passphrase|password|key|token|auth)/i.test(value[i - 1]) ? MASK : maskDeep(v)));
+	}
+	if (typeof value === 'object') {
+		const out = {};
+		for (const k of Object.keys(value)) {
+			out[k] = maskDeep(value[k], k);
+		}
+		return out;
+	}
+	return value;
+};
+
+// Collects the parts; a part that fails is recorded as its error and does not stop the rest.
+export const collectDiagnostics = async (parts) => {
+	const out = { format: 'yayin-paneli-diagnostics', version: 1, created: new Date().toISOString(), browser: '' };
+	try {
+		out.browser = navigator.userAgent;
+	} catch (e) {}
+	for (const name of Object.keys(parts)) {
+		try {
+			out[name] = maskDeep(await parts[name]());
+		} catch (e) {
+			out[name] = { error: `${(e && e.message) || e}` };
+		}
+	}
+	return out;
+};
