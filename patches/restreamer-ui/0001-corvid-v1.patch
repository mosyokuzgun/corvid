+import React from 'react';
+
+import mark from './images/mark.png';
+
+// Corvid's mark, the white outline for the dark panel; size is its height.
+export default function Mark(props) {
+	return <img src={mark} alt="" height={props.size} width={Math.round((props.size * 142) / 104)} style={{ display: 'block' }} />;
+}
+
+Mark.defaultProps = {
+	size: 44,
+};
