+};
+
+test('canvas:uploaded background image ends up in the graph', async () => {
+	const upload = jest.fn(async (name) => `/channels/abc/${name}`);
+	const changes = await uploadImage((changes) => (
+		<RestreamerProvider value={{ channelid: 'abc', upload, rtmpEnabled: true }}>
+			<Canvas.component settings={{ ...base, bg: 'image', image: '' }} onChange={(s, g) => changes.push([s, g])} />
+		</RestreamerProvider>
+	));
+	// a new file name per upload, so that a replaced picture changes the graph
+	await waitFor(() => expect(upload).toHaveBeenCalledWith(expect.stringMatching(/^canvas\d+\.png$/), expect.anything()));
+	await waitFor(() => expect(changes[changes.length - 1][0].image).toMatch(/^\/channels\/abc\/canvas\d+\.png$/));
+	expect(changes[changes.length - 1][1]).toMatch(/movie=filename='\{diskfs\}\/channels\/abc\/canvas\d+\.png'/);
+});
+
+test('canvas:a failed upload is shown instead of silently using the blur', async () => {
+	const changes = await uploadImage((changes) => (
+		<Canvas.component settings={{ ...base, bg: 'image', image: '' }} onChange={(s, g) => changes.push([s, g])} />
