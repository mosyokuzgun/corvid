+test('on air: the source while it delivers, else the backup stream, else the standby image', () => {
+	const { onAirOf } = require('./restreamer');
+	const run = { order: 'start', exec: 'running', fps: 25 };
+	const silent = { order: 'start', exec: 'running', fps: 0 };
+	const stop = { order: 'stop', exec: 'finished', fps: 0 };
+
+	// no fallback configured
+	expect(onAirOf({ source: 'connected', relay: false })).toEqual({ onair: 'source', feeds: { source: 'onair', stream: null, slate: null } });
+	expect(onAirOf({ source: 'error', relay: false })).toEqual({ onair: 'none', feeds: { source: 'lost', stream: null, slate: null } });
+	expect(onAirOf({ source: 'disconnected', relay: false }).feeds.source).toBe('off');
+
+	// the source is on air; the fallbacks stand by
+	expect(onAirOf({ source: 'connected', relay: true, stream: run, slate: run })).toEqual({
+		onair: 'source',
+		feeds: { source: 'onair', stream: 'ready', slate: 'ready' },
+	});
+	// the source is lost: the backup stream if it delivers frames ...
+	expect(onAirOf({ source: 'error', relay: true, stream: run, slate: run })).toEqual({
+		onair: 'stream',
+		feeds: { source: 'lost', stream: 'onair', slate: 'ready' },
+	});
+	// ... else the standby image
+	expect(onAirOf({ source: 'connecting', relay: true, stream: silent, slate: run })).toEqual({
+		onair: 'slate',
+		feeds: { source: 'connecting', stream: 'waiting', slate: 'onair' },
+	});
+	// nothing delivers
+	expect(onAirOf({ source: 'error', relay: true, stream: silent, slate: null }).onair).toBe('none');
+	// without the relay nothing of the fallback reaches the viewers
+	expect(onAirOf({ source: 'error', relay: false, stream: run, slate: run }).onair).toBe('none');
+	expect(onAirOf({ source: 'disconnected', relay: false, stream: stop, slate: stop }).feeds).toEqual({ source: 'off', stream: 'off', slate: 'off' });
+	// stopped by the operator after a failure: off, not "lost, retrying"
+	expect(onAirOf({ source: 'error', order: 'stop', relay: false, stream: stop, slate: stop }).feeds.source).toBe('off');
+	expect(onAirOf({ source: 'error', order: 'start', relay: false }).feeds.source).toBe('lost');
+});
+
+test('on air: the tiles get the numbers of the fallback that is on air', async () => {
+	const r = Object.create(Restreamer.prototype);
+	r.GetChannel = () => ({ id: 'restreamer-ui:ingest:abc' });
+	const states = {
+		'restreamer-ui:ingest:abc_fallback': {
+			order: 'start',
+			exec: 'running',
+			runtime_seconds: 600,
+			command: [],
+			progress: { fps: 25, bitrate_kbit: 4000, speed: 1 },
+		},
+		'restreamer-ui:ingest:abc_fallback2': {
+			order: 'start',
+			exec: 'running',
+			runtime_seconds: 600,
+			command: [],
+			progress: { fps: 25, bitrate_kbit: 200, speed: 1 },
+		},
+		'restreamer-ui:ingest:abc_hls': {
+			order: 'start',
+			exec: 'running',
+			runtime_seconds: 42,
+			command: [],
+			progress: { fps: 30, bitrate_kbit: 0, speed: 0.7 },
+		},
+	};
+	r._getProcessState = async (id) => states[id] || null;
+
+	let res = await r.GetOnAirState('abc', 'error', true);
+	expect(res.onair).toBe('stream');
+	// the encoder's numbers, the relay's running time
+	expect(res.progress).toEqual({ bitrate: 4000, fps: 25, speed: 1, time: 42 });
