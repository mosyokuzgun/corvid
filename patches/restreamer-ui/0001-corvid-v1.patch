@@ -0,0 +1,41 @@
+import React from 'react';
+import { useNavigate, useParams } from 'react-router-dom';
+
+import Status from './Main/Status';
+
+// "Status and tools" as a page of its own (fork); the tab is part of the address, so a
+// link or the browser's back button lands on the same tab.
+const TABS = ['status', 'events', 'recordings', 'keys', 'tools'];
+
+export default function StatusPage(props) {
+	const navigate = useNavigate();
+	const { channelid, tab } = useParams();
+	const [$record, setRecord] = React.useState(undefined);
+
+	React.useEffect(() => {
+		(async () => {
+			const metadata = await props.restreamer.GetIngestMetadata(channelid);
+			setRecord(metadata && metadata.control ? metadata.control.record : null);
+		})();
+		// eslint-disable-next-line react-hooks/exhaustive-deps
+	}, [channelid]);
+
+	if ($record === undefined) {
+		return null;
+	}
+
+	const channel = props.restreamer.GetChannel(channelid);
+	const current = TABS.includes(tab) ? tab : 'status';
+
+	return (
+		<Status
+			page
+			tab={current}
+			onTab={(t) => navigate(`/${channelid}/status/${t}`, { replace: true })}
+			restreamer={props.restreamer}
+			channelid={channelid}
+			channelName={channel ? channel.name : ''}
+			record={$record}
+		/>
+	);
+}
