diff --git a/src/misc/CommandView.js b/src/misc/CommandView.js
new file mode 100644
index 0000000..abc9c8f
--- /dev/null
+++ b/src/misc/CommandView.js
@@ -0,0 +1,231 @@
+import React from 'react';
+
+import { i18n } from '@lingui/core';
+import { Trans, t } from '@lingui/macro';
+import Box from '@mui/material/Box';
+import Button from '@mui/material/Button';
+import FormControlLabel from '@mui/material/FormControlLabel';
+import Switch from '@mui/material/Switch';
+import ToggleButton from '@mui/material/ToggleButton';
+import ToggleButtonGroup from '@mui/material/ToggleButtonGroup';
+import Typography from '@mui/material/Typography';
+import ContentCopyIcon from '@mui/icons-material/ContentCopy';
+
+import Palette from '../theme/base/palette';
+import { describe, regrouped, shellCommand, shellLine, splitCommand } from '../utils/command';
+import { maskSecrets } from '../utils/secrets';
+
+// An FFmpeg command for people (fork): by part with a plain sentence for each, or on one line;
+// keys hidden until asked for; copy for a terminal in the order FFmpeg gets the arguments.
+// Used by the process page and by "Preview command" before saving.
+
+const MONO = '"IBM Plex Mono", "Consolas", "Menlo", monospace';
+
+const GROUP = {
+	general: <Trans>General</Trans>,
+	input: <Trans>Input</Trans>,
+	video: <Trans>Picture</Trans>,
+	audio: <Trans>Sound</Trans>,
+	info: <Trans>Information</Trans>,
+	output: <Trans>Output</Trans>,
+};
+
+const rateText = (v) => {
+	const m = /^(\d+(?:\.\d+)?)([kKmM])?$/.exec(`${v || ''}`);
+	if (!m) return `${v}`;
+	const kbit = Number(m[1]) * (m[2] && m[2].toLowerCase() === 'm' ? 1000 : m[2] ? 1 : 0.001);
+	return `${i18n.number(Math.round(kbit))} kbit/s`;
+};
+
+// The sentence next to a part of the command.
+function Explain(props) {
+	const g = props.group;
+	const d = describe(g);
+	switch (g.kind) {
+		case 'general':
+			return <Trans>How FFmpeg runs: log level and how it reacts to damaged data.</Trans>;
+		case 'input':
+			if (d.proto === 'own') return <Trans>Reads the channel's stream on this server (the address is filled in when the process starts).</Trans>;
+			if (d.proto === 'srt') return <Trans>Reads an SRT stream.</Trans>;
+			if (d.proto === 'rtmp' || d.proto === 'rtmps') return <Trans>Reads an RTMP stream.</Trans>;
+			if (d.proto === 'http' || d.proto === 'https') return <Trans>Reads over HTTP (HLS or a file on a web server).</Trans>;
+			if (d.proto === 'rtsp') return <Trans>Reads a camera over RTSP.</Trans>;
+			if (d.format === 'lavfi') return <Trans>Makes a signal of its own (test picture or silence).</Trans>;
+			if (d.loop) return <Trans>Reads an image or file over and over.</Trans>;
+			return <Trans>Reads the input.</Trans>;
+		case 'video':
+			if (d.none) return <Trans>No picture in this output.</Trans>;
+			if (d.measured) return <Trans>The picture is only measured, nothing is encoded.</Trans>;
+			if (d.copy) return <Trans>The picture is passed on as it is: no encoder, no load on the graphics card.</Trans>;
+			if (d.nvenc)
+				return (
+					<span>
+						<Trans>Encoded with NVENC on the graphics card</Trans>
+						{d.bitrate ? `, ${rateText(d.bitrate)}` : ''}
+						{d.fps ? `, ${d.fps} FPS` : ''}
+						{d.keyframe ? (
+							<span>
+								, <Trans>a keyframe every {i18n.number(d.keyframe)} s</Trans>
+							</span>
+						) : (
+							''
+						)}
+						.{d.filter ? <span> <Trans>The picture is changed by filters on the way (size, canvas).</Trans></span> : ''}
+					</span>
+				);
+			if (d.codec)
+				return (
+					<span>
+						<Trans>Encoded by the processor ({d.codec}).</Trans>
+					</span>
+				);
+			return <Trans>Which picture goes into the output.</Trans>;
+		case 'audio':
+			if (d.none) return <Trans>No sound in this output.</Trans>;
+			if (d.measured) return <Trans>The sound is only measured, nothing is encoded.</Trans>;
+			if (d.copy) return <Trans>The sound is passed on as it is.</Trans>;
+			if (d.codec)
+				return (
+					<span>
+						<Trans>Sound encoded as {d.codec}</Trans>
+						{d.bitrate ? `, ${rateText(d.bitrate)}` : ''}
+						{d.rate ? `, ${i18n.number(Number(d.rate))} Hz` : ''}.
+					</span>
+				);
+			return <Trans>Which sound goes into the output.</Trans>;
+		case 'info':
+			return <Trans>Information written into the stream (title, provider).</Trans>;
+		case 'output':
+			if (d.discard) return <Trans>Writes nothing: the process only measures.</Trans>;
+			if (d.local) return <Trans>Goes to this server's own stream or storage.</Trans>;
+			if (d.tee) return <Trans>Goes to several places at once.</Trans>;
+			if (d.proto) return <Trans>Goes to a remote server ({d.proto}).</Trans>;
+			return <Trans>Where the result is written.</Trans>;
+		default:
+			return null;
+	}
+}
+
+export default function CommandView(props) {
+	const command = Array.isArray(props.command) ? props.command : [];
+	const config = props.config || null;
+	const [$readable, setReadable] = React.useState(true);
+	// keys shown or hidden: controlled by the page if it passes secrets/onSecrets (the process
+	// page shares the switch with its log), otherwise kept here
+	const [$own, setOwn] = React.useState(false);
+	const controlled = typeof props.onSecrets === 'function';
+	const $secrets = controlled ? props.secrets === true : $own;
+	const setSecrets = controlled ? props.onSecrets : setOwn;
+	const [$copied, setCopied] = React.useState(false);
+
+	React.useEffect(() => {
+		// another command: its keys are hidden again
+		setSecrets(false);
+		// eslint-disable-next-line react-hooks/exhaustive-deps
+	}, [props.resetKey]);
+
+	const show = (text) => ($secrets ? text : maskSecrets(text));
+	const groups = splitCommand(command, config);
+	const sorted = regrouped(command, config);
+
+	const copy = async () => {
+		try {
+			await navigator.clipboard.writeText(show(shellCommand(command, config, $readable)));
+			setCopied(true);
+			setTimeout(() => setCopied(false), 2000);
+		} catch (e) {}
+	};
+
+	return (
+				<Box component="section" sx={{ backgroundColor: Palette.background.paper, border: `1px solid ${Palette.background.line}`, borderRadius: 1.5, p: { xs: 2, md: 2.5 }, mb: 2 }}>
+					<Box sx={{ display: 'flex', flexWrap: 'wrap', alignItems: 'center', justifyContent: 'space-between', gap: 1.5, mb: 1.5 }}>
+						<Typography variant="h3" component="h2">
+							<Trans>FFmpeg command</Trans>
+						</Typography>
+						<Box sx={{ display: 'flex', flexWrap: 'wrap', alignItems: 'center', gap: '8px 16px' }}>
+							<ToggleButtonGroup
+								size="small"
+								exclusive
+								value={$readable ? 'parts' : 'line'}
+								onChange={(e, v) => v && setReadable(v === 'parts')}
+								aria-label={i18n._(t`Command view`)}
+								sx={{ '& .MuiToggleButton-root.Mui-selected, & .MuiToggleButton-root.Mui-selected:hover': { backgroundColor: '#F1F2F3', color: '#1B1C1E', borderColor: '#F1F2F3' } }}
+							>
+								<ToggleButton value="parts" sx={{ textTransform: 'none', px: 1.5 }}>
+									<Trans>By part</Trans>
+								</ToggleButton>
+								<ToggleButton value="line" sx={{ textTransform: 'none', px: 1.5 }}>
+									<Trans>One line</Trans>
+								</ToggleButton>
+							</ToggleButtonGroup>
+							<FormControlLabel sx={{ mr: 0 }} control={<Switch checked={$secrets} onChange={(e) => setSecrets(e.target.checked)} />} label={<Trans>Show keys and passwords</Trans>} />
+							<Button variant="outlined" color="inherit" startIcon={<ContentCopyIcon />} onClick={copy} disabled={command.length === 0}>
+								{$copied ? <Trans>Copied</Trans> : <Trans>Copy</Trans>}
+							</Button>
+						</Box>
+					</Box>
+
+					{command.length === 0 ? (
+						<Typography variant="body1" sx={{ color: 'text.secondary' }}>
+							<Trans>The core reports no command for this process.</Trans>
+						</Typography>
+					) : $readable ? (
+						<Box sx={{ backgroundColor: Palette.background.surround, border: `1px solid ${Palette.background.line}`, borderRadius: 1 }}>
+							{groups.map((g, i) => (
+								<Box
+									key={i}
+									sx={{ display: 'flex', flexWrap: 'wrap', gap: '4px 20px', px: 2, py: 1.5, borderTop: i === 0 ? 0 : `1px solid ${Palette.background.raised}` }}
+								>
+									<Box sx={{ flex: '0 0 96px', fontSize: '.9rem', fontWeight: 600, color: 'text.secondary' }}>
+										{GROUP[g.kind]}
+										{(g.kind === 'input' && config && config.input.length > 1) || (g.kind !== 'input' && g.kind !== 'general' && config && config.output.length > 1)
+											? ` ${g.index + 1}`
+											: ''}
+									</Box>
+									<Box
+										component="code"
+										sx={{ flex: '999 1 420px', minWidth: 0, fontFamily: MONO, fontSize: '.85rem', lineHeight: 1.6, whiteSpace: 'pre-wrap', overflowWrap: 'anywhere' }}
+									>
+										{show(shellLine(g.tokens))}
+									</Box>
+									<Box sx={{ flex: '1 1 220px', fontSize: '.9rem', color: 'text.secondary', lineHeight: 1.5 }}>
+										<Explain group={g} />
+									</Box>
+								</Box>
+							))}
+						</Box>
+					) : (
+						<Box
+							component="code"
+							sx={{
+								display: 'block',
+								backgroundColor: Palette.background.surround,
+								border: `1px solid ${Palette.background.line}`,
+								borderRadius: 1,
+								p: 2,
+								fontFamily: MONO,
+								fontSize: '.85rem',
+								lineHeight: 1.6,
+								whiteSpace: 'pre-wrap',
+								overflowWrap: 'anywhere',
+							}}
+						>
+							{show(shellCommand(command, config, false))}
+						</Box>
+					)}
+					<Typography variant="caption" sx={{ display: 'block', mt: 1.5, maxWidth: '90ch' }}>
+						<Trans>The command is written from the channel settings and is not changed here. Copy gives it ready for a terminal.</Trans>{' '}
+						{!$secrets && <Trans>Keys and passwords are hidden in the copy too.</Trans>}{' '}
+						{$readable && sorted && <Trans>For reading, the options of an output are sorted by kind; the copy keeps the order FFmpeg gets.</Trans>}
+					</Typography>
+				</Box>
+
+	);
+}
+
+CommandView.defaultProps = {
+	command: [],
+	config: null,
+	resetKey: '',
+	note: null,
+};
