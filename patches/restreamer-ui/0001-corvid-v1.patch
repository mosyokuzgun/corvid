@@ -0,0 +1,187 @@
+import * as M from './metadata';
+import * as NVENC from '../misc/coders/Encoders/video/nvenc';
+
+const profile = (decoder, encoder, filters) => ({
+	video: {
+		decoder: { coder: decoder },
+		encoder: { coder: encoder },
+		filter: { graph: '', settings: filters },
+	},
+});
+
+test('gpu:zero-copy NVDEC -> CUDA filters -> NVENC has no transfers', () => {
+	const r = M.buildVideoFilterGraph(profile('cuda', 'h264_nvenc', { scale_cuda: { graph: 'scale_cuda=w=1280:h=720' } }));
+	expect(r.graph).toBe('scale_cuda=w=1280:h=720');
+	expect(r.global).toEqual([]);
+});
+
+test('gpu:CPU filter on CUDA frames gets hwdownload', () => {
+	const r = M.buildVideoFilterGraph(profile('cuda', 'h264_nvenc', { scale: { graph: 'scale=1280:720' } }));
+	expect(r.graph).toBe('hwdownload,format=nv12,scale=1280:720,format=yuv420p');
+});
+
+test('gpu:CUDA filter after software decoding gets hwupload and a CUDA device', () => {
+	const r = M.buildVideoFilterGraph(
+		profile('default', 'h264_nvenc', { bwdif: { graph: 'bwdif' }, overlay_cuda: { graph: 'split=2[a][b];[a][b]overlay_cuda' } }),
+	);
+	expect(r.graph).toBe('bwdif,format=nv12,hwupload,split=2[a][b];[a][b]overlay_cuda');
+	expect(r.global).toEqual([
+		['-init_hw_device', 'cuda=gpu:{gpu}'],
+		['-filter_hw_device', 'gpu'],
+	]);
+});
+
+test('gpu:CPU encoder after NVDEC downloads the frames', () => {
+	expect(M.buildVideoFilterGraph(profile('cuda', 'libx264', {})).graph).toBe('hwdownload,format=nv12');
+});
+
+test('nvenc:legacy settings are migrated to p1..p7 + tune', () => {
+	const s = NVENC.init({ preset: 'llhq', rc: 'cbr_ld_hq', bframes: '2' });
+	expect(s.preset).toBe('p5');
+	expect(s.tune).toBe('ll');
+	expect(s.rc).toBe('cbr');
+	expect(s.bframes).toBe('0');
+});
+
+test('nvenc:mapping uses {gpu}, zerolatency and a strict GOP', () => {
+	const m = NVENC.createMapping('h264_nvenc', NVENC.init({ multipass: 'fullres', tune: 'ull' }), {}, {});
+	const a = m.local.join(' ');
+	expect(a).toContain('-codec:v h264_nvenc -gpu {gpu} -preset:v p4 -tune:v ull -multipass fullres');
+	expect(a).toContain('-zerolatency 1 -delay 0');
+	expect(a).toContain('-bf 0 -rc-lookahead 0');
+	expect(a).toContain('-g 50 -keyint_min 50 -forced-idr 1');
+	expect(a).not.toContain('-pix_fmt');
+});
+
+test('backoff: the old 60 s default cap is migrated to 10 s, explicit values stay', () => {
+	const M = require('./metadata');
+	expect(M.initIngestMetadata({ control: { process: { delay: 3, delay_max: 60 } } }).control.process.delay_max).toBe(10);
+	expect(M.initEgressMetadata({ control: { process: { delay: 3, delay_max: '60' } } }).control.process.delay_max).toBe(10);
+	expect(M.initIngestMetadata({ control: { process: { delay: 3, delay_max: 20 } } }).control.process.delay_max).toBe(20);
+	expect(M.initIngestMetadata({}).control.process.delay_max).toBe(10);
+});
+
+test('h264: a width that is not a multiple of 16 gets an explicit crop flag', () => {
+	expect(M.h264CropRight(['-codec:v', 'h264_nvenc'], 1080)).toBe(8);
+	expect(M.h264CropRight(['-codec:v', 'libx264'], 1080)).toBe(8);
+	expect(M.h264CropRight(['-codec:v', 'h264_nvenc'], 1920)).toBe(0);
+	expect(M.h264CropRight(['-codec:v', 'h264_nvenc'], 720)).toBe(0);
+	expect(M.h264CropRight(['-codec:v', 'hevc_nvenc'], 1080)).toBe(0);
+	expect(M.h264CropRight(['-codec:v', 'copy'], 1080)).toBe(0);
+	expect(M.h264CropRight(['-codec:v', 'h264_nvenc'], 0)).toBe(0);
+
+	const sources = [
+		{
+			type: 'network',
+			inputs: [{ address: 'rtmp://x/y', options: [] }],
+			streams: [{ index: 0, stream: 0, type: 'video', codec: 'h264', width: 1920, height: 1080 }],
+		},
+	];
+	const mk = (width) => [
+		{
+			video: {
+				source: 0,
+				stream: 0,
+				decoder: { coder: 'default', mapping: { global: [], local: [], filter: [] } },
+				encoder: { coder: 'libx264', codec: 'h264', mapping: { global: [], local: ['-codec:v', 'libx264'], filter: [] } },
+				filter: { graph: '', settings: { overlay_cuda: { graph: 'null', settings: { mode: 'canvas', width: width, height: 1920 } } } },
+			},
+			audio: { source: -1, stream: -1, encoder: { coder: 'none' } },
+		},
+	];
+	let [, , outputs] = M.createInputsOutputs(sources, mk(1080), true);
+	expect(outputs[0].options.join(' ')).toContain('-bsf:v h264_metadata=crop_right=8');
+	[, , outputs] = M.createInputsOutputs(sources, mk(720), true);
+	expect(outputs[0].options.join(' ')).not.toContain('h264_metadata');
+});
+
+test('inputs: the same address for video and audio is opened once', () => {
+	const net = (address) => ({
+		type: 'network',
+		inputs: [{ address: address, options: ['-probesize', '5000000'] }],
+		streams: [
+			{ index: 0, stream: 0, type: 'video', codec: 'h264', width: 1920, height: 1080 },
+			{ index: 0, stream: 1, type: 'audio', codec: 'aac', sampling_hz: 48000, layout: 'stereo', channels: 2 },
+		],
+	});
+	const mk = () => [
+		{
+			video: {
+				source: 0,
+				stream: 0,
+				decoder: { coder: 'default', mapping: { global: [], local: [], filter: [] } },
+				encoder: { coder: 'libx264', codec: 'h264', mapping: { global: [], local: ['-codec:v', 'libx264'], filter: [] } },
+				filter: { graph: '', settings: {} },
+			},
+			audio: {
+				source: 1,
+				stream: 1,
+				decoder: { coder: 'default', mapping: { global: [], local: [], filter: [] } },
+				encoder: { coder: 'aac', codec: 'aac', mapping: { global: [], local: ['-codec:a', 'aac'], filter: [] } },
+				filter: { graph: '', settings: {} },
+			},
+		},
+	];
+
+	let [, inputs, outputs] = M.createInputsOutputs([net('srt://a:6000?streamid=x'), net('srt://a:6000?streamid=x')], mk(), true);
+	expect(inputs.length).toBe(1);
+	expect(outputs[0].options.join(' ')).toContain('-map 0:0 -codec:v libx264 -map 0:1 -codec:a aac');
+
+	[, inputs, outputs] = M.createInputsOutputs([net('srt://a:6000?streamid=x'), net('rtmp://b/live/y')], mk(), true);
+	expect(inputs.length).toBe(2);
+	expect(outputs[0].options.join(' ')).toContain('-map 0:0 -codec:v libx264 -map 1:1 -codec:a aac');
+});
+
+test('inputs: video encoded on the GPU is decoded there, audio still shares the input', () => {
+	const net = (address, codec = 'h264') => ({
+		type: 'network',
+		inputs: [{ address: address, options: ['-probesize', '5000000'] }],
+		streams: [
+			{ index: 0, stream: 0, type: 'video', codec: codec, width: 1920, height: 1080 },
