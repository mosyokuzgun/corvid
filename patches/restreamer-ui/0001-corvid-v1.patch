+test('connect starts the source first; the fallback follows when the source is on air or stays away', async () => {
+	const r = Object.create(Restreamer.prototype);
+	const id = 'restreamer-ui:ingest:abc';
+	r.GetChannel = () => ({ id });
+	r.GetIngestMetadata = async () => ({ control: {} });
+	const order = { [id]: 'stop', [id + '_hls']: 'stop', [id + '_fallback']: 'stop', [id + '_fallback2']: 'stop' };
+	const started = [];
+	r._hasProcess = async (p) => p in order;
+	r._startProcess = async (p) => {
+		started.push(p.replace(id, 'D'));
+		order[p] = 'start';
+		return true;
+	};
+	r._getProcessState = async (p) => (p in order ? { order: order[p] } : null);
+
+	await r.StartIngest('abc');
+	expect(started).toEqual(['D', 'D_hls']);
+
+	// the source is still connecting: nothing yet
+	expect(await r.EnsureFallbacks('abc', false)).toBe(false);
+	expect(started).toEqual(['D', 'D_hls']);
+	// the source is on air: now the fallback
+	expect(await r.EnsureFallbacks('abc', true)).toBe(true);
+	expect(started).toEqual(['D', 'D_hls', 'D_fallback', 'D_fallback2']);
+	// and only once
+	expect(await r.EnsureFallbacks('abc', true)).toBe(false);
+
+	// a source that does not come up: the fallback starts when the wait is over
+	order[id + '_fallback'] = order[id + '_fallback2'] = 'stop';
+	started.length = 0;
+	await r.StartIngest('abc');
+	const now = Date.now;
+	Date.now = () => now() + 21000;
+	expect(await r.EnsureFallbacks('abc', false)).toBe(true);
+	Date.now = now;
+	expect(started).toEqual(['D', 'D_hls', 'D_fallback', 'D_fallback2']);
+
+	// a page that was opened later knows of no wait and starts them right away
+	const r2 = Object.create(Restreamer.prototype);
+	Object.assign(r2, { GetChannel: r.GetChannel, _getProcessState: r._getProcessState, _startProcess: r._startProcess });
+	order[id + '_fallback2'] = 'stop';
+	started.length = 0;
+	expect(await r2.EnsureFallbacks('abc', false)).toBe(true);
+	expect(started).toEqual(['D_fallback2']);
+});
