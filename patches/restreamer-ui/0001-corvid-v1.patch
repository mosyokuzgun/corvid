new file mode 100644
index 0000000..a0ba2d0
--- /dev/null
+++ b/src/views/Main/Preflight.js
@@ -0,0 +1,243 @@
+import React from 'react';
+
+import { i18n } from '@lingui/core';
+import { Trans } from '@lingui/macro';
+import Box from '@mui/material/Box';
+import Button from '@mui/material/Button';
+import CircularProgress from '@mui/material/CircularProgress';
+import Modal from '@mui/material/Modal';
+import Typography from '@mui/material/Typography';
+
+import ModalContent from '../../misc/ModalContent';
+import Palette from '../../theme/base/palette';
+
+// Check before a broadcast (fork): one click that answers "can we go on air?". It looks at
+// the source, the sound, both fallbacks, the publication targets, the disk, the clock and
+// the encoder. It starts and stops nothing.
+
+const ORDER = ['source', 'audio', 'backup', 'slate', 'targets', 'disk', 'clock', 'gpu'];
+
+const TITLE = {
+	source: <Trans>Source</Trans>,
+	audio: <Trans>Sound</Trans>,
+	backup: <Trans>Backup stream</Trans>,
+	slate: <Trans>Standby image</Trans>,
+	targets: <Trans>Publication targets</Trans>,
+	disk: <Trans>Room for the recording</Trans>,
+	clock: <Trans>Server clock</Trans>,
+	gpu: <Trans>Encoder</Trans>,
+};
+
+const WORD = {
+	ok: <Trans>Fine</Trans>,
+	warn: <Trans>Attention</Trans>,
+	fail: <Trans>Problem</Trans>,
+	skip: <Trans>Not checked</Trans>,
+};
+
+const COLOR = {
+	ok: Palette.tally.live,
+	warn: Palette.tally.standby,
+	fail: Palette.tally.fault,
+	skip: Palette.tally.off,
+};
+
+const gb = (bytes) => i18n.number(bytes / 1024 / 1024 / 1024, { maximumFractionDigits: bytes < 10 * 1024 * 1024 * 1024 ? 1 : 0 });
+
+const detail = (r) => {
+	switch (r.id) {
+		case 'source':
+			if (r.state === 'ok') {
+				return r.live ? (
+					<Trans>On air.</Trans>
+				) : (
+					<Trans>
+						The signal is there: {r.width}×{r.height}, {r.codec}. The channel is not connected yet.
+					</Trans>
+				);
+			}
+			return r.reason === 'nosource' ? <Trans>The channel has no source yet.</Trans> : <Trans>No signal at the source address. Is the encoder sending?</Trans>;
+		case 'audio':
+			if (r.state === 'ok') {
+				if (r.track) {
+					return <Trans>The source has a sound track. Its level is measured once the channel is connected.</Trans>;
+				}
+				const levels = r.rms.filter((v) => v !== null).map((v) => `${Math.round(v)} dB`);
+				return <Trans>Sound is coming: {levels.join(' / ')}.</Trans>;
+			}
+			if (r.reason === 'silent') return <Trans>Silent for {r.seconds} s. Check the microphone and the mixer.</Trans>;
+			if (r.reason === 'notrack') return <Trans>No sound track. Viewers would hear nothing.</Trans>;
+			if (r.reason === 'nowatch') return <Trans>No measurement yet. Try again in a few seconds.</Trans>;
+			return <Trans>Needs a signal at the source first.</Trans>;
+		case 'backup':
+			if (r.state === 'ok') return r.live ? <Trans>Ready.</Trans> : <Trans>The backup signal is there.</Trans>;
+			if (r.reason === 'none') return <Trans>Not set up. If the source is lost, viewers get the standby image right away.</Trans>;
+			return <Trans>No signal at the backup address. Is the second encoder sending?</Trans>;
+		case 'slate':
+			if (r.state === 'ok') return r.live ? <Trans>Ready.</Trans> : <Trans>The image is in place.</Trans>;
+			if (r.reason === 'none') return <Trans>Not set up. If source and backup are lost, the broadcast stops.</Trans>;
+			return <Trans>The image file is missing. Choose it again in the channel settings.</Trans>;
+		case 'targets':
+			if (r.reason === 'none') return <Trans>No publication is set up.</Trans>;
+			if (r.reason === 'unsupported') return <Trans>The server cannot check this yet. Install the current update package.</Trans>;
+			return (
+				<React.Fragment>
+					{r.targets.map((t, i) => (
+						<div key={i}>
+							{t.name || <Trans>Publication</Trans>}:{' '}
+							{t.hosts.length === 0 ? (
+								<Trans>sends to this server.</Trans>
+							) : (
+								t.hosts.map((h, j) => (
+									<span key={j}>
+										{j !== 0 && ', '}
+										{h.target}{' '}
+										{h.ok ? (
+											h.nameOnly ? (
+												<Trans>found</Trans>
+											) : (
+												<Trans>reachable</Trans>
+											)
+										) : h.error === 'name not found' ? (
+											<Trans>not found (DNS)</Trans>
+										) : (
+											<Trans>not reachable (firewall or network)</Trans>
+										)}
+									</span>
+								))
+							)}
+						</div>
+					))}
+					<div>
+						<Trans>The stream key is only tested by a real broadcast.</Trans>
+					</div>
+				</React.Fragment>
+			);
+		case 'disk':
+			if (r.reason === 'norecord') return <Trans>Recording is not set up.</Trans>;
+			if (r.reason === 'unknown') return <Trans>The free space could not be read.</Trans>;
+			return r.hours !== null ? (
+				<Trans>
+					{gb(r.free)} GB free, about {Math.floor(r.hours)} hours at the current bitrate.
+				</Trans>
+			) : (
+				<Trans>{gb(r.free)} GB free.</Trans>
+			);
+		case 'clock':
+			if (r.reason === 'unknown') return <Trans>The server time could not be read.</Trans>;
+			return Math.abs(r.diff) > 60 ? (
+				<Trans>Server and this computer differ by {Math.abs(r.diff)} s. Recordings and events carry the server's time.</Trans>
+			) : (
+				<Trans>Agrees with this computer.</Trans>
+			);
+		case 'gpu':
+			if (r.reason === 'none') return <Trans>No graphics card reported.</Trans>;
+			return r.state === 'ok' ? (
+				<Trans>
+					Encoder load {r.load} %, memory {r.memory} %.
+				</Trans>
+			) : (
+				<Trans>
+					Encoder load {r.load} %, memory {r.memory} %. Little room for more encoded outputs.
+				</Trans>
+			);
+		default:
+			return null;
+	}
+};
+
+export default function Preflight(props) {
+	const [$results, setResults] = React.useState([]);
+	const [$running, setRunning] = React.useState(false);
+	const run = React.useRef(0);
+
+	const start = async () => {
+		const mine = ++run.current;
+		setResults([]);
+		setRunning(true);
+		await props.restreamer.Preflight(props.channelid, (result, all) => {
+			if (mine === run.current) {
+				setResults([...all]);
+			}
+		});
+		if (mine === run.current) {
+			setRunning(false);
+		}
+	};
+
+	React.useEffect(() => {
+		if (props.open) {
+			start();
+		} else {
+			run.current++;
+		}
+		// eslint-disable-next-line react-hooks/exhaustive-deps
+	}, [props.open]);
+
+	const byId = {};
+	for (const r of $results) {
+		byId[r.id] = r;
+	}
+	const fails = $results.filter((r) => r.state === 'fail').length;
+	const warns = $results.filter((r) => r.state === 'warn').length;
+
+	return (
+		<Modal open={props.open} onClose={props.onClose} className="modal">
+			<ModalContent title={<Trans>Check before broadcast</Trans>} onClose={props.onClose} style={{ maxWidth: 720 }}>
+				<Box component="ul" sx={{ listStyle: 'none', m: 0, p: 0 }}>
+					{ORDER.map((id) => {
+						const r = byId[id];
+						return (
+							<Box
+								component="li"
+								key={id}
+								sx={{ display: 'flex', gap: 1.5, py: 1.1, borderTop: `1px solid ${Palette.background.line}`, alignItems: 'flex-start' }}
+							>
+								<Box sx={{ width: 108, flexShrink: 0, display: 'flex', alignItems: 'center', gap: 1, pt: '2px' }}>
+									{r ? (
+										<React.Fragment>
+											<Box component="span" sx={{ width: 10, height: 10, borderRadius: '50%', flexShrink: 0, backgroundColor: COLOR[r.state] }} />
+											<Typography component="span" variant="body1" sx={{ fontWeight: 600, color: r.state === 'fail' ? Palette.error.light : 'inherit' }}>
+												{WORD[r.state]}
+											</Typography>
+										</React.Fragment>
+									) : (
+										<CircularProgress size={14} color="inherit" sx={{ visibility: $running ? 'visible' : 'hidden' }} />
+									)}
+								</Box>
+								<Box sx={{ minWidth: 0, flex: '1 1 auto' }}>
+									<Typography variant="body1" sx={{ fontWeight: 600 }}>
+										{TITLE[id]}
+									</Typography>
+									<Typography variant="body1" component="div" sx={{ color: 'text.secondary', overflowWrap: 'anywhere' }}>
+										{r ? detail(r) : $running ? <Trans>Checking…</Trans> : null}
+									</Typography>
+								</Box>
+							</Box>
+						);
+					})}
+				</Box>
+				<Box
+					role="status"
+					aria-live="polite"
+					sx={{ display: 'flex', flexWrap: 'wrap', alignItems: 'center', gap: 1.5, pt: 1.5, borderTop: `1px solid ${Palette.background.line}` }}
+				>
+					<Typography variant="body1" sx={{ flex: '1 1 240px', fontWeight: 600 }}>
+						{$running ? (
+							<Trans>Checking…</Trans>
+						) : fails !== 0 ? (
+							<Trans>{fails} problem(s) to fix before the broadcast.</Trans>
+						) : warns !== 0 ? (
+							<Trans>Can go on air. {warns} point(s) need attention.</Trans>
+						) : (
+							<Trans>Everything checked is fine.</Trans>
+						)}
+					</Typography>
+					<Button variant="outlined" color="inherit" disabled={$running} onClick={start}>
+						<Trans>Check again</Trans>
+					</Button>
+				</Box>
+			</ModalContent>
+		</Modal>
+	);
+}
