diff --git a/src/views/Edit/RecordEstimate.js b/src/views/Edit/RecordEstimate.js
new file mode 100644
index 0000000..0335f63
--- /dev/null
+++ b/src/views/Edit/RecordEstimate.js
@@ -0,0 +1,91 @@
+import React from 'react';
+
+import { i18n } from '@lingui/core';
+import { Trans } from '@lingui/macro';
+import Box from '@mui/material/Box';
+import Typography from '@mui/material/Typography';
+
+import Palette from '../../theme/base/palette';
+
+// How much room the recording takes (fork): from the current bitrate of the channel, the
+// length and number of parts, and the free space on the server's disk.
+
+const GiB = 1024 * 1024 * 1024;
+const gb = (bytes) => i18n.number(bytes / GiB, { maximumFractionDigits: bytes < 10 * GiB ? 1 : 0 });
+
+export default function RecordEstimate(props) {
+	const [$load, setLoad] = React.useState(null);
+	const r = props.record || {};
+
+	React.useEffect(() => {
+		let cancelled = false;
+		(async () => {
+			const progress = await props.restreamer.GetIngestProgress(props.channelid);
+			const server = await props.restreamer.GetServerLoad();
+			if (!cancelled) {
+				setLoad({ kbit: progress && progress.state === 'connected' ? progress.bitrate || 0 : 0, server });
+			}
+		})();
+		return () => {
+			cancelled = true;
+		};
+		// eslint-disable-next-line react-hooks/exhaustive-deps
+	}, []);
+
+	if (!r.enable || $load === null) {
+		return null;
+	}
+
+	// The live bitrate if the core reports one, otherwise the bitrate the encoder is set to
+	// (a copied stream has none: then only a connected channel gives a number).
+	const setting = (p) => (p && p.encoder && p.encoder.coder !== 'copy' && p.encoder.settings ? parseInt(p.encoder.settings.bitrate) || 0 : 0);
+	const profile = props.profile || {};
+	const configured = setting(profile.video) > 0 ? setting(profile.video) + (setting(profile.audio) || (profile.audio && profile.audio.encoder && profile.audio.encoder.coder !== 'none' ? 128 : 0)) : 0;
+	const live = $load.kbit > 0;
+	const kbit = live ? $load.kbit : configured;
+
+	const free = $load.server && $load.server.diskTotal ? Math.max(0, $load.server.diskTotal - $load.server.diskUsed) : null;
+	const perHour = kbit > 0 ? ((kbit * 1000) / 8) * 3600 : 0;
+	const minutes = parseInt(r.minutes) || 0;
+	const files = parseInt(r.files) || 0;
+	const max = perHour > 0 && minutes > 0 && files > 0 ? (perHour * minutes * files) / 60 : null;
+	const tight = max !== null && free !== null && max > free;
+
+	return (
+		<Box
+			role="note"
+			sx={{
+				mt: 2,
+				p: 1.5,
+				borderRadius: 1,
+				backgroundColor: Palette.background.raised,
+				border: tight ? `1px solid ${Palette.tally.standby}` : 0,
+			}}
+		>
+			<Typography variant="body1">
+				{perHour > 0 && live ? (
+					<Trans>
+						At the current bitrate ({i18n.number(Math.round(kbit))} kbit/s) a recording takes about {gb(perHour)} GB per hour.
+					</Trans>
+				) : perHour > 0 ? (
+					<Trans>
+						At the bitrate the encoder is set to ({i18n.number(Math.round(kbit))} kbit/s) a recording takes about {gb(perHour)} GB per hour.
+					</Trans>
+				) : (
+					<Trans>The size per hour is shown while the channel is connected.</Trans>
+				)}{' '}
+				{max !== null && (
+					<Trans>
+						{files} parts of {minutes} min take {gb(max)} GB at most.
+					</Trans>
+				)}{' '}
+				{free !== null && <Trans>{gb(free)} GB are free on the disk.</Trans>}
+			</Typography>
+			{tight && (
+				<Typography variant="body1" sx={{ color: Palette.tally.standby, mt: 0.5 }}>
+					<Trans>The parts would not fit on the disk: keep fewer parts or fewer days.</Trans>
+				</Typography>
+			)}
+		</Box>
+	);
+}
