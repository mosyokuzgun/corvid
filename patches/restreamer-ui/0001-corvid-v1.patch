index 0000000..82aab5e
--- /dev/null
+++ b/src/utils/secrets.js
@@ -0,0 +1,38 @@
+// Hides keys and passwords in text that is shown on screen: FFmpeg commands, banners and
+// log lines (fork). The text stays readable, only the secret values are replaced.
+
+const MASK = '••••';
+
+const LOCAL = /^(localhost|127\.0\.0\.1|\[::1\])$/i;
+
+// Query and streamid parameters whose value is a secret.
+const PARAMS = ['token', 'passphrase', 'password', 'pass', 'key', 'streamkey', 'stream_key', 'secret', 'auth', 'signature', 'sig'];
+
+const maskSecrets = (text) => {
+	if (typeof text !== 'string' || text.length === 0) {
+		return text;
+	}
+
+	let out = text;
+
+	// user:password@host, also in the escaped form of FFmpeg option strings: http\\://user\\:password@host
+	out = out.replace(/([a-z][a-z0-9+.-]*(?:\\*):\/\/[^\s/:@'"\\]+)(\\*):([^\s/@'"\\]+)@/gi, `$1$2:${MASK}@`);
+
+	// ?token=... &passphrase=... and the SRT streamid forms ",token:..." / "token=..."
+	const names = PARAMS.join('|');
+	out = out.replace(new RegExp(`([?&,;|:{\\\\](?:${names}))([=:])([^\\s&,;|'"}\\]\\\\]+)`, 'gi'), `$1$2${MASK}`);
+
+	// rtmp(s)://remote.host/app/STREAMKEY: at publishing services the last path element is the key.
+	out = out.replace(/(rtmps?:\/\/)([^\s/'"?|\]]+)((?:\/[^\s/'"?|\]]+)*)\/([^\s/'"?|\]]+)/gi, (match, scheme, host, path, last) => {
+		const hostname = host.replace(/^[^@]*@/, '').replace(/:\d+$/, '');
+		if (LOCAL.test(hostname) || path.length === 0) {
+			// Own server ("/name.stream") or no application path: nothing secret in the path.
+			return match;
+		}
+		return `${scheme}${host}${path}/${MASK}`;
+	});
+
+	return out;
+};
+
+export { maskSecrets, MASK };
