new file mode 100644
index 0000000..2b70d5a
--- /dev/null
+++ b/src/views/SettingsUsers.js
@@ -0,0 +1,221 @@
+import React from 'react';
+
+import { Trans, t } from '@lingui/macro';
+import { useLingui } from '@lingui/react';
+import Alert from '@mui/material/Alert';
+import Box from '@mui/material/Box';
+import Button from '@mui/material/Button';
+import MenuItem from '@mui/material/MenuItem';
+import TextField from '@mui/material/TextField';
+import Typography from '@mui/material/Typography';
+
+import Palette from '../theme/base/palette';
+
+// Accounts under System (fork). The account from "Access" is the administrator; more accounts
+// are operators (channels and publications) or viewers (look only). The core keeps them
+// (hashed passwords) and enforces the roles.
+
+const ROLES = ['admin', 'operator', 'viewer'];
+
+function RoleName(props) {
+	switch (props.role) {
+		case 'admin':
+			return <Trans>Administrator</Trans>;
+		case 'operator':
+			return <Trans>Operator</Trans>;
+		default:
+			return <Trans>Viewer</Trans>;
+	}
+}
+
+function RoleSelect(props) {
+	return (
+		<TextField select size="small" label={<Trans>Role</Trans>} value={props.value} onChange={(e) => props.onChange(e.target.value)} sx={{ minWidth: 170 }}>
+			{ROLES.map((r) => (
+				<MenuItem key={r} value={r}>
+					<RoleName role={r} />
+				</MenuItem>
+			))}
+		</TextField>
+	);
+}
+
+function UserRow(props) {
+	const u = props.user;
+	const [$password, setPassword] = React.useState(null);
+	const [$armed, setArmed] = React.useState(false);
+
+	const savePassword = async () => {
+		if (await props.onSet(u.name, u.role, $password)) {
+			setPassword(null);
+		}
+	};
+
+	return (
+		<Box
+			sx={{
+				display: 'flex',
+				flexWrap: 'wrap',
+				alignItems: 'center',
+				gap: 1,
+				py: 1,
+				borderTop: `1px solid ${Palette.background.line}`,
+			}}
+		>
+			<Box sx={{ flex: '1 1 180px', minWidth: 0 }}>
+				<Typography variant="body1" sx={{ fontWeight: 600, overflowWrap: 'anywhere' }}>
+					{u.name}
+				</Typography>
+				{u.builtin && (
+					<Typography variant="caption">
+						<Trans>Set under Access</Trans>
+					</Typography>
+				)}
+			</Box>
+			{u.builtin ? (
+				<Typography variant="body1" sx={{ minWidth: 170 }}>
+					<RoleName role="admin" />
+				</Typography>
+			) : (
+				<RoleSelect value={u.role} onChange={(role) => props.onSet(u.name, role, '')} />
+			)}
+			{!u.builtin && $password === null && (
+				<Button variant="outlined" color="inherit" onClick={() => setPassword('')}>
+					<Trans>New password</Trans>
+				</Button>
+			)}
+			{!u.builtin && $password !== null && (
+				<React.Fragment>
+					<TextField
+						size="small"
+						type="password"
+						autoComplete="new-password"
+						label={<Trans>New password</Trans>}
+						value={$password}
+						onChange={(e) => setPassword(e.target.value)}
+					/>
+					<Button variant="outlined" color="inherit" disabled={$password.length < 8} onClick={savePassword}>
+						<Trans>Save</Trans>
+					</Button>
+					<Button color="inherit" onClick={() => setPassword(null)}>
+						<Trans>Cancel</Trans>
+					</Button>
+				</React.Fragment>
+			)}
+			{!u.builtin &&
+				($armed ? (
+					<Button variant="contained" color="secondary" onClick={() => props.onDelete(u.name)} onBlur={() => setArmed(false)}>
+						<Trans>Really delete</Trans>
+					</Button>
+				) : (
+					<Button color="inherit" onClick={() => setArmed(true)}>
+						<Trans>Delete</Trans>
+					</Button>
+				))}
+		</Box>
+	);
+}
+
+export default function SettingsUsers(props) {
+	const r = props.restreamer;
+	const { i18n } = useLingui();
+	const [$users, setUsers] = React.useState(null);
+	const [$note, setNote] = React.useState(null);
+	const [$new, setNew] = React.useState({ name: '', role: 'viewer', password: '' });
+
+	const load = async () => {
+		setUsers(await r.Users());
+	};
+
+	React.useEffect(() => {
+		load();
+		// eslint-disable-next-line react-hooks/exhaustive-deps
+	}, []);
+
+	const set = async (name, role, password) => {
+		const err = await r.SetUser(name, role, password);
+		if (err) {
+			setNote({ severity: 'error', text: err });
+			return false;
+		}
+		setNote({ severity: 'success', text: i18n._(t`Saved. It applies right away.`) });
+		await load();
+		return true;
+	};
+
+	const remove = async (name) => {
+		const err = await r.DeleteUser(name);
+		setNote(err ? { severity: 'error', text: err } : { severity: 'success', text: i18n._(t`The account was deleted and signed out.`) });
+		await load();
+	};
+
+	const add = async () => {
+		if (await set($new.name.trim(), $new.role, $new.password)) {
+			setNew({ name: '', role: 'viewer', password: '' });
+		}
+	};
+
+	const validName = /^[A-Za-z0-9._@-]{1,64}$/.test($new.name.trim());
+
+	return (
+		<Box
+			component="section"
+			sx={{
+				backgroundColor: Palette.background.paper,
+				border: `1px solid ${Palette.background.line}`,
+				borderRadius: 1.5,
+				p: { xs: 2, md: 2.5 },
+				display: 'flex',
+				flexDirection: 'column',
+				gap: 1.5,
+			}}
+		>
+			<Typography variant="h3" component="h2">
+				<Trans>Users</Trans>
+			</Typography>
+			<Typography variant="body1" sx={{ color: 'text.secondary', maxWidth: '75ch' }}>
+				<Trans>
+					Operators start, stop and edit channels and publications, but cannot change the system settings or accounts. Viewers only look: stream
+					keys and addresses are hidden from them.
+				</Trans>
+			</Typography>
+			{$users === null ? (
+				<Alert severity="warning">
+					<Trans>The accounts could not be loaded. Sign in is probably turned off under Access.</Trans>
+				</Alert>
+			) : (
+				<Box>
+					{$users.map((u) => (
+						<UserRow key={u.name} user={u} onSet={set} onDelete={remove} />
+					))}
+				</Box>
+			)}
+			{$users !== null && (
+				<Box sx={{ display: 'flex', flexWrap: 'wrap', alignItems: 'flex-start', gap: 1, pt: 1, borderTop: `1px solid ${Palette.background.line}` }}>
+					<TextField
+						size="small"
+						label={<Trans>Username</Trans>}
+						value={$new.name}
+						onChange={(e) => setNew({ ...$new, name: e.target.value })}
+						error={$new.name.length !== 0 && !validName}
+						helperText={$new.name.length !== 0 && !validName ? <Trans>Letters, digits and . _ @ - only</Trans> : ' '}
+					/>
+					<RoleSelect value={$new.role} onChange={(role) => setNew({ ...$new, role })} />
+					<TextField
+						size="small"
+						type="password"
+						autoComplete="new-password"
+						label={<Trans>Password, at least 8 characters</Trans>}
+						value={$new.password}
+						onChange={(e) => setNew({ ...$new, password: e.target.value })}
+						sx={{ minWidth: 260 }}
+					/>
+					<Button variant="outlined" color="inherit" disabled={!validName || $new.password.length < 8} onClick={add} sx={{ height: 40 }}>
+						<Trans>Add account</Trans>
+					</Button>
+				</Box>
+			)}
+			{$note && <Alert severity={$note.severity}>{$note.text}</Alert>}
+		</Box>
+	);
+}
