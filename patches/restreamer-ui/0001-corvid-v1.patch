+			video: {
+				source: 0,
+				stream: 0,
+				decoder: decoder,
+				encoder: { coder: enc, codec: 'h264', mapping: { global: [], local: ['-codec:v', enc], filter: [] } },
+				filter: { graph: '', settings: {} },
+			},
+			audio: {
+				source: 1,
+				stream: 1,
+				decoder: { coder: 'default', mapping: { global: [], local: [], filter: [] } },
+				encoder: { coder: 'aac', codec: 'aac', mapping: { global: [], local: ['-codec:a', 'aac'], filter: [] } },
+				filter: { graph: '', settings: {} },
+			},
