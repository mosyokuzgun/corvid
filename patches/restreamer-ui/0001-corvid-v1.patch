+	input: [{ id: 'in', address: '/tmp/a.flv', options: ['-re', '-stream_loop', '-1'] }],
+	output: [{ options: ['-c', 'copy', '-f', 'flv'], id: 'out', address: '{rtmp,name=hx.stream}', cleanup: [] }],
+	autostart: true,
+	reconnect: true,
+	reconnect_delay_seconds: 2,
+};
+
+test('the stored config with the core defaults equals what the UI sends', () => {
+	expect(sameProcessConfig(stored, wanted)).toBe(true);
+});
+
+test('any real change counts', () => {
+	expect(sameProcessConfig(stored, { ...wanted, options: ['-loglevel', 'info'] })).toBe(false);
+	expect(sameProcessConfig(stored, { ...wanted, autostart: false })).toBe(false);
+	expect(sameProcessConfig(stored, { ...wanted, limits: { cpu_usage: 50 } })).toBe(false);
+	const out = [{ ...wanted.output[0], options: ['-c', 'copy', '-f', 'flv', '-metadata', 'title=x'] }];
+	expect(sameProcessConfig(stored, { ...wanted, output: out })).toBe(false);
+	expect(sameProcessConfig(stored, { ...wanted, input: [] })).toBe(false);
+});
+
+test('nothing stored means update', () => {
+	expect(sameProcessConfig(null, wanted)).toBe(false);
+	expect(sameProcessConfig(stored, null)).toBe(false);
+});
