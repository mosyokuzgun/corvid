+							<Box>
+								<Typography variant="h4" sx={{ mb: 0.5 }}>
+									<Trans>Source</Trans>
+								</Typography>
+								<Typography variant="body1" sx={{ color: 'text.secondary', mb: 1.5 }}>
+									<Trans>Select RTMP or SRT (if enabled) for less latency.</Trans>
+								</Typography>
+								<SourceControl settings={s.control.source} sources={props.localSources} onChange={props.onControl('source')} />
+							</Box>
+							<Box sx={{ pt: 2, borderTop: `1px solid ${Palette.background.line}` }}>
+								<Typography variant="h4" sx={{ mb: 1.5 }}>
+									<Trans>Process</Trans>
+								</Typography>
