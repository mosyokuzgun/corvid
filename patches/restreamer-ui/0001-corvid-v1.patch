+// A publication on one page (fork), for adding and for editing: target and key first, then
+// picture and sound, then when it starts. Source, reconnecting and limits stay under a closed
+// "Advanced". A summary says in plain words what saving will do, and "Preview command" shows
+// the FFmpeg command before anything is saved. The fields are the same controls as before;
+// only their arrangement changed, so the command a publication gets is the same.
+
+const card = { backgroundColor: Palette.background.paper, border: `1px solid ${Palette.background.line}`, borderRadius: 1.5, p: { xs: 2, md: 2.5 } };
+
+function Section(props) {
+	return (
+		<Box component="section" aria-label={props.label} sx={{ ...card, display: 'flex', flexDirection: 'column', gap: 2 }}>
+			{props.title && (
+				<Box>
+					<Typography variant="h3" component="h2">
+						{props.title}
+					</Typography>
+					{props.text && (
+						<Typography variant="body1" sx={{ color: 'text.secondary', mt: 0.5, maxWidth: '75ch' }}>
+							{props.text}
+						</Typography>
+					)}
+				</Box>
+			)}
+			{props.children}
+		</Box>
+	);
+}
+
+const coderOf = (profile) => (profile && profile.encoder ? profile.encoder.coder : '');
+
+// What saving will do, in plain words.
+function Summary(props) {
+	const s = props.settings;
+	const video = coderOf(s.profiles[0].video);
+	const audio = coderOf(s.profiles[0].audio);
+	const p = s.control.process || {};
+	const nvenc = /nvenc/.test(video);
+	const items = [];
+
+	if (video === 'copy' && (audio === 'copy' || audio === 'none' || audio === '')) {
+		items.push(<Trans key="copy">The programme goes out as it is, without encoding: no load on the graphics card.</Trans>);
+	} else if (video === 'copy') {
+		items.push(<Trans key="audio">The picture goes out as it is; only the sound is encoded ({audio}).</Trans>);
+	} else if (nvenc) {
+		items.push(<Trans key="nvenc">The picture is encoded with NVENC on the graphics card ({video}). Every encoded publication takes one more encoder session.</Trans>);
+	} else if (video === 'none') {
+		items.push(<Trans key="novideo">No picture is sent, only sound.</Trans>);
+	} else if (video) {
+		items.push(<Trans key="cpu">The picture is encoded by the processor ({video}). That loads the server; NVENC or "copy" are lighter.</Trans>);
+	}
+
+	items.push(
+		p.autostart ? (
+			<Trans key="auto">It starts by itself when the channel is connected.</Trans>
+		) : (
+			<Trans key="manual">It does not start by itself: use its switch on the main screen.</Trans>
+		),
+	);
+	if (p.reconnect) {
+		items.push(<Trans key="re">If the connection breaks, it tries again after {p.delay} s.</Trans>);
+	} else {
+		items.push(<Trans key="nore">If the connection breaks, it stays off until it is started again.</Trans>);
+	}
+	items.push(<Trans key="fb">If the source is lost, the fallback goes out instead; the publication keeps running.</Trans>);
+	if (props.mode === 'edit' && props.unsaved && props.running) {
+		items.push(<Trans key="restart">It is on air: saving restarts it, which interrupts it for a few seconds.</Trans>);
+	}
+
+	return (
+		<Box component="aside" aria-label={props.label} sx={{ ...card, flex: '1 1 300px', minWidth: 0, position: { md: 'sticky' }, top: { md: 16 } }}>
+			<Typography variant="h3" component="h2" sx={{ mb: 1.5 }}>
+				<Trans>What saving will do</Trans>
+			</Typography>
+			<Box component="ul" sx={{ m: 0, pl: 2.5, display: 'flex', flexDirection: 'column', gap: 1.25 }}>
+				{items.map((x, i) => (
+					<Typography component="li" variant="body1" key={i}>
+						{x}
+					</Typography>
+				))}
+			</Box>
+			<Typography variant="caption" sx={{ display: 'block', mt: 2, pt: 1.5, borderTop: `1px solid ${Palette.background.line}` }}>
+				<Trans>This summary follows the choices on the left.</Trans>
+			</Typography>
+		</Box>
+	);
+}
+
+export default function Form(props) {
+	const s = props.settings;
+	const ServiceControl = props.service.component;
+	const [$preview, setPreview] = React.useState(null);
+	const [$advanced, setAdvanced] = React.useState(false);
+
+	const preview = async () => {
+		setPreview({ loading: true });
+		const res = await props.onPreview();
+		setPreview(res === null ? { error: true } : res);
+	};
+
+	const autostart = s.control.process && s.control.process.autostart === true;
+	const setAutostart = (value) => props.onControl('process')({ ...s.control.process, autostart: value }, false);
+
+	return (
+		<Box sx={{ width: '100%', maxWidth: 1200, mx: 'auto', pb: 4 }}>
+			<Button size="small" color="inherit" startIcon={<ArrowBackIcon />} onClick={props.onAbort}>
+				<Trans>Main screen</Trans>
+			</Button>
+			<Box sx={{ mb: 2 }}>
+				<Typography variant="h1">{props.title}</Typography>
+				<Typography variant="body1" sx={{ color: 'text.secondary', mt: 0.5, maxWidth: '75ch' }}>
+					{props.service.description}
+				</Typography>
+			</Box>
+
+			<Box sx={{ display: 'flex', flexWrap: 'wrap', gap: 2, alignItems: 'flex-start' }}>
+				<Box sx={{ flex: '999 1 560px', minWidth: 0, display: 'flex', flexDirection: 'column', gap: 2 }}>
+					<Section label={props.service.name} title={props.service.name}>
+						<Box>
+							<TextField variant="outlined" fullWidth label={<Trans>Name</Trans>} value={s.name} onChange={props.onName} />
+							<Typography variant="caption" sx={{ display: 'block', mt: 0.5 }}>
+								<Trans>The publication is shown with this name on the main screen.</Trans>
+							</Typography>
+						</Box>
+						<ServiceControl settings={s.settings} skills={props.serviceSkills} metadata={props.metadata} streams={s.streams} onChange={props.onServiceChange} />
+					</Section>
+
+					<Section
+						label="encoding"
+						title={<Trans>Picture and sound</Trans>}
+						text={<Trans>"Passthrough (copy)" sends the channel as it is and needs no encoder. Encode only if the target asks for another size or format.</Trans>}
+					>
+						<Box>
+							<Typography variant="h4" sx={{ mb: 1 }}>
+								<Trans>Picture</Trans>
+							</Typography>
+							<EncodingSelect
+								type="video"
+								streams={props.sources[0].streams}
+								profile={s.profiles[0].video}
+								codecs={props.serviceSkills.codecs.video}
+								skills={props.skills}
+								onChange={props.onEncoding('video')}
+							/>
+							{coderOf(s.profiles[0].video) !== 'copy' && (
+								<Box sx={{ mt: 2 }}>
+									<FilterSelect type="video" profile={s.profiles[0].video} availableFilters={props.skills.filter} onChange={props.onFilter('video')} />
+								</Box>
+							)}
+						</Box>
+						<Box sx={{ pt: 2, borderTop: `1px solid ${Palette.background.line}` }}>
+							<Typography variant="h4" sx={{ mb: 1 }}>
+								<Trans>Sound</Trans>
+							</Typography>
+							<EncodingSelect
+								type="audio"
+								streams={props.sources[0].streams}
+								profile={s.profiles[0].audio}
+								codecs={props.serviceSkills.codecs.audio}
+								skills={props.skills}
+								onChange={props.onEncoding('audio')}
+							/>
+							{coderOf(s.profiles[0].audio) !== 'copy' && (
+								<Box sx={{ mt: 2 }}>
+									<FilterSelect type="audio" profile={s.profiles[0].audio} availableFilters={props.skills.filter} onChange={props.onFilter('audio')} />
+								</Box>
+							)}
+						</Box>
+					</Section>
+
+					<Section label="start" title={<Trans>When should it start?</Trans>}>
+						<RadioGroup value={autostart ? 'auto' : 'manual'} onChange={(e) => setAutostart(e.target.value === 'auto')}>
+							<FormControlLabel value="auto" control={<Radio />} label={<Trans>By itself when the channel is connected</Trans>} />
+							<FormControlLabel value="manual" control={<Radio />} label={<Trans>I start it from the main screen</Trans>} />
+						</RadioGroup>
+						{props.extra}
