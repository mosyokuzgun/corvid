diff --git a/src/views/SettingsFile.js b/src/views/SettingsFile.js
new file mode 100644
index 0000000..a95f871
--- /dev/null
+++ b/src/views/SettingsFile.js
@@ -0,0 +1,217 @@
+import React from 'react';
+
+import { Trans } from '@lingui/macro';
+import Alert from '@mui/material/Alert';
+import Box from '@mui/material/Box';
+import Button from '@mui/material/Button';
+import TextField from '@mui/material/TextField';
+import Typography from '@mui/material/Typography';
+import DownloadIcon from '@mui/icons-material/Download';
+import UploadIcon from '@mui/icons-material/Upload';
+
+import Palette from '../theme/base/palette';
+
+// The configuration file under System (fork): the same export and import as under
+// "Status and tools" > Backup and copy. Before an import the current state is exported first,
+// so there is always a way back. With a password the file is encrypted (AES-256-GCM, key from
+// the password with Argon2id, on the server): without the password it shows nothing.
+
+const save = (data, name) => {
+	const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
+	const a = document.createElement('a');
+	a.href = URL.createObjectURL(blob);
+	a.download = name;
+	a.click();
+	URL.revokeObjectURL(a.href);
+};
+
+const day = () => new Date().toISOString().slice(0, 19).replace(/[:T]/g, '-');
+
+// Export and import buttons with the password fields; also used on the status page.
+export function ConfigFileControls(props) {
+	const r = props.restreamer;
+	const [$note, setNote] = React.useState(null);
+	const [$password, setPassword] = React.useState('');
+	const [$repeat, setRepeat] = React.useState('');
+
+	const tooShort = $password.length !== 0 && $password.length < 8;
+	const mismatch = $password.length !== 0 && $repeat.length !== 0 && $password !== $repeat;
+	const canExport = $password.length === 0 || ($password.length >= 8 && $password === $repeat);
+
+	// The current state, encrypted when a password is set.
+	const exportData = async () => {
+		const data = await r.ExportConfig();
+		if ($password.length === 0) {
+			return [data, ''];
+		}
+		return [await r.SealConfig(data, $password), '.sifreli'];
+	};
+
+	const exportFile = async () => {
+		try {
+			const [data, suffix] = await exportData();
+			save(data, `${props.prefix}-${day()}${suffix}.json`);
+			setNote(null);
+		} catch (e) {
+			setNote({ severity: 'error', text: e.message });
+		}
+	};
+
+	const importFile = async (event) => {
+		const file = event.target.files[0];
+		event.target.value = '';
+		if (!file) {
+			return;
+		}
+		let data = null;
+		try {
+			data = JSON.parse(await file.text());
+		} catch (e) {
+			setNote({ severity: 'error', text: <Trans>The file is not a configuration file of this application.</Trans> });
+			return;
+		}
+		if (r.IsSealedConfig(data)) {
+			if ($password.length === 0) {
+				setNote({ severity: 'warning', text: <Trans>This file is encrypted. Enter its password above and import it again.</Trans> });
+				return;
+			}
+			try {
+				data = await r.OpenConfig(data, $password);
+			} catch (e) {
+				setNote({ severity: 'error', text: <Trans>The password is wrong or the file is damaged.</Trans> });
+				return;
+			}
+		}
+		// the way back first
+		try {
+			const [before, suffix] = await exportData();
+			save(before, `${props.prefix}-ice-aktarmadan-once-${day()}${suffix}.json`);
+		} catch (e) {
+			setNote({ severity: 'error', text: e.message });
+			return;
+		}
+		try {
+			const res = await r.ImportConfig(data);
+			setNote({
+				severity: res.failed ? 'warning' : 'success',
+				text: (
+					<Trans>
+						Imported: {res.added} added, {res.skipped} already there, {res.failed} failed. Added channels are stopped; reload the page to see them.
+						The state before the import was downloaded first.
+					</Trans>
+				),
+			});
+		} catch (e) {
+			setNote({ severity: 'error', text: <Trans>The file is not a configuration file of this application.</Trans> });
+		}
+	};
+
+	return (
+		<Box sx={{ display: 'flex', flexDirection: 'column', gap: 1.5 }}>
+			<Box sx={{ display: 'flex', flexWrap: 'wrap', gap: 1, alignItems: 'flex-start' }}>
+				<TextField
+					size="small"
+					type="password"
+					autoComplete="new-password"
+					label={<Trans>Password (optional)</Trans>}
+					value={$password}
+					onChange={(e) => setPassword(e.target.value)}
+					error={tooShort}
+					helperText={tooShort ? <Trans>At least 8 characters</Trans> : ' '}
+				/>
+				<TextField
+					size="small"
+					type="password"
+					autoComplete="new-password"
+					label={<Trans>Repeat for the export</Trans>}
+					value={$repeat}
+					disabled={$password.length === 0}
+					onChange={(e) => setRepeat(e.target.value)}
+					error={mismatch}
+					helperText={mismatch ? <Trans>The passwords differ</Trans> : ' '}
+				/>
+			</Box>
+			<Box sx={{ display: 'flex', flexWrap: 'wrap', gap: 1 }}>
+				<Button variant="outlined" color="inherit" startIcon={<DownloadIcon />} onClick={exportFile} disabled={!canExport}>
+					{$password.length === 0 ? <Trans>Export</Trans> : <Trans>Export encrypted</Trans>}
+				</Button>
+				<Button variant="outlined" color="inherit" startIcon={<UploadIcon />} component="label">
+					<Trans>Import</Trans>
+					<input type="file" hidden accept="application/json,.json" onChange={importFile} />
+				</Button>
+			</Box>
+			<Typography variant="caption">
+				<Trans>
+					With a password the file is encrypted and useless without it; there is no way to recover a forgotten password. An encrypted file
+					is imported with its password in the first field. Before an import, the current state is downloaded first, so you can go back.
+				</Trans>
+			</Typography>
+			{$note && <Alert severity={$note.severity}>{$note.text}</Alert>}
+		</Box>
+	);
+}
+
+ConfigFileControls.defaultProps = {
+	prefix: 'ayarlar',
+};
+
+// Downloads the diagnostics file (see utils/diagnostics.js).
+export function DiagnosticsButton(props) {
+	const r = props.restreamer;
+	const [$busy, setBusy] = React.useState(false);
+
+	const download = async () => {
+		setBusy(true);
+		try {
+			save(await r.Diagnostics(), `tanilama-${day()}.json`);
+		} finally {
+			setBusy(false);
+		}
+	};
+
+	return (
+		<Button variant="outlined" color="inherit" startIcon={<DownloadIcon />} onClick={download} disabled={$busy}>
+			{$busy ? <Trans>Collecting…</Trans> : <Trans>Download diagnostics</Trans>}
+		</Button>
+	);
+}
+
+const sectionSx = {
+	backgroundColor: Palette.background.paper,
+	border: `1px solid ${Palette.background.line}`,
+	borderRadius: 1.5,
+	p: { xs: 2, md: 2.5 },
+	display: 'flex',
+	flexDirection: 'column',
+	gap: 1.5,
+};
+
+export default function SettingsFile(props) {
+	return (
+		<Box sx={{ display: 'flex', flexDirection: 'column', gap: 2 }}>
+			<Box component="section" sx={sectionSx}>
+				<Typography variant="h3" component="h2">
+					<Trans>Configuration file</Trans>
+				</Typography>
+				<Typography variant="body1" sx={{ color: 'text.secondary', maxWidth: '75ch' }}>
+					<Trans>Channels, publications, keys and panel settings in one file. It holds the stream keys: keep it safe.</Trans>
+				</Typography>
+				<ConfigFileControls restreamer={props.restreamer} />
+			</Box>
+			<Box component="section" sx={sectionSx}>
+				<Typography variant="h3" component="h2">
+					<Trans>Diagnostics</Trans>
+				</Typography>
+				<Typography variant="body1" sx={{ color: 'text.secondary', maxWidth: '75ch' }}>
+					<Trans>
+						One file with the versions, settings, channel states and reports, the core log, GPU, RTMP and SRT state and the open
+						connections, for whoever helps with a problem. Passwords, keys and stream keys are removed from it.
+					</Trans>
+				</Typography>
+				<Box>
+					<DiagnosticsButton restreamer={props.restreamer} />
+				</Box>
+			</Box>
+		</Box>
+	);
+}
