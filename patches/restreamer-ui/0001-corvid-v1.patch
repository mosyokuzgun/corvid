+import * as L from './CanvasLayers';
+
+// A recording stand-in for the 2D context: every character is 10 px wide.
+const fake = () => {
+	const calls = [];
+	return {
+		calls,
+		measureText: (t) => ({ width: t.length * 10 }),
+		fillText: (...a) => calls.push(['fillText', ...a]),
+		drawImage: (...a) => calls.push(['drawImage', ...a]),
+		fillRect: (...a) => calls.push(['fillRect', ...a]),
+		clearRect: () => {},
+		save: () => {},
+		restore: () => {},
+	};
+};
+
+test('layers: text wraps inside its box and keeps explicit line breaks', () => {
+	const ctx = fake();
+	expect(L.wrapLines(ctx, 'SPOR HABER BULTENI GECE', 200)).toEqual(['SPOR HABER BULTENI', 'GECE']);
+	expect(L.wrapLines(ctx, 'A\nB', 200)).toEqual(['A', 'B']);
+	expect(L.wrapLines(ctx, 'SUPERCALIFRAGILISTIC', 50)).toEqual(['SUPERCALIFRAGILISTIC']);
+});
+
+test('layers: behind the video they go into the background, otherwise on top', () => {
+	const text = L.initLayer({ type: 'text', text: 'x' });
+	expect(L.layerTarget({ bg: 'image', image: '/a.png' }, text)).toBe('bg');
+	expect(L.layerTarget({ bg: 'color' }, text)).toBe('bg');
+	expect(L.layerTarget({ bg: 'color' }, { ...text, above: true })).toBe('top');
+	// no still background to draw into
+	expect(L.layerTarget({ bg: 'blur' }, text)).toBe('top');
+	expect(L.layerTarget({ bg: 'image', image: '' }, text)).toBe('top');
+});
+
+test('layers: the key changes with everything the pictures depend on', () => {
+	const s = { width: '1080', height: '1920', bg: 'color', color: '#000000', layers: [{ type: 'text', text: 'A' }] };
+	const k = L.layersKey(s);
+	expect(L.layersKey({ ...s })).toBe(k);
+	expect(L.layersKey({ ...s, color: '#ffffff' })).not.toBe(k);
+	expect(L.layersKey({ ...s, width: '720' })).not.toBe(k);
+	expect(L.layersKey({ ...s, layers: [{ type: 'text', text: 'B' }] })).not.toBe(k);
+	// the video box is not part of the pictures
+	expect(L.layersKey({ ...s, x: '10', vw: '500' })).toBe(k);
+	// empty layers do not count
+	expect(
+		L.layersKey({
+			...s,
+			layers: [
+				{ type: 'text', text: '  ' },
+				{ type: 'image', image: '' },
+			],
+		}),
+	).toBe('');
+	expect(L.hasLayers({ layers: [{ type: 'text', text: ' ' }] })).toBe(false);
+});
+
+test('layers: drawing places text lines and scales images by their aspect', () => {
+	const ctx = fake();
+	const img = { width: 400, height: 200 };
+	L.drawLayer(ctx, { type: 'text', text: 'AB CD', x: '100', y: '50', w: '30', size: '20', align: 'left' }, {});
+	expect(ctx.calls).toEqual([
+		['fillText', 'AB', 100, 50 + 0.5 * 24],
+		['fillText', 'CD', 100, 50 + 1.5 * 24],
+	]);
+	ctx.calls.length = 0;
+	L.drawLayer(ctx, { type: 'image', image: '/logo.png', x: '10', y: '20', w: '100' }, { '/logo.png': img });
+	expect(ctx.calls).toEqual([['drawImage', img, 10, 20, 100, 50]]);
+	expect(L.layerBox(ctx, { type: 'image', image: '/logo.png', x: '10', y: '20', w: '100' }, { '/logo.png': img })).toEqual({ x: 10, y: 20, w: 100, h: 50 });
+});
+
+test('layers: compose draws the two pictures only where they are needed', async () => {
+	const made = [];
+	const createCanvas = (w, h) => {
+		const ctx = fake();
+		const c = { width: w, height: h, getContext: () => ctx, ctx, toBlob: (cb) => cb({ arrayBuffer: async () => new ArrayBuffer(made.length) }) };
