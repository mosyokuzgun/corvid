diff --git a/src/views/Main/Server.js b/src/views/Main/Server.js
new file mode 100644
index 0000000..b5b6bd3
--- /dev/null
+++ b/src/views/Main/Server.js
@@ -0,0 +1,198 @@
+import React from 'react';
+
+import { i18n } from '@lingui/core';
+import { Trans, t } from '@lingui/macro';
+import Box from '@mui/material/Box';
+import Typography from '@mui/material/Typography';
+
+import useInterval from '../../hooks/useInterval';
+import Paper from '../../misc/Paper';
+import PaperHeader from '../../misc/PaperHeader';
+import Palette from '../../theme/base/palette';
+
+// Server card (fork): the load of the machine in one place - processor, memory, network,
+// disk and the graphics cards - each with the last two minutes as a small graph. The lines
+// are neutral; they turn amber above 80 % and red above 90 %, so colour means "look here".
+
+const HISTORY = 60;
+const GiB = 1024 * 1024 * 1024;
+const NEUTRAL = '#B4B7BB';
+
+const tone = (pct) => (pct > 90 ? Palette.tally.fault : pct > 80 ? Palette.tally.standby : NEUTRAL);
+
+// The history as a filled graph, the current value at the right.
+function Meter(props) {
+	const color = props.plain ? NEUTRAL : tone(Math.max(0, Math.min(100, props.percent || 0)));
+	const values = props.history.length ? props.history : [0];
+	const n = Math.max(HISTORY - 1, 1);
+	const offset = HISTORY - values.length;
+	const pts = values.map((v, i) => `${((i + offset) / n) * 100},${24 - (Math.max(0, Math.min(100, v)) / 100) * 22}`);
+	const area = `${(offset / n) * 100},24 ${pts.join(' ')} 100,24`;
+
+	return (
+		<Box sx={{ display: 'flex', alignItems: 'center', gap: 1.25, py: 0.4 }}>
+			<Box sx={{ width: 74, flexShrink: 0, fontSize: '.85rem', color: 'text.secondary' }}>{props.label}</Box>
+			<Box sx={{ flex: '1 1 auto', minWidth: 0, height: 24, borderRadius: 0.5, backgroundColor: Palette.background.raised, overflow: 'hidden' }}>
+				<svg width="100%" height="24" viewBox="0 0 100 24" preserveAspectRatio="none" role="img" aria-label={`${props.name || ''} ${props.text}`}>
+					<polygon points={area} fill={color} fillOpacity="0.25" />
+					<polyline points={pts.join(' ')} fill="none" stroke={color} strokeWidth="1.5" vectorEffect="non-scaling-stroke" />
+				</svg>
+			</Box>
+			<Box className="tabular" sx={{ width: 96, flexShrink: 0, textAlign: 'right', fontWeight: 600, fontSize: '.95rem', whiteSpace: 'nowrap' }}>
+				{props.text}
+			</Box>
+		</Box>
+	);
+}
+
+// A level without history: how full something is.
+function Fill(props) {
+	const pct = Math.max(0, Math.min(100, props.percent || 0));
+	return (
+		<Box sx={{ display: 'flex', alignItems: 'center', gap: 1.25, py: 0.4 }}>
+			<Box sx={{ width: 74, flexShrink: 0, fontSize: '.85rem', color: 'text.secondary' }}>{props.label}</Box>
+			<Box sx={{ flex: '1 1 auto', minWidth: 0, height: 10, borderRadius: 5, backgroundColor: Palette.background.raised, overflow: 'hidden' }} aria-hidden="true">
+				<Box sx={{ width: `${pct}%`, height: '100%', backgroundColor: tone(pct) }} />
+			</Box>
+			<Box className="tabular" sx={{ width: 96, flexShrink: 0, textAlign: 'right', fontWeight: 600, fontSize: '.95rem', whiteSpace: 'nowrap' }}>
+				{props.text}
+			</Box>
+		</Box>
+	);
+}
+
+const num = (v, digits = 0) => i18n.number(v, { minimumFractionDigits: digits, maximumFractionDigits: digits });
+const pctText = (v) => i18n.number(Math.round(v) / 100, { style: 'percent', maximumFractionDigits: 0 });
+const rate = (bits) => (bits >= 1e6 ? `${num(bits / 1e6, bits >= 1e7 ? 0 : 1)} Mbit/s` : `${num(bits / 1e3)} kbit/s`);
+
+export default function Server(props) {
+	const [$load, setLoad] = React.useState(null);
+	const [$gpus, setGPUs] = React.useState([]);
+	const history = React.useRef({ cpu: [], mem: [], tx: [], rx: [], gpu: {} });
+	const counters = React.useRef(null);
+
+	const update = async () => {
+		const h = history.current;
+		const push = (list, v) => [...list, v].slice(-HISTORY);
+
+		const load = await props.restreamer.GetServerLoad();
+		if (load !== null) {
+			const now = Date.now();
+			let tx = null;
+			let rx = null;
+			const prev = counters.current;
+			if (prev && load.tx !== null && load.rx !== null && now > prev.time) {
+				const seconds = (now - prev.time) / 1000;
+				// a counter that went backwards was reset (restart); skip that sample
+				if (load.tx >= prev.tx && load.rx >= prev.rx) {
+					tx = ((load.tx - prev.tx) * 8) / seconds;
+					rx = ((load.rx - prev.rx) * 8) / seconds;
+				}
+			}
+			if (load.tx !== null && load.rx !== null) {
+				counters.current = { time: now, tx: load.tx, rx: load.rx };
+			}
+			if (load.cpu !== null) h.cpu = push(h.cpu, load.cpu);
+			if (load.memTotal) h.mem = push(h.mem, (load.memUsed / load.memTotal) * 100);
+			if (tx !== null) {
+				h.tx = push(h.tx, tx);
+				h.rx = push(h.rx, rx);
+			}
+			setLoad({ ...load, txRate: tx, rxRate: rx });
+		}
+
+		const list = await props.restreamer.ListGPUs();
+		for (let c of list) {
+			const d = c.device;
+			const g = h.gpu[d.uuid] || { enc: [], dec: [] };
+			g.enc = push(g.enc, d.util_encoder_percent);
+			g.dec = push(g.dec, d.util_decoder_percent);
+			h.gpu[d.uuid] = g;
+		}
+		setGPUs(list);
+	};
+
+	useInterval(update, 2000);
+
+	React.useEffect(() => {
+		update();
+		// eslint-disable-next-line react-hooks/exhaustive-deps
+	}, []);
+
+	if ($load === null && $gpus.length === 0) {
+		return null;
+	}
+
+	const h = history.current;
+	// The network graphs have no fixed top: they are drawn against their own two-minute peak.
+	const scaled = (list) => {
+		const top = Math.max(1e6, ...list);
+		return list.map((v) => (v / top) * 100);
+	};
+	const l = $load;
+	const diskFree = l && l.diskTotal ? Math.max(0, l.diskTotal - l.diskUsed) : null;
+
+	return (
+		<Paper style={{ marginTop: '1em' }}>
+			<PaperHeader title={<Trans>Server</Trans>} />
+			{l !== null && (
+				<Box>
+					{l.cpu !== null && (
+						<Meter label={<Trans>Processor</Trans>} name={i18n._(t`Processor`)} percent={l.cpu} history={h.cpu} text={pctText(l.cpu)} />
+					)}
+					{l.memTotal > 0 && (
+						<Meter
+							label={<Trans>Memory</Trans>}
+							name={i18n._(t`Memory`)}
+							percent={(l.memUsed / l.memTotal) * 100}
+							history={h.mem}
+							text={`${num(l.memUsed / GiB, 1)} / ${num(l.memTotal / GiB, l.memTotal / GiB >= 10 ? 0 : 1)} GB`}
+						/>
+					)}
+					{h.tx.length !== 0 && (
+						<React.Fragment>
+							<Meter plain label={<Trans>Net out</Trans>} name={i18n._(t`Net out`)} history={scaled(h.tx)} text={rate(h.tx[h.tx.length - 1])} />
+							<Meter plain label={<Trans>Net in</Trans>} name={i18n._(t`Net in`)} history={scaled(h.rx)} text={rate(h.rx[h.rx.length - 1])} />
+						</React.Fragment>
+					)}
+					{diskFree !== null && (
+						<Fill label={<Trans>Disk</Trans>} percent={(l.diskUsed / l.diskTotal) * 100} text={<Trans>{num(diskFree / GiB, diskFree < 10 * GiB ? 1 : 0)} GB free</Trans>} />
+					)}
+				</Box>
+			)}
+			{$gpus.map((c) => {
+				const d = c.device;
+				const g = h.gpu[d.uuid] || { enc: [], dec: [] };
+				const mem = d.memory_total_bytes ? (d.memory_used_bytes / d.memory_total_bytes) * 100 : 0;
+				const hot = d.temperature_celsius >= 83;
+				return (
+					<Box key={d.uuid} sx={{ mt: 1.25, pt: 1.25, borderTop: `1px solid ${Palette.background.line}` }}>
+						<Box sx={{ display: 'flex', alignItems: 'baseline', justifyContent: 'space-between', gap: 1, mb: 0.5 }}>
+							<Typography variant="subtitle2" sx={{ minWidth: 0, overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>
+								{$gpus.length > 1 ? `GPU ${d.index}: ` : ''}
+								{d.name.replace(/^NVIDIA /, '')}
+							</Typography>
+							<Box className="tabular" sx={{ flexShrink: 0, fontWeight: 600, color: hot ? Palette.error.light : 'text.primary' }}>
+								{Math.round(d.temperature_celsius)} °C
+								{d.power_watts > 0 && (
+									<Box component="span" sx={{ color: 'text.secondary', fontWeight: 400, ml: 1 }}>
+										{Math.round(d.power_watts)} W
+									</Box>
+								)}
+							</Box>
+						</Box>
+						<Meter label="NVENC" name="NVENC" percent={d.util_encoder_percent} history={g.enc} text={pctText(d.util_encoder_percent)} />
+						<Meter label="NVDEC" name="NVDEC" percent={d.util_decoder_percent} history={g.dec} text={pctText(d.util_decoder_percent)} />
+						<Fill label="VRAM" percent={mem} text={`${num(d.memory_used_bytes / GiB, 1)} / ${num(d.memory_total_bytes / GiB)} GB`} />
+						<Typography variant="caption">
+							<Trans>
+								{d.encoder_sessions} encoder sessions, {c.leases} processes assigned
+							</Trans>
+							{!c.eligible && c.reason ? <span>. {c.reason}</span> : ''}
+						</Typography>
+					</Box>
+				);
+			})}
+		</Paper>
+	);
+}
