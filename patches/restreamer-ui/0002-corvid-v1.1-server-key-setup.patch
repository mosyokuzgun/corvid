diff --git a/src/misc/ObsAddress.js b/src/misc/ObsAddress.js
new file mode 100644
index 0000000..8ae1fe6
--- /dev/null
+++ b/src/misc/ObsAddress.js
@@ -0,0 +1,63 @@
+import React from 'react';
+
+import { Trans } from '@lingui/macro';
+import Grid from '@mui/material/Grid';
+import Typography from '@mui/material/Typography';
+
+import BoxTextarea from './BoxTextarea';
+import Textarea from './Textarea';
+
+// OBS asks for an RTMP address in two parts (fork): "Server" and "Stream key". The key part is
+// what follows the application path: "<name>.stream/<token>".
+export const splitRTMP = (address, name) => {
+	const marker = '/' + name + '.stream';
+	const i = address.lastIndexOf(marker);
+	if (i < 0) {
+		return null;
+	}
+	return { server: address.slice(0, i), key: address.slice(i + 1) };
+};
+
+export default function ObsAddress(props) {
+	const parts = splitRTMP(props.address, props.name);
+
+	return (
+		<React.Fragment>
+			<Grid item xs={12}>
+				<Typography>
+					<Trans>Address:</Trans>
+				</Typography>
+			</Grid>
+			<Grid item xs={12}>
+				<BoxTextarea>
+					<Textarea rows={2} value={props.address} readOnly allowCopy />
+				</BoxTextarea>
+			</Grid>
+			{parts && (
+				<React.Fragment>
+					<Grid item xs={12}>
+						<Typography variant="caption">
+							<Trans>In OBS (Settings → Stream → Service "Custom"):</Trans>
+						</Typography>
+					</Grid>
+					<Grid item xs={12}>
+						<Typography variant="body2">
+							<Trans>Server</Trans>
+						</Typography>
+						<BoxTextarea>
+							<Textarea rows={1} value={parts.server} readOnly allowCopy />
+						</BoxTextarea>
+					</Grid>
+					<Grid item xs={12}>
+						<Typography variant="body2">
+							<Trans>Stream key</Trans>
+						</Typography>
+						<BoxTextarea>
+							<Textarea rows={1} value={parts.key} readOnly allowCopy />
+						</BoxTextarea>
+					</Grid>
+				</React.Fragment>
+			)}
+		</React.Fragment>
+	);
+}
diff --git a/src/misc/ObsAddress.test.js b/src/misc/ObsAddress.test.js
new file mode 100644
index 0000000..9b50c93
--- /dev/null
+++ b/src/misc/ObsAddress.test.js
@@ -0,0 +1,7 @@
+import { splitRTMP } from './ObsAddress';
+
+test('an RTMP address is split into the two OBS fields', () => {
+	expect(splitRTMP('rtmp://203.0.113.10/live/abc.stream/0123abcd', 'abc')).toEqual({ server: 'rtmp://203.0.113.10/live', key: 'abc.stream/0123abcd' });
+	expect(splitRTMP('rtmp://host:1935/abc.stream', 'abc')).toEqual({ server: 'rtmp://host:1935', key: 'abc.stream' });
+	expect(splitRTMP('rtmp://host/other', 'abc')).toBe(null);
+});
