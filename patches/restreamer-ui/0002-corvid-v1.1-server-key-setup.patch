+import Alert from '@mui/material/Alert';
+import Box from '@mui/material/Box';
+import Button from '@mui/material/Button';
+import Typography from '@mui/material/Typography';
+
+import { panelClient } from '../utils/panelClient';
+
+// Shown where a source would use this server's own RTMP or SRT server (fork): turns the server
+// on and gives it a stream key in one step. A server without a key takes a stream from anyone
+// who knows the address, so a server that is on but has no key is pointed out as well.
+//
+// kind: 'rtmp' | 'srt'; enabled, token: the server's state; onDone: called after the settings
+// were changed (without it, the page is reloaded so it shows the new state).
+export default function ServerKeySetup(props) {
+	const client = panelClient();
+	const [$busy, setBusy] = React.useState(false);
+	const [$error, setError] = React.useState('');
+
+	if (props.enabled && props.token) {
+		return null;
+	}
+
+	const name = props.kind === 'srt' ? 'SRT' : 'RTMP';
+	const admin = !client || client.IsAdmin();
+
+	const setup = async () => {
+		setBusy(true);
+		setError('');
+		const err = client ? await client.SetupServer(props.kind) : 'no connection';
+		if (err) {
+			setBusy(false);
+			setError(err);
+			return;
+		}
+		if (props.onDone) {
+			await props.onDone();
+			setBusy(false);
+		} else {
+			window.location.reload();
+		}
+	};
+
+	return (
+		<Box sx={{ display: 'flex', flexDirection: 'column', gap: 1.5 }}>
+			{props.enabled ? (
+				<Alert severity="warning">
+					<Trans>
+						This {name} server has no stream key: anyone who knows the address can send a stream to it. Create a key; it becomes part
+						of the address you give to OBS or the encoder.
+					</Trans>
+				</Alert>
+			) : (
+				<Typography>
+					<Trans>
+						The {name} server is off. Turn it on so OBS or an encoder can send to it. A stream key is created with it: without the key
+						nobody can send a stream.
+					</Trans>
+				</Typography>
+			)}
+			{admin ? (
+				<React.Fragment>
+					<Button variant="outlined" size="large" fullWidth color="primary" disabled={$busy} onClick={setup}>
+						{$busy ? (
+							<Trans>Applying the settings…</Trans>
+						) : props.enabled ? (
+							<Trans>Create a stream key</Trans>
+						) : (
+							<Trans>Turn on the {name} server and create a key</Trans>
+						)}
+					</Button>
+					<Typography variant="caption">
+						<Trans>The server settings are reloaded: connected channels are interrupted for a few seconds.</Trans>
+					</Typography>
+				</React.Fragment>
+			) : (
+				<Typography variant="caption">
+					<Trans>Only an administrator can do this.</Trans>
+				</Typography>
+			)}
+			{$error && (
+				<Alert severity="error">
+					<Trans>The settings could not be changed: {$error}</Trans>
+				</Alert>
+			)}
+		</Box>
+	);
+}
