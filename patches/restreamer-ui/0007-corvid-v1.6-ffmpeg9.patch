diff --git a/src/misc/coders/Encoders/audio/vsync.test.js b/src/misc/coders/Encoders/audio/vsync.test.js
new file mode 100644
index 0000000..e0467bb
--- /dev/null
+++ b/src/misc/coders/Encoders/audio/vsync.test.js
@@ -0,0 +1,29 @@
+import * as Opus from './opus';
+import * as Mp3 from './mp3_libmp3lame';
+import * as Vorbis from './vorbis_libvorbis';
+
+const skills = (version) => {
+	const [major, minor] = version.split('.').map((x) => parseInt(x));
+	return { ffmpeg: { version, version_major: major, version_minor: minor } };
+};
+
+const stream = { codec: 'aac', sampling_hz: 48000, layout: 'stereo', channels: 2 };
+
+// "-vsync" is gone since FFmpeg 7: an encoder must not add it there, but keeps adding it
+// for FFmpeg 6 (unchanged behavior).
+describe.each([
+	['opus', Opus],
+	['mp3', Mp3],
+	['vorbis', Vorbis],
+])('%s', (name, coder) => {
+	test('FFmpeg 6 keeps -vsync drop', () => {
+		const settings = coder.defaults(stream, skills('6.1.1'));
+		expect(settings.mapping.global).toEqual([['-vsync', 'drop']]);
+	});
+
+	test('FFmpeg 9 adds no -vsync', () => {
+		const settings = coder.defaults(stream, skills('9.0.2'));
+		expect(settings.mapping.global).toEqual([]);
+		expect(settings.mapping.local).not.toContain('-vsync');
+	});
+});
diff --git a/src/misc/coders/helper/index.js b/src/misc/coders/helper/index.js
index 9bf5c1b..aba8172 100644
--- a/src/misc/coders/helper/index.js
+++ b/src/misc/coders/helper/index.js
@@ -31,7 +31,19 @@ function InitSkills(initialSkills) {
 	return skills;
 }
 
+// Global options that some audio encoders add. "-vsync" is gone since
+// FFmpeg 7 (replaced by the per output "-fps_mode"); it only ever affected
+// encoded video, so nothing is added there.
+function AudioGlobals(skills) {
+	if (skills.ffmpeg.version_major >= 7) {
+		return [];
+	}
+
+	return [['-vsync', 'drop']];
+}
+
 export default {
 	InitStream,
 	InitSkills,
+	AudioGlobals,
 };
