diff --git a/public/_player/videojs/player.html b/public/_player/videojs/player.html
index a3273ca..389f004 100644
--- a/public/_player/videojs/player.html
+++ b/public/_player/videojs/player.html
@@ -73,6 +73,21 @@
 	var statistics = convertBoolParam("stats", playerConfig.statistics);
 	var color = convertColorParam("color", playerConfig.color.buttons);
 
+	// Corvid: a viewer code from this page's address ("?code=...") goes into the path of the
+	// stream and the poster ("memfs/k/<code>/..."), so every part of the stream carries it.
+	var code = getQueryParam("code", "");
+	if (!/^[0-9A-Za-z_-]{16,128}$/.test(code)) {
+		code = "";
+	}
+	function withCode(path) {
+		if (code.length === 0 || path.indexOf("memfs/") !== 0) {
+			return path;
+		}
+		return "memfs/k/" + code + "/" + path.substring(6);
+	}
+	playerConfig.source = withCode(playerConfig.source);
+	playerConfig.poster = withCode(playerConfig.poster);
+
 	var config = {
 		controls: true,
 		poster: playerConfig.poster + '?t=' + String(new Date().getTime()),
