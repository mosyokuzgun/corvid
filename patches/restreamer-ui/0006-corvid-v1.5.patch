diff --git a/src/utils/clipboard.test.js b/src/utils/clipboard.test.js
new file mode 100644
index 0000000..069a8da
--- /dev/null
+++ b/src/utils/clipboard.test.js
@@ -0,0 +1,29 @@
+import CopyToClipboard from './clipboard';
+
+afterEach(() => {
+	delete navigator.clipboard;
+});
+
+test('without navigator.clipboard (plain HTTP) the text field is used', async () => {
+	let copied = '';
+	document.execCommand = jest.fn(() => {
+		copied = document.activeElement.value;
+		return true;
+	});
+	expect(await CopyToClipboard('srt://host:6000?streamid=a')).toBe(true);
+	expect(copied).toBe('srt://host:6000?streamid=a');
+	expect(document.querySelectorAll('textarea').length).toBe(0);
+});
+
+test('a refused clipboard falls back to the text field', async () => {
+	Object.defineProperty(navigator, 'clipboard', { value: { writeText: () => Promise.reject(new Error('denied')) }, configurable: true });
+	document.execCommand = jest.fn(() => true);
+	jest.spyOn(console, 'warn').mockImplementation(() => {});
+	expect(await CopyToClipboard('x')).toBe(true);
+	expect(document.execCommand).toHaveBeenCalledWith('copy');
+});
+
+test('a failed copy is reported', async () => {
+	document.execCommand = jest.fn(() => false);
+	expect(await CopyToClipboard('x')).toBe(false);
+});
