diff --git a/src/views/Main/Share.js b/src/views/Main/Share.js
new file mode 100644
index 0000000..aae32db
--- /dev/null
+++ b/src/views/Main/Share.js
@@ -0,0 +1,265 @@
+import React from 'react';
+
+import { Trans, t } from '@lingui/macro';
+import { useLingui } from '@lingui/react';
+import Alert from '@mui/material/Alert';
+import Box from '@mui/material/Box';
+import Button from '@mui/material/Button';
+import Dialog from '@mui/material/Dialog';
+import DialogActions from '@mui/material/DialogActions';
+import DialogContent from '@mui/material/DialogContent';
+import DialogTitle from '@mui/material/DialogTitle';
+import FormControlLabel from '@mui/material/FormControlLabel';
+import MenuItem from '@mui/material/MenuItem';
+import Switch from '@mui/material/Switch';
+import TextField from '@mui/material/TextField';
+import Typography from '@mui/material/Typography';
+
+import BoxTextarea from '../../misc/BoxTextarea';
+import Textarea from '../../misc/Textarea';
+import Palette from '../../theme/base/palette';
+
+// Share a channel with viewers (fork): every viewer gets a code of their own, which plays the
+// channel's player, HLS, RTMP and SRT until it expires or is removed. See the viewer codes in
+// utils/restreamer.js.
+
+const DURATIONS = [
+	{ hours: 24, label: () => t`1 day` },
+	{ hours: 24 * 7, label: () => t`1 week` },
+	{ hours: 24 * 30, label: () => t`30 days` },
+];
+
+const date = (unix) =>
+	new Date(unix * 1000).toLocaleString(undefined, { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' });
+
+function Addresses(props) {
+	const { i18n } = useLingui();
+	const a = props.addresses;
+	const names = { player: i18n._(t`Player link`), hls: 'HLS', rtmp: 'RTMP', srt: 'SRT' };
+	const rows = [
+		{ key: 'player', label: <Trans>Player link</Trans>, hint: <Trans>Opens in any browser.</Trans> },
+		{ key: 'hls', label: <Trans>HLS</Trans>, hint: <Trans>For VLC, smart TVs and other players.</Trans> },
+		{ key: 'rtmp', label: <Trans>RTMP</Trans>, hint: null },
+		{ key: 'srt', label: <Trans>SRT</Trans>, hint: null },
+	].filter((r) => a[r.key]);
+
+	return (
+		<Box sx={{ display: 'flex', flexDirection: 'column', gap: 1.25 }}>
+			{rows.map((r) => (
+				<Box key={r.key}>
+					<Typography variant="body2" component="div" sx={{ fontWeight: 600 }}>
+						{r.label}
+						{r.hint && (
+							<Typography variant="caption" component="span" sx={{ fontWeight: 400, ml: 1 }}>
+								{r.hint}
+							</Typography>
+						)}
+					</Typography>
+					<BoxTextarea>
+						<Textarea rows={1} value={a[r.key]} readOnly allowCopy label={names[r.key]} />
+					</BoxTextarea>
+				</Box>
+			))}
+		</Box>
+	);
+}
+
+export default function Share(props) {
+	const r = props.restreamer;
+	const { i18n } = useLingui();
+	const [$label, setLabel] = React.useState('');
+	const [$hours, setHours] = React.useState(24 * 7);
+	const [$codes, setCodes] = React.useState([]);
+	const [$shown, setShown] = React.useState(null); // { key, addresses }
+	const [$armed, setArmed] = React.useState('');
+	const [$protected, setProtected] = React.useState(r.IsPlayerProtected(props.channelid));
+	const [$busy, setBusy] = React.useState(false);
+	const [$error, setError] = React.useState('');
+
+	const load = async () => {
+		const now = Math.floor(Date.now() / 1000);
+		setCodes((await r.GetViewerCodes(props.channelid)).filter((k) => k.expires > now).sort((a, b) => b.created - a.created));
+	};
+
+	React.useEffect(() => {
+		if (props.open) {
+			setProtected(r.IsPlayerProtected(props.channelid));
+			setShown(null);
+			setError('');
+			load();
+		}
+		// eslint-disable-next-line react-hooks/exhaustive-deps
+	}, [props.open, props.channelid]);
+
+	const show = async (key) => {
+		setShown({ key, addresses: await r.ViewerAddresses(props.channelid, key) });
+	};
+
+	const create = async () => {
+		setBusy(true);
+		setError('');
+		const key = await r.AddViewerCode(props.channelid, $label, $hours);
+		setBusy(false);
+		if (!key) {
+			setError(i18n._(t`The code could not be created.`));
+			return;
+		}
+		setLabel('');
+		await load();
+		await show(key);
+	};
+
+	const remove = async (token) => {
+		await r.DeleteGuestKey(token);
+		setArmed('');
+		if ($shown && $shown.key.token === token) {
+			setShown(null);
+		}
+		await load();
+	};
+
+	const toggleProtection = async (on) => {
+		setBusy(true);
+		const err = await r.SetPlayerProtected(props.channelid, on);
+		setBusy(false);
+		if (err) {
+			setError(err);
+			return;
+		}
+		setProtected(on);
+	};
+
+	const memfs = props.storage !== 'diskfs';
+
+	return (
+		<Dialog open={props.open} onClose={props.onClose} fullWidth maxWidth="sm" aria-labelledby="share-title" scroll="paper">
+			<DialogTitle id="share-title" component="div">
+				<Typography variant="h3" component="h2">
+					<Trans>Share with viewers</Trans>
+				</Typography>
+				{props.name && (
+					<Typography variant="body2" component="div" sx={{ color: 'text.secondary' }}>
+						{props.name}
+					</Typography>
+				)}
+			</DialogTitle>
+			<DialogContent dividers sx={{ display: 'flex', flexDirection: 'column', gap: 2 }}>
+				<Typography variant="body2">
+					<Trans>
+						Every viewer gets addresses with a code of their own. When the code expires or you remove it, those addresses stop
+						working; the others go on.
+					</Trans>
+				</Typography>
+
+				<Box component="form" onSubmit={(e) => e.preventDefault()} sx={{ display: 'flex', flexWrap: 'wrap', gap: 1, alignItems: 'flex-start' }}>
+					<TextField
+						size="small"
+						autoFocus
+						label={<Trans>Viewer (optional)</Trans>}
+						placeholder={i18n._(t`e.g. press room`)}
+						value={$label}
+						inputProps={{ maxLength: 60 }}
+						onChange={(e) => setLabel(e.target.value)}
+						sx={{ flex: '1 1 200px' }}
+					/>
+					<TextField select size="small" label={<Trans>Valid for</Trans>} value={$hours} onChange={(e) => setHours(e.target.value)} sx={{ minWidth: 140 }}>
+						{DURATIONS.map((d) => (
+							<MenuItem key={d.hours} value={d.hours}>
+								{i18n._(d.label())}
+							</MenuItem>
+						))}
+					</TextField>
+					<Button type="submit" variant="contained" color="primary" disabled={$busy} onClick={create} sx={{ height: 40 }}>
+						<Trans>Create addresses</Trans>
+					</Button>
+				</Box>
+
+				{$error && <Alert severity="error">{$error}</Alert>}
+
+				{$shown && (
+					<Box sx={{ border: `1px solid ${Palette.background.line}`, borderRadius: 1, p: 1.5 }} aria-live="polite">
+						<Typography variant="subtitle2" sx={{ mb: 1 }}>
+							{$shown.key.label || i18n._(t`Viewer without a name`)}
+							<Typography variant="caption" component="span" sx={{ ml: 1 }}>
+								<Trans>valid until {date($shown.key.expires)}</Trans>
+							</Typography>
+						</Typography>
+						<Addresses addresses={$shown.addresses} />
+						{!$protected && (
+							<Typography variant="caption" component="div" sx={{ mt: 1 }}>
+								<Trans>The player and HLS are open to everyone now; the code only matters there once the protection below is on.</Trans>
+							</Typography>
+						)}
+					</Box>
+				)}
+
+				<Box>
+					<FormControlLabel
+						control={<Switch checked={$protected} disabled={$busy || !memfs} onChange={(e) => toggleProtection(e.target.checked)} />}
+						label={<Trans>Player and HLS only with a code</Trans>}
+					/>
+					<Typography variant="caption" component="div">
+						{memfs ? (
+							<Trans>
+								When on, the player and HLS addresses without a code stop working, also a player embedded in a website and the player
+								site. RTMP and SRT always need a code or the stream key. The preview in this panel keeps working.
+							</Trans>
+						) : (
+							<Trans>Only possible when the channel keeps its HLS in memory (Edit channel → Player and outputs).</Trans>
+						)}
+					</Typography>
+				</Box>
+
+				<Box>
+					<Typography variant="subtitle2" sx={{ mb: 0.5 }}>
+						<Trans>Codes of this channel</Trans>
+					</Typography>
+					{$codes.length === 0 ? (
+						<Typography variant="body2" sx={{ color: 'text.secondary' }}>
+							<Trans>None yet.</Trans>
+						</Typography>
+					) : (
+						<Box component="ul" sx={{ listStyle: 'none', m: 0, p: 0 }}>
+							{$codes.map((k) => (
+								<Box
+									component="li"
+									key={k.token}
+									sx={{ display: 'flex', alignItems: 'center', flexWrap: 'wrap', gap: 1, py: 0.75, borderTop: `1px solid ${Palette.background.line}` }}
+								>
+									<Box sx={{ flex: '1 1 160px', minWidth: 0 }}>
+										<Typography variant="body2" sx={{ overflowWrap: 'anywhere' }}>
+											{k.label || i18n._(t`Viewer without a name`)}
+										</Typography>
+										<Typography variant="caption">
+											<Trans>until {date(k.expires)}</Trans>
+										</Typography>
+									</Box>
+									<Button size="small" color="inherit" onClick={() => show(k)}>
+										<Trans>Addresses</Trans>
+									</Button>
+									{$armed === k.token ? (
+										<Button size="small" variant="contained" color="secondary" onClick={() => remove(k.token)} onBlur={() => setArmed('')}>
+											<Trans>Really remove</Trans>
+										</Button>
+									) : (
+										<Button size="small" color="inherit" onClick={() => setArmed(k.token)}>
+											<Trans>Remove</Trans>
+										</Button>
+									)}
+								</Box>
+							))}
+						</Box>
+					)}
+					<Typography variant="caption" component="div" sx={{ mt: 0.5 }}>
+						<Trans>A removed code stops new connections at once; an RTMP or SRT viewer already connected stays until they reconnect.</Trans>
+					</Typography>
+				</Box>
+			</DialogContent>
+			<DialogActions>
+				<Button onClick={props.onClose} color="inherit">
+					<Trans>Close</Trans>
+				</Button>
+			</DialogActions>
+		</Dialog>
+	);
+}
