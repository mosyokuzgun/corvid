+test('the preview of a protected player goes through the ticket', () => {
+	const r = make(['abc'], 'p123-ff');
+	expect(r.GetChannelAddress('hls+memfs', 'abc')).toBe('http://panel:4501/memfs/k/p123-ff/abc.m3u8');
+	expect(r.GetChannelAddress('snapshot+memfs', 'abc')).toBe('http://panel:4501/memfs/k/p123-ff/abc.jpg');
+	// another channel, or no ticket: the plain address
+	expect(r.GetChannelAddress('hls+memfs', 'other')).toBe('http://panel:4501/memfs/other.m3u8');
+	expect(make(['abc'], '').GetChannelAddress('hls+memfs', 'abc')).toBe('http://panel:4501/memfs/abc.m3u8');
+});
