diff --git a/contrib/ffmpeg-9.0-jsonstats.patch b/contrib/ffmpeg-9.0-jsonstats.patch
new file mode 100644
index 0000000..36aa411
--- /dev/null
+++ b/contrib/ffmpeg-9.0-jsonstats.patch
@@ -0,0 +1,596 @@
+From 9eaf131df3c74ed364829caf72ab924fcb6d57c7 Mon Sep 17 00:00:00 2001
+From: Corvid <corvid@example.invalid>
+Date: Fri, 20 Nov 2026 10:50:47 +0300
+Subject: [PATCH] JSON progress report (ffmpeg 9.0)
+
+Port of the datarhei JSON progress report (Ingo Oppermann, v29 for 6.1)
+to the threaded fftools of FFmpeg 7 and later. The lines and fields the
+Restreamer core parses are unchanged:
+
+  ffmpeg.inputs:[...]    after the inputs are opened
+  ffmpeg.mapping:{...}   before the first progress line (graphs: [])
+  ffmpeg.outputs:[...]   once all muxers wrote their header
+  ffmpeg.progress:{...}  every -stats_period
+
+The per stream counters live in a JsonStats block of the public
+InputStream/OutputStream, updated by the demuxer and muxer threads.
+Changes: the framerate/GOP estimation starts at the second keyframe (the
+first interval used to be measured from timestamp 0), the hundredths of
+the time are zero padded, strings are JSON escaped.
+---
+ fftools/ffmpeg.c       | 407 ++++++++++++++++++++++++++++++++++++++++-
+ fftools/ffmpeg.h       |  28 +++
+ fftools/ffmpeg_demux.c |   4 +
+ fftools/ffmpeg_mux.c   |   3 +
+ fftools/ffmpeg_opt.c   |   6 +
+ 5 files changed, 447 insertions(+), 1 deletion(-)
+
+diff --git a/fftools/ffmpeg.c b/fftools/ffmpeg.c
+index b394243..bf03568 100644
+--- a/fftools/ffmpeg.c
++++ b/fftools/ffmpeg.c
+@@ -69,6 +69,8 @@
+ #endif
+ 
+ #include "libavutil/bprint.h"
++#include "libavutil/channel_layout.h"
++#include "libavutil/pixdesc.h"
+ #include "libavutil/dict.h"
+ #include "libavutil/mem.h"
+ #include "libavutil/time.h"
+@@ -82,6 +84,7 @@
+ #include "compat/android/binder.h"
+ #endif
+ #include "ffmpeg.h"
++#include "ffmpeg_mux.h"
+ #include "ffmpeg_sched.h"
+ #include "ffmpeg_utils.h"
+ #include "graph/graphprint.h"
+@@ -569,7 +572,7 @@ void update_benchmark(const char *fmt, ...)
+     }
+ }
+ 
+-static void print_report(int is_last_report, int64_t timer_start, int64_t cur_time, int64_t pts)
++static void print_default_report(int is_last_report, int64_t timer_start, int64_t cur_time, int64_t pts)
+ {
+     AVBPrint buf, buf_script;
+     int64_t total_size = of_filesize(output_files[0]);
+@@ -731,6 +734,408 @@ static void print_report(int is_last_report, int64_t timer_start, int64_t cur_ti
+     first_report = 0;
+ }
+ 
++/*
++ * JSON progress report (datarhei Restreamer / Corvid).
++ *
++ * The lines printed here are parsed by the Restreamer core:
++ *   ffmpeg.inputs:[...]     once, after the inputs are opened
++ *   ffmpeg.mapping:{...}    once, before the first progress report
++ *   ffmpeg.outputs:[...]    once, before the first progress report
++ *   ffmpeg.progress:{...}   every stats_period
++ */
++
++void jsonstats_update(JsonStats *js, const AVPacket *pkt, AVRational tb, int is_key)
++{
++    js->nb_packets++;
++    js->data_size += pkt->size;
++
++    if (!is_key)
++        return;
++
++    js->nb_keyframes++;
++
++    if (pkt->dts == AV_NOPTS_VALUE)
++        return;
++
++    {
++        int64_t ts = av_rescale_q(pkt->dts, tb, AV_TIME_BASE_Q);
++
++        // framerate and GOP size estimation between two keyframes
++        if (js->have_keyframe && ts - js->last_keyframe_dts > 0) {
++            double gopsize   = (double)(js->nb_packets - js->last_keyframe_pktnb);
++            double framerate = gopsize / (double)(ts - js->last_keyframe_dts) * (double)AV_TIME_BASE;
++
++            if (js->min_framerate == 0.0 || framerate < js->min_framerate)
++                js->min_framerate = framerate;
++            if (js->max_framerate == 0.0 || framerate > js->max_framerate)
++                js->max_framerate = framerate;
++
++            if (js->min_gopsize == 0.0 || gopsize < js->min_gopsize)
++                js->min_gopsize = gopsize;
++            if (js->max_gopsize == 0.0 || gopsize > js->max_gopsize)
++                js->max_gopsize = gopsize;
++
++            js->nsamples_average++;
++
