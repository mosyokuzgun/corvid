diff --git a/Build.ubuntu.corvid.env b/Build.ubuntu.corvid.env
new file mode 100644
index 0000000..8253a2f
--- /dev/null
+++ b/Build.ubuntu.corvid.env
@@ -0,0 +1,5 @@
+# FFMPEG 9 FOR CORVID (redistributable, NVENC/NVDEC + CUDA filters via clang)
+OS_NAME=ubuntu
+OS_VERSION=24.04
+FFNVCODEC_VERSION=12.1.14.0
+FFMPEG_VERSION=9.0.2
diff --git a/Dockerfile.ubuntu.corvid b/Dockerfile.ubuntu.corvid
new file mode 100644
index 0000000..50a9746
--- /dev/null
+++ b/Dockerfile.ubuntu.corvid
@@ -0,0 +1,156 @@
+# FFmpeg 9.0 for Corvid (datarhei Restreamer fork) with NVIDIA NVENC/NVDEC and CUDA filters.
+#
+# Redistributable: no --enable-nonfree. The CUDA filters (scale_cuda, overlay_cuda, ...) are
+# compiled with clang (--enable-cuda-llvm) instead of nvcc, libfdk-aac is not used (Corvid uses
+# the native aac encoder). The build needs no CUDA toolkit: NVENC/NVDEC/CUDA are loaded from the
+# driver at run time (nv-codec-headers), the NVIDIA container toolkit mounts the driver libraries.
+#
+#   docker build -f Dockerfile.ubuntu.corvid -t corvid-ffmpeg:9.0.2 .
+
+ARG BUILD_IMAGE=ubuntu:24.04
+# The runtime stays the CUDA runtime image Corvid already runs on (same Ubuntu 24.04 base).
+ARG DEPLOY_IMAGE=nvidia/cuda:12.6.1-runtime-ubuntu24.04
+
+FROM $BUILD_IMAGE AS builder
+
+# 12.1.14.0 needs NVIDIA driver >= 530 (the 580 branch is the last one for Pascal/Maxwell/Volta)
+ARG FFNVCODEC_VERSION=12.1.14.0
+ARG FFMPEG_VERSION=9.0.2
+ARG BUILD_DATE=1970-01-01T00:00:00Z
+ARG BUILD_COMMIT=unknown
+
+ENV PKG_CONFIG_PATH=/usr/local/lib/pkgconfig
+ENV SRC=/usr/local
+ENV DEBIAN_FRONTEND=noninteractive
+
+RUN apt-get update -y && \
+  apt-get install -y --no-install-recommends \
+  ca-certificates \
+  pkg-config \
+  curl \
+  xz-utils \
+  nasm \
+  build-essential \
+  clang \
+  llvm \
+  libssl-dev \
+  libv4l-dev \
+  libasound2-dev \
+  libx264-dev \
+  libx265-dev \
+  librav1e-dev \
+  libaom-dev \
+  libdav1d-dev \
+  libvpx-dev \
+  libmp3lame-dev \
+  libopus-dev \
+  libvorbis-dev \
+  libogg-dev \
+  libfreetype-dev \
+  libharfbuzz-dev \
+  libsrt-openssl-dev \
+  libxml2-dev \
+  libxcb1-dev \
+  libxcb-xfixes0-dev \
+  libxcb-shm0-dev \
+  libxcb-shape0-dev \
+  zlib1g-dev
+
+RUN mkdir -p /dist && cd /dist && \
+  curl -fsSLO https://ffmpeg.org/releases/ffmpeg-${FFMPEG_VERSION}.tar.xz && \
+  curl -fsSLO https://github.com/FFmpeg/nv-codec-headers/releases/download/n${FFNVCODEC_VERSION}/nv-codec-headers-${FFNVCODEC_VERSION}.tar.gz && \
+  tar -xJf ffmpeg-${FFMPEG_VERSION}.tar.xz && \
+  tar -xzf nv-codec-headers-${FFNVCODEC_VERSION}.tar.gz && \
+  rm ffmpeg-${FFMPEG_VERSION}.tar.xz nv-codec-headers-${FFNVCODEC_VERSION}.tar.gz && \
+  make -C nv-codec-headers-${FFNVCODEC_VERSION} install
+
+COPY ./contrib /contrib
+
+RUN cd /dist/ffmpeg-${FFMPEG_VERSION} && \
+  patch -p1 < /contrib/ffmpeg-9.0-jsonstats.patch && \
+  patch -p1 < /contrib/ffmpeg-9.0-hls.patch && \
+  ./configure \
+  --extra-version="corvid-${BUILD_COMMIT}" \
+  --prefix="${SRC}" \
+  --enable-gpl \
+  --enable-version3 \
+  --enable-openssl \
+  --enable-libxml2 \
+  --enable-ffnvcodec \
+  --enable-cuda-llvm \
+  --enable-cuvid \
+  --enable-nvdec \
+  --enable-nvenc \
+  --enable-libv4l2 \
+  --enable-libfreetype \
+  --enable-libharfbuzz \
+  --enable-alsa \
+  --enable-libsrt \
+  --enable-libx264 \
+  --enable-libx265 \
+  --enable-libvpx \
+  --enable-libmp3lame \
+  --enable-libopus \
+  --enable-libvorbis \
+  --enable-libdav1d \
+  --enable-librav1e \
+  --enable-libaom \
+  --enable-libxcb \
+  --disable-ffplay \
+  --disable-ffprobe \
+  --disable-debug \
+  --disable-doc && \
+  make -j$(nproc) && \
+  make install && \
+  hash -r && \
+  ffmpeg -hide_banner -buildconf | grep -q -- '--enable-nonfree' && { echo "ERROR: nonfree build"; exit 1; } || true
+
+RUN mkdir -p /ffmpeglibs && \
+  ldd /usr/local/bin/ffmpeg | grep -o -e '/lib/[a-z0-9_]*-linux-gnu/[^ ]*' | xargs -I % cp -v % /ffmpeglibs
+
+# Self-contained FFmpeg for the Corvid update package (update.sh mounts it at /core/ffmpeg):
+# the binary looks for its libraries next to itself ($ORIGIN/lib, DT_RPATH so it also applies
+# to the libraries' own dependencies), glibc stays the container's (same Ubuntu 24.04).
+#   docker build --target bundle -o type=local,dest=out -f Dockerfile.ubuntu.corvid .
+FROM builder AS bundle-build
+RUN apt-get install -y --no-install-recommends patchelf && \
+  mkdir -p /bundle/lib && \
+  cp /usr/local/bin/ffmpeg /bundle/ffmpeg && \
+  ldd /usr/local/bin/ffmpeg | grep -o -e '/lib/[a-z0-9_]*-linux-gnu/[^ ]*' | \
+    grep -v -E '/(libc|libm|libdl|libpthread|librt|libresolv|libmvec|ld-linux-x86-64)\.so' | \
+    xargs -I % cp -L % /bundle/lib/ && \
+  patchelf --force-rpath --set-rpath '$ORIGIN/lib' /bundle/ffmpeg && \
+  strip --strip-unneeded /bundle/lib/*.so* && \
+  /bundle/ffmpeg -hide_banner -version | head -n 1 && \
+  cd /bundle && sha256sum ffmpeg lib/* > SHA256SUMS
+
+FROM scratch AS bundle
+COPY --from=bundle-build /bundle /
+
+FROM $DEPLOY_IMAGE
+
+COPY --from=builder /usr/local/bin/ffmpeg /usr/local/bin/ffmpeg
+COPY --from=builder /ffmpeglibs /ffmpeglibs
+
+ENV DEBIAN_FRONTEND=noninteractive
+
+# Fail the build if the filters the Corvid GPU canvas needs are missing.
+RUN echo "/ffmpeglibs" > /etc/ld.so.conf.d/ffmpeg.conf && \
+  ldconfig && \
+  apt-get update && \
+  apt-get install -y --no-install-recommends ca-certificates openssl tzdata v4l-utils fbset libasound2t64 && \
+  rm -rf /var/lib/apt/lists/* && \
+  ffmpeg -hide_banner -buildconf && \
+  for f in scale_cuda overlay_cuda; do \
+    ffmpeg -hide_banner -filters | grep -q " $f " || { echo "ERROR: FFmpeg has no $f"; exit 1; }; \
+  done && \
+  for e in h264_nvenc hevc_nvenc; do \
+    ffmpeg -hide_banner -encoders | grep -q " $e " || { echo "ERROR: FFmpeg has no $e"; exit 1; }; \
+  done
+
+ENV NVIDIA_VISIBLE_DEVICES=all
+ENV NVIDIA_DRIVER_CAPABILITIES=compute,video,utility
+
+WORKDIR /tmp
+ENTRYPOINT ["/usr/local/bin/ffmpeg"]
+CMD ["-version"]
diff --git a/contrib/ffmpeg-9.0-hls.patch b/contrib/ffmpeg-9.0-hls.patch
new file mode 100644
index 0000000..6f7c9d3
--- /dev/null
+++ b/contrib/ffmpeg-9.0-hls.patch
@@ -0,0 +1,224 @@
+From ed9d293c1c9de42343ed160be95728e5df62b7d4 Mon Sep 17 00:00:00 2001
+From: Corvid <corvid@example.invalid>
+Date: Fri, 20 Nov 2026 10:39:57 +0300
+Subject: [PATCH] HLS extensions (ffmpeg 9.0)
+
+Port of the datarhei HLS muxer extensions (Ingo Oppermann, v6 for 6.1):
+bitrate estimation for streamcopy and the hls.streammap line. The
+estimation now skips packets without pts and intervals without data.
+---
+ README.HLS.md        | 48 +++++++++++++++++++++++++
+ libavformat/hlsenc.c | 86 +++++++++++++++++++++++++++++++++++++++++---
+ 2 files changed, 129 insertions(+), 5 deletions(-)
+ create mode 100644 README.HLS.md
+
+diff --git a/README.HLS.md b/README.HLS.md
+new file mode 100644
+index 0000000..5462338
+--- /dev/null
++++ b/README.HLS.md
+@@ -0,0 +1,48 @@
++# HLS Muxer Extensions
++
++Various extensions to the HLS muxer `hlsenc.c`.
++
++## Bitrate Estimation
++
++If streamcopy is used, the muxer doesn't get always information about the bitrate. However, this is required if you want
++to write a manifest with multiple bitrate substreams. This patch adds an estimator for the bitrate (based on data written
++between two keyframes) which kicks in if there's no bitrate provided, e.g.
++
++```
++ffmpeg \
++  -re -i https://demo.datarhei.com/memfs/1f33d538-d714-4c7e-9559-46ddb8118f03.m3u8 \
++  -c:v:0 copy -bsf:v:0 h264_metadata \
++  -map 0:v:0 \
++  -f hls \
++  -start_number 0 -hls_time 2 -hls_list_size 6 -hls_delete_threshold 12 \
++  -hls_flags append_list+delete_segments+program_date_time+independent_segments \
++  -hls_segment_type mpegts -hls_segment_filename 'http://localhost:8080/memfs/%v_%04d.ts' \
++  -master_pl_name main.m3u8 -master_pl_publish_rate 5 -var_stream_map v:0 -y \
++  -method PUT -http_persistent 1 -ignore_io_errors 1 'http://localhost:8080/memfs/%v.m3u8'
++```
++
++Without the patch, a message like `Bandwidth info not available, set audio and video bitrates` will appear.
++
++## Variant Stream Map
++
++From the outside of the muxer, everything is one output even if the muxer creates several variants. This patch prints a
++map of the variants to `stderr` as JSON on one line, similar to this one:
++
++```
++hls.streammap:{"address":"http://127.0.0.1:8080/memfs/live/%v.m3u8","variants":[{"variant":0,"address":"http://127.0.0.1:8080/memfs/live/0.m3u8","streams":[0,2]},{"variant":1,"address":"http://127.0.0.1:8080/memfs/live/1.m3u8","streams":[1,3]}]}
++```
++
++The prefix is `hls.streammap`.
++
++It lists all variant substreams and which output streams are used. The `streams` array lists the indexs of the output streams from the stream mapping. For the
++above HLS stream map, this is the FFmpeg stream map:
++
++```
++Stream mapping:
++  Stream #0:0 -> #0:0 (copy)
++  Stream #1:0 -> #0:1 (copy)
++  Stream #2:0 -> #0:2 (pcm_u8 (native) -> aac (native))
++  Stream #2:0 -> #0:3 (pcm_u8 (native) -> aac (native))
++```
++
++In the command, the `-var_stream_map` option had the value `v:0,a:0 v:1,a:1`.
+diff --git a/libavformat/hlsenc.c b/libavformat/hlsenc.c
+index 50f19f9..47bfd70 100644
+--- a/libavformat/hlsenc.c
++++ b/libavformat/hlsenc.c
+@@ -126,6 +126,7 @@ typedef struct VariantStream {
+     AVIOContext *out;
+     AVIOContext *out_single_file;
+     int packets_written;
++    uint64_t bytes_written;
+     int init_range_length;
+     uint8_t *temp_buffer;
+     uint8_t *init_buffer;
+@@ -140,6 +141,8 @@ typedef struct VariantStream {
+     double dpp;           // duration per packet
+     int64_t start_pts;
+     int64_t end_pts;
++    int64_t scaled_start_pts;
++    int64_t scaled_cur_pts;
+     int64_t video_lastpos;
+     double duration;      // last segment duration computed so far, in seconds
+     int64_t start_pos;    // last segment starting position
+@@ -1370,7 +1373,7 @@ static int create_master_playlist(AVFormatContext *s,
+     AVStream *vid_st, *aud_st;
+     AVDictionary *options = NULL;
+     unsigned int i, j;
+-    int ret, bandwidth, avg_bandwidth;
++    int ret, bandwidth, avg_bandwidth, st_bandwidth, est_bandwidth;
+     const char *m3u8_rel_name = NULL;
+     const char *vtt_m3u8_rel_name = NULL;
+     const char *ccgroup;
+@@ -1487,10 +1490,37 @@ static int create_master_playlist(AVFormatContext *s,
+         } else {
+             bandwidth = 0;
+             avg_bandwidth = 0;
+-            if (vid_st)
+-                bandwidth += get_stream_bit_rate(vid_st);
+-            if (aud_st)
+-                bandwidth += get_stream_bit_rate(aud_st);
++            est_bandwidth = 0;
++
++            if (vid_st) {
++                st_bandwidth = get_stream_bit_rate(vid_st);
++                if (st_bandwidth == 0) {
++                    est_bandwidth = 1;
++                } else {
++                    bandwidth += st_bandwidth;
++                }
++            }
++            if (aud_st) {
++                st_bandwidth = get_stream_bit_rate(aud_st);
++                if (st_bandwidth == 0) {
++                    est_bandwidth = 1;
++                } else {
++                    bandwidth += st_bandwidth;
++                }
++            }
++
++            if (est_bandwidth != 0 && vs->scaled_cur_pts != AV_NOPTS_VALUE &&
++                vs->scaled_start_pts != AV_NOPTS_VALUE &&
++                vs->scaled_cur_pts > vs->scaled_start_pts) {
++                // Estimate bandwidth (streamcopy doesn't always know the bitrate)
++                bandwidth = (int)round((double)vs->bytes_written / (av_q2d(AV_TIME_BASE_Q) * (vs->scaled_cur_pts - vs->scaled_start_pts)) * 8);
++
++                // Reset counters
++                vs->bytes_written = 0;
++                vs->scaled_start_pts = vs->scaled_cur_pts;
++            }
++
++            // Add 10% of the bandwidth to itself
+             bandwidth += bandwidth / 10;
+         }
+ 
+@@ -2463,6 +2493,16 @@ static int hls_write_packet(AVFormatContext *s, AVPacket *pkt)
+         return AVERROR(ENOMEM);
+     }
+ 
++    if (pkt->pts != AV_NOPTS_VALUE) {
++        int64_t pts = av_rescale_q(pkt->pts, st->time_base, AV_TIME_BASE_Q);
++
++        if (vs->scaled_start_pts == AV_NOPTS_VALUE)
++            vs->scaled_start_pts = pts;
++
++        if (vs->scaled_cur_pts == AV_NOPTS_VALUE || pts > vs->scaled_cur_pts)
++            vs->scaled_cur_pts = pts;
++    }
++
+     end_pts = hls->recording_time * vs->number;
+ 
+     if (vs->sequence - vs->nb_entries > hls->start_sequence && hls->init_time > 0) {
+@@ -2691,6 +2731,7 @@ static int hls_write_packet(AVFormatContext *s, AVPacket *pkt)
+     }
+ 
+     vs->packets_written++;
++    vs->bytes_written += (uint64_t)pkt->size;
+     if (oc->pb) {
+         ret = ff_write_chained(oc, stream_index, pkt, s, 0);
+         if (hls->ignore_io_errors)
+@@ -2872,6 +2913,36 @@ failed:
+     return 0;
+ }
+ 
++static void print_stream_mapping(AVFormatContext *s) {
++    int i = 0, j = 0;
++    HLSContext *hls = s->priv_data;
++    VariantStream *vs = NULL;
++    AVStream *avs = NULL;
++
++    fprintf(stderr, "hls.streammap:{\"address\":\"%s\",\"variants\":[", s->url);
++    for (i = 0; i < hls->nb_varstreams; i++) {
++        vs = &hls->var_streams[i];
++
++        fprintf(stderr, "{\"variant\":%d,\"address\":\"%s\",\"streams\":[", i, vs->m3u8_name);
++        for (j = 0; j < vs->nb_streams; j++) {
++            avs = vs->streams[j];
++
++            fprintf(stderr, "%d", avs->index);
++
++            if (j != vs->nb_streams-1) {
++                fprintf(stderr, ",");
++            }
++        }
++        fprintf(stderr, "]}");
++
++        if (i != hls->nb_varstreams-1) {
++            fprintf(stderr, ",");
++        }
++    }
++    fprintf(stderr, "]}\n");
++
++    return;
++}
+ 
+ static int hls_init(AVFormatContext *s)
+ {
+@@ -2978,6 +3049,8 @@ static int hls_init(AVFormatContext *s)
+         vs->sequence  = hls->start_sequence;
+         vs->start_pts = AV_NOPTS_VALUE;
+         vs->end_pts   = AV_NOPTS_VALUE;
++        vs->scaled_start_pts = AV_NOPTS_VALUE;
++        vs->scaled_cur_pts = AV_NOPTS_VALUE;
+         vs->current_segment_final_filename_fmt[0] = '\0';
+         vs->initial_prog_date_time = initial_program_date_time;
+ 
+@@ -3123,6 +3196,9 @@ static int hls_init(AVFormatContext *s)
+         vs->number++;
+     }
+ 
++    // Write out HLS stream mapping
++    print_stream_mapping(s);
++
+     return ret;
+ }
+ 
+-- 
+2.43.0
